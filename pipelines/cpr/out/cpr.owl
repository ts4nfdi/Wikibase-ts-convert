        <skos:altLabel xml:lang="en">glacier hazards</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier mass change</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier mass loss</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier melt</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier recession</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier retreat</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier runoff</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier shrinkage</skos:altLabel>
