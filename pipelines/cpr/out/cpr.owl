    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1012">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1514"/>
