        <skos:altLabel xml:lang="en">nano plastics</skos:altLabel>
        <skos:altLabel xml:lang="en">nanoplastics</skos:altLabel>
        <cpr:P7 xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm.</cpr:P7>
        <schema:description xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q106 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q106">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:label xml:lang="en">riverine flood protection</rdfs:label>
        <skos:altLabel xml:lang="en">fluvial flood protection</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against fluvial flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against fluvial floods</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against river flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against river floods</skos:altLabel>
        <skos:altLabel xml:lang="en">river flood protection</skos:altLabel>
        <skos:altLabel xml:lang="en">river floodwall</skos:altLabel>
        <skos:altLabel xml:lang="en">river floodwalls</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q982"/>
        <cpr:P7 xml:lang="en">A fluvial (riverine) flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate. Riverine flood protection refers to a set of measures and strategies designed to prevent or mitigate the impacts of flooding in areas adjacent to rivers.</cpr:P7>
        <schema:description xml:lang="en">A fluvial (riverine) flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate. Riverine flood protection refers to a set of measures and strategies designed to prevent or mitigate the impacts of flooding in areas adjacent to rivers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1067 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1067">
