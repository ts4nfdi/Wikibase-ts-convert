        <rdfs:label xml:lang="en">coal gas</rdfs:label>
        <schema:description xml:lang="en">Coal gas is a flammable gaseous fuel made from coal and supplied to the user via a piped distribution system, produced when coal is heated strongly without air.</schema:description>
    </owl:Class>
    


