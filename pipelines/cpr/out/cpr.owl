    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1429 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1429">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1291"/>
        <rdfs:label xml:lang="en">monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">standards for environmental monitoring</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q143 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q143">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">soil moisture monitoring</rdfs:label>
        <cpr:P7 xml:lang="en">Soil moisture is the amount of water in the soil. It is linked to the water cycle and is affected by both weather and climate patterns. It is also a vital component of the overall composition of ecosystems, affecting biodiversity. Accurate monitoring of soil moisture is therefore essential for understanding and managing environmental and societal challenges such as agricultural dynamics and biodiversity monitoring.</cpr:P7>
        <schema:description xml:lang="en">Soil moisture is the amount of water in the soil. It is linked to the water cycle and is affected by both weather and climate patterns. It is also a vital component of the overall composition of ecosystems, affecting biodiversity. Accurate monitoring of soil moisture is therefore essential for understanding and managing environmental and societal challenges such as agricultural dynamics and biodiversity monitoring.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1430 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1430">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1283"/>
        <rdfs:label xml:lang="en">permits</rdfs:label>
        <skos:altLabel xml:lang="en">environmental permit, environmental permits, permit, environmental permitting, development consent, development consent order, environmental authorization, mining right, planning consent, planning permission, planning permissions, prospecting right</skos:altLabel>
        <cpr:P7 xml:lang="en">A legal document that permits you to do something, such as a building permit that confirms a building is suitable for a business.</cpr:P7>
        <cpr:P9 xml:lang="en">permitting</cpr:P9>
        <schema:description xml:lang="en">A legal document that permits you to do something, such as a building permit that confirms a building is suitable for a business.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1431 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1431">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1430"/>
        <rdfs:label xml:lang="en">building permit</rdfs:label>
        <skos:altLabel xml:lang="en">construction permit, building permits, construction permits, demolition permit, land permit</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1432 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1432">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1283"/>
        <rdfs:label xml:lang="en">license</rdfs:label>
        <skos:altLabel xml:lang="en">licenses, environmental license, environmental licenses, environmental licensing, licensing, pollution license, pollution licenses, pollution licensing</skos:altLabel>
        <schema:description xml:lang="en">A legal contract that allows you to conduct actions that are otherwise prohibited.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1433 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1433">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1430"/>
        <rdfs:label xml:lang="en">pollution prevention and control permits</rdfs:label>
        <skos:altLabel xml:lang="en">PPC permit, PPC permits, pollution permit, pollution permits</skos:altLabel>
        <cpr:P7 xml:lang="en">PPC permits are regulatory requirements for industries that may release pollutants. These permits cover energy activities like combustion and refining, metals production, and mineral processing such as cement, lime, glass, and ceramics manufacturing. They ensure compliance with environmental standards to protect air, water, and land quality, reducing harm to public health and ecosystems.</cpr:P7>
        <schema:description xml:lang="en">Pollution prevention and control permits are required for industrial activities that may pollute, like energy production, metals processing, and mineral manufacturing to protect the environment.</schema:description>
    </owl:Class>
    


