    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1608 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1608">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <rdfs:label xml:lang="en">tax exemption</rdfs:label>
        <skos:altLabel xml:lang="en">exempt from tax, exempt from taxation, exempt from taxes, exempt from customs duties, exempt from customs duty, exempt from excise duties, exempt from excise duty, exempt from import duties, exempt from import duty, exempt from tariffs, tariff exempt, tax break, tax breaks, tax exemptions, tax deduction, tax write down, tax write downs, tax write off, VAT exemption, VAT exemptions, tariff exemption, tariff waiver, tax allowance, tax allowances, tax holiday, tax holidays, zero rated value added tax, zero rated VAT, exclusion from tax, tax exclusion</skos:altLabel>
        <cpr:P7 xml:lang="en">A tax exemption or exclusion is a tax incentive where the government does not count certain income or transactions as taxable, or declares certain entities to be fully tax-exempt. Example: income from feed-in tariffs is not taxable; NGOs do not pay taxes.</cpr:P7>
        <schema:description xml:lang="en">A tax exemption or exclusion is a tax incentive where the government does not count certain income or transactions as taxable, or declares certain entities to be fully tax-exempt. Example: income from feed-in tariffs is not taxable; NGOs do not pay taxes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1609 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1609">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <rdfs:label xml:lang="en">tax reduction</rdfs:label>
        <skos:altLabel xml:lang="en">tariff reduction, tax cut, tax cuts, tariff cut, tariff cuts, tariff reductions, tax reduction, tax reductions, tax abatement</skos:altLabel>
        <cpr:P7 xml:lang="en">A tax reduction is a tax incentive where the government reduces taxes for selected activities, goods or actors. Example: A lower VAT rate for renewable energy equipment.</cpr:P7>
        <schema:description xml:lang="en">A tax reduction is a tax incentive where the government reduces taxes for selected activities, goods or actors. Example: A lower VAT rate for renewable energy equipment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q161 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q161">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <rdfs:label xml:lang="en">improved irrigation efficiency</rdfs:label>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/irrigation-efficiency-and-information-systems"/>
        <cpr:P7 xml:lang="en">Improving irrigation efficiency aims at minimizing water use within the agricultural sector while continuing to maintain optimal crop productivity rates. Water (and energy) efficient irrigation also provides a number of environmental and socio-economic benefits. High irrigation efficiency is becoming increasingly important due to the current decrease in available water resources and growing populations that drive expansion of agricultural activities. Technological advances for improved irrigation include more efficient irrigation systems where water release can be controlled so that crops receive only the amount needed (e.g. pressurized irrigation systems such as drip irrigation).</cpr:P7>
        <schema:description xml:lang="en">Improving irrigation efficiency aims at minimising water use within the agricultural sector while continuing to maintain optimal crop productivity rates. Water (and energy) efficient irrigation also provides a number of environmental and socio-economic benefits. High irrigation efficiency is becoming increasingly important due to the current decrease in available water resources and growing populations that drive expansion of agricultural activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1610 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1610">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <rdfs:label xml:lang="en">accelerated depreciation</rdfs:label>
        <skos:altLabel xml:lang="en">tax free, tax-deferred, tax-free, free from tax, deferred tax, deferred taxes, tax deferral, pre tax, pre taxes</skos:altLabel>
        <cpr:P7 xml:lang="en">Accelerated depreciation rule is a tax deduction where the government allows sustainable projects to depreciate (part of) the investment in the early years of the asset’s life, effectively reducing their taxable income during these years.</cpr:P7>
        <schema:description xml:lang="en">Accelerated depreciation rule is a tax deduction where the government allows sustainable projects to depreciate (part of) the investment in the early years of the asset’s life, effectively reducing their taxable income during these years.</schema:description>
    </owl:Class>
    


