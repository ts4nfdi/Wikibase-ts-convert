        <cpr:P4 rdf:resource="https://climate.copernicus.eu/climate-projections"/>
        <schema:description xml:lang="en">Climate projections are simulations of Earth’s climate for future decades based on assumed &apos;scenarios&apos; for variables such as the concentration of greenhouse gases. Climate projections are obtained by running numerical models describing the interactions between the components of the Earth’s climate, covering the entire globe or just a specific region e.g. Europe.</schema:description>
    </owl:Class>
    


