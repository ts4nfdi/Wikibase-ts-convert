    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2555 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2555">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <rdfs:label xml:lang="en">synthetic fertiliser emissions</rdfs:label>
        <skos:altLabel xml:lang="en">emission from synthetic fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">emission from synthetic fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from application of commercial fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from application of synthetic fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic N fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic N fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic N fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic N fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic nitrogen fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from inorganic nitrogen fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from mineral fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic nitrogen fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from synthetic nitrogen fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">emissions from use of synthetic fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">synthetic fertilisers emissions</skos:altLabel>
        <skos:altLabel xml:lang="en">synthetic fertilizer emissions</skos:altLabel>
        <skos:altLabel xml:lang="en">synthetic fertilizers emissions</skos:altLabel>
        <cpr:P7 xml:lang="en">Synthetic fertilisers contribute to greenhouse gas emissions during both their production and application. They are manufactured through energy-intensive processes that rely heavily on fossil fuels. When nitrogen fertilisers are applied to soil, some of the nitrogen is absorbed by plants, while some is processed by soil microorganisms, which release nitrous oxide (N₂O) as a by-product of their metabolic processes. Synthetic nitrogen fertilisers are estimated to account for approximately 2.1% of global emissions.</cpr:P7>
        <schema:description xml:lang="en">Synthetic fertilisers contribute to greenhouse gas emissions during both their production and application. They are manufactured through energy-intensive processes that rely heavily on fossil fuels and their field application releases nitrous oxide.</schema:description>
    </owl:Class>
    


