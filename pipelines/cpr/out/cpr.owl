    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2011">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1574"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1633"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1635"/>
