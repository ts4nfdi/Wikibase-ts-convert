    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q47 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q47">
        <rdfs:label xml:lang="en">just transition</rdfs:label>
        <skos:altLabel xml:lang="en">equitable transition</skos:altLabel>
        <skos:altLabel xml:lang="en">fair transition</skos:altLabel>
        <skos:altLabel xml:lang="en">inclusive transition</skos:altLabel>
        <skos:altLabel xml:lang="en">just decarbonisation</skos:altLabel>
        <skos:altLabel xml:lang="en">just ecological transition</skos:altLabel>
        <skos:altLabel xml:lang="en">just energy transition</skos:altLabel>
        <skos:altLabel xml:lang="en">just transition</skos:altLabel>
        <skos:altLabel xml:lang="en">leave no one behind</skos:altLabel>
        <skos:altLabel xml:lang="en">leaves no one behind</skos:altLabel>
        <skos:altLabel xml:lang="en">leaving no one behind</skos:altLabel>
        <skos:altLabel xml:lang="en">participatory transition</skos:altLabel>
        <cpr:P20 xml:lang="en">y6vgzs7e</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1568"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q31"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q33"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q43"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q563"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q64"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q774"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q894"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P7 xml:lang="en">A set of principles, processes, and practices that build economic and political power to shift from an extractive economy to a regenerative economy. The protection of workers rights and livelihoods lie at the core of the just transition, but the concept has expanded the concept to encompass actions that support the full range of climate justice principles.</cpr:P7>
        <schema:description xml:lang="en">A set of principles, processes, and practices that build economic and political power to shift from an extractive economy to a regenerative economy.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q519 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q519">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">infrastructure failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breach of infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdown in infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdown of infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">climate event induced damages to physical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse in infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">damage infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">damage to infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">damages to infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">destroyed infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">destroys infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">destruction of infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">failure in infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure breach</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure collapse</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure damage</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure damages</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure fail</skos:altLabel>
        <skos:altLabel xml:lang="en">infrastructure failures</skos:altLabel>
        <skos:altLabel xml:lang="en">urban infrastructure failure</skos:altLabel>
        <skos:altLabel xml:lang="en">urban infrastructure failures</skos:altLabel>
        <cpr:P7 xml:lang="en">Extreme or slow-onset events can have adverse consequences for infrastructure, compromising systems such as transportation, water, sanitation, and energy. This leads to economic losses, service disruptions, and negative impacts on health and well-being, with costly recovery and significant effects on local economic activity.</cpr:P7>
        <schema:description xml:lang="en">Infrastructure systems, such as transportation, water, sanitation, and energy, have been compromised by extreme and slow-onset events, leading to economic losses, service disruptions, and impacts on well-being.</schema:description>
    </owl:Class>
    


