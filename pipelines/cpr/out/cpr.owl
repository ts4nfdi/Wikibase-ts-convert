        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q732"/>
        <cpr:P7 xml:lang="en">Sulfur hexafluoride is used as an insulating gas in electrical transmission equipment, including circuit breakers. The global warming potential of SF6 is 23,500.</cpr:P7>
    </rdf:Description>
