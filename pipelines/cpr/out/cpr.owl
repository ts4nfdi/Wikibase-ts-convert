        <skos:altLabel xml:lang="en">transformative adaptation</skos:altLabel>
        <cpr:P7 xml:lang="en">Fundamental systems’ changes that address root causes of vulnerability.</cpr:P7>
        <schema:description xml:lang="en">Fundamental systems’ changes that address root causes of vulnerability.</schema:description>
    </owl:Class>
    


