        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <cpr:P7 xml:lang="en">The term “Phase Down” refers to structured reduction in the use of fossil fuels, whereas &quot;Phase out&quot; is a complete end to the use of fossil fuels for energy.</cpr:P7>
        <schema:description xml:lang="en">The term “Phase Down” refers to structured reduction in the use of fossil fuels.</schema:description>
