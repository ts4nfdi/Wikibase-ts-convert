        <skos:altLabel xml:lang="en">rainforest action network, climate action network, loss and damage coalition, RINGO, YOUNGO</skos:altLabel>
        <schema:description xml:lang="en">Networks of different actors operating transnationally.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q94 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q94">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1619"/>
        <rdfs:label xml:lang="en">landslide early warning system</rdfs:label>
        <skos:altLabel xml:lang="en">landslide warning system, landslide early warning systems, landslide warning systems, landslide EWS</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q408"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q949 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q949">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">environmental risk</rdfs:label>
        <skos:altLabel xml:lang="en">degradation of the environment, environmental degradation, environmental risks, environmental climate impact, environmental climate impact driver, environmental climate impact drivers, environmental climate impacts, environmental impact, environmental impacts, degradation of ecosystem service, degradation of ecosystem services, ecosystem degradation, degrading ecosystems, threats to ecosystem health</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P7 xml:lang="en">Environmental risk refers to adverse impacts on biodiversity and ecosystems. Unsustainable land-use and land cover change, unsustainable use of natural resources, deforestation, loss of biodiversity, pollution, and their interactions, adversely affect the capacities of ecosystems, societies, communities and individuals to adapt to climate change.</cpr:P7>
        <schema:description xml:lang="en">Environmental risk refers to adverse impacts on terrestrial, marine, and cryospheric systems from climate-related hazards, exposure, and vulnerability, and the risks related to air-pollution.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q95 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q95">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1619"/>
        <rdfs:label xml:lang="en">mudflow early warning system</rdfs:label>
        <skos:altLabel xml:lang="en">mudflow warning system, mudflow early warning systems, mudflow warning systems, mudflow EWS</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q408"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q954 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q954">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">technological impact</rdfs:label>
        <skos:altLabel xml:lang="en">technological hazard, climate impact on technology, climate impacts on technology, impact on technology, impacts on technology, technological hazards, technological impacts</skos:altLabel>
        <cpr:P20 xml:lang="en">fyhqe7b6</cpr:P20>
        <cpr:P7 xml:lang="en">Climate change can have a range of impacts on technological system. Extreme weather events can cause infrastructure failures like power outages or damage to roads and bridges, as well as the impacts from waste following natural disasters. Human activities also cause technological impacts, such as the risks posed by oil spillage and leaks.</cpr:P7>
        <schema:description xml:lang="en">Climate change can have a range of impacts on technological system. Extreme weather events can cause infrastructure failures like power outages or damage to roads and bridges, as well as the impacts from waste following natural disasters. Human activities also cause technological impacts, such as the risks posed by oil spillage and leaks.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q955 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q955">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">chemical impact</rdfs:label>
        <skos:altLabel xml:lang="en">chemical hazard, chemical disaster risk, chemical risk, chemical risks, impact of chemicals, toxic chemicals, chemical contaminants, toxic chemical, harmful chemical, harmful chemicals</skos:altLabel>
        <cpr:P20 xml:lang="en">hx47bkk6</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1070"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1103"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q760"/>
        <cpr:P7 xml:lang="en">Any substance with chemical properties that can cause physical harm to people or damage the environment, including ammonia, carbon monoxide, phosphine, chlorine, arsenic, cadmium, mercury, pesticides, dioxins, microplastics, benzene, asbestos, aflatoxins, fluoride, methanol, and toxins from marine sources.</cpr:P7>
        <cpr:P9 xml:lang="en">bio-chemical</cpr:P9>
        <cpr:P9 xml:lang="en">bio-chemicals</cpr:P9>
        <cpr:P9 xml:lang="en">bio-fertiliser</cpr:P9>
        <cpr:P9 xml:lang="en">bio-fertilizer</cpr:P9>
        <cpr:P9 xml:lang="en">bio-pesticides</cpr:P9>
        <cpr:P9 xml:lang="en">hydrogen fluoride</cpr:P9>
        <cpr:P9 xml:lang="en">hydrogen fluoride hydrocarbons</cpr:P9>
        <cpr:P9 xml:lang="en">sulfur fluoride</cpr:P9>
        <schema:description xml:lang="en">Any substance with chemical properties that can cause physical harm to people or damage the environment, including ammonia, carbon monoxide, phosphine, chlorine, arsenic, cadmium, mercury, pesticides, dioxins, microplastics, benzene, asbestos, aflatoxins, fluoride, methanol, and toxins from marine sources.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q956 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q956">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">societal impact</rdfs:label>
        <skos:altLabel xml:lang="en">social impact, social impacts, societal collapse, societal damage, societal impacts</skos:altLabel>
        <cpr:P20 xml:lang="en">7dcdxgfj</cpr:P20>
        <cpr:P7 xml:lang="en">Climate change impacts our society by disrupting the natural, economic and social systems we depend on. Physical hazards and underlying vulnerabilities can lead to increased resource competition for food and water, which can heighten the risk of conflict.</cpr:P7>
        <schema:description xml:lang="en">Climate change impacts our society by disrupting the natural, economic and social systems we depend on. Physical hazards and underlying vulnerabilities can lead to increased resource competition for food and water, which can heighten the risk of conflict.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q96 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q96">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q98"/>
        <rdfs:label xml:lang="en">hazard mapping</rdfs:label>
        <skos:altLabel xml:lang="en">hazard mapping</skos:altLabel>
        <cpr:P7 xml:lang="en">Hazard Mapping is the process of establishing where and to what extent particular phenomena are likely to pose a threat to people,property, infrastructure and economic activities. Hazard mapping represents the results of a hazard assessment on a map, showing the frequency/probability of occurrences of various magnitudes or duration.</cpr:P7>
        <schema:description xml:lang="en">Hazard Mapping is the process of establishing where and to what extent particular phenomena are likely to pose a threat to people,property, infrastructure and economic activities. Hazard mapping represents the results of a hazard assessment on a map, showing the frequency/probability of occurrences of various magnitudes or duration.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q969 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q969">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1122"/>
        <rdfs:label xml:lang="en">shrink-swell subsidence</rdfs:label>
        <skos:altLabel xml:lang="en">clay shrink-swell, expansive clay subsidence, pipe clays, problem soils, shrink-swell clay</skos:altLabel>
        <schema:description xml:lang="en">A group of soils that exhibit volumetric change in response to changes in moisture content, such that they shrink in response to desiccation and swell by hydration, resulting in ground subsidence and ground heave respectively.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q97 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q97">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1893"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q88"/>
        <rdfs:label xml:lang="en">seasonal to interannual weather forecast</rdfs:label>
        <skos:altLabel xml:lang="en">inter-annual weather forecast, inter-annual weather forecasting, interannual weather forecast, interannual weather forecasting, seasonal to interannual weather forecast, seasonal to interannual weather forecasting, seasonal weather forecast, seasonal weather forecasting, seasonal forecast, seasonal forecasts</skos:altLabel>
        <cpr:P7 xml:lang="en">This technology allows for a forecast of weather conditions for a period of three to six months ahead. Seasonal forecasts are based on existing climate data; in particular, on sea surface temperatures, which are then used in ocean-atmosphere dynamic models, coupled with the synthesis of physically plausible national and international models.</cpr:P7>
        <schema:description xml:lang="en">This technology allows for a forecast of weather conditions for a period of three to six months ahead. Seasonal forecasts are based on existing climate data; in particular, on sea surface temperatures, which are then used in ocean-atmosphere dynamic models, coupled with the synthesis of physically plausible national and international models.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q973 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q973">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">slow onset event</rdfs:label>
        <skos:altLabel xml:lang="en">slow onset event, slow-onset changes, slow-onset climate impact, slow-onset climate impacts, slow-onset disaster, slow-onset disasters, slow-onset hazard, slow-onset hazards, slow-onset processes, creeping changes, slow incremental change, slow-onset climate event, slow-onset climate events, creeping change, slow-incremental changes, slow-onset process, slow-onset events</skos:altLabel>
        <cpr:P20 xml:lang="en">2nwj5fwh</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1514"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q770"/>
        <cpr:P7 xml:lang="en">Slow onset events evolve gradually from incremental changes over many years or from increased frequency or intensity of recurring events. As defined in the Cancun Adaptation Framework (2010), slow onset events include risks and impacts from rising temperatures, desertification, biodiversity loss, land and forest degradation, glacial retreat, ocean acidification, sea level rise, and salinization.</cpr:P7>
        <schema:description xml:lang="en">Slow onset events evolve gradually from incremental changes over many years or from increased frequency or intensity of recurring events. As defined in the Cancun Adaptation Framework (2010), slow onset events include risks and impacts from rising temperatures, desertification, biodiversity loss, land and forest degradation, glacial retreat, ocean acidification, sea level rise, and salinization.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q974 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q974">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">increasing temperatures</rdfs:label>
        <skos:altLabel xml:lang="en">global warming, temperature increase, temperatures increasing, rise in temperature, temperature rise, temperature rising, SSTs, increase in maximum temperature, increase in maximum temperature values, increase in air temperature, temperature increased</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1006"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1008"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q418"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q441"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q448"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q978"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <cpr:P7 xml:lang="en">Earth&apos;s temperature has risen by an average of 0.11° Fahrenheit (0.06° Celsius) per decade since 1850 due to human induced climate change. Increasing temperatures intensify the hydrologic cycle, causing dry regions to become drier and wet regions to become wetter.</cpr:P7>
        <schema:description xml:lang="en">Earth&apos;s temperature has risen since 1850 due to human induced climate change. Increasing temperatures intensify the hydrologic cycle, causing dry regions to become drier and wet regions to become wetter.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q975 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q975">
        <rdfs:label xml:lang="en">risk</rdfs:label>
        <skos:altLabel xml:lang="en">climate-related hazard, climate-related hazards, climate hazard, climate hazards, disaster risk, risks, climate impact, climatic impact, climatic impact driver, climatic impact drivers, disaster risks, climate impacts, climate change hazard, climate change impact, impact of climate change, impacts of climate change, climate risk, climate risks, climate disaster, natural disaster, geo-hydro-meteorological hazard, geo-hydro-meteorological hazards</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1580"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1583"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1599"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2288"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q763"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q848"/>
        <cpr:P7 xml:lang="en">Risk is the potential for adverse consequences for human or ecological systems, resulting from the dynamic interactions between (climate-related) hazards, exposure, and vulnerability. These interactions may change over time due to socio-economic factors and human decisions, leading to risks affecting lives, livelihoods, health, wellbeing, economic and social assets, infrastructure, and ecosystems.</cpr:P7>
        <schema:description xml:lang="en">Risk is the potential for adverse consequences resulting from the dynamic interplay between (climate-related) hazards, exposure, and vulnerability of affected human or ecological systems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q977 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q977">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <rdfs:label xml:lang="en">water vapor</rdfs:label>
        <skos:altLabel xml:lang="en">aqueous vapor, aqueous vapour</skos:altLabel>
        <schema:description xml:lang="en">The most abundant greenhouse gas, naturally present in the atmosphere and influenced by temperature changes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q979 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q979">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">heavy precipitation</rdfs:label>
        <skos:altLabel xml:lang="en">extreme precipitation, torrential rainfall, blizzard, hail, hailstone, hailstorm, ice storm, silver storm, snow storm, snowstorm, winter storm, heavy precipitation, heavy rain, extreme rainfall, heavy rainfall, blizzards, hailstones, hailstorms, ice storms, silver storms, snow storms, snowstorms, winter storms, intense rainfall events, torrential rains, high precipitation events, increased precipitation, extreme precipitation events, heavy rains</skos:altLabel>
        <cpr:P20 xml:lang="en">n3a3av8a</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1004"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1854"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q982"/>
        <cpr:P7 xml:lang="en">Precipitation refers to any form of water falling from the sky, such as rain, snow, sleet, or hail. Extreme precipitation, influenced by both thermodynamic and dynamic processes, has increased due to warming and other factors. Since the mid-20th century, maximum daily precipitation over land has risen, with greenhouse gases attributed as dominant contributor.</cpr:P7>
        <schema:description xml:lang="en">Heavy precipitation refers to any form of weather where substances fall from the sky, including rain, snow, sleet, or hail.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q98 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q98">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1838"/>
        <rdfs:label xml:lang="en">risk and vulnerability assessment tool</rdfs:label>
        <skos:altLabel xml:lang="en">vulnerability assessment, climate risk assessment, CRVA, assess climate risk, assess climate vulnerability, assessing climate risk, assessing climate vulnerability, risk and vulnerability assessment, vulnerability and risk assessment, evaluating climate risk, climate risk assessments, CRVAs, risk and vulnerability assessments, vulnerability and risk assessments, vulnerability assessments, vulnerability and impact assessment</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q104"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q84"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q86"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q87"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P4 rdf:resource="https://maps.scag.ca.gov/climate/?page=page_3"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/sites/www.ctc-n.org/files/resources/climate_change_vulnerability_assessments_1.pdf"/>
        <cpr:P7 xml:lang="en">Climate change vulnerability assessments evaluate how climate change will impact a specific system (e.g., a river basin, water sector, country, or city). These assessments go beyond the exposure (e.g. rainfall) by also considering the system&apos;s characteristics (sensitivity) and its ability to adapt (adaptive capacity). The results help to identify near-term actions to prioritise, as well as identify those the longer term issues.</cpr:P7>
        <schema:description xml:lang="en">Climate change vulnerability assessments evaluate how climate change will impact a specific system (e.g., a river basin, water sector, country, or city). These assessments go beyond the exposure (e.g. rainfall) by also considering the system&apos;s characteristics (sensitivity) and its ability to adapt (adaptive capacity). The results help to identify near-term actions to prioritise, as well as identify those the longer term issues.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q980 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q980">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">temperature extremes</rdfs:label>
        <skos:altLabel xml:lang="en">extreme temperature, temperature extreme, extreme temperatures, hot and cold extreme, hot and cold extreme event, hot and cold extreme events, hot and cold extremes</skos:altLabel>
        <cpr:P7 xml:lang="en">Temperature extremes refer to significant deviations from average temperatures, including both unusually high (warm) and low (cold) extremes. Influenced predominantly by greenhouse gases, these extremes are assessed globally, continentally, and regionally, focusing on changes in intensity, frequency, and duration from daily to seasonal scales.</cpr:P7>
        <schema:description xml:lang="en">Increases in the intensity, frequency, and duration of warm extremes and the decrease in those of cold extremes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q981 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q981">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <rdfs:label xml:lang="en">coastal flood</rdfs:label>
        <skos:altLabel xml:lang="en">coastal flooding, coastal floods, coastal inundation, estuarine flood, estuarine flooding, estuarine floods</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1515"/>
        <cpr:P7 xml:lang="en">Coastal flooding is the inundation of normally dry land in coastal areas caused by storm surges, high winds, and high tides raising sea levels due to low atmospheric pressure. This flooding can obstruct river flow and is exacerbated by seabed shallowing and reduced return flow. Estuarine flooding involves similar processes and can also be triggered by tsunamis.</cpr:P7>
        <schema:description xml:lang="en">Coastal flooding often results from storm surges and high winds during high tides, with water levels rising due to low pressure and geographic factors.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q982 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q982">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <rdfs:label xml:lang="en">riverine flood</rdfs:label>
        <skos:altLabel xml:lang="en">drainage flood, drainage flooding, drainage floods, flash flood, flash flooding, flash floods, fluvial flood, fluvial flooding, fluvial floods, freshet, freshets, groundwater flood, groundwater flooding, groundwater floods, huayco, huaycos, ice-jam flood, melt-induced flood, melt-induced flooding, melt-induced floods, ponding flood, ponding flooding, ponding floods, riverine flooding, riverine floods, snowmelt flood, snowmelt flooding, snowmelt floods, snowmelt-runoff flood, snowmelt-runoff flooding, snowmelt-runoff floods, storm-driven flood, storm-driven flooding, storm-driven floods, surface water flood, surface water flooding, surface water floods</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P7 xml:lang="en">Riverine flooding occurs when rivers and streams overflow their banks, flooding nearby land. This happens due to the complex interplay of hydrology, climate, and human management. Factors like heavy rain, snowmelt, and river management practices contribute to this type of flood.</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q983 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q983">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q949"/>
        <rdfs:label xml:lang="en">cryosphere risk</rdfs:label>
        <skos:altLabel xml:lang="en">changes in the cryosphere, cryosphere change, cryospheric risk, shrinking cryosphere, cryospheric changes, cryospheric hazards, cryosphere-related changes, cryosphere hazard</skos:altLabel>
        <cpr:P20 xml:lang="en">dsxc3m8e</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1518"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">The cryosphere is the frozen part of the Earth—it includes sea ice, glaciers, snow, and ice sheets. It helps regulate the climate and weather by reflecting sunlight. Rising temperatures are causing melting, leading to sea ice loss, glacier collapse, and glacier landslides and avalanches. This threatens the livelihoods of around 700 million people who rely on the cryosphere for food, water security, and cultural practices.</cpr:P7>
        <schema:description xml:lang="en">The cryosphere is the frozen part of the Earth—it includes sea ice, glaciers, snow, and ice sheets. It helps regulate the climate and weather by reflecting sunlight. Rising temperatures are causing melting, leading to sea ice loss, glacier collapse, and glacier landslides and avalanches. This threatens the livelihoods of around 700 million people who rely on the cryosphere for food, water security, and cultural practices.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q984 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q984">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <rdfs:label xml:lang="en">malnutrition</rdfs:label>
        <skos:altLabel xml:lang="en">hunger, nutritional deficiencies, nutritional deficiency, undernutrition, caloric deficiency, dietary deficiency, energy deficiency, food deprivation, hidden hunger, inadequate nutrition, malnourishment, micronutrient malnutrition, nutrient deficiency, nutritional imbalance, nutritional inadequacy, overnutrition, poor nutritional status, protein-energy malnutrition, starvation, undernourishment, micro-nutrient deficiencies, obesity</skos:altLabel>
        <cpr:P7 xml:lang="en">Malnutrition arises from insufficient food intake, poor health, and inadequate care, leading to being underweight, stunted, wasted, or deficient in essential vitamins and minerals. Extreme weather events like floods and droughts can worsen food insecurity and malnutrition by disrupting food production, increasing food prices, and reducing household incomes.</cpr:P7>
        <schema:description xml:lang="en">Malnutrition occurs when inadequate food intake and poor health lead to underweight, stunted growth, wasting, or vitamin/mineral deficiencies, impacting overall health.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q985 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q985">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">cyber impact</rdfs:label>
        <skos:altLabel xml:lang="en">cyber hazard</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q838"/>
        <cpr:P7 xml:lang="en">Data security involves protecting data to ensure its availability, confidentiality, and integrity. Impacts to data security include risks from increased system complexity, which can enable cyberattacks, as well as potential data loss from severe incidents like natural disasters</cpr:P7>
        <schema:description xml:lang="en">Data security ensures data availability, confidentiality, and integrity. Impacts include risks from complex systems enabling cyberattacks and data loss from major incidents</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q986 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q986">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">geohazard</rdfs:label>
        <skos:altLabel xml:lang="en">geological hazard, geohazards, geological hazards, geological disaster, non-climatic natural disaster, non-climatic natural risks</skos:altLabel>
        <cpr:P20 xml:lang="en">mjaupkch</cpr:P20>
        <cpr:P7 xml:lang="en">Geohazards are adverse geological phenomenon&apos;s that are capable of causing widespread damage or loss to property, life and the environment, such as earthquakes, volcano eruptions and tsunamis. Climate change can increase the frequency and severity of some geohazards, such as landslides, and soil erosion.</cpr:P7>
        <schema:description xml:lang="en">Geohazards are adverse geological phenomenon&apos;s that are capable of causing widespread damage or loss to property, life and the environment, such as earthquakes, volcano eruptions and tsunamis. Climate change can increase the frequency and severity of some geohazards, such as landslides, and soil erosion.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q987 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q987">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">seismogenic hazards</rdfs:label>
        <skos:altLabel xml:lang="en">seismogenic hazard, seismic hazard</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1143"/>
        <schema:description xml:lang="en">A seismic hazard is the probability that an earthquake will occur in a given geographic area, within a given window of time, and with ground motion intensity exceeding a given threshold</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q988 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q988">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">volcanogenic hazards</rdfs:label>
        <skos:altLabel xml:lang="en">volcanogenic hazard</skos:altLabel>
        <schema:description xml:lang="en">It refers to any potentially dangerous volcanic process that puts human lives, livelihoods or infrastructure at risk of harm.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q989 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q989">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">industrial failure</rdfs:label>
        <skos:altLabel xml:lang="en">industrial accident</skos:altLabel>
        <cpr:P7 xml:lang="en">Industrial accidents, such as oil spills from leaks, blowouts, or shipping accidents, pose severe climate risks to ecosystems. These incidents, often exacerbated by extreme weather, threaten biodiversity and disrupt ecosystem health. As climate-related extreme events rise, so does the risk of industrial accidents, including oil spills and explosions.</cpr:P7>
        <schema:description xml:lang="en">Industrial accidents like oil spills, often intensified by extreme weather, threaten ecosystems and biodiversity, with risks rising as climate impacts grow.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q99 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q99">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q98"/>
        <rdfs:label xml:lang="en">disaster risk assessment tools</rdfs:label>
        <skos:altLabel xml:lang="en">disaster risk assessment, assess disaster risk, assessing disaster risk, disaster risk assessments, disaster risk map, disaster risk mapping, disaster risk maps, mapping disaster risk</skos:altLabel>
        <cpr:P7 xml:lang="en">A qualitative or quantitative approach to determine the nature and extent of disaster risk by analysing potential hazards and evaluating existing conditions of exposure and vulnerability that together could harm people, property, services, livelihoods and the environment on which they depend.</cpr:P7>
        <schema:description xml:lang="en">A qualitative or quantitative approach to determine the nature and extent of disaster risk by analysing potential hazards and evaluating existing conditions of exposure and vulnerability that together could harm people, property, services, livelihoods and the environment on which they depend.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q990 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q990">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">transportation accident</rdfs:label>
        <skos:altLabel xml:lang="en">transport accident</skos:altLabel>
        <cpr:P7 xml:lang="en">Extreme weather events can increase the risks of accidents, disruptions in travel, and lead to road closures or detours, causing delays and logistical challenges.</cpr:P7>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of accidents, disruptions in travel, and lead to road closures or detours, causing delays and logistical challenges.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q991 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q991">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">CBRNE</rdfs:label>
        <skos:altLabel xml:lang="en">radioactive material, biological agents, chemical warfare  agents, explosive agents, nuclear agents, radiation agents</skos:altLabel>
        <cpr:P7 xml:lang="en">The acronym CBRNE stands for Chemical, Biological, Radiological, Nuclear, and Explosive. It encompasses a range of hazardous materials and situations, often used in the context of emergency response and public safety to describe threats or incidents involving these dangerous agents.</cpr:P7>
        <schema:description xml:lang="en">The acronym CBRNE stands for Chemical, Biological, Radiological, Nuclear, and Explosive. It encompasses a range of hazardous materials and situations, often used in the context of emergency response and public safety to describe threats or incidents involving these dangerous agents.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q992 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q992">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q956"/>
        <rdfs:label xml:lang="en">armed conflict</rdfs:label>
        <skos:altLabel xml:lang="en">civil disorder, civil disturbance, civil unrest, environmental degradation from conflict, explosive remnants of war, international armed conflict, NIAC, non-international armed conflict, social unrest, stampede, violent disorder, violent conflict, environmental degradation from war, conflict risk, risk of conflict</skos:altLabel>
        <cpr:P7 xml:lang="en">Conflict risk refers to the increased likelihood of social or political unrest arising from various stressors, including social, economic, and environmental factors. While climate change doesn&apos;t directly cause conflict, it can worsen conditions like resource scarcity, food insecurity, and displacement, increasing tensions and instability, especially in regions with poor governance.</cpr:P7>
        <cpr:P9 xml:lang="en">conflict of interest</cpr:P9>
        <cpr:P9 xml:lang="en">conflict of interests</cpr:P9>
        <cpr:P9 xml:lang="en">conflicts of interest</cpr:P9>
        <cpr:P9 xml:lang="en">conflicts of interests</cpr:P9>
        <schema:description xml:lang="en">Scientists generally agree that climate change does not directly cause armed conflict but can indirectly raise conflict risks by worsening social, economic, and environmental stresses.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q994 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q994">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1017"/>
        <rdfs:label xml:lang="en">food insecurity</rdfs:label>
        <skos:altLabel xml:lang="en">malnutrition, undernutrition, acute-food insecurity, drought-related acute food insecurity, drought-related food insecurity, flood-related acute food insecurity, flood-related food insecurity, food insecure, food security, famine, food scarcity, scarcity of food, food resource scarcity, food shortage, food shortages, shortage of food, nutrition insecurity, food crisis, risk of hunger, food availability</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1599"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1826"/>
        <cpr:P7 xml:lang="en">Food insecurity refers to the lack of reliable access to sufficient, safe, and nutritious food. Climate change exacerbates this issue by directly impacting food production, increasing food prices, and reducing household incomes. In addition, climate change frequently acts to compound drivers of food insecurity, such as poverty and inequity.</cpr:P7>
        <schema:description xml:lang="en">Food insecurity is the lack of access to enough safe and nutritious food. Climate change worsens it by disrupting food production and increasing prices, impacting vulnerable populations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q995 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q995">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">extraterrestrial hazard</rdfs:label>
        <skos:altLabel xml:lang="en">extra-terrestrial hazards, air-blast, airburst, bolide, D region absorption, electromagnetic pulse, fireball, geomagnetic storm, ionospheric storm, magnetic storm, meteorite impact, near-earth object, radio blackout, Solar energetic particle event, solar proton event, solar radiation storm, solar storm, space accident, space hazard, space weather, superbolide, UV radiation, meteor collision, meteor impact, radio disturbance</skos:altLabel>
        <cpr:P7 xml:lang="en">Extraterrestrial  hazards are caused by asteroids, meteoroids, and comets as they pass near to the Earth, enter the Earth’s atmosphere, and/or strike the Earth, and by changes in interplanetary conditions that effect the Earth’s magnetosphere, ionosphere, and thermosphere.</cpr:P7>
        <cpr:P7 xml:lang="en">We have not applied extra-terrestrial hazard to our dataset, as it is not relevant to our climate-centred dataset (e.g. meteor impacts).</cpr:P7>
        <schema:description xml:lang="en">Extraterrestrial hazards are caused by asteroids, meteoroids, and comets as they pass near to the Earth, enter the Earth’s atmosphere, and/or strike the Earth, and by changes in interplanetary conditions that effect the Earth’s magnetosphere, ionosphere, and thermosphere.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q996 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q996">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">ocean deoxygenation</rdfs:label>
        <skos:altLabel xml:lang="en">aquatic oxygen loss, decreased marine oxygen levels, hypoxia in the ocean, marine deoxygenation, marine hypoxia, oceanic hypoxia, oxygen depletion in seawater, sea oxygen decline, coastal hypoxia event, coastal hypoxia events, open-ocean deoxygenation, marine oxygen loss, ocean oxygen loss</skos:altLabel>
        <cpr:P7 xml:lang="en">Ocean deoxygenation is the loss of oxygen in ocean waters due to warming, reducing oxygen saturation, and increasing consumption, stratification, and ventilation changes. Human activities, such as nutrient runoff and pollution, have worsened coastal and open-ocean hypoxia, harming marine organisms and shrinking marine habitats.</cpr:P7>
        <schema:description xml:lang="en">Deoxygenation is the reduction of oxygen levels in seawater, primarily due to ocean warming, which decreases dissolved oxygen. It is exacerbated by increased oxygen consumption, stratification, and reduced water mixing.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q997 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q997">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1017"/>
        <rdfs:label xml:lang="en">water insecurity</rdfs:label>
        <skos:altLabel xml:lang="en">water security, lack of water availability, shortage of water, deficit of water, lack of water, limited water availability, scarcity of water, water deficit, water insecure, water scarcity, water resource scarcity, shortages of water, water shortage, water shortages, water deficits, vulnerable water resources, water crisis</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q441"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P7 xml:lang="en">Water scarcity can be defined as a lack of sufficient water, or not having access to safe water supplies, which is worsened by climate change by disrupting precipitation patterns and the water cycle. Currently, two billion people lack safe drinking water, and about half the world’s population faces severe water scarcity for at least part of the year, as climate impacts intensify.</cpr:P7>
        <schema:description xml:lang="en">Water scarcity can be defined as a lack of sufficient water, or not having access to safe water supplies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q999 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q999">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <rdfs:label xml:lang="en">ocean warming</rdfs:label>
        <skos:altLabel xml:lang="en">increased sea surface temperatures, increased ocean surface temperature, increasing ocean temperatures, rise in ocean temperatures, rising ocean temperatures, warming oceans, warming of the ocean, warming of the sea, warming seas, increasing ocean heat content</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P7 xml:lang="en">The ocean absorbs excess heat from greenhouse gas emissions, causing rising temperatures that lead to coral bleaching and the loss of breeding grounds for marine species.</cpr:P7>
        <schema:description xml:lang="en">The ocean absorbs excess heat from greenhouse gas emissions, causing rising temperatures that lead to coral bleaching and the loss of breeding grounds for marine species.</schema:description>
    </owl:Class>
</rdf:RDF>



