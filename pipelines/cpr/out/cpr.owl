        <schema:description xml:lang="en">Activities related to the design, implementation, and management of blockchain systems and distributed ledgers</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1711 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1711">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">environmental standard</rdfs:label>
        <skos:altLabel xml:lang="en">environmental standards, national environmental standard, national environmental standards</skos:altLabel>
        <cpr:P7 xml:lang="en">Environmental standards are legal tools used by governments to limit pollution and enforce climate action. They set thresholds for air, water, emissions, and waste, ensuring industries comply. Examples include air quality limits, emissions caps, and energy efficiency rules, promoting sustainability.</cpr:P7>
        <schema:description xml:lang="en">Environmental standards are legal tools used by governments to limit pollution and enforce climate action. They set thresholds for air, water, emissions, and waste, ensuring industries comply. Examples include air quality limits, emissions caps, and energy efficiency rules, promoting sustainability.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1712 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1712">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">emission standard</rdfs:label>
        <skos:altLabel xml:lang="en">emission standards, product emissions standard, product emissions standards</skos:altLabel>
        <cpr:P7 xml:lang="en">Emission standards are legal limits on the amount of pollutants that can be released into the atmosphere. They apply to vehicles, engines, and fuels.</cpr:P7>
        <schema:description xml:lang="en">Emission standards are legal limits on the amount of pollutants that can be released into the atmosphere. They can apply to a range of products, including vehicles, engines, and fuels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1713 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1713">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">standard for soil quality</rdfs:label>
        <skos:altLabel xml:lang="en">minimum standards for soil, minimum standards for the quality of the soil, soil quality standard, soil quality standards, standards for soil quality</skos:altLabel>
        <cpr:P7 xml:lang="en">Soil quality standards are guidelines that protect and improve the health of soil. They are important for agriculture, biodiversity, and carbon sequestration.</cpr:P7>
        <schema:description xml:lang="en">Soil quality standards are guidelines that protect and improve the health of soil. They are important for agriculture, biodiversity, and carbon sequestration.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1714 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1714">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1712"/>
        <rdfs:label xml:lang="en">vehicle emissions standard</rdfs:label>
        <skos:altLabel xml:lang="en">heavy-duty emissions standards, heavy-duty vehicle emission standard, heavy-duty vehicle emission standards, vehicle emission standards, Bharat Stage, CAFE standard, CAFE standards, China VI, corporate average fuel economy, Euro 6, Euro 7, Euro VI, fuel economy standard, fuel economy standards</skos:altLabel>
        <cpr:P7 xml:lang="en">Vehicle emission standards are legal limits on the amount of air pollutants that vehicles can release. They are designed to protect human health and improve air quality.</cpr:P7>
        <schema:description xml:lang="en">Vehicle emission standards are legal limits on the amount of air pollutants that vehicles can release. They are designed to protect human health and improve air quality.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1715 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1715">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1379"/>
        <rdfs:label xml:lang="en">imbalance charge</rdfs:label>
        <skos:altLabel xml:lang="en">imbalance charges</skos:altLabel>
        <cpr:P7 xml:lang="en">Imbalance charges are fees that are applied when the amount of energy brought into and taken out of an energy system is not equal</cpr:P7>
        <schema:description xml:lang="en">Imbalance charges are fees that are applied when the amount of energy brought into and taken out of an energy system is not equal</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1716 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1716">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1379"/>
        <rdfs:label xml:lang="en">emission charge</rdfs:label>
        <skos:altLabel xml:lang="en">emission charges, fuel and excess emission charge, fuel and excess emission charges</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1400"/>
        <cpr:P7 xml:lang="en">A charge or fee levied on vehicle owners based on the amount of pollutants their vehicle emits, essentially penalizing drivers who use high-emission fuels and encouraging them to switch to cleaner options.</cpr:P7>
        <schema:description xml:lang="en">A charge or fee levied on vehicle owners based on the amount of pollutants their vehicle emits, essentially penalizing drivers who use high-emission fuels and encouraging them to switch to cleaner options.</schema:description>
    </owl:Class>
    


