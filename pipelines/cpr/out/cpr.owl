    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1728 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1728">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q911"/>
        <rdfs:label xml:lang="en">spatial justice</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1734"/>
        <cpr:P7 xml:lang="en">The just distribution of benefits and impacts related to climate change viewed, through a spatial lens. This can mean, for example, offsetting loss of opportunities in an area with additional investments, providing extra protections for highly vulnerable areas, or ensuring that resources and infrastructure are reaching historically left-behind areas. Often, spatial justice is addressing existing inequalities between rural and urban areas, which may increase due to climate change and the green transition; however, other spatial scales, such as under-invested neighbourhoods, may also be considered relevant.</cpr:P7>
        <schema:description xml:lang="en">The just distribution of benefits and impacts related to climate change viewed through a spatial lens -- for example, rural/urban distributions</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q173 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q173">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">seawater desalination</rdfs:label>
        <skos:altLabel xml:lang="en">desalination of sea water</skos:altLabel>
        <skos:altLabel xml:lang="en">desalination of seawater</skos:altLabel>
        <skos:altLabel xml:lang="en">desalinisation</skos:altLabel>
        <skos:altLabel xml:lang="en">sea water desalination</skos:altLabel>
        <skos:altLabel xml:lang="en">seawater desalination</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/seawater-desalination"/>
        <schema:description xml:lang="en">Seawater desalination is a process in which salt and other constituents are removed to produce pure water.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1730 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1730">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">transformative justice</rdfs:label>
        <cpr:P7 xml:lang="en">Remaking structural social and institutional inequalities that drive and perpetuate climate change through a whole-of-society transformation. This includes the argument that addressing climate justice requires a fundamental shift away from capitalist, extractivist, and/or neo-colonial systems.</cpr:P7>
        <schema:description xml:lang="en">Remaking structural social and institutional inequalities that drive and perpetuate climate change through a whole-of-society transformation</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1731 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1731">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">recognition justice</rdfs:label>
        <cpr:P7 xml:lang="en">the recognition of underlying systemic injustices and representation of dignity, values and identities of humans and other species. When referencing humans, this dimension refers both to individuals and social groups and entails recognising and respecting how different values, preferences and needs are rooted in diverse histories, identities and cultural backgrounds. For other species, this implies recognising the intrinsic and inherent value of nature regardless of its utility to humans</cpr:P7>
        <schema:description xml:lang="en">recognising and respecting how different values, preferences and needs are rooted in diverse histories, identities and cultural backgrounds</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1732 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1732">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1731"/>
        <rdfs:label xml:lang="en">relational justice</rdfs:label>
        <cpr:P7 xml:lang="en">emphasises the importance of fostering collaborative relationships through dialogue and negotiation, arguing that cooperation between groups and communities must purposely aim to advance climate justice. Fair, equal and respectful relationships are seen as essential in developing equitable climate change responses.</cpr:P7>
        <schema:description xml:lang="en">emphasises the importance of fostering collaborative relationships through dialogue and negotiation, arguing that cooperation between groups and communities must purposely aim to advance climate justice</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1733 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1733">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">justice-informed governance</rdfs:label>
        <skos:altLabel xml:lang="en">HBRA</skos:altLabel>
        <skos:altLabel xml:lang="en">accountable governance</skos:altLabel>
        <skos:altLabel xml:lang="en">gender-based approach</skos:altLabel>
        <skos:altLabel xml:lang="en">human rights-based governance</skos:altLabel>
        <skos:altLabel xml:lang="en">human-rights based approach</skos:altLabel>
        <skos:altLabel xml:lang="en">just transition governance</skos:altLabel>
        <skos:altLabel xml:lang="en">justice-based governance</skos:altLabel>
        <skos:altLabel xml:lang="en">transparent governance</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q912"/>
        <cpr:P7 xml:lang="en">Governance approaches that promote justice,at minimum by providing a formal opportunity for widespread consultation, but ideally by focussing on institutionalising inclusive principles, creating the conditions for meaningful participation, such as by addressing imbalances in power, access to justice, or the resources to participate effectively</cpr:P7>
        <schema:description xml:lang="en">Promoting a just transition through inclusive and ethical governance initiatives</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1736 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1736">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">equitable rural development</rdfs:label>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1737 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1737">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">climate reparations</rdfs:label>
        <skos:altLabel xml:lang="en">loss and damage reparations</skos:altLabel>
        <skos:altLabel xml:lang="en">reparations for climate</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q72"/>
        <schema:description xml:lang="en">Seeking redress for the damages of climate change, including historical damages, usually through financial support</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1738 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1738">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">justice-focussed climate solutions</rdfs:label>
        <skos:altLabel xml:lang="en">locally led adaptation</skos:altLabel>
        <schema:description xml:lang="en">Climate actions that explicitly incorporate climate justice principles in their design and implementation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1739 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1739">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">economic instruments for a just transition</rdfs:label>
        <cpr:P7 xml:lang="en">Creating new economic opportunities to replace traditional industries or update existing ones, while respecting other elements of climate justice.</cpr:P7>
        <schema:description xml:lang="en">Economic instruments supporting a just transition are financial and policy mechanisms designed to facilitate the shift towards sustainable, low-carbon economies in a way that is equitable, inclusive, and minimises negative socio-economic impacts on communities and workers most affected by this transformation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q174 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q174">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">interbasin transfers</rdfs:label>
        <skos:altLabel xml:lang="en">inter-basin transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">interbasin transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">interbasin water transfer</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <schema:description xml:lang="en">Interbasin transfer refers to projects that transport water from one waterbasin or catchment area to another via canals, tunnels, bridges, or stream flow rerouting to usually address water scarcity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1741 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1741">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1763"/>
        <rdfs:label xml:lang="en">deep democracy</rdfs:label>
        <cpr:P7 xml:lang="en">a set of practices as well as a political movement that is radically inclusive, international, class conscious and community-based, to bring about a more equitable world through democratic and self-organised means</cpr:P7>
        <schema:description xml:lang="en">a set of practices as well as a political movement that is radically inclusive, international, class conscious and community-based, to bring about a more equitable world through democratic and self-organised means</schema:description>
    </owl:Class>
    


