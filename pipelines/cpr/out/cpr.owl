    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1797 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1797">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q53"/>
        <rdfs:label xml:lang="en">housing support</rdfs:label>
        <skos:altLabel xml:lang="en">supported housing, social housing, supported living, supportive housing, rental assistance, housing allowance, housing allowances, housing subsidies, housing subsidy, rental allowance, rental subsidies, rental subsidy, affordable housing, housing assistance, improving living conditions, adequate housing</skos:altLabel>
        <cpr:P7 xml:lang="en">Supported housing is any housing scheme where housing is provided alongside care, support or supervision to help people live as independently as possible in the community. This can include financial aid, practical help with finding accommodation, and support in maintaining their tenancy.</cpr:P7>
        <schema:description xml:lang="en">Housing support generally refers to the provision of assistance to individuals or families to secure and maintain suitable housing.</schema:description>
    </owl:Class>
    


