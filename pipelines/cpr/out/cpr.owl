        <skos:altLabel xml:lang="en">harmful chemicals</skos:altLabel>
        <skos:altLabel xml:lang="en">impact of chemicals</skos:altLabel>
        <skos:altLabel xml:lang="en">toxic chemical</skos:altLabel>
        <skos:altLabel xml:lang="en">toxic chemicals</skos:altLabel>
        <cpr:P20 xml:lang="en">hx47bkk6</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1070"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1103"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q760"/>
        <cpr:P7 xml:lang="en">Any substance with chemical properties that can cause physical harm to people or damage the environment, including ammonia, carbon monoxide, phosphine, chlorine, arsenic, cadmium, mercury, pesticides, dioxins, microplastics, benzene, asbestos, aflatoxins, fluoride, methanol, and toxins from marine sources.</cpr:P7>
        <cpr:P9 xml:lang="en">bio-chemical</cpr:P9>
        <cpr:P9 xml:lang="en">bio-chemicals</cpr:P9>
        <cpr:P9 xml:lang="en">bio-fertiliser</cpr:P9>
        <cpr:P9 xml:lang="en">bio-fertilizer</cpr:P9>
        <cpr:P9 xml:lang="en">bio-pesticides</cpr:P9>
        <cpr:P9 xml:lang="en">hydrogen fluoride</cpr:P9>
        <cpr:P9 xml:lang="en">hydrogen fluoride hydrocarbons</cpr:P9>
        <cpr:P9 xml:lang="en">sulfur fluoride</cpr:P9>
        <schema:description xml:lang="en">Any substance with chemical properties that can cause physical harm to people or damage the environment, including ammonia, carbon monoxide, phosphine, chlorine, arsenic, cadmium, mercury, pesticides, dioxins, microplastics, benzene, asbestos, aflatoxins, fluoride, methanol, and toxins from marine sources.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q956 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q956">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">societal impact</rdfs:label>
        <skos:altLabel xml:lang="en">social impact</skos:altLabel>
        <skos:altLabel xml:lang="en">social impacts</skos:altLabel>
        <skos:altLabel xml:lang="en">societal collapse</skos:altLabel>
        <skos:altLabel xml:lang="en">societal damage</skos:altLabel>
        <skos:altLabel xml:lang="en">societal impacts</skos:altLabel>
        <cpr:P20 xml:lang="en">7dcdxgfj</cpr:P20>
        <cpr:P7 xml:lang="en">Climate change impacts our society by disrupting the natural, economic and social systems we depend on. Physical hazards and underlying vulnerabilities can lead to increased resource competition for food and water, which can heighten the risk of conflict.</cpr:P7>
        <schema:description xml:lang="en">Climate change impacts our society by disrupting the natural, economic and social systems we depend on. Physical hazards and underlying vulnerabilities can lead to increased resource competition for food and water, which can heighten the risk of conflict.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q96 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q96">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q98"/>
        <rdfs:label xml:lang="en">hazard mapping</rdfs:label>
        <skos:altLabel xml:lang="en">hazard mapping</skos:altLabel>
        <cpr:P7 xml:lang="en">Hazard Mapping is the process of establishing where and to what extent particular phenomena are likely to pose a threat to people,property, infrastructure and economic activities. Hazard mapping represents the results of a hazard assessment on a map, showing the frequency/probability of occurrences of various magnitudes or duration.</cpr:P7>
        <schema:description xml:lang="en">Hazard Mapping is the process of establishing where and to what extent particular phenomena are likely to pose a threat to people,property, infrastructure and economic activities. Hazard mapping represents the results of a hazard assessment on a map, showing the frequency/probability of occurrences of various magnitudes or duration.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q969 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q969">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1122"/>
        <rdfs:label xml:lang="en">shrink-swell subsidence</rdfs:label>
        <skos:altLabel xml:lang="en">clay shrink-swell</skos:altLabel>
        <skos:altLabel xml:lang="en">expansive clay subsidence</skos:altLabel>
        <skos:altLabel xml:lang="en">pipe clays</skos:altLabel>
        <skos:altLabel xml:lang="en">problem soils</skos:altLabel>
        <skos:altLabel xml:lang="en">shrink-swell clay</skos:altLabel>
        <schema:description xml:lang="en">A group of soils that exhibit volumetric change in response to changes in moisture content, such that they shrink in response to desiccation and swell by hydration, resulting in ground subsidence and ground heave respectively.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q97 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q97">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1893"/>
