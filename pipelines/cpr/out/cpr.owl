    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1384 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1384">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1599"/>
