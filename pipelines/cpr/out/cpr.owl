        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q328"/>
        <cpr:P7 xml:lang="en">Disaster waste is waste generated by the impact of a disaster, both from the disaster itself and during the response and recovery phase due to poor waste management. Examples are the waste following extreme weather events, such as flooding or storms.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q756">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q924"/>
