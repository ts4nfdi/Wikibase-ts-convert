        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1430"/>
        <rdfs:label xml:lang="en">pollution prevention and control permits</rdfs:label>
        <skos:altLabel xml:lang="en">PPC permit</skos:altLabel>
        <skos:altLabel xml:lang="en">PPC permits</skos:altLabel>
        <skos:altLabel xml:lang="en">discharge consent</skos:altLabel>
        <skos:altLabel xml:lang="en">discharge consents</skos:altLabel>
        <skos:altLabel xml:lang="en">discharge licence</skos:altLabel>
