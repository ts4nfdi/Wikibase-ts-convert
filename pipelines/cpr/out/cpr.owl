        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P7 xml:lang="en">Covers financial services, insurance activities, and related support services, regardless of the technology employed. It includes funding acquisition, insurance underwriting, and specialized services supporting financial and insurance activities. Additionally, it encompasses asset holding activities, including those of holding companies, trusts, funds, reinsurance, and pension funds.</cpr:P7>
    </rdf:Description>
