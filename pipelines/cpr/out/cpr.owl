        <skos:altLabel xml:lang="en">eco-agriculture</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental friendly agriculture</skos:altLabel>
        <skos:altLabel xml:lang="en">regenerative agriculture</skos:altLabel>
