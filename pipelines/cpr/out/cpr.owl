    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q949 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q949">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">environmental risk</rdfs:label>
        <skos:altLabel xml:lang="en">degradation of ecosystem service</skos:altLabel>
        <skos:altLabel xml:lang="en">degradation of ecosystem services</skos:altLabel>
        <skos:altLabel xml:lang="en">degradation of the environment</skos:altLabel>
        <skos:altLabel xml:lang="en">degrading ecosystems</skos:altLabel>
        <skos:altLabel xml:lang="en">ecosystem degradation</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental climate impact</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental climate impact driver</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental climate impact drivers</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental climate impacts</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental degradation</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental impact</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental impacts</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental risks</skos:altLabel>
        <skos:altLabel xml:lang="en">threats to ecosystem health</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P7 xml:lang="en">Environmental risk refers to adverse impacts on biodiversity and ecosystems. Unsustainable land-use and land cover change, unsustainable use of natural resources, deforestation, loss of biodiversity, pollution, and their interactions, adversely affect the capacities of ecosystems, societies, communities and individuals to adapt to climate change.</cpr:P7>
        <schema:description xml:lang="en">Environmental risk refers to adverse impacts on terrestrial, marine, and cryospheric systems from climate-related hazards, exposure, and vulnerability, and the risks related to air-pollution.</schema:description>
    </owl:Class>
    


