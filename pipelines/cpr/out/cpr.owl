    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q146">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">fungal symbiosis</rdfs:label>
        <skos:altLabel xml:lang="en">fungal symbioses, mycorrhiza, mycorrhizae, symbiotic soil fungi, mycorrhizal fungi</skos:altLabel>
        <cpr:P7 xml:lang="en">Fungal symbiosis is a symbiotic relationship between a fungus and a photosynthetic bacteria or algae. The cells from the alga or bacterium live inside the fungus. Besides providing a home, the fungus also provides nutrients. In turn, the bacterium or the alga provides energy to the fungus by performing photosynthesis. Fungal symbiosis can enhance ecosystem resilience and reduce the negative impact of increased precipitation on nutrient losses.</cpr:P7>
        <schema:description xml:lang="en">Fungal symbioses is a symbiotic relationship between a fungus and a photosynthetic bacteria or algae.</schema:description>
    </owl:Class>
    


