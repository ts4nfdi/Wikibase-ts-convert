        <skos:altLabel xml:lang="en">marine heatwaves</skos:altLabel>
        <skos:altLabel xml:lang="en">ocean heat wave</skos:altLabel>
        <skos:altLabel xml:lang="en">ocean heat waves</skos:altLabel>
        <skos:altLabel xml:lang="en">ocean heatwave</skos:altLabel>
        <skos:altLabel xml:lang="en">ocean heatwaves</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P7 xml:lang="en">An extended period of unusually high sea temperatures lasting several days to weeks, with temperatures exceeding local thresholds.</cpr:P7>
