        <skos:altLabel xml:lang="en">soil-less production</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless crops</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless cultivation</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless culture</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless cultures</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless farm</skos:altLabel>
        <skos:altLabel xml:lang="en">soilless farming</skos:altLabel>
