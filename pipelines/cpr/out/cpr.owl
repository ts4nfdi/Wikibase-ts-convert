    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1889">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1826"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1935"/>
