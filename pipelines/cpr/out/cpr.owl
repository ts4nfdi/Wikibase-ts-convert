        <rdfs:label xml:lang="en">compressed natural gas</rdfs:label>
        <skos:altLabel xml:lang="en">CNG</skos:altLabel>
        <schema:description xml:lang="en">Compressed natural gas is primarily comprised of methane. The high amounts of pressure used to create CNG shrink the gas to under 1% of its original volume. When combined with air and ignited, CNG works as fuel.</schema:description>
    </owl:Class>
    


