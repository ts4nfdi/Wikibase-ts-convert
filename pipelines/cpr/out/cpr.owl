        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1315"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1817"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q149">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1613"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2550"/>
        <cpr:P7 xml:lang="en">Crop rotation on arable land is the practice of alternating crops grown on a specific field in a planned pattern or sequence in successive crop years so that crops of the same species are not grown without interruption on the same field. In a rotation the crops are normally changed annually, but they can also be multi-annual.</cpr:P7>
    </rdf:Description>
