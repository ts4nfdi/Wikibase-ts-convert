    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q172 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q172">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1635"/>
        <rdfs:label xml:lang="en">indigenous water storage structures</rdfs:label>
        <skos:altLabel xml:lang="en">indigenous water storage</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P4 rdf:resource="https://atpsnet.org/wp-content/uploads/2017/05/rps22.pdf"/>
        <schema:description xml:lang="en">Indigenous knowledge have developed over time by communities. It is a body of knowledge based on experience and not confined to tribal groups. Communities in arid and semi-arid areas have relied on indigenous knowledge to harvest rain water providing water as supplement, to increase crop yield and reduce the risk of crop failure. Indigenous RWH combine technical efficiency with low cost and acceptability to the local farmers.</schema:description>
    </owl:Class>
    


