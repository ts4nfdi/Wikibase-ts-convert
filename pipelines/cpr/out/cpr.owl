    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1746 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1746">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <rdfs:label xml:lang="en">access to justice</rdfs:label>
        <skos:altLabel xml:lang="en">access to judicial procedures</skos:altLabel>
        <skos:altLabel xml:lang="en">justice access</skos:altLabel>
        <skos:altLabel xml:lang="en">public access to justice</skos:altLabel>
        <skos:altLabel xml:lang="en">social access to justice</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q843"/>
        <cpr:P7 xml:lang="en">Access to justice refers to the public’s right to review by a court or another independent body to ensure that public authorities respect the rights to access to information and public participation, and environmental law in general.</cpr:P7>
        <schema:description xml:lang="en">providing easier access for everyone to legal support and representation, regardless of situation or location</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1747 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1747">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:label xml:lang="en">indigenous self-determination</rdfs:label>
        <skos:altLabel xml:lang="en">self-determination of first nations</skos:altLabel>
        <skos:altLabel xml:lang="en">self-determination of indigenous</skos:altLabel>
        <skos:altLabel xml:lang="en">self-determination of maori</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P7 xml:lang="en">Self-determination is an ongoing process of ensuring that peoples are able to make decisions about matters that affect their lives, based on choice, participation and control. Articles 3 and 4 of the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP) confirms that Indigenous peoples have the right to self-determination under international law. By virtue of that right they freely determine their political status and freely pursue their economic, social and cultural development.</cpr:P7>
        <schema:description xml:lang="en">the right of Indigenous Peoples to freely determine their political status and pursue their economic, social, and cultural development</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1748 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1748">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:label xml:lang="en">indigenous right to object</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1602"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1758"/>
        <schema:description xml:lang="en">The right of Indigenous Peoples to object to developments on their land, or which would otherwise influence their way of life</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q175 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q175">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">solar water distillation</rdfs:label>
        <skos:altLabel xml:lang="en">solar water distillation</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/resources/solar-water-distillation"/>
        <schema:description xml:lang="en">Solar water distillation is the process of using the energy from sunlight to separate freshwater from salts or other contaminants.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1750 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1750">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1254"/>
        <rdfs:label xml:lang="en">non-methane volatile organic compounds</rdfs:label>
        <skos:altLabel xml:lang="en">NMVOCs</skos:altLabel>
        <skos:altLabel xml:lang="en">non-methane VOCs</skos:altLabel>
        <cpr:P7 xml:lang="en">Non-methane volatile organic compounds (NMVOCs) are the same as volatile organic compounds (VOCs), but with methane excluded. Methane is relatively non-toxic and not directly harmful to human health, although it does significantly contribute to climate change and ozone formation. NMVOCs are air pollutants that can harm human health and typically originate from combustion or the evaporation of fuels and other substances.</cpr:P7>
        <schema:description xml:lang="en">Non-methane volatile organic compounds (NMVOCs) are the same as volatile organic compounds (VOCs), but with methane excluded. Methane is relatively non-toxic and not directly harmful to human health, although it does significantly contribute to climate change and ozone formation. NMVOCs are air pollutants that can harm human health and typically originate from combustion or the evaporation of fuels and other substances.</schema:description>
    </owl:Class>
    


