        <skos:altLabel xml:lang="en">risk reduction investments</skos:altLabel>
        <skos:altLabel xml:lang="en">risk reduction payments</skos:altLabel>
        <cpr:P20 xml:lang="en">r4qxcp34</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1585"/>
        <cpr:P7 xml:lang="en">Climate finance encompasses financial actors and resources primarily directed towards climate change mitigation, adaptation and compensation. It is characterised by its specific intent to address the challenges and impacts of climate change. Adaptation finance is specifically allocated to activities that enhance resilience to climate impacts.</cpr:P7>
        <schema:description xml:lang="en">Finance that is primarily directed towards climate change adaptation, including increasing resilience and robustness to actual or expected climate change and its effects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1346 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1346">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1343"/>
        <rdfs:label xml:lang="en">loss and damage finance</rdfs:label>
        <skos:altLabel xml:lang="en">finance for addressing loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">finance for addressing loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">finance for l&amp;d</skos:altLabel>
        <skos:altLabel xml:lang="en">finance for loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">finance for loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">financing for addressing loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">financing for addressing loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">financing l&amp;d</skos:altLabel>
        <skos:altLabel xml:lang="en">financing loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">financing loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">funding for addressing loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">funding for addressing loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">funding for loss &amp; damage</skos:altLabel>
        <skos:altLabel xml:lang="en">funding for loss and damage</skos:altLabel>
        <skos:altLabel xml:lang="en">l &amp; d finance</skos:altLabel>
        <skos:altLabel xml:lang="en">l &amp; d funding</skos:altLabel>
        <skos:altLabel xml:lang="en">l &amp; d investment</skos:altLabel>
        <skos:altLabel xml:lang="en">l&amp;d finance</skos:altLabel>
        <skos:altLabel xml:lang="en">l&amp;d funding</skos:altLabel>
        <skos:altLabel xml:lang="en">l&amp;d investment</skos:altLabel>
        <skos:altLabel xml:lang="en">loss &amp; damage funding</skos:altLabel>
        <skos:altLabel xml:lang="en">loss and damage funding</skos:altLabel>
        <skos:altLabel xml:lang="en">loss and damage investment</skos:altLabel>
        <cpr:P20 xml:lang="en">aqrcdtxx</cpr:P20>
        <cpr:P7 xml:lang="en">Climate finance encompasses financial actors and resources primarily directed towards climate change mitigation, adaptation and compensation. It is characterised by its specific intent to address the challenges and impacts of climate change. Loss and damage finance refers to financial mechanisms that cover the significant and often unavoidable economic costs from climate change impacts that remain even after the most effective adaptation measures are applied, particularly in vulnerable regions, as illustrated by integrated economic models that compare optimal adaptation spending with the persistent residual damages.</cpr:P7>
        <schema:description xml:lang="en">Funding provided to help pay for the economic harm from climate change that cannot be completely prevented by adaptation measures.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q135 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q135">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">ecological buffer zones</rdfs:label>
        <skos:altLabel xml:lang="en">biodiversity buffer zone</skos:altLabel>
        <skos:altLabel xml:lang="en">biodiversity buffer zones</skos:altLabel>
        <skos:altLabel xml:lang="en">ecological buffer</skos:altLabel>
        <skos:altLabel xml:lang="en">ecological buffer zone</skos:altLabel>
        <skos:altLabel xml:lang="en">ecological buffers</skos:altLabel>
        <cpr:P7 xml:lang="en">Buffer zones are designated areas used to protect sensitive landscape patches (e.g., wetlands, wildlife reserves) to lessen the impacts of human activity and land disturbance.</cpr:P7>
        <schema:description xml:lang="en">Buffer zones are designated areas used to protect sensitive landscape patches (e.g., wetlands, wildlife reserves) to lessen the impacts of human activity and land disturbance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q136 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q136">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q136"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">wildfire control</rdfs:label>
        <skos:altLabel xml:lang="en">bushfire containment</skos:altLabel>
        <skos:altLabel xml:lang="en">bushfire reduction</skos:altLabel>
        <skos:altLabel xml:lang="en">bushfire suppression</skos:altLabel>
        <skos:altLabel xml:lang="en">containing bushfires</skos:altLabel>
        <skos:altLabel xml:lang="en">containing wildfires</skos:altLabel>
        <skos:altLabel xml:lang="en">controlling bushfires</skos:altLabel>
        <skos:altLabel xml:lang="en">controlling wildfires</skos:altLabel>
        <skos:altLabel xml:lang="en">create a fire break</skos:altLabel>
        <skos:altLabel xml:lang="en">fighting wildfires</skos:altLabel>
        <skos:altLabel xml:lang="en">fire breaks</skos:altLabel>
        <skos:altLabel xml:lang="en">firebreaks</skos:altLabel>
        <skos:altLabel xml:lang="en">suppressing bushfires</skos:altLabel>
        <skos:altLabel xml:lang="en">suppressing wildfires</skos:altLabel>
        <skos:altLabel xml:lang="en">wildfire containment</skos:altLabel>
        <skos:altLabel xml:lang="en">wildfire suppression</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q137"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q422"/>
        <cpr:P7 xml:lang="en">Wildfire control refers to efforts and strategies aimed at minimizing the risk, frequency, and severity of wildfires. One strategy is the &apos;firebreaks&apos;, which purpose is to prevent forest fires from spreading before they damage the ecosystem, cropland or personal property. It consists in creating cleared areas to stop or slow the spread of wildfires.</cpr:P7>
        <schema:description xml:lang="en">Wildfire control refers to efforts and strategies aimed at minimizing the risk, frequency, and severity of wildfires. One strategy is the &apos;firebreaks&apos;, which purpose is to prevent forest fires from spreading before they damage the ecosystem, cropland or personal property. It consists in creating cleared areas to stop or slow the spread of wildfires.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1362 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1362">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1343"/>
        <rdfs:label xml:lang="en">climate fund</rdfs:label>
        <cpr:P20 xml:lang="en">bugd7dbt</cpr:P20>
        <cpr:P7 xml:lang="en">A dedicated financial mechanism that mobilises, manages and disburses resources to support actions addressing climate change. Climate funds are designed to facilitate the transition to a low-carbon, climate-resilient future by financing projects and initiatives that reduce greenhouse gas emissions (mitigation), help societies adapt to the impacts of climate change (adaptation) and pay for the economic harm from climate change that cannot be completely prevented by adaptation measures (loss and damage). Climate funds can be public, private or a blend of both but this concept is focused on public climate finance. They may operate at international, national or local levels but this concept is focused on international and national climate finance flows. Climate funds use a range of financial instruments and are often structured to attract additional investment from governments, development banks, businesses and other stakeholders. Their governance, priorities and funding mechanisms vary, but all climate funds share the common goal of accelerating climate action through strategic financial support.</cpr:P7>
        <schema:description xml:lang="en">Dedicated pool of financial resources for climate-related projects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1363 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1363">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1362"/>
        <rdfs:label xml:lang="en">multilateral climate fund</rdfs:label>
        <skos:altLabel xml:lang="en">Accelerating Coal Transition</skos:altLabel>
        <skos:altLabel xml:lang="en">Accelerating Coal Transition Program</skos:altLabel>
        <skos:altLabel xml:lang="en">Adaptation Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">CTF</skos:altLabel>
        <skos:altLabel xml:lang="en">Clean Technology Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate Investment Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate Investment Funds</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate Smart Cities Program</skos:altLabel>
        <skos:altLabel xml:lang="en">Forest Investment Program</skos:altLabel>
        <skos:altLabel xml:lang="en">GCF</skos:altLabel>
        <skos:altLabel xml:lang="en">GEF</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Climate Action Program</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Environment Facility</skos:altLabel>
        <skos:altLabel xml:lang="en">Green Climate Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Industry Decarbonization Program</skos:altLabel>
        <skos:altLabel xml:lang="en">L &amp; D Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">L&amp;D Fund</skos:altLabel>
