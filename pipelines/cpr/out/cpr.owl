    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q164 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q164">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1633"/>
        <rdfs:label xml:lang="en">drip irrigation</rdfs:label>
        <skos:altLabel xml:lang="en">drip irrigation</skos:altLabel>
        <cpr:P4 rdf:resource="https://tech-action.unepccc.org/wp-content/uploads/sites/2/2019/05/tna-guidebook-adaptationagriculture.pdf"/>
        <cpr:P4 rdf:resource="https://www.fao.org/4/s8684e/s8684e07.htm"/>
        <schema:description xml:lang="en">Drip irrigation involves dripping water onto the soil at very low rates (2-20 litres/hour) from a system of small diameter plastic pipes fitted with outlets called emitters or drippers. Water is applied close to plants so that only part of the soil in which the roots grow is wetted. Drip irrigation can provide asmuch as 90 per cent water-use efficiency and has been applied in arid and semi-aridzones as well as in areas with irregular flows of water.</schema:description>
    </owl:Class>
    


