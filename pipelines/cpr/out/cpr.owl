    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1995">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1943"/>
        <cpr:P7 xml:lang="en">Improved capacity and adoption of technologies to ensure the safety of fishers at sea during extreme climatic events, such as storms.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1996">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1998">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q182"/>
        <cpr:P7 xml:lang="en">A climate resilient airport is one that has taken steps to prepare for the challenges that climate change and severe weather bring. Airport planning is conducted for many reasons, and they increasingly include consideration of the risks and impacts associated with climate changes and plans for future climate conditions.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2000">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
    </rdf:Description>
