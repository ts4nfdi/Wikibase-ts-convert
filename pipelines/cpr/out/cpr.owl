        <skos:altLabel xml:lang="en">desertified land</skos:altLabel>
        <skos:altLabel xml:lang="en">land desertification</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1004"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1008"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q138"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">Desertification is land degradation in arid, semi-arid, and dry sub-humid areas due to climatic variations and human activities like deforestation and overexploitation of aquifers. It leads to reduced crop yields, loss of aquifers and biodiversity, and displacement of people, exacerbating the impacts of climate change by increasing greenhouse gas emissions and reducing carbon sequestration.</cpr:P7>
        <schema:description xml:lang="en">Land degradation in arid, semi-arid and dry sub-humid areas (drylands) resulting from various factors, including climatic variations and human activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q435 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q435">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">coral bleaching</rdfs:label>
        <skos:altLabel xml:lang="en">bleach coral</skos:altLabel>
        <skos:altLabel xml:lang="en">bleached coral</skos:altLabel>
        <skos:altLabel xml:lang="en">bleaching of coral</skos:altLabel>
        <skos:altLabel xml:lang="en">bleaching of corals</skos:altLabel>
        <skos:altLabel xml:lang="en">bleaching of the coral</skos:altLabel>
        <skos:altLabel xml:lang="en">corals bleached</skos:altLabel>
        <skos:altLabel xml:lang="en">mass bleaching of corals</skos:altLabel>
        <skos:altLabel xml:lang="en">widespread bleaching</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1002"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1007"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1940"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q999"/>
        <cpr:P7 xml:lang="en">Coral bleaching occurs when corals expel the algae living in their tissues, usually due to increased sea temperatures, leaving them white and more susceptible to disease. This process, driven by warmer seas, ocean acidification, and pollution, can lead to coral death if prolonged. Between 2014 and 2017, over 75% of the world’s tropical reefs experienced unprecedented bleaching.</cpr:P7>
        <schema:description xml:lang="en">Coral bleaching occurs when corals expel the algae living in their tissues, usually due to increased sea temperatures, leaving them white and more susceptible to disease.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q439 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q439">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">permafrost loss</rdfs:label>
        <skos:altLabel xml:lang="en">degradation of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">loss of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">melt of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">melting of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">melting tundra</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost changes</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost degradation</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost loss</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost melt</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost melting</skos:altLabel>
        <skos:altLabel xml:lang="en">permafrost thaw</skos:altLabel>
        <skos:altLabel xml:lang="en">reduced depth of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">thawing of permafrost</skos:altLabel>
        <skos:altLabel xml:lang="en">thawing permafrost</skos:altLabel>
        <cpr:P7 xml:lang="en">Permafrost, ground frozen below 0°C for at least two years, gradually melts due to heat, a process known as permafrost thaw. This can span decades to centuries, impacting ground stability, infrastructure, and releasing greenhouse gases. Thawing moderates temperature changes through the ice-water phase transition. Once thawed, the ground no longer qualifies as permafrost.</cpr:P7>
        <schema:description xml:lang="en">Permafrost loss, or thaw, is the gradual melting of ground ice due to heat, occurring over decades to centuries, with impacts unfolding as thaw progresses.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q441 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q441">
