    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2021 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2021">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1830"/>
        <rdfs:label xml:lang="en">adaptation cooperation</rdfs:label>
        <skos:altLabel xml:lang="en">adaptation collaboration, collaborate on adaptation, collaboration on adaptation, cooperate on adaptation, cooperation on adaptation</skos:altLabel>
        <schema:description xml:lang="en">Collaborating to accelerate adaptation to climate change, particularly across international borders.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2022 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2022">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1830"/>
        <rdfs:label xml:lang="en">adaptation technology transfer</rdfs:label>
        <skos:altLabel xml:lang="en">transfer of adaptation technology, transfer adaptation technology, transferred adaptation technology, technology transfer for climate resilience, technology transfer for climate resilient</skos:altLabel>
        <cpr:P7 xml:lang="en">Technologies play a key role in adapting to climate change, helping countries and societies respond to a changing environment and managing both current and future climate risks. However, developing countries face barriers to tap into these new technologies. Adaptation technology transfer refers to the action of transferring technologies that aid climate adaptation to developing countries, accelerating their capacity to adapt to climate change.</cpr:P7>
        <schema:description xml:lang="en">Adaptation technology transfer refers to the action of transferring technologies that aid climate adaptation to developing countries, accelerating their capacity to adapt to climate change.</schema:description>
    </owl:Class>
    


