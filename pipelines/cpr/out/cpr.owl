        <skos:altLabel xml:lang="en">emission standards</skos:altLabel>
        <skos:altLabel xml:lang="en">product emissions standard</skos:altLabel>
        <skos:altLabel xml:lang="en">product emissions standards</skos:altLabel>
        <cpr:P7 xml:lang="en">Emission standards are legal limits on the amount of pollutants that can be released into the atmosphere. They apply to vehicles, engines, and fuels.</cpr:P7>
        <schema:description xml:lang="en">Emission standards are legal limits on the amount of pollutants that can be released into the atmosphere. They can apply to a range of products, including vehicles, engines, and fuels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1713 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1713">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">standard for soil quality</rdfs:label>
        <skos:altLabel xml:lang="en">minimum standards for soil</skos:altLabel>
        <skos:altLabel xml:lang="en">minimum standards for the quality of the soil</skos:altLabel>
        <skos:altLabel xml:lang="en">soil quality standard</skos:altLabel>
        <skos:altLabel xml:lang="en">soil quality standards</skos:altLabel>
        <skos:altLabel xml:lang="en">standards for soil quality</skos:altLabel>
        <cpr:P7 xml:lang="en">Soil quality standards are guidelines that protect and improve the health of soil. They are important for agriculture, biodiversity, and carbon sequestration.</cpr:P7>
        <schema:description xml:lang="en">Soil quality standards are guidelines that protect and improve the health of soil. They are important for agriculture, biodiversity, and carbon sequestration.</schema:description>
    </owl:Class>
    


