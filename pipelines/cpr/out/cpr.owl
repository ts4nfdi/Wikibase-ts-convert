    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2819 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2819">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2698"/>
        <rdfs:label xml:lang="en">electric off-road vehicle</rdfs:label>
        <skos:altLabel xml:lang="en">electric tractor, electric farm vehicle</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q316 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q316">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
        <rdfs:label xml:lang="en">building insulation</rdfs:label>
        <skos:altLabel xml:lang="en">building insulation, insulation in building, insulation of building, thermal insulation</skos:altLabel>
        <cpr:P7 xml:lang="en">Building insulation contains many tiny air cavities and slows heat transmission when installed on a building’s interior or exterior surface or in building cavities. As well as reducing carbon emissions, retrofitting buildings helps them keep warmer in the winter and cooler in the summer. This means that as temperatures rise, homes can stay cooler without the need for energy intensive air conditioning.</cpr:P7>
        <schema:description xml:lang="en">Building insulation contains many tiny air cavities and slows heat transmission when installed on a building’s interior or exterior surface or in building cavities. As well as reducing carbon emissions, retrofitting buildings helps them keep warmer in the winter and cooler in the summer. This means that as temperatures rise, homes can stay cooler without the need for energy intensive air conditioning.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q32 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q32">
        <rdfs:label xml:lang="en">climate justice</rdfs:label>
        <cpr:P20 xml:lang="en">thhpmb5e</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q45"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q55"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q743"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q914"/>
        <cpr:P7 xml:lang="en">Justice centers the moral obligation to address disproportionate impacts and systemic causes. Climate justice means analysing global climate change as a political and ethical issue, recognising how climate change -- and the exploitation of natural resources more broadly -- impacts people, communities and countries differently and disproportionately, while benefiting others. Justice requires addressing structural inequities; including those affected and the most vulnerable in decision making; and recognising their well-being, as well as the value of different ways of knowing and being. To be considered justice-aligned, actions must aim to bring about a fairer, more inclusive world.</cpr:P7>
        <schema:description xml:lang="en">Justice is the ethical and political framework that addresses fairness, including issues of responsibility, rights, and structural inequity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q326 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q326">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q763"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q334 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q334">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1636"/>
        <rdfs:label xml:lang="en">wastewater management</rdfs:label>
        <skos:altLabel xml:lang="en">management of waste water, management of wastewater, waste water management</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1577"/>
        <schema:description xml:lang="en">Actions to collect, treat and safely dispose waste water, including domestic, agricultural, aquaculture, commercial and industrial effluent.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q335 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q335">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2672"/>
        <rdfs:label xml:lang="en">aerobic wastewater treatment</rdfs:label>
        <skos:altLabel xml:lang="en">aerobic waste water treatment, aerobic treatment of waste water, aerobic treatment of wastewater</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q35 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q35">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q915"/>
        <rdfs:label xml:lang="en">intergenerational equity</rdfs:label>
        <skos:altLabel xml:lang="en">inter-generational equity</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q352 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q352">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1855"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">windbreak</rdfs:label>
        <skos:altLabel xml:lang="en">wind break, windbreaks, wind breaks, shelter belt, shelter belts, shelterbelt, shelterbelts</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1975"/>
        <cpr:P7 xml:lang="en">Windbreaks are linear plantings of trees and shrubs designed to provide economic, environmental and community benefits. The primary purpose of most windbreaks is to slow the wind which creates a more beneficial condition for soils, crops, livestock, wildlife and people.</cpr:P7>
        <schema:description xml:lang="en">Windbreaks are linear plantings of trees and shrubs designed to provide economic, environmental and community benefits. The primary purpose of most windbreaks is to slow the wind which creates a more beneficial condition for soils, crops, livestock, wildlife and people.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q354 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q354">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">restoration of organic soils</rdfs:label>
        <skos:altLabel xml:lang="en">organic soil restoration, restoration of organic soil, restore organic soil, restoring organic soil</skos:altLabel>
        <cpr:P7 xml:lang="en">Soil restoration refers to actions to regenerate natural soil cycles through revegetation with shrub and creeper species, reforestation with native arboreal species and containment work with stakes. The aim is to stabilize the soil and increase the supply of organic matter, which promotes restoration. Geomesh is also used when the soil is highly eroded and degraded and the slope exceeds 25%. Soil is restored in accordance with the particular biological and edaphological conditions, and this also determines which species will be selected. The plants are obtained from local nurseries to ensure their adaptability and safeguard the site’s endemic genetic diversity.</cpr:P7>
        <schema:description xml:lang="en">Soil restoration refers to actions to regenerate natural soil cycles through revegetation with shrub and creeper species, reforestation with native arboreal species and containment work with stakes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q355 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q355">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">restoration of degraded lands</rdfs:label>
        <skos:altLabel xml:lang="en">degraded land restoration, restoration of degraded land, restore degraded land, restoring degraded land, degraded area restoration, degraded areas restoration, degraded areas restored, land restored, lands restored, landscape restored, landscapes restoration, landscapes restored, restoration of degraded areas, restoration of landscapes, restore degraded areas, restore degraded lands, restore landscapes, restored degraded areas, restored landscapes, restoring degraded areas, restoring landscapes, land restoration, lands restoration, land rehabilitated, land rehabilitation, lands rehabilitation, rehabilitation of degraded land, rehabilitation of degraded lands, rehabilitation of land, rehabilitation of lands, rehabilitate degraded areas, rehabilitate degraded land, rehabilitate degraded lands, rehabilitation of degraded areas, restoration of damaged areas, reverse land degradation, reversing land degradation, land degradation neutrality</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q356 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q356">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">precision agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">precision agriculture</skos:altLabel>
        <cpr:P7 xml:lang="en">Precision agriculture is a management approach that utilizes information technology to collect and analyze data from various sources to inform crop production decisions. This method involves identifying and measuring geographical and seasonal variations within agricultural sectors, enabling tailored agronomic treatments for specific sites.</cpr:P7>
        <schema:description xml:lang="en">Precision agriculture is a management approach that utilizes information technology to collect and analyze data from various sources to inform crop production decisions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q357 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q357">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">conservation tillage</rdfs:label>
        <skos:altLabel xml:lang="en">conservation agriculture</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2551"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2820"/>
        <cpr:P7 xml:lang="en">Conservation tillage is any method of soil cultivation that leaves the previous year’s crop residue (such as corn stalks or wheat stubble) on fields before and after planting the next crop to reduce soil erosion and runoff, as well as other benefits such as carbon sequestration. Conventional tillage is the traditional method of farming in which soil is prepared for planting by completely inverting it with a tractor-pulled plough, followed by subsequent additional tillage to smooth the soil surface for crop cultivation. In contrast, conservation tillage is a tillage system that conserves soil, water and energy resources through the reduction of tillage intensity and retention of crop residue. Conservation tillage involves the planting, growing and harvesting of crops with limited disturbance to the soil surface.</cpr:P7>
        <schema:description xml:lang="en">Conservation tillage is any method of soil cultivation that leaves the previous year’s crop residue (such as corn stalks or wheat stubble) on fields before and after planting the next crop to reduce soil erosion and runoff, as well as other benefits such as carbon sequestration.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q358 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q358">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">selective breeding via controlled mating</rdfs:label>
        <skos:altLabel xml:lang="en">selective breeding, selective animal breeding</skos:altLabel>
        <cpr:P7 xml:lang="en">Genetic make-up influences fitness and adaptation and determines an animal’s tolerance to shocks such as temperature extremes, drought, flooding, pests and diseases. Adaptation to harsh environments includes heat tolerance and an animal’s ability to survive, grow and reproduce in the presence of poor seasonal nutrition as well as parasites and diseases. Selective breeding is a technology that aims to improve the value of animal genetic diversity. This technology can be applied to all types of livestock, including cattle, sheep, goats, alpacas and guinea pigs.</cpr:P7>
        <schema:description xml:lang="en">Selective breeding is a technology that aims to improve the value of animal genetic diversity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q359 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q359">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">straw ammoniation and silage</rdfs:label>
        <skos:altLabel xml:lang="en">ammoniation, silage, ammoniating straw</skos:altLabel>
        <cpr:P7 xml:lang="en">Straw ammoniation is a process by which low-value forage such as corn stalks, rice straw, wheat straw, and straw of other crops is ammoniated. Adding liquid ammonia, urea, or ammonium bicarbonate as ammonia sources result in the straw lignin being completely degraded while the nutrients are enhanced, making it more easily digestible by rumen microorganisms. Straw silage refers to forage that is prepared through the fermentation of chopped fresh green fodder, forage grass, and all kinds of vines and other materials by lactobacillus in the anaerobic conditions of an airproof silage container.</cpr:P7>
        <schema:description xml:lang="en">Straw ammoniation is a process by which low-value forage is ammoniated. Silage refers to forage that is prepared through a fermentation process in the anaerobic conditions of an airproof silage container.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q360 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q360">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">temperature regulation for livestock</rdfs:label>
        <skos:altLabel xml:lang="en">temperature regulation for livestock</skos:altLabel>
        <schema:description xml:lang="en">Strategies to manage heat stress of livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q361 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q361">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">livestock disease management</rdfs:label>
        <skos:altLabel xml:lang="en">managing livestock disease</skos:altLabel>
        <cpr:P7 xml:lang="en">Livestock disease management reduces disease through improved animal husbandry practices. These include: controlled breeding, controlling entry to farm lots, and quarantining sick animals and through developing and improving antibiotics, vaccines and diagnostic tools, evaluation of ethno-therapeutic options, and vector control techniques.</cpr:P7>
        <schema:description xml:lang="en">Livestock disease management reduces disease through improved animal husbandry practices.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q362 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q362">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
        <rdfs:label xml:lang="en">grazing land management</rdfs:label>
        <skos:altLabel xml:lang="en">grazing area management, grazing land managed, grazing lands managed, grazing management, manage grazing, managed grazing, management of grazing, managing grazing, grazing plan, grazing strategies, plan for grazing, planned grazing, planning grazing, strategies for grazing</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2667"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
        <cpr:P7 xml:lang="en">Grazing management involves the planning, implementing, and monitoring of grazing. Through the reduction of overgrazing and the improvement of forage production, its aims to maintain healthy and productive grazing land so that cattle and other grazers can use the land for as long as possible during the year while staying within the limits of the ecosystem.</cpr:P7>
        <schema:description xml:lang="en">Grazing management defines actions to improve grazing land and increase the quality of grazing for livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q363 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q363">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">fodder banks</rdfs:label>
        <skos:altLabel xml:lang="en">fodder bank</skos:altLabel>
        <cpr:P7 xml:lang="en">Fodder banks are plantings of high-quality fodder species to provide livestock with quality feeds to augment dry season forages. The goal of fodder banks is to maintain healthy productive animals. They can be utilized all year, but are designed to bridge the forage scarcity of annual dry seasons. Fodder banks do not provide 100% of feed requirements, but supplement the available dry season forage.</cpr:P7>
        <schema:description xml:lang="en">Fodder banks are plantings of high-quality fodder species to provide livestock with quality feeds to augment dry season forages.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q364 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q364">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q362"/>
        <rdfs:label xml:lang="en">pasture management</rdfs:label>
        <skos:altLabel xml:lang="en">pasture management, manage pasture, management of pastoral areas, pasture land management, manage pastures, managed pasture, managed pastures, management of pastoral land, management of pastoral lands, management of pasture, management of pastures, managing pasture, managing pastures, pastoral land management, reduce degradation of pastures, reducing the degradation of pasture</skos:altLabel>
        <cpr:P7 xml:lang="en">Pasture management defines actions to improve pasture quality for livestock. Strategies aim to improve grass health and forage production, reduce production costs and maintain a sustainable ecological balance.</cpr:P7>
        <schema:description xml:lang="en">Pasture management defines actions to improve pasture quality for livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q365 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q365">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
        <rdfs:label xml:lang="en">livestock feed optimisation</rdfs:label>
        <skos:altLabel xml:lang="en">livestock feed additives, livestock feed optimization, optimisation of livestock feed, optimization of livestock feed, additives in animal feed, animal feed additives, animal feed supplements, cattle feed additives, improve animal feed, improve livestock feed, improved animal feed, improved livestock feed, improvement of animal feed, improvement of livestock feed, improving animal feed, improving livestock feed, livestock feed supplement, livestock feed supplements, optimisation of cattle feed, feed additives</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2563"/>
        <cpr:P7 xml:lang="en">The principle of nutrition regulation technology to reduce methane emissions is: to optimise the concentrate to forage ratio in diet by controlling the crude fiber content of the diet or the fermentation process to reduce methane emission while ensuring normal production performance of ruminant animals without increasing production cost. This way, the rumen fermentation pattern or rumen microbial populations (such as methanogens, ciliates) and pH characteristics are altered to reduce methane emissions. At present, nutritional regulation is one of the most feasible approaches to reduce methane emissions and much research is being carried out to reduce methane emissions by changing the concentrate to forage ratio in diet.</cpr:P7>
        <schema:description xml:lang="en">Actions to optimise livestock diets by controlling the crude fiber content of the diet or the fermentation process to reduce methane emission while ensuring normal production performance of ruminant animals without increasing production cost.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q368 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q368">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q949"/>
        <rdfs:label xml:lang="en">marine risk</rdfs:label>
        <skos:altLabel xml:lang="en">sea water intrusion, marine hazards, ocean hazard, ocean hazards, marine climatic driver, marine impact, ocean climatic driver, ocean climatic drivers</skos:altLabel>
        <cpr:P20 xml:lang="en">mfe6wvbv</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1032"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1403"/>
        <cpr:P7 xml:lang="en">Environmental risks to marine ecosystems refer to threats from climate change impacts like rising sea temperatures, ocean acidification, and deoxygenation. These disrupt marine biodiversity, species health, and distribution, endangering ecosystem services and the livelihoods of coastal communities.</cpr:P7>
        <schema:description xml:lang="en">Risks to the ecosystem health of the marine environment, including ocean warming, ocean acidification, and ocean deoxygenation, harming biodiversity, species health, ecosystem services, and coastal community livelihoods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q370 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q370">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">ocean acidification</rdfs:label>
        <skos:altLabel xml:lang="en">acidification of the ocean, acidification of the sea, acidification of the seawater, acidify the ocean, acidify the sea, acidify the seawater, sea acidification, seawater acidification, change in ocean chemistry, ocean chemistry change</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1004"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1007"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q223"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P7 xml:lang="en">Ocean acidification is the long-term reduction of ocean pH due to atmospheric CO2 uptake. It threatens marine organisms and ecosystems, reducing biodiversity, degrading habitats, and endangering fisheries and aquaculture, thus impacting food security. Combined with warmer sea temperatures and pollution, acidification drives issues like coral bleaching.</cpr:P7>
        <schema:description xml:lang="en">Ocean acidification refers to a reduction in the pH of the ocean over an extended period of time, caused primarily by uptake of carbon dioxide (CO2) from the atmosphere.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q372 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q372">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">sea level rise</rdfs:label>
        <skos:altLabel xml:lang="en">increase in sea level, increasing sea level, rise in sea level, rising sea level, sea level change, sea level increase, rise in the sea level, rising of the sea level, sea-level change, sea-level fall, sea level rises, sea-level rise, rise of sea level, rise of sea levels, rising sea levels, rise of the sea level, sea level extremes</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1180"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1499"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1515"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1517"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1518"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q185"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q418"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q441"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q778"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q779"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q933"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q934"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <cpr:P7 xml:lang="en">Refers to an increase in the average height of the ocean&apos;s surface. The two main causes are the melting of ice (glaciers and ice sheets) and the thermal expansion of seawater as it warms. This rise can result in coastal flooding, damage to infrastructure, and the loss of low-lying ecosystems. It can also lead to the displacement of communities and increased vulnerability to extreme weather events</cpr:P7>
        <schema:description xml:lang="en">Sea level rise is a change to the height of sea level, both globally and locally at seasonal, annual, or longer time scales due to change in ocean volume.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q374 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q374">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">extreme weather</rdfs:label>
        <skos:altLabel xml:lang="en">weather extremes, extreme weather events, rapid onset event, rapid onset events, extreme events, climate extreme, climate extremes, weird weather, crazy weather, extreme meteorological event, extreme meteorological events, adverse weather, extreme climatic phenomena, weather anomalies, weather anomaly, weather disaster, weather disasters, global weirding, extreme hydro-meteorological event, extreme hydro-meteorological events, extreme weather patterns, extreme climate risks, dangerous hydrometeorological phenomena, increased weather volatility, hydro meteorological events, hydrometeorological events, hydrometeorological phenomena, hydro meteorological phenomena, extreme hydrological events, hydrological extreme, meteorological extreme, severe weather, rapid-onset event, rapid-onset events</skos:altLabel>
        <cpr:P20 xml:lang="en">j8jjs2z6</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1286"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1514"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q762"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q765"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q766"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q770"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q779"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P7 xml:lang="en">Extreme weather refers to events where a weather variable exceeds (or falls below) a threshold, with thresholds defined differently across studies. Extreme weather events can span from hours (e.g., convective storms), days (e.g., heatwaves), to seasons and years (e.g., droughts), posing risks to health, livelihoods, assets, and ecosystems.</cpr:P7>
        <schema:description xml:lang="en">Extreme weather refers to events where a weather variable exceeds (or falls below) a threshold. Meaning it is significantly different from the average or usual weather pattern.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q382 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q382">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">flood</rdfs:label>
        <skos:altLabel xml:lang="en">flooding, floods, inundation, flooded</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q107"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q111"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q112"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q113"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1198"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1523"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q168"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q77"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q82"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q91"/>
        <cpr:P7 xml:lang="en">Floods occur when normally dry land is submerged, resulting from the interplay of hydrology, climate, and human management. They are classified by type and scale, with factors varying by region. Measuring flooded areas is challenging, so studies often focus on streamflow to assess changes.</cpr:P7>
        <schema:description xml:lang="en">Floods are the inundation of normally dry land, resulting from a mix of hydrology, climate, and human factors, varying by type and region.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q385 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q385">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">drought</rdfs:label>
        <skos:altLabel xml:lang="en">agricultural drought, droughts, ecological drought, flash drought, flash droughts, hydrological drought, megadrought, megadroughts, meteorological  drought, aridity, dry period, dry spell, massive drought, massive severe drought, severe drought, drouth, dry periods, dry spells</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q154"/>
        <cpr:P20 xml:lang="en">4mcdpeaw</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q100"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1986"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1992"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q90"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q994"/>
        <cpr:P7 xml:lang="en">A drought is an extended period of abnormally dry weather with significantly reduced precipitation over a large area lasting more than a month. It results in below-average moisture, impacting natural systems and economic sectors. Droughts can be meteorological, agricultural, ecological, or hydrological, and often affect multiple areas of the Earth system simultaneously or sequentially.</cpr:P7>
        <schema:description xml:lang="en">A drought is an extended period of unusually dry weather marked by a significant and sustained lack of precipitation, falling below a specific threshold over a large area for more than a month</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q389 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q389">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q980"/>
        <rdfs:label xml:lang="en">cold extremes</rdfs:label>
        <skos:altLabel xml:lang="en">cold wave, dzud, extreme cold, freezing rain, supercooled rain, thaw, cold extreme, cold waves, dzuds, freezing rains, frost, glaze, ground frost, hoar frost, extreme low temperature events, cold spell, cold spells</skos:altLabel>
        <cpr:P7 xml:lang="en">Cold refers to periods of unusually low temperatures, such as cold waves, frost, and freezing rain. As global warming increases, the frequency and intensity of hot extremes are expected to rise, while cold extremes will decrease across global and continental scales, affecting nearly all inhabited regions.</cpr:P7>
        <schema:description xml:lang="en">Cold refers to periods of unusually low temperatures, impacting various phenomena like cold waves, frost, and freezing rain. These events can include ground frost, hoar frost, and supercooled rain.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q393 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q393">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2029"/>
        <rdfs:label xml:lang="en">heatwave</rdfs:label>
        <skos:altLabel xml:lang="en">extreme heat, exceptionally hot, heat wave, heat event, heat events, heat waves, abnormally hot, abnormally hot weather, heatwaves, hot weather, dangerous heat, deadly heat</skos:altLabel>
        <cpr:P7 xml:lang="en">A heatwave is an extended period of unusually high temperatures over a large area, lasting from a few days to several weeks. It involves significant warming or an influx of very warm air, exceeding local climatological thresholds. Human-induced greenhouse gas forcing is the main driver of observed increases in both hot and cold extremes globally, including heatwaves.</cpr:P7>
        <schema:description xml:lang="en">A heatwave is an extended period of unusually high temperatures lasting several days to weeks, with temperatures exceeding local thresholds.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q399 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q399">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">storm</rdfs:label>
        <skos:altLabel xml:lang="en">extreme storm, freak wave, rogue wave, storm surge, storm tide, gale, cold air funnel, cyclonic wind, hurricane, land spout, squall, storm, tornado, twister, typhoon, whirlwind, extreme storm wave, extreme storm waves, freak waves, rogue waves, seiche, seiches, tidal wave, tidal waves, storm surges, storm tides, baroclinic storm, baroclinic storms, cold air funnels, cyclonic winds, downburst, downbursts, ETCs, extra-tropical cyclone, extra-tropical cyclones, extratropical storm, extratropical storms, extreme storms, extreme wind, extreme winds, firebolt, gales, hurricanes, land spouts, lightning, microburst, microbursts, severe convective storm, severe convective storms, squalls, sub-tropical cyclone, sub-tropical cyclones, subtropical storm, subtropical storms, TCs, thunderball, thunderbolt, thunderstorm, thunderstorms, thunderstroke, tornadoes, tropical cyclone, tropical cyclones, tropical storm, tropical storms, twisters, typhoons, whirlwinds, wind sear, violent winds</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1185"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1196"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q82"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q92"/>
        <cpr:P7 xml:lang="en">Storms are intense weather events with strong winds that can cause significant damage to infrastructure and ecosystems. They are characterized by severe winds, and can lead to large waves, and high storm surges. Assessing the impact of climate change on these events is challenging due to their rarity, short duration, and local variability.</cpr:P7>
        <schema:description xml:lang="en">Storms are intense weather events with strong winds that can cause significant damage to infrastructure and ecosystems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q4 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q4">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:label xml:lang="en">deforestation</rdfs:label>
        <skos:altLabel xml:lang="en">net forest area loss, forest clearance, removal of forest, removal of forests, deforestation area, permanent reduction of trees, deforestation fronts, global forest cover loss, conversion of a forest into a non-forest area, forest land converted to other land, forest conversion, unsustainable exploitation of forest, unsustainable exploitation of forests, tree felling, conversion of forest, conversion of forests, cutting down of trees, cutting down tree, cutting down trees, extraction of forest, extraction of forests, unsustainable exploitation of the forest, unsustainable exploitation of the forests, deforested</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1008"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q17"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q18"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q19"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q21"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q221"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q28"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q5"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P7 xml:lang="en">Deforestation is the direct human-induced conversion of forested land to non-forested land, reducing tree canopy cover below 10%. It implies long-term or permanent loss of forest cover due to conversion to other land uses like agriculture, pasture, urban areas, or water reservoirs, maintained by ongoing human or natural disturbances.</cpr:P7>
        <schema:description xml:lang="en">Removal of forest and conversion of the land to non-forest use, and is the direct human-induced conversion of forested land to non-forested land</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q404 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q404">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q949"/>
        <rdfs:label xml:lang="en">terrestrial risk</rdfs:label>
        <skos:altLabel xml:lang="en">terrestrial hazard, terrestrial hazards, terrestrial ecosystem, terrestrial impact, terrestrial climate impact driver, terrestrial climate impact drivers, terrestrial impacts</skos:altLabel>
        <cpr:P20 xml:lang="en">fd5t9bhw</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1033"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1408"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1514"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1831"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q741"/>
        <cpr:P7 xml:lang="en">Terrestrial means &quot;of the earth&quot;, and refers to factors and phenomena that occur on land and influence climatic conditions and environmental systems. It encompasses a range of land-based risks affecting climate and ecosystems, including events such as landslides, wildfires, and soil erosion. Examples of terrestrial ecosystems include the tropical rainforests, grasslands, and deserts.</cpr:P7>
        <schema:description xml:lang="en">Terrestrial means &quot;of the earth&quot; and relates to the risks to ecological system that includes all living organisms and their interactions within land-based environments, such as forests, grasslands, and deserts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q406 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q406">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">avalanche</rdfs:label>
        <skos:altLabel xml:lang="en">avalanches, snow slide, snow slip, snowslide, snowslip, loose snow avalanche, loose snow avalanches, sluff, sluffs, slab avalanche, gliding avalanche, gliding avalanches, powder avalanche, powder avalanches, wet-snow avalanche, wet-snow avalanches, snow avalanche, glacier landslide, glacier landslides</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1519"/>
        <schema:description xml:lang="en">An avalanche is a mass of snow and ice falling suddenly down a mountain slope and often taking with it earth, rocks and rubble of every description</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q408 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q408">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">landslide</rdfs:label>
        <skos:altLabel xml:lang="en">mud flow, mudflow, debris flow, land slide, rotational slide, translational slide, mud flows, debris flows, hyperconcentrated flows, mudslide, mudslides, landslides, debris avalanche, debris avalanches, land slides, mass movement, mass movements, mass wasting, mass wastings, rock fall-debris avalanche, sediment rock avalanche, sediment related disasters, sediment related disaster</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1079"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1975"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q94"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q95"/>
        <cpr:P7 xml:lang="en">Landslides are the downslope movement of soil, rock, and organic materials driven by gravity when it overcomes slope friction. They are often caused by extreme weather events like heavy rainfall and floods, or triggered by mining, industrial activities, or earthquakes. Cryosphere-related changes can exacerbate landslides, impacting people, infrastructure, and economies.</cpr:P7>
        <schema:description xml:lang="en">Landslide is the downslope movement of soil, rock and organic materials under the effects of gravity, which occurs when the gravitational driving forces exceed the frictional resistance of the material resisting on the slope.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q412 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q412">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q949"/>
        <rdfs:label xml:lang="en">air pollution risk</rdfs:label>
        <skos:altLabel xml:lang="en">air contamination, air pollution, air-pollution</skos:altLabel>
        <cpr:P20 xml:lang="en">9cfzu8vh</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1064"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1103"/>
        <cpr:P7 xml:lang="en">Air pollution involves harmful contaminants in the air, affecting both indoor and outdoor environments. It can lead to health issues like respiratory diseases and heart problems, and climate impacts such as global warming. Pollutants can damage plants, trees, habitats, and water bodies like rivers and lakes.</cpr:P7>
        <schema:description xml:lang="en">Air pollution involves harmful contaminants in the air, affecting both indoor and outdoor environments. It can lead to health issues like respiratory diseases and heart problems, and climate impacts such as global warming. Pollutants can damage plants, trees, habitats, and water bodies like rivers and lakes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q415 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q415">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">land degradation</rdfs:label>
        <skos:altLabel xml:lang="en">degradation of the land, soil degradation, mangrove loss, wetland degradation, eutrophication, degradation of land, degradation of wetland, degradation of wetlands, loss of wetland, loss of wetlands, wetland loss, degradation of soil, loss of mangroves, sand mining, degradation of soil fertility, loss of soil fertility, degradation of vegetation, devegetation, natural resource degradation, degraded land, degraded lands</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1008"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q355"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P7 xml:lang="en">Land degradation is the reduction or loss of biological or economic productivity in arid, semi-arid, and dry sub-humid areas due to human activities or natural processes. It includes soil erosion, loss of soil quality, and long-term loss of vegetation. This degradation, worsened by anthropogenic climate change, reduces land&apos;s ability to produce benefits, impacting ecosystems and human livelihoods.</cpr:P7>
        <schema:description xml:lang="en">A negative trend in the condition of land, expressed as long-term reduction or loss of at least one of the following: biological productivity, ecological integrity or value to humans.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q418 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q418">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">salinisation</rdfs:label>
        <skos:altLabel xml:lang="en">saline soil, salinity of the soil, salt-affected soil, soil salinity, salinity of the water, salinization, rising salinity, salt in waters and in soil, salt in waters and in soils, salinised, salinized, saline intrusion</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">Salinization is the accumulation of salts in soil and water, often due to increased evaporation from rising temperatures. It alters the balance between saline and fresh water, harming ecosystems, lake fisheries, crops, and human health. This process degrades soil, reduces agricultural productivity, and negatively impacts farmers&apos; well-being and regional economies.</cpr:P7>
        <schema:description xml:lang="en">Increasing evaporation from rising temperatures leads to the salinization of soil and water. Salts accumulate in the soils of arid environments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q419 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q419">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">biodiversity loss</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q420"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q741"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q758"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q765"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q914"/>
        <cpr:P7 xml:lang="en">The decline in genetic, species, and ecosystem diversity due to factors like extinction, habitat destruction, or removal. It can occur at various scales, from local population losses to global extinctions. Near-term warming and extreme events pose high risks to ecosystems, exacerbating biodiversity loss. This issue intersects with climate change and demographic shifts, affecting risk distribution.</cpr:P7>
        <schema:description xml:lang="en">Biodiversity loss refers to the reduction of any aspect of biological diversity (i.e. diversity at the genetic, species and ecosystem levels) in a particular area through death (including extinction), destruction or manual removal. It can occur at many scales, from global extinctions to local population extinctions, leading to a decline in total diversity at the same scale.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q420 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q420">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:label xml:lang="en">invasive species</rdfs:label>
        <skos:altLabel xml:lang="en">invasive weeds, insect infestation, insect outbreaks, invasive plant species</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q741"/>
        <schema:description xml:lang="en">Invasive species, or alien invasive species, are non-native species that threaten ecosystems, habitats, and other species, causing social, economic, environmental, or health harm.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q422 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q422">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:label xml:lang="en">wildfire</rdfs:label>
        <skos:altLabel xml:lang="en">forest fire, landscape fire, wild fire, brush fire, bush fire, bushfire, grass fire, peat fire, scrub fire, vegetation fire, wildland fire, wild fires, wildfires, brush fires, bushfires, forest fires, grass fires, landscape fires, peat fires, scrub fires, vegetation fires, wildland fires, bush fires</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1162"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q136"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1520"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q5"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q663"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q664"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P7 xml:lang="en">Wildfires are any unplanned or uncontrolled fire affecting natural, cultural, industrial, and residential landscapes. Changing weather conditions associated with global warming increase the probability of wildfires. Degradation and loss of ecosystems also contribute to greenhouse gas emissions and are increasingly exacerbated by climate change impacts, including droughts and wildfires.</cpr:P7>
        <schema:description xml:lang="en">Wildfires are any unplanned or uncontrolled fire affecting natural, cultural, industrial and residential landscapes. Changing weather conditions associated with global warming increase the probability of wildfires.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q432 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q432">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:label xml:lang="en">desertification</rdfs:label>
        <skos:altLabel xml:lang="en">desertification of land, desertified land, land desertification</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1004"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1008"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q138"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q767"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q818"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">Desertification is land degradation in arid, semi-arid, and dry sub-humid areas due to climatic variations and human activities like deforestation and overexploitation of aquifers. It leads to reduced crop yields, loss of aquifers and biodiversity, and displacement of people, exacerbating the impacts of climate change by increasing greenhouse gas emissions and reducing carbon sequestration.</cpr:P7>
        <schema:description xml:lang="en">Land degradation in arid, semi-arid and dry sub-humid areas (drylands) resulting from various factors, including climatic variations and human activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q435 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q435">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">coral bleaching</rdfs:label>
        <skos:altLabel xml:lang="en">bleach coral, bleaching of the coral, bleached coral, bleaching of coral, bleaching of corals, corals bleached, mass bleaching of corals, widespread bleaching</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1002"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1007"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1940"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q999"/>
        <cpr:P7 xml:lang="en">Coral bleaching occurs when corals expel the algae living in their tissues, usually due to increased sea temperatures, leaving them white and more susceptible to disease. This process, driven by warmer seas, ocean acidification, and pollution, can lead to coral death if prolonged. Between 2014 and 2017, over 75% of the world’s tropical reefs experienced unprecedented bleaching.</cpr:P7>
        <schema:description xml:lang="en">Coral bleaching occurs when corals expel the algae living in their tissues, usually due to increased sea temperatures, leaving them white and more susceptible to disease.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q439 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q439">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">permafrost loss</rdfs:label>
        <skos:altLabel xml:lang="en">degradation of permafrost, loss of permafrost, melt of permafrost, melting of permafrost, permafrost degradation, permafrost loss, permafrost melt, permafrost melting, permafrost thaw, thawing of permafrost, melting tundra, thawing permafrost, permafrost changes, reduced depth of permafrost</skos:altLabel>
        <cpr:P7 xml:lang="en">Permafrost, ground frozen below 0°C for at least two years, gradually melts due to heat, a process known as permafrost thaw. This can span decades to centuries, impacting ground stability, infrastructure, and releasing greenhouse gases. Thawing moderates temperature changes through the ice-water phase transition. Once thawed, the ground no longer qualifies as permafrost.</cpr:P7>
        <schema:description xml:lang="en">Permafrost loss, or thaw, is the gradual melting of ground ice due to heat, occurring over decades to centuries, with impacts unfolding as thaw progresses.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q441 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q441">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q973"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">glacial retreat</rdfs:label>
        <skos:altLabel xml:lang="en">glacial melt, glacier melt, melt glacier, glacier retreat, glacier mass loss, glacier shrinkage, glacial melting, retreating glacier, retreating glaciers, snow cover change, snow cover changes, glacier hazards, melting of glaciers, glacier recession, calving glacier, calving glaciers, calving of glaciers, glacier calving, changes in glacial system, changes in glacial systems, glacier coverage decline, glacier coverage declined, melting of the glaciers, shorter snow cover period, decreasing glaciers, glacier mass change, glacier runoff, melting glaciers, receding glacier, reduced snow cover, reductions in glacier and snow cover, snow cover decrease, snow cover decreases</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1006"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q997"/>
        <cpr:P7 xml:lang="en">Glacial retreat, driven by rising temperatures, causes erosion, mudslides, and flooding. As glaciers recede, reduced runoff and river flows lead to water shortages, impacting ecosystems and livelihoods. The decline of glaciers, snow, and permafrost also alters natural hazard patterns, increases the frequency and magnitude of hazards, destabilizes mountain slopes, and threatens infrastructure.</cpr:P7>
        <schema:description xml:lang="en">Glacial retreat is what happens when a glacier melts faster than new ice can build it back up. Directly related to increasing temperatures, it produces erosion, mudslides, flooding.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q443 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q443">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <rdfs:label xml:lang="en">health impact</rdfs:label>
        <skos:altLabel xml:lang="en">biological hazard, health hazards, health related hazard, health related hazards, health impacts, impact on health, impacts on health, health and wellbeing, climate and health, biological hazards</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1098"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1239"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1571"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1601"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q418"/>
        <cpr:P7 xml:lang="en">Biological hazard has been redefined as health impact, though it is not included in this classifier development. A separate taxonomy will be created for climate and health, given the large interest in this subject.</cpr:P7>
        <cpr:P7 xml:lang="en">Climate change contributes to global disease and premature deaths. People are directly affected by changing weather patterns like temperature shifts, sea-level rise, and more frequent extreme events. Indirect impacts include changes in water, air, and food quality, as well as disruptions to ecosystems, agriculture, industry, settlements, and the economy. These effects are expected to increase.</cpr:P7>
        <schema:description xml:lang="en">Climate change contributes to global disease and premature deaths. People are directly affected by changing weather patterns like temperature shifts, sea-level rise, and more frequent extreme events. Indirect impacts include changes in water, air, and food quality, as well as disruptions to ecosystems, agriculture, industry, settlements, and the economy. These effects are expected to increase.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q446 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q446">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <rdfs:label xml:lang="en">mental health</rdfs:label>
        <skos:altLabel xml:lang="en">crisis in mental health, crisis of mental health, mental health crisis, suicide, suicide cluster, mental wellbeing</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1645"/>
        <cpr:P7 xml:lang="en">Climate change impacts mental health by exacerbating stress and trauma from extreme weather events, rising temperatures, and loss of livelihoods and culture. Increased exposure to wildfire smoke, dust, and allergens also contributes to mental health challenges and cardiovascular and respiratory distress.</cpr:P7>
        <schema:description xml:lang="en">Mental health is a state of well-being that allows individuals to handle life stresses, realize their abilities, learn, work effectively, and contribute to their community.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q448 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q448">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <rdfs:label xml:lang="en">infectious disease</rdfs:label>
        <skos:altLabel xml:lang="en">air-borne disease, air-borne illness, airborne disease, airborne illness, blood-borne disease, blood-borne illness, bloodborne disease, bloodborne illness, epidemic, food-borne disease, food-borne illness, foodborne disease, foodborne illness, infectious disease, neglected tropical disease, pandemic, plague, sexually transmitted disease, vaccine-preventable disease, water-borne disease, water-borne illness, waterborne disease, waterborne illness, zoonotic disease, AIDS, animal disease, COVID-19, diarrhoeal disease, HIV, viral haemorrhagic fever, avian influenza, cholera, cryptosporidium, listeriosis, pandemic influenza, paratyphoid fever, shigellosis, typhoid fever, chikungunya, cysticercosis, diphtheria, leprosy, leptospirosis, measles, meningococcal meningitis, seasonal influenza, zika virus, crimean-congo haemorrhagic fever, dengue, ebola, lassa fever, malaria, pertussis, polio, smallpox, varicella and herpes zoster, yellow fever, middle east respiratory syndrome, monkeypox, tuberculosis, african swine fever, brucellosis, contagious bovine pleuropneumonia, contagious caprine pleuropneumonia, rabies, rotavirus, severe acute respiratory syndrome, lumpy skin disease, new world screwworm, newcastle disease virus, peste des petits ruminants, rift valley fever, rinderpest, trypanosomosis, west nile fever, oyster disease, shrimp disease, animal diseases, antimicrobial resistant microorganisms, diarrhoea, diarrhoeal diseases, escherichia Coli, foot and mouth disease virus, hepatitis A, hepatitis B, hepatitis C, MERS, neglected tropical diseases, prion diseases, Q fever, SARS, sexually transmitted diseases, small pox, vaccine-preventable diseases, vector borne disease, vector borne diseases, viral haemorrhagic fevers, zoonotic diseases, respiratory disease, anthrax</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1614"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1888"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q47 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q47">
        <rdfs:label xml:lang="en">just transition</rdfs:label>
        <skos:altLabel xml:lang="en">fair transition, just decarbonisation, just ecological transition, just energy transition, just transition, inclusive transition, participatory transition, leave no one behind, equitable transition, leaving no one behind, leaves no one behind</skos:altLabel>
        <cpr:P20 xml:lang="en">y6vgzs7e</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1568"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q31"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q33"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q43"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q563"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q64"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q774"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q894"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P7 xml:lang="en">A set of principles, processes, and practices that build economic and political power to shift from an extractive economy to a regenerative economy. The protection of workers rights and livelihoods lie at the core of the just transition, but the concept has expanded the concept to encompass actions that support the full range of climate justice principles.</cpr:P7>
        <schema:description xml:lang="en">A set of principles, processes, and practices that build economic and political power to shift from an extractive economy to a regenerative economy.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q519 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q519">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">infrastructure failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in infrastructure, breach of infrastructure, breakdown in infrastructure, breakdown of infrastructure, collapse in infrastructure, collapse of infrastructure, failure in infrastructure, failure of infrastructure, infrastructure breach, infrastructure collapse, infrastructure fail, urban infrastructure failure, urban infrastructure failures, damage to infrastructure, damages to infrastructure, climate event induced damages to physical infrastructure, destroyed infrastructure, destroys infrastructure, infrastructure damages, infrastructure damage, damage infrastructure, destruction of infrastructure, infrastructure failures</skos:altLabel>
        <cpr:P7 xml:lang="en">Extreme or slow-onset events can have adverse consequences for infrastructure, compromising systems such as transportation, water, sanitation, and energy. This leads to economic losses, service disruptions, and negative impacts on health and well-being, with costly recovery and significant effects on local economic activity.</cpr:P7>
        <schema:description xml:lang="en">Infrastructure systems, such as transportation, water, sanitation, and energy, have been compromised by extreme and slow-onset events, leading to economic losses, service disruptions, and impacts on well-being.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q528 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q528">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q53 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q53">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">social protection</rdfs:label>
        <skos:altLabel xml:lang="en">social security, social protection systems, social safeguards, social safety net, social protection programmes, social protection programs, social safety nets, social protection floor, universal social protection, social stability, social transfers, social insurance, social transfer</skos:altLabel>
        <cpr:P20 xml:lang="en">gmnm929r</cpr:P20>
        <cpr:P7 xml:lang="en">Social protection systems consist of policies that help people manage social risks in order to prevent poverty and maintain decent incomes and living standards. It also prevents social exclusion for those that lose (part of) their income or employment due to the effects or mitigation of climate change.</cpr:P7>
        <cpr:P9 xml:lang="en">environmental and social safeguards</cpr:P9>
        <cpr:P9 xml:lang="en">social security administration</cpr:P9>
        <cpr:P9 xml:lang="en">social security number</cpr:P9>
        <cpr:P9 xml:lang="en">social security numbers</cpr:P9>
        <schema:description xml:lang="en">Social protection systems consist of policies that help people manage social risks in order to prevent poverty and maintain decent incomes and living standards</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q54 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q54">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q68"/>
        <rdfs:label xml:lang="en">social dialogue</rdfs:label>
        <skos:altLabel xml:lang="en">inclusive dialogue, stakeholder dialogue, dialogue round table, dialogue round tables, dialogue roundtable, dialogue roundtables, inclusive round table, inclusive round tables, inclusive roundtable, inclusive roundtables, social exchange, multi-actor dialogue, multi-sector dialogue, multi-sectoral dialogue, inclusive space for dialogues, inclusive space, multi-actor exchange</skos:altLabel>
        <schema:description xml:lang="en">Social dialogue means concrete actions from its key stakeholders – governments, workers&apos; and employers&apos; organizations – as well as from the involved social dialogue institutions at all levels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q557 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q557">
        <rdfs:label xml:lang="en">adaptation/resilience</rdfs:label>
        <skos:altLabel xml:lang="en">adaptation, climate adaptation, climate change adaptation, adaptations, augmented resilience, increased resilience, resilience, address climate change impact, address climate change impacts, address climate change risk, address climate change risks, address climate impact, address climate impacts, address climate risk, address climate risks, address impact of climate, address impacts of climate, address risk, address risks, addressed climate change impact, addressed climate change impacts, addressed climate change risk, addressed climate change risks, addressed climate impact, addressed climate impacts, addressed climate risk, addressed climate risks, addressed impact of climate, addressed impacts of climate, addressed risk, addressed risks, addresses climate change impact, addresses climate change impacts, addresses climate change risk, addresses climate change risks, addresses climate impact, addresses climate impacts, addresses climate risk, addresses climate risks, addresses impact of climate, addresses impacts of climate, addresses risk, addresses risks, addressing climate change impact, addressing climate change impacts, addressing climate change risk, addressing climate change risks, addressing climate impact, addressing climate impacts, addressing climate risk, addressing climate risks, addressing impact of climate, addressing impacts of climate, addressing risk, addressing risks, decrease climate change impact, decrease climate change impacts, decrease climate change risk, decrease climate change risks, decrease climate impact, decrease climate impacts, decrease climate risk, decrease climate risks, decrease impact of climate, decrease impacts of climate, decrease risk, decrease risks, decreased climate change impact, decreased climate change impacts, decreased climate change risk, decreased climate change risks, decreased climate impact, decreased climate impacts, decreased climate risk, decreased climate risks, decreased impact of climate, decreased impacts of climate, decreased risk, decreased risks, decreases climate change impact, decreases climate change impacts, decreases climate change risk, decreases climate change risks, decreases climate impact, decreases climate impacts, decreases climate risk, decreases climate risks, decreases impact of climate, decreases impacts of climate, decreases risk, decreases risks, decreasing climate change impact, decreasing climate change impacts, decreasing climate change risk, decreasing climate change risks, decreasing climate impact, decreasing climate impacts, decreasing climate risk, decreasing climate risks, decreasing impact of climate, decreasing impacts of climate, decreasing risk, decreasing risks, lower climate change impact, lower climate change impacts, lower climate change risk, lower climate change risks, lower climate impact, lower climate impacts, lower climate risk, lower climate risks, lower impact of climate, lower impacts of climate, lower risk, lower risks, lowered climate change impact, lowered climate change impacts, lowered climate change risk, lowered climate change risks, lowered climate impact, lowered climate impacts, lowered climate risk, lowered climate risks, lowered impact of climate, lowered impacts of climate, lowered risk, lowered risks, lowering climate change impact, lowering climate change impacts, lowering climate change risk, lowering climate change risks, lowering climate impact, lowering climate impacts, lowering climate risk, lowering climate risks, lowering impact of climate, lowering impacts of climate, lowering risk, lowering risks, lowers climate change impact, lowers climate change impacts, lowers climate change risk, lowers climate change risks, lowers climate impact, lowers climate impacts, lowers climate risk, lowers climate risks, lowers impact of climate, lowers impacts of climate, lowers risk, lowers risks, reduce climate change impact, reduce climate change impacts, reduce climate change risk, reduce climate change risks, reduce climate impact, reduce climate impacts, reduce climate risk, reduce climate risks, reduce impact of climate, reduce impacts of climate, reduce risk, reduce risks, reduced climate change impact, reduced climate change impacts, reduced climate change risk, reduced climate change risks, reduced climate impact, reduced climate impacts, reduced climate risk, reduced climate risks, reduced impact of climate, reduced impacts of climate, reduced risk, reduced risks, reduces climate change impact, reduces climate change impacts, reduces climate change risk, reduces climate change risks, reduces climate impact, reduces climate impacts, reduces climate risk, reduces climate risks, reduces impact of climate, reduces impacts of climate, reduces risk, reduces risks, reducing climate change impact, reducing climate change impacts, reducing climate change risk, reducing climate change risks, reducing climate impact, reducing climate impacts, reducing climate risk, reducing climate risks, reducing impact of climate, reducing impacts of climate, reducing risk, reducing risks, adaptive capacity, climate resilient, adaption, climate adaptive, adapting to climate, adapting to climate change, climate adapting, reduced exposure to climate risk, reduced exposure to climate risks, adapting to impacts of climate, adaptative capacities, adaptative capacity, adapted to climate change</skos:altLabel>
        <cpr:P20 xml:lang="en">bydjsp6d</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1585"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q730"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q998"/>
        <cpr:P7 xml:lang="en">In human systems, the process of adjustment to actual or expected climate and its effects, in order to moderate harm, increase resilience or exploit beneficial opportunities. In natural systems, the process of adjustment to actual climate and its effects; human intervention may facilitate adjustment to expected climate and its effects.</cpr:P7>
        <schema:description xml:lang="en">In human systems, the process of adjustment to actual or expected climate change and its effects, in order to moderate harm, increase resilience or exploit beneficial opportunities. In natural systems, the process of adjustment to actual climate change and its effects; human intervention may facilitate adjustment to expected climate change and its effects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q56 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q56">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q54"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q59"/>
        <rdfs:label xml:lang="en">social partners</rdfs:label>
        <skos:altLabel xml:lang="en">social partner</skos:altLabel>
        <schema:description xml:lang="en">Representatives of management and labour (employer organisations and trade unions), and in some contexts public authorities, that engage in social dialogue.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q563 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q563">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1208"/>
        <rdfs:label xml:lang="en">capacity building</rdfs:label>
