    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q102 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q102">
        <rdfs:label xml:lang="en">monitoring systems</rdfs:label>
        <skos:altLabel xml:lang="en">monitoring system</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1429"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q103"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q87"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technology-type-group/monitoring-systems"/>
        <schema:description xml:lang="en">A monitoring system refers to a set of tools, technologies, and processes used to continuously collect, track, and analyse data. In the context of climate change, these systems are crucial for observing changes in factors such as temperature, emissions, weather patterns, or resource use.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q103 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q103">
        <rdfs:label xml:lang="en">climate change monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">climate change monitoring, climate change risk monitoring, climate risk monitoring, climate monitoring, climate observation, climate observations, observation of the climate</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q102"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/monitoring-technologies"/>
        <schema:description xml:lang="en">A climate change monitoring system integrates satellite observations, ground-based data and forecast models to monitor and forecast changes in the weather and climate. A historical record of spot measurements is built up over time, which provides the data to enable statistical analysis and the identification of mean values, trends and variations.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q105 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q105">
        <rdfs:label xml:lang="en">ecosystem monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">ecosystem monitoring, monitoring of ecosystem, environmental monitoring</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1429"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P4 rdf:resource="https://library.fiveable.me/key-terms/earth-systems-science/ecosystem-monitoring"/>
        <cpr:P4 rdf:resource="https://unece.org/environmental-monitoring"/>
        <schema:description xml:lang="en">Ecosystem monitoring refers to the systematic observation and assessment of ecosystems to track changes, understand ecological processes, and evaluate the health of environmental systems over time. This process often employs various tools and technologies to gather data and supports policymaking.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1207 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1207">
        <rdfs:label xml:lang="en">regulatory instrument</rdfs:label>
        <skos:altLabel xml:lang="en">authoritative instrument, regulatory instruments, authoritative instruments</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1282"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1283"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1284"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <cpr:P7 xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, regulate behaviour by setting some kind of boundary. This refers to the power to make rules, which require actors to adopt certain behaviours and prohibit others. In climate policy, these include obligations to disclose emissions, moratoria and bans on fossil fuel production or use, and spatial planning laws.</cpr:P7>
        <schema:description xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, set boundaries on behaviour through rules, like emissions disclosure, fossil fuel bans, and spatial planning laws.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1208 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1208">
        <rdfs:label xml:lang="en">information instrument</rdfs:label>
        <skos:altLabel xml:lang="en">information instruments, nodality instrument, nodality instruments</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1286"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1288"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1289"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1291"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q563"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <cpr:P7 xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</cpr:P7>
        <schema:description xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1209 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1209">
        <rdfs:label xml:lang="en">organisation and governance instrument</rdfs:label>
        <skos:altLabel xml:lang="en">organisation instrument</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1292"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1293"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1294"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1296"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <cpr:P7 xml:lang="en">Allows governments to act directly on individuals, their property, or the environment, focusing on &quot;effecting&quot; rather than detecting. In climate policy, they are designed to enhance institutions’ capacity to address climate change. This includes granting new responsibilities to existing bodies, creating new institutions, and developing governance plans and strategies.</cpr:P7>
        <schema:description xml:lang="en">Organisation and governance instruments let governments act directly on individuals, property, or the environment, enhancing institutions’ capacity for climate action through new roles, bodies, and strategies.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1269 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1269">
        <rdfs:label xml:lang="en">tax advantage</rdfs:label>
        <skos:altLabel xml:lang="en">tax advantages, tax benefit, tax benefits</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1270"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1271"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1301"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1608"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1609"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1610"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <cpr:P20 xml:lang="en">vtkghc5f</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P7 xml:lang="en">A tax advantage is a fiscal incentive where the government reduces or exempts selected activities, goods or actors from taxes.</cpr:P7>
        <schema:description xml:lang="en">A tax advantage is a fiscal incentive where the government reduces or exempts selected activities, goods or actors from taxes.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1270 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1270">
        <rdfs:label xml:lang="en">tax rebate</rdfs:label>
        <skos:altLabel xml:lang="en">tax rebates, tax relief, VAT rebate, VAT rebates, VAT refund, VAT refunds, VAT relief, tax reimbursement, tax reimbursements, VAT reimbursement, VAT reimbursements, tax offset, tax offsets, tax refund, tax refunds</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P7 xml:lang="en">A tax rebate is a policy instrument that provides a refund to taxpayers for excess taxes paid, often used to incentivise certain behaviours. In environmental contexts, rebates can encourage eco-friendly actions by reducing tax burdens on individuals or businesses who adopt sustainable practices.</cpr:P7>
        <schema:description xml:lang="en">A tax rebate is a reimbursement made to a taxpayer for an excess amount paid in taxes during the year, which can be used to encourage environmentally conscious behaviour from the private sector.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1271 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1271">
        <rdfs:label xml:lang="en">tax incentive</rdfs:label>
        <skos:altLabel xml:lang="en">tax incentives, excise incentive, excise incentives, VAT incentive, VAT incentives, tax subsidies, tax subsidy</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P7 xml:lang="en">Tax incentives reduce tax liabilities to promote environmentally beneficial investments and behaviours. Examples include incentives that encourage lower natural resource consumption, a shift to renewable or alternative energy sources, and the development of low-carbon products and manufacturing processes. These incentives aim to support sustainable innovation and reduce environmental impact.</cpr:P7>
        <schema:description xml:lang="en">Tax incentives reduce tax liabilities to promote environmentally beneficial investments and behaviours.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1272 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1272">
        <rdfs:label xml:lang="en">grant</rdfs:label>
        <skos:altLabel xml:lang="en">grants, grant funding, grant finance, grant financing, grant funds, grant support, transfer payment, transfer payments, payment of grant, payment of grants, in kind contribution, in kind contributions, in kind payment, in kind payments, in-kind contribution, in-kind contributions, in-kind payment, in-kind payments, payment in kind, payments in kind</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1338"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <cpr:P7 xml:lang="en">A grant is a policy instrument in which a sum of money is given by a federal, state, or local government authority or private sector, and is effectively a transfer payment. Unlike loans, grants do not need to be repaid and are often awarded for climate change projects or other beneficial initiatives.</cpr:P7>
        <schema:description xml:lang="en">A grant is a policy instrument in which a sum of money is given by a federal, state, or local government authority or private sector, and is effectively a transfer payment.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1273 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1273">
        <rdfs:label xml:lang="en">loan</rdfs:label>
        <skos:altLabel xml:lang="en">loans, loan finance, lending, lends</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1309"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1310"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1333"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1381"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1457"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1458"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1459"/>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2404"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1338"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <cpr:P20 xml:lang="en">mab9t6ps</cpr:P20>
        <cpr:P7 xml:lang="en">A loan is a policy instrument where funds are provided to a borrower with the expectation of repaying the principal plus interest. Loans may be on commercial terms (market interest rates) or concessional (favourable terms). They can be used as tool to encourage low-emissions investments such as energy efficiency or sustainable development.</cpr:P7>
        <cpr:P9 xml:lang="en">bank</cpr:P9>
        <cpr:P9 xml:lang="en">banks</cpr:P9>
        <cpr:P9 xml:lang="en">concessional loan insurance</cpr:P9>
        <cpr:P9 xml:lang="en">lender</cpr:P9>
        <cpr:P9 xml:lang="en">lenders</cpr:P9>
        <cpr:P9 xml:lang="en">lends itself</cpr:P9>
        <cpr:P9 xml:lang="en">lends support</cpr:P9>
        <cpr:P9 xml:lang="en">loan market</cpr:P9>
        <cpr:P9 xml:lang="en">loan markets</cpr:P9>
        <cpr:P9 xml:lang="en">mortgage</cpr:P9>
        <cpr:P9 xml:lang="en">mortgages</cpr:P9>
        <cpr:P9 xml:lang="en">working capital loan</cpr:P9>
        <cpr:P9 xml:lang="en">working capital loans</cpr:P9>
        <schema:description xml:lang="en">A loan is a policy instrument where funds are provided to a borrower with the expectation of repaying the principal plus interest.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1274 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1274">
        <rdfs:label xml:lang="en">subsidy</rdfs:label>
        <skos:altLabel xml:lang="en">subsidies, subsidised, subsidized, subsidy scheme, subsidy schemes, environmentally beneficial subsidies, payment scheme, payment schemes, subsidise, subsidize, subsidising, subsidizing, support payment, support payments</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1376"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1611"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2658"/>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1275"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <cpr:P20 xml:lang="en">5n5kb8dd</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1275"/>
        <cpr:P7 xml:lang="en">A subsidy is a direct or indirect payment to individuals or businesses, typically provided as a government cash payment or a specific tax reduction. Examples are subsidies to energy efficiency measures, to promote more efficient energy use.</cpr:P7>
        <cpr:P9 xml:lang="en">subsidised loan</cpr:P9>
        <cpr:P9 xml:lang="en">subsidised loans</cpr:P9>
        <cpr:P9 xml:lang="en">subsidized loan</cpr:P9>
        <cpr:P9 xml:lang="en">subsidized loans</cpr:P9>
        <schema:description xml:lang="en">A subsidy is a direct or indirect payment to individuals or businesses, typically provided as a government cash payment or a specific tax reduction.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1275 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1275">
