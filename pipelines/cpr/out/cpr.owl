        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q994"/>
        <schema:description xml:lang="en">Projects, policies and programmes that help people meet their nutritional needs</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1827 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1827">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1763"/>
        <rdfs:label xml:lang="en">participatory budgeting</rdfs:label>
        <skos:altLabel xml:lang="en">collaborative budgeting, collective budgeting</skos:altLabel>
        <cpr:P7 xml:lang="en">Participatory budgeting is a form of citizen participation in which citizens are involved in the process of deciding how public money is spent. Local people are often given a role in the scrutiny and monitoring of the process following the allocation of budgets.</cpr:P7>
        <schema:description xml:lang="en">A form of citizen participation in which citizens are involved in the process of deciding how public money is spent. Local people are often given a role in the scrutiny and monitoring of the process following the allocation of budgets.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1828 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1828">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q900"/>
        <rdfs:label xml:lang="en">preventing workplace heat stress</rdfs:label>
        <skos:altLabel xml:lang="en">OHAP, OHAPs, avoid peak daytime temperatures, cooling oases, cooling oasis, drinking regime, drinking regimes, hydration break, hydration breaks, protect outdoor workers, work in high temperatures, work in hot, working in hot, workplace heat, protect workers from overheating, protecting workers from overheating, water break, water breaks, cooling center, cooling centers</skos:altLabel>
        <schema:description xml:lang="en">Measures to prevent heat stress in the workplace.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1829 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1829">
        <rdfs:label xml:lang="en">finance flow</rdfs:label>
        <skos:altLabel xml:lang="en">financial flow</skos:altLabel>
        <cpr:P20 xml:lang="en">ds667yyj</cpr:P20>
        <cpr:P7 xml:lang="en">A finance flow is an economic flow that reflects the creation, transformation, exchange, transfer, or extinction of economic value and involves changes in ownership of goods and/or financial assets, the provision of services, or the provision of labor and capital. Ideally, a financial flow describes four elements: the source (who is sending the financial asset, such as a bank or organisation); the financial instrument or mechanism (how it is being sent, such as a grant, loan or a subsidy); the use or destination (the purpose for which the asset will be used, which is often expressed as the recipient organisation or their sectoral categorisation); and the value (which can, but does not need to be, expressed in monetary terms directly).</cpr:P7>
        <schema:description xml:lang="en">Either money or something of monetary value is transferred between two or more organisations, people or countries.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q183 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q183">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q182"/>
        <rdfs:label xml:lang="en">resilient rail systems</rdfs:label>
        <skos:altLabel xml:lang="en">resilient rail, resilient railway, adaptation of railways, railway adaptation, resilient railroad, resilient railroads, resilient railways, adaptation of rail, adaptation of rail infrastructure, adaptation of railroad, adaptation of railroads, adaptation of railway, adaptations of rail, adaptations of rail infrastructure, adaptations of railroad, adaptations of railroads, adaptations of railway, adaptations of railways, adapting rail, adapting rail infrastructure, adapting railroad, adapting railroads, adapting railway, adapting railways, adaptive capacity of rail, adaptive capacity of rail infrastructure, adaptive capacity of railroad, adaptive capacity of railroads, adaptive capacity of railway, adaptive capacity of railways, climate resilient rail, climate resilient rail infrastructure, climate resilient railroad, climate resilient railroads, climate resilient railway, climate resilient railways, climate-smart rail, climate-smart rail infrastructure, climate-smart railroad, climate-smart railroads, climate-smart railway, climate-smart railways, resilience of rail, resilience of rail infrastructure, resilience of railroad, resilience of railroads, resilience of railway, resilience of railways, resilient rail infrastructure</skos:altLabel>
        <cpr:P4 rdf:resource="https://railroads.dot.gov/sites/fra.dot.gov/files/2024-07/FRA%20Resiliency%20Bulletin%20July%202024_%20PDFa.pdf"/>
        <cpr:P4 rdf:resource="https://www.sciencedirect.com/org/science/article/pii/S0144164722000204"/>
        <schema:description xml:lang="en">Resilience of railway transport system is defined as the ability of a railway system to provide effective services in normal conditions, as well as to resist, absorb, accommodate and recover quickly from disruptions or disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1830 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1830">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <rdfs:label xml:lang="en">adaptation enabling factor</rdfs:label>
        <skos:altLabel xml:lang="en">adaptation enabling factors, adaptation enabling condition, adaptation enabling conditions, resilience enabling factor, resilience enabling factors, enabling adaptation, enabling resilience, factors that enable adaptation, factors that enable resilience</skos:altLabel>
        <cpr:P20 xml:lang="en">zu4827wd</cpr:P20>
        <cpr:P7 xml:lang="en">Conditions that enhance the feasibility of adaptation options. Enabling conditions include finance, technological innovation, strengthening policy instruments, institutional capacity, multi-level governance and changes in human behaviour and lifestyles.</cpr:P7>
        <schema:description xml:lang="en">Conditions that enhance the feasibility of adaptation options. Enabling conditions include finance, technological innovation, strengthening policy instruments, institutional capacity, multi-level governance and changes in human behaviour and lifestyles.</schema:description>
    </owl:Class>
    


