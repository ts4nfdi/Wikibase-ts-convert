        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q82"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q91"/>
        <cpr:P7 xml:lang="en">Floods occur when normally dry land is submerged, resulting from the interplay of hydrology, climate, and human management. They are classified by type and scale, with factors varying by region. Measuring flooded areas is challenging, so studies often focus on streamflow to assess changes.</cpr:P7>
        <schema:description xml:lang="en">Floods are the inundation of normally dry land, resulting from a mix of hydrology, climate, and human factors, varying by type and region.</schema:description>
    </owl:Class>
    


