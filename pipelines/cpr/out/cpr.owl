        <rdfs:label xml:lang="en">activities of embassies</rdfs:label>
        <skos:altLabel xml:lang="en">consulates, consulate, embassies, embassy</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q93 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q93">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1990"/>
        <rdfs:label xml:lang="en">climate model projections</rdfs:label>
        <skos:altLabel xml:lang="en">climate model projection, climate change models, climate modelling, climate change projection, climate change projections, climate projections, climate model, climate models</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1894"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q89"/>
        <cpr:P4 rdf:resource="https://climate.copernicus.eu/climate-projections"/>
        <schema:description xml:lang="en">Climate projections are simulations of Earth’s climate for future decades based on assumed &apos;scenarios&apos; for variables such as the concentration of greenhouse gases. Climate projections are obtained by running numerical models describing the interactions between the components of the Earth’s climate, covering the entire globe or just a specific region e.g. Europe.</schema:description>
    </owl:Class>
    


