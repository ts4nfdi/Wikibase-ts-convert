    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1846">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1831"/>
        <rdfs:label xml:lang="en">terrestrial ecosystem-based adaptation</rdfs:label>
        <skos:altLabel xml:lang="en">biodiversity adaptation</skos:altLabel>
        <skos:altLabel xml:lang="en">terrestrial ecosystem adaptation</skos:altLabel>
        <skos:altLabel xml:lang="en">terrestrial ecosystem conservation</skos:altLabel>
