        <schema:description xml:lang="en">Ecosystem monitoring refers to the systematic observation and assessment of ecosystems to track changes, understand ecological processes, and evaluate the health of environmental systems over time. This process often employs various tools and technologies to gather data and supports policymaking.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1050 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1050">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">microplastics</rdfs:label>
        <cpr:P7 xml:lang="en">Micro- to macroplastics are insoluble in water, and can range in size from 1 μm to anything above 5mm. They can originate from primary sources (manufactured at that size) or secondary sources (breakdown from later plastics). Macroplastics can degrade into microplastics over time, and are major pollutants in aquatic ecosystems, posing risks to human and animal health.</cpr:P7>
        <schema:description xml:lang="en">Micro- to macroplastics are insoluble in water, and can range in size from 1 μm to anything above 5mm. They can originate from primary sources (manufactured at that size) or secondary sources (breakdown from later plastics). Macroplastics can degrade into microplastics over time, and are major pollutants in aquatic ecosystems, posing risks to human and animal health.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1052 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1052">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <rdfs:label xml:lang="en">mesoplastic</rdfs:label>
        <skos:altLabel xml:lang="en">large micro plastic</skos:altLabel>
        <skos:altLabel xml:lang="en">large micro plastics</skos:altLabel>
        <skos:altLabel xml:lang="en">large microplastic</skos:altLabel>
        <skos:altLabel xml:lang="en">large microplastics</skos:altLabel>
        <cpr:P7 xml:lang="en">add</cpr:P7>
        <schema:description xml:lang="en">any solid plastic particle insoluble in water with any dimension between 1 mm and 5 mm</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1053 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1053">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <rdfs:label xml:lang="en">microplastic</rdfs:label>
