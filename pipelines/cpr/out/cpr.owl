        <skos:altLabel xml:lang="en">Cap-and-Trade</skos:altLabel>
        <skos:altLabel xml:lang="en">ETS</skos:altLabel>
        <skos:altLabel xml:lang="en">Emission Trading Systems</skos:altLabel>
