    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1952 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1952">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1875"/>
        <rdfs:label xml:lang="en">postharvest loss reduction</rdfs:label>
        <skos:altLabel xml:lang="en">reducing postharvest losses, reducing post-harvest losses, reduction in post-harvest losses, reduction in postharvest losses, post-harvest loss reduction, reducing post-harvest loss, improved post-harvest, improved postharvest, post-harvest losses reduced, reduce post-harvest losses, reduce postharvest losses, reduced post-harvest losses, reduced postharvest losses, reduction of post-harvest losses, reduction of postharvest losses, minimize post-harvest losses, minimizing post-harvest losses, prevent post-harvest losses</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1784"/>
        <cpr:P7 xml:lang="en">Prevention and minimization of loss in quantity or quality of agricultural produce that occurs between harvest and consumption. Causes of postharvest losses include poor storage, inadequate transportation, delayed sales, and lack of cold chain infrastructure.</cpr:P7>
        <schema:description xml:lang="en">Prevention and minimization of loss in quantity or quality of agricultural produce that occurs between harvest and consumption.</schema:description>
    </owl:Class>
    


