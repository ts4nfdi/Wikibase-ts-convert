    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2682 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2682">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2556"/>
        <rdfs:label xml:lang="en">pumped storage power plant</rdfs:label>
        <skos:altLabel xml:lang="en">pumped-storage power plants, pumped-storage power plant, pumped-storage power station, pumped-storage power stations, pumped storage power plants</skos:altLabel>
        <schema:description xml:lang="en">A hydroelectric facility that stores energy by pumping water from a lower reservoir to a higher elevation reservoir during times of low electricity demand, and releasing it back through turbines to generate electricity when demand peaks.</schema:description>
    </owl:Class>
    


