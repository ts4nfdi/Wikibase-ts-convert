        <skos:altLabel xml:lang="en">legal framework for adaptation</skos:altLabel>
        <skos:altLabel xml:lang="en">legal framework for climate resilience</skos:altLabel>
        <skos:altLabel xml:lang="en">legal provision for adaptation</skos:altLabel>
        <skos:altLabel xml:lang="en">legal provision for climate resilience</skos:altLabel>
        <schema:description xml:lang="en">Activites related to developing laws and legal frameworks for adapting to climate change.</schema:description>
    </owl:Class>
    


