    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2026 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2026">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
