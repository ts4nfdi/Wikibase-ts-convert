        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2792"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2793"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2574"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2575"/>
        <cpr:P7 xml:lang="en">Soilless agriculture refers to farming practices that involve growing plants without the use of traditional soil. Crops are either grown in water-based nutrient solutions, in inert substrates, or completely exposed to air. It allows for more efficient use of space and resources, higher yield and complete control of the nutrient balance.</cpr:P7>
    </rdf:Description>
