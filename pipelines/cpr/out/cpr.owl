        <skos:altLabel xml:lang="en">zero deforestation</skos:altLabel>
        <skos:altLabel xml:lang="en">zero-deforestation</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1404"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P7 xml:lang="en">Avoided forest conversion refers to activities that avoid deforestation and maintain the integrity and resilience of forested ecosystems. This maintains carbon stocks and forest resilience to climate change. Activities include designation of conservation easements on forested land, the use of protective guidelines, such as best management practices, that avoid unintentional loss of forest cover or soil carbon and reducing the amount of forest that is displaced for forest management activities (e.g. designing road systems or landings to minimize their footprint).</cpr:P7>
        <schema:description xml:lang="en">Avoided forest conversion refers to activities that avoid deforestation and maintain the integrity and resilience of forested ecosystems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1853 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1853">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <rdfs:label xml:lang="en">forest stewardship</rdfs:label>
        <skos:altLabel xml:lang="en">FLR</skos:altLabel>
        <skos:altLabel xml:lang="en">SFM</skos:altLabel>
        <skos:altLabel xml:lang="en">close-to-nature forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">ecological forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">forest landscape restoration</skos:altLabel>
        <skos:altLabel xml:lang="en">forests managed sustainably</skos:altLabel>
        <skos:altLabel xml:lang="en">integrated forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">manage forests sustainably</skos:altLabel>
        <skos:altLabel xml:lang="en">managing forests sustainably</skos:altLabel>
        <skos:altLabel xml:lang="en">natural forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">responsible forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">responsible forestry</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable forest management</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable forestry</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable management of forest</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable management of forests</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable management of native forests</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable management of timber</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable management of woodlands</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of forest products</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of forests</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of non-timber forest products</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of non-timber products from forests</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of timber</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainably managed forest</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainably managed forests</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q134"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <cpr:P7 xml:lang="en">Forest stewardship is a general approach to forest management that meets the needs of current owners but doesn&apos;t detract from or degrade the use by future generations. Forest stewardship is based on conservation principles that ensure protection of all forest resources including wildlife, timber, soil, water recreational opportunities and makes them more resilient to climate change. Forest stewards actively manage their land on a long-term basis by following management objectives that are based on multiple resources, are economically viable and conserve natural resources.</cpr:P7>
        <schema:description xml:lang="en">Forest stewardship is a general approach to forest management that meets the needs of current owners but doesn&apos;t detract from or degrade the use by future generations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1854 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1854">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:label xml:lang="en">rainguard for rubber trees</rdfs:label>
        <skos:altLabel xml:lang="en">polythene skirt rainguards</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P7 xml:lang="en">Rainguards protect rubber tree tapping, helping to maintain latex rubber tapping yields and prevent the growth of fungi during periods of rainfall.</cpr:P7>
        <schema:description xml:lang="en">Rainguards protect rubber tree tapping, helping to maintain rubber tapping yields and prevent the growth of fungi during periods of rainfall.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1855 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1855">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:label xml:lang="en">agroforestry</rdfs:label>
        <skos:altLabel xml:lang="en">agro-forest</skos:altLabel>
        <skos:altLabel xml:lang="en">agro-forestry</skos:altLabel>
        <skos:altLabel xml:lang="en">agro-forests</skos:altLabel>
        <skos:altLabel xml:lang="en">agro-sylviculture</skos:altLabel>
        <skos:altLabel xml:lang="en">agroforest</skos:altLabel>
        <skos:altLabel xml:lang="en">agroforests</skos:altLabel>
        <skos:altLabel xml:lang="en">agrosilviculture</skos:altLabel>
        <skos:altLabel xml:lang="en">farm forestry</skos:altLabel>
        <skos:altLabel xml:lang="en">farming in forest</skos:altLabel>
        <skos:altLabel xml:lang="en">forest farming</skos:altLabel>
        <skos:altLabel xml:lang="en">silvoarable</skos:altLabel>
        <skos:altLabel xml:lang="en">trees in cropland</skos:altLabel>
        <skos:altLabel xml:lang="en">trees in croplands</skos:altLabel>
        <skos:altLabel xml:lang="en">trees in farming</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1864"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2561"/>
        <cpr:P7 xml:lang="en">Agroforestry refers to land use systems in which trees are grown in combination with agriculture on the same land. Agroforestry exploits the complementarity between perennial species (trees or shrubs) and crops, so that the available resources can be more effectively exploited. Efficient and modern versions of agroforestry allow the diversification of farm activity and make better use of environmental resources. Agroforestry can be implemented in different regions, producing food and fibre for better food and nutritional security, sustaining livelihoods, alleviating poverty and promoting productive, resilient agricultural environments. Moreover, agroforestry can contribute to climate change adaptation by preventing deforestation, increasing biodiversity conservation, producing cleaner water and controlling soil erosion, thus enabling agricultural lands to better cope with floods and drought events.</cpr:P7>
        <schema:description xml:lang="en">Agroforestry refers to land use systems in which trees are grown in combination with agriculture on the same land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1856 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1856">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">climate-resilient crop storage</rdfs:label>
        <skos:altLabel xml:lang="en">grain storage</skos:altLabel>
        <cpr:P7 xml:lang="en">Climate-resilient crop storage refers to methods to store crops post harvest and ensure they remain in good condition that can withstand future climate impacts.</cpr:P7>
        <schema:description xml:lang="en">Climate-resilient crop storage refers to methods to store crops post harvest and ensure they remain in good condition that can withstand future climate impacts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1857 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1857">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">ex situ conservation</rdfs:label>
        <skos:altLabel xml:lang="en">artificial propagation of plants</skos:altLabel>
        <skos:altLabel xml:lang="en">preservation of seed</skos:altLabel>
        <skos:altLabel xml:lang="en">preservation of seeds</skos:altLabel>
        <skos:altLabel xml:lang="en">seed bank</skos:altLabel>
        <skos:altLabel xml:lang="en">seed banks</skos:altLabel>
        <cpr:P7 xml:lang="en">Ex situ or ‘off-site’ conservation means the conservation of components of biological diversity outside their natural habitats. The main objective of ex situ techniques is to support conservation by ensuring the survival of threatened species and the maintenance of associated genetic diversity. Ex situ techniques should always be seen as complimentary to in situ conservation, aiding species recovery and reintroduction. The main techniques are: gene banks, e.g. seed banks, sperm and ova banks; captive breeding of animals and artificial propagation of plants; and collections of living organisms for zoos, aquaria, and botanic gardens for research and public awareness.</cpr:P7>
        <schema:description xml:lang="en">Ex situ or ‘off-site’ conservation means the conservation of components of biological diversity outside their natural habitats.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1858 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1858">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2579"/>
        <rdfs:label xml:lang="en">food surplus distribution</rdfs:label>
        <skos:altLabel xml:lang="en">distribute food surplus</skos:altLabel>
        <skos:altLabel xml:lang="en">distributing food surplus</skos:altLabel>
        <skos:altLabel xml:lang="en">distribution of food surplus</skos:altLabel>
        <skos:altLabel xml:lang="en">food bank</skos:altLabel>
        <skos:altLabel xml:lang="en">food banks</skos:altLabel>
        <skos:altLabel xml:lang="en">redistributing food surplus</skos:altLabel>
        <skos:altLabel xml:lang="en">redistribution of food surplus</skos:altLabel>
        <cpr:P7 xml:lang="en">Food surplus distribution refers to increasing the availability of food by enabling products to flow from surplus to deficit areas, which can emerge as a consequence of extreme weather events or other disruptions. It is a practice used to reduce emissions related to food waste management and adapt to climate-related food insecurity.</cpr:P7>
        <schema:description xml:lang="en">Food surplus distribution refers to increasing the availability of food by enabling products to flow from surplus to deficit areas, which can emerge as a consequence of extreme weather events or other disruptions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1860 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1860">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">increasing crop resilience and productivity</rdfs:label>
        <skos:altLabel xml:lang="en">improving crop resilience</skos:altLabel>
        <skos:altLabel xml:lang="en">resilient crops</skos:altLabel>
        <skos:altLabel xml:lang="en">resistant crops</skos:altLabel>
        <skos:altLabel xml:lang="en">tolerant crops</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1613"/>
        <cpr:P7 xml:lang="en">Increasing crop resilience refers to activities to improve the ability of plants to withstand and recover from stressors, ensuring consistent yields and overall health.</cpr:P7>
        <schema:description xml:lang="en">Increasing crop resilience refers to activities to improve the ability of plants to withstand and recover from stressors, ensuring consistent yields and overall health.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1861 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1861">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">sustainable fertilizer</rdfs:label>
        <skos:altLabel xml:lang="en">eco-friendly fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">ecological fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">green fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">green fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">green fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">green fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">responsible use of fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable fertilisation</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable fertilization</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable use of fertilizers</skos:altLabel>
        <cpr:P7 xml:lang="en">Sustainable fertilizers refer to a biodigester system utilizing organic waste, particularly animal and human excreta, to produce fertilizer and biogas. A biodigester consists of an airtight, high-density polyethylene container within which excreta diluted in water flow continuously and are fermented by microorganisms present in the waste. The fermentation process is anaerobic, i.e., it takes place without oxygen, and the bacteria responsible for decomposition are methanogenic (i.e., they produce methane, also known as biogas). The processed manure is an organic, pathogen-free fertilizer that is rich in nitrogen, phosphorus and potassium. The products are primarily for self-consumption on farms. By producing a nutrient-rich fertilizer, this system reduces the need for agricultural inputs. Adding manure to soils reduces their deterioration and increases their productivity. Soil to which organic fertilizers have been added is less vulnerable to pests, erosion and drought.</cpr:P7>
        <schema:description xml:lang="en">Sustainable fertilizer refers to a biodigester system utilizing organic waste, particularly animal and human excreta, to produce fertilizer and biogas.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1862 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1862">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">fodder crop</rdfs:label>
        <skos:altLabel xml:lang="en">fodder crops</skos:altLabel>
        <skos:altLabel xml:lang="en">resilient fodder</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P7 xml:lang="en">Fodder crops are homegrown crops used to feed livestock. They can help to reduce the reliance on purchased feeds increasing the resilience of farms. Subsistence farmers often rely on fodder crops to sustain healthy herds.</cpr:P7>
        <schema:description xml:lang="en">Fodder crops are homegrown crops used to feed livestock. They can help to reduce the reliance on purchased feeds increasing the resilience of farms.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1863 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1863">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">greenhouse crop management</rdfs:label>
        <skos:altLabel xml:lang="en">agriculture in greenhouse</skos:altLabel>
        <skos:altLabel xml:lang="en">agriculture in greenhouses</skos:altLabel>
        <skos:altLabel xml:lang="en">crops in greenhouse</skos:altLabel>
        <skos:altLabel xml:lang="en">cultivation in greenhouses</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse agriculture</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse crop</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse crops</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse cultivation</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse farm</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse farming</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse growing</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse horticulture</skos:altLabel>
        <skos:altLabel xml:lang="en">greenhouse production</skos:altLabel>
        <skos:altLabel xml:lang="en">growing in greenhouses</skos:altLabel>
        <skos:altLabel xml:lang="en">horticulture in greenhouse</skos:altLabel>
        <skos:altLabel xml:lang="en">horticulture in greenhouses</skos:altLabel>
        <skos:altLabel xml:lang="en">production in greenhouses</skos:altLabel>
        <cpr:P7 xml:lang="en">Greenhouse crop management refers to using greenhouse-type structures to create optimal climate, water, pest control, soil fertility and ventilation conditions in order to attain high productivity more quickly, at lower cost and with less of an environmental impact. Climate variables inside the greenhouse are controlled with several devices and materials including, inter alia, shade mesh, windows and openings, forced ventilation and humidifiers. The shape of the structure and the material with which it is covered will vary according to the specific purpose (for example, germination). By providing a space with the most suitable microclimate for cultivation, greenhouses diminish the impact of changing rainfall patterns, strong winds, hail, frost and extreme heat. This raises productivity, avoids crop damage and failure and improves food security.</cpr:P7>
        <schema:description xml:lang="en">Greenhouse crop management refers to using greenhouse-type structures to create optimal climate, water, pest control, soil fertility and ventilation conditions in order to attain high productivity more quickly, at lower cost and with less of an environmental impact.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1864 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1864">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">organic agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">certification of organic products</skos:altLabel>
        <skos:altLabel xml:lang="en">growing organic</skos:altLabel>
        <skos:altLabel xml:lang="en">organic agricultural produce</skos:altLabel>
        <skos:altLabel xml:lang="en">organic certification</skos:altLabel>
        <skos:altLabel xml:lang="en">organic crop</skos:altLabel>
        <skos:altLabel xml:lang="en">organic crops</skos:altLabel>
        <skos:altLabel xml:lang="en">organic cultivation</skos:altLabel>
        <skos:altLabel xml:lang="en">organic farm</skos:altLabel>
        <skos:altLabel xml:lang="en">organic farming</skos:altLabel>
        <skos:altLabel xml:lang="en">organic growing</skos:altLabel>
        <skos:altLabel xml:lang="en">organic produce</skos:altLabel>
        <skos:altLabel xml:lang="en">organic production</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1855"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1866"/>
        <cpr:P7 xml:lang="en">Organic agriculture is a production system which avoids or largely excludes the use of synthetic fertilisers, pesticides and growth regulators. It can sequester carbon using crop rotations, crop residues, animal manure, legumes, green manure, and off-farm organic waste. It can also reduce carbon emissions by avoiding the use of fossil fuels used in the manufacture of the chemicals used to make synthetic materials. Organic agriculture increases soil’s water retention capacity, which would enable a crop to go longer into a drought cycle assuming an initial full profile. This provides an adaptation measure to unpredictable climatic conditions. Organic systems are highly adaptive to climate change due to the application of traditional skills and farmers’ knowledge, soil fertility-building techniques and a high degree of diversity.</cpr:P7>
        <schema:description xml:lang="en">Organic agriculture is a production system which avoids or largely excludes the use of synthetic fertilisers, pesticides and growth regulators.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1865 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1865">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">biochar</rdfs:label>
        <skos:altLabel xml:lang="en">bio char</skos:altLabel>
        <skos:altLabel xml:lang="en">biochar technology</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1784"/>
        <cpr:P7 xml:lang="en">Biochar is a form of charcoal created by heating organic material, known as biomass, in an environment without oxygen at temperatures of 400°C or higher. This  pyrolysis process produces energy-rich gases and liquids as well as a solid product—biochar. It is used as soil enhancer to increase fertility, prevent soil degradation and to sequester carbon in the soil.</cpr:P7>
        <schema:description xml:lang="en">Biochar is a form of charcoal created by heating organic material, known as biomass, in an environment without oxygen at temperatures of 400°C or higher.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1866 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1866">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">pest and disease control</rdfs:label>
        <skos:altLabel xml:lang="en">disease-resistant crops</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1864"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2808"/>
        <cpr:P7 xml:lang="en">Pest and insect control refers to increasing the resilience of crops to pests and insects. For example, disease-resistant early-maturing peanut variety.</cpr:P7>
        <schema:description xml:lang="en">Pest and insect control refers to increasing the resilience of crops to pests and insects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1867 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1867">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">genetically modified crops</rdfs:label>
        <skos:altLabel xml:lang="en">GMO crop</skos:altLabel>
        <skos:altLabel xml:lang="en">GMO crops</skos:altLabel>
        <skos:altLabel xml:lang="en">biotechnology for crop adaptation</skos:altLabel>
        <skos:altLabel xml:lang="en">genetically engineered crops</skos:altLabel>
        <skos:altLabel xml:lang="en">genetically modified crop</skos:altLabel>
        <skos:altLabel xml:lang="en">genetically modified food</skos:altLabel>
        <skos:altLabel xml:lang="en">genetically modified foods</skos:altLabel>
        <skos:altLabel xml:lang="en">gm crop</skos:altLabel>
        <skos:altLabel xml:lang="en">gm crops</skos:altLabel>
        <skos:altLabel xml:lang="en">gmos in agriculture</skos:altLabel>
        <skos:altLabel xml:lang="en">modified crop genetics</skos:altLabel>
        <skos:altLabel xml:lang="en">modify crop genetics</skos:altLabel>
        <cpr:P7 xml:lang="en">Biotechnology for crop adaptation refers to breeding crops for improved performance under environmental stresses involving activities which accumulate favourable alleles (different forms of a gene) and increase stress tolerance. Biotechnological contributions to crop adaptation to climate change concern the placement into the crop of one or more genes from an organism with which the crop could not normally breed (i.e. genetically modified crops). Biotechnological tools focus on providing the ability to directly detect and transfer genes of interest from other plant lines or organisms into the crop of interest without the continuing need to use the appearance or stress response of the plant (its phenotype) as a proxy for the presence of that gene.</cpr:P7>
        <schema:description xml:lang="en">Biotechnology for crop adaptation refers to breeding crops for improved performance under environmental stresses involving activities which accumulate favourable alleles (different forms of a gene) and increase stress tolerance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1868 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1868">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">climate-resilient livestock management</rdfs:label>
        <skos:altLabel xml:lang="en">resilient animal husbandry</skos:altLabel>
        <cpr:P7 xml:lang="en">Climate-resilient livestock management refers to activities to adapt livestock farming to climate change.</cpr:P7>
        <schema:description xml:lang="en">Climate-resilient livestock management refers to activities to adapt livestock farming to climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1869 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1869">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">land management training</rdfs:label>
        <skos:altLabel xml:lang="en">land management education</skos:altLabel>
        <schema:description xml:lang="en">Training and education for farmers and agricultural workers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1870 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1870">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">community-based agricultural extension</rdfs:label>
        <skos:altLabel xml:lang="en">local agricultural extension</skos:altLabel>
        <cpr:P7 xml:lang="en">Agricultural extension describes the services that provide rural people with the access to knowledge and information they need to increase productivity and sustainability of their production systems and improve their quality of life and livelihoods. Recent developments in agricultural policies have re-emphasised the importance of extension services (extensionists are technically qualified individuals who provide outreach services to rural areas). However, models of extension based on government services or private agro-dealers and service providers are not sufficient to meet the needs of farmers in less favoured areas. This is due to a number of factors including the necessity to respond to the specific technological needs of farmer in different agroecological zones, high transaction costs of reaching remote areas; the need for localised crop and livestock management solutions suited to tough environmental conditions, which are often not well understood by extension agents trained for work in high potential areas; and the challenges of finding professional extension specialists willing to live and work in remote, and sometimes insecure areas. The community-based rural agricultural extension model is based on the idea of providing specialised and intensive technical training to 1 or 2 people in a community who then promote a variety of appropriate technologies and provide technical services with occasional support and review from a supporting organisation. This model is demand-based in that the providers of service are contracted directly by farmers’ groups or communities to deliver information and related services that are specified by farmers. These models have generally experienced a high degree of success in terms of discovering or identifying productivity enhancing technologies, which are then widely adopted. They have also been able to do so at relatively low cost.</cpr:P7>
        <schema:description xml:lang="en">Agricultural extension describes the services that provide rural people with the access to knowledge and information they need to increase productivity and sustainability of their production systems and improve their quality of life and livelihoods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1871 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1871">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">forest user group</rdfs:label>
        <skos:altLabel xml:lang="en">forest user executive committee</skos:altLabel>
        <cpr:P7 xml:lang="en">In many countries, forest governance has remained a centralised and top-down process. Policies ignore the role of forests in tribal livelihoods and cultures, violating the overlapping laws protecting the rights of these communities. Premises and procedures for identifying and defining forests are poor, resulting in land use conflicts, unclear boundaries, legal disputes and inappropriate management objectives for lands wrongly classified as ‘forest’. Forest User Groups (FUGs) represent one mechanism for decentralising forest management and increasing community-based responsibility and authority. FUGs are based on the three principles of participation, collective action and long-term sustainability. They are formed through democratic processes whereby local residents are elected as community representatives to work as an autonomous body alongside existing government authorities to manage forest resources and to articulate the needs and priorities of local people. FUG members may receive training in resource management and participate in multi-stakeholder forest management mechanisms, develop land-use plans in line with national forest laws and regulations, and undertake forest patrols and awareness-raising with the aim of curbing illegal activities.</cpr:P7>
        <schema:description xml:lang="en">Forest User Groups (FUGs) are a mechanism for decentralising forest management and increasing community-based responsibility and authority.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1872 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1872">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">farmer field school</rdfs:label>
        <skos:altLabel xml:lang="en">farmer field schools</skos:altLabel>
        <cpr:P7 xml:lang="en">The Farmer Field School (FFS) is a group-based learning process that has been used by a number of governments, NGOs and international agencies originally to promote integrated pest management. The first FFS were designed and managed by the Food and Agriculture Organisation (FAO) in Indonesia in 1989. They were developed in response to perception that small farmers were not managing agrochemical-based agriculture well, particularly pest management through the use of pesticides. Many farmers did not have the resources to use pesticides, and sometimes wrong uses and storage caused the problems of poisoning. Furthermore many pests seemed to rapidly develop resistance to the pesticides. FFSs bring together concepts and methods from agro-ecology, experimental education and community development, as a group-based learning process. Overall, FFSs look to reinforce the understanding of farmers about the ecological processes that affect the production of their crops and animals, through conducting field learning exercises such as field observations, simple experiments and group analysis.The knowledge gained from these activities enables participants to make their own locally-specific decisions about crop management practices. Although FFSs were initiated as a training process for pest control in field crops, the principles have now been adapted to all agricultural production systems from livestock to coffee production.</cpr:P7>
        <schema:description xml:lang="en">The Farmer Field School is a group-based learning process that has been used by a number of governments, NGOs and international agencies originally to promote integrated pest management.</schema:description>
    </owl:Class>
    


