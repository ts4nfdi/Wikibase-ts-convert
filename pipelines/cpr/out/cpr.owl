        <skos:altLabel xml:lang="en">C₂H₃CI₂</skos:altLabel>
        <schema:description xml:lang="en">A volatile, ozone-depleting solvent, once used in industrial cleaning and adhesives.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q919 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q919">
