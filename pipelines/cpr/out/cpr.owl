        <cpr:P7 xml:lang="en">Covers the generation, transmission and distribution of energy, including electricity, gas, steam and air conditioning. This sector supports modern economies by providing power from both traditional fossil fuels and renewable sources, and by managing the infrastructure necessary for centralised and distributed energy supply.</cpr:P7>
        <cpr:P9 xml:lang="en">extreme</cpr:P9>
        <cpr:P9 xml:lang="en">increased</cpr:P9>
        <cpr:P9 xml:lang="en">waves</cpr:P9>
    </rdf:Description>
