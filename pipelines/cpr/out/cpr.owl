    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2541 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2541">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <rdfs:label xml:lang="en">old growth forest protection</rdfs:label>
        <skos:altLabel xml:lang="en">conservation of primary forests, old-growth forests protected, preservation of virgin forests, preserve old-growth, primary forest protection, protect old-growth forests, protect primary forests, protecting old-growth forests, protecting primary forests, protection of old-growth, protection of primary forests</skos:altLabel>
        <schema:description xml:lang="en">Old-growth forest protection consists of measures to preserve ancient, undisturbed woodlands and their complex ecosystems in order to maintain their substantial carbon stocks and capacity for long-term carbon storage.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2546 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2546">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <rdfs:label xml:lang="en">forest fire management</rdfs:label>
        <skos:altLabel xml:lang="en">control of forest fire, forest fire control, forest fire prevention, prevention of forest fires, manage forest fires, managing forest fires, prevent forest fires, preventing forest fires, controlling forest fires, forest fires management, control forest fire, control forest fires, control of forest fires, extinction of forest fires, extinguish forest fires, extinguishing forest fires, fight forest fire, fight forest fires, fighting forest fires, forest fire extinction, forest fires control, manage forest fire, management of forest fire, management of forest fires, prevent forest fire, preventing forest fire, prevention of forest fire, suppressing forest fires, suppression of forest fires, forest fire fighting, forest fire protection, forest fire response, forest fires prevention, forest fires protection, protect against forest fires, protection against forest fire, protection against forest fires, protection from forest fires, respond to forest fire, respond to forest fires, response to forest fire, response to forest fires, handling of forest fires, combat against forest fires, combat forest fires, fight against forest fires, reduce forest fire, reduce forest fires, reduced forest fire, reduction of forest fires</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2555 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2555">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <rdfs:label xml:lang="en">synthetic fertiliser emissions</rdfs:label>
        <skos:altLabel xml:lang="en">emission from synthetic fertilizer, emission from synthetic fertilizers, emissions from application of commercial fertilisers, emissions from application of synthetic fertilizers, emissions from inorganic fertilisers, emissions from inorganic fertilizer, emissions from inorganic fertilizers, emissions from inorganic N fertiliser, emissions from inorganic N fertilisers, emissions from inorganic N fertilizer, emissions from inorganic N fertilizers, emissions from inorganic nitrogen fertilisers, emissions from synthetic fertiliser, emissions from synthetic fertilisers, emissions from synthetic fertilizer, emissions from synthetic fertilizers, emissions from synthetic nitrogen fertilizer, emissions from synthetic nitrogen fertilizers, emissions from use of synthetic fertilizers, synthetic fertilisers emissions, synthetic fertilizer emissions, synthetic fertilizers emissions, emissions from inorganic nitrogen fertilizers, emissions from mineral fertiliser</skos:altLabel>
        <cpr:P7 xml:lang="en">Synthetic fertilisers contribute to greenhouse gas emissions during both their production and application. They are manufactured through energy-intensive processes that rely heavily on fossil fuels. When nitrogen fertilisers are applied to soil, some of the nitrogen is absorbed by plants, while some is processed by soil microorganisms, which release nitrous oxide (N₂O) as a by-product of their metabolic processes. Synthetic nitrogen fertilisers are estimated to account for approximately 2.1% of global emissions.</cpr:P7>
        <schema:description xml:lang="en">Synthetic fertilisers contribute to greenhouse gas emissions during both their production and application. They are manufactured through energy-intensive processes that rely heavily on fossil fuels and their field application releases nitrous oxide.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2556 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2556">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2508"/>
        <rdfs:label xml:lang="en">hydropower plant</rdfs:label>
        <skos:altLabel xml:lang="en">hydroelectricity plant, hydroelectric plant, hydroelectric plants, hydroelectric power plant, hydroelectric power plants, hydroelectricity plants, hydroelectricity power plant, hydroelectricity power plants, hydropower plants, hydropower power plant, hydropower power plants</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2565 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2565">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q362"/>
        <rdfs:label xml:lang="en">rotational grazing</rdfs:label>
        <skos:altLabel xml:lang="en">rotation grazing, grazing rotation, grazing rotations, rotational livestock grazing, pasture rotations, rotational pasture, rotational pasturing</skos:altLabel>
        <cpr:P7 xml:lang="en">A rotational grazing system comprises a series of pastures that are used at various times, on a rotational basis, based on weather and forage availability. Consequently, each of the pastures is at a different stage of growth compared to its counterparts. Periods of rest and regrowth are critical in allowing pasture species time to build energy stores and root reserves.</cpr:P7>
        <schema:description xml:lang="en">A rotational grazing system comprises a series of pastures that are used at various times, on a rotational basis, based on weather and forage availability.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2566 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2566">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q362"/>
        <rdfs:label xml:lang="en">stocking rate</rdfs:label>
        <skos:altLabel xml:lang="en">stocking rates, livestock unit, livestock units, maximum stocking density</skos:altLabel>
        <cpr:P7 xml:lang="en">A stocking rate is the amount of grazing animals allocated to a certain area of land. It is typically expressed in animals per hectare (livestock units per hectare) and applies mainly to cattle. A correct stocking rate will achieve high, long-term farm profitability.</cpr:P7>
        <schema:description xml:lang="en">A stocking rate is the amount of grazing animals allocated to a certain area of land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2578 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2578">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q144"/>
        <rdfs:label xml:lang="en">hydroponics</rdfs:label>
        <skos:altLabel xml:lang="en">hydroponic, hydro-culture, hydroculture</skos:altLabel>
        <cpr:P7 xml:lang="en">Hydroponic cultures use water-based nutrient solutions or granulate substrates, which include peat moss, charcoal, gravel, rock wool, perlite, coco peat, and coconut coir. Main advantages of hydroponics are optimization of resources, recycling and reutilization of nutrient solutions, high yields, and reduction of the risk of soil-borne pests and diseases.</cpr:P7>
        <schema:description xml:lang="en">Hydroponics is the practice of growing plants in a nutrient-rich water solution or inert substrate instead of soil.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2579 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2579">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1952"/>
        <rdfs:label xml:lang="en">food waste reduction and management</rdfs:label>
        <skos:altLabel xml:lang="en">reduce food waste, food waste reduction, reducing food waste, food waste prevention, food waste management, food waste reduced, manage food waste, management of food waste, managing food waste, minimise food waste, minimising food waste, minimize food waste, minimizing food waste, reduced food waste, reducing food wastage, reduction of food wastage, reduction of food waste, reduce food wastage, prevent food wastage, prevent food waste, prevention of food waste, stop food waste, limit food waste, food loss reduction, minimise food loss, minimise food losses, minimize food loss, minimize food losses, reduce food loss, reduce food losses, reduced food loss, reduced food losses, reducing food loss, reducing food losses, reduction of food loss, reduction of food losses</skos:altLabel>
        <cpr:P7 xml:lang="en">Reducing food loss and waste with efficient management practices at the distribution, retail and consumption levels. Measure mainly involve efficient technologies for quality preservation, optimization of transport and supply chains, and awareness-raising.</cpr:P7>
        <schema:description xml:lang="en">Reducing food loss and waste with efficient management practices at the distribution, retail and consumption levels.</schema:description>
    </owl:Class>
    


