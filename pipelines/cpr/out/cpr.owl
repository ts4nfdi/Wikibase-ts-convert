    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2662 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2662">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <rdfs:label xml:lang="en">grassland, shrubland and savanna fire management</rdfs:label>
        <skos:altLabel xml:lang="en">grassland fire management, savanna fire management, shrubland fire management, grassland fire fighting, grassland fire prevention, handling of grassland fires, savannah fire management</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2663 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2663">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <rdfs:label xml:lang="en">peatland fire management</rdfs:label>
        <skos:altLabel xml:lang="en">extinguish fires in peatlands, peatland fire prediction, peatland fire prevention, peatland fire protection, reduce fires in peatlands</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2665 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2665">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1305"/>
        <rdfs:label xml:lang="en">fixed feed-in-premium</rdfs:label>
        <skos:altLabel xml:lang="en">fixed FiP</skos:altLabel>
        <schema:description xml:lang="en">Under a fixed Feed-In-Premium scheme, the Renewable Energy Sources plant operator receives a fixed support payment on top of the remuneration obtained from selling the produced electricity on the market.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2666 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2666">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1305"/>
        <rdfs:label xml:lang="en">sliding feed-in-premium</rdfs:label>
        <skos:altLabel xml:lang="en">sliding FiP</skos:altLabel>
        <schema:description xml:lang="en">Under a sliding FIP scheme, the support paid to an awarded project will consist of the difference between the winning price and a reference electricity price. The reference electricity price is usually defined as the average electricity market value of plants in the same technology category over a given period</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2667 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2667">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1855"/>
        <rdfs:label xml:lang="en">silvopasture</rdfs:label>
        <skos:altLabel xml:lang="en">silvo-pastoral, silvo-pasture, agrosilvo-pastoral, agrosilvopastoral, agrosilvopasture, livestock in forest, livestock in forests, silvopastoral, silvopastures, wood pasture, wood pastures, woodland grazing, silvi-pasture, silvipasture</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q362"/>
        <cpr:P7 xml:lang="en">Silvopasture is a category of agroforestry in which trees are integrated with grazing animals to create a managed woodland pasture. There are two ways to achieve a silvopasture, either by planting trees in a pasture or by thinning a forest enough to establish pasture plants.  The aim is to secure the benefits that trees bring but to manage them so they do not over-shade the pasture. In typical silvopastural systems, the trees are productive; either producing and timber crop or a fruit or nut harvest. Benefits include improvements in soil health and animal welfare.</cpr:P7>
        <schema:description xml:lang="en">Silvopasture is a category of agroforestry in which trees are integrated with grazing animals to create a managed woodland pasture.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2668 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2668">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <rdfs:label xml:lang="en">Contracts for Difference</rdfs:label>
        <skos:altLabel xml:lang="en">CfD, contract for difference</skos:altLabel>
        <schema:description xml:lang="en">A CfD is a long-term contract between a renewable energy generator and a government or financial counterparty that stabilizes revenue by fixing the price of electricity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2669 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2669">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <rdfs:label xml:lang="en">feed in tariff technology specific</rdfs:label>
        <skos:altLabel xml:lang="en">FiTT</skos:altLabel>
        <schema:description xml:lang="en">Same as feed in tariff, but a technology specific policy (generally, a higher support payment for Offshore Wind Power was necessary than for other renewables, like onshore wind power or solar).</schema:description>
    </owl:Class>
    


