        <rdfs:label xml:lang="en">public procurement of food</rdfs:label>
        <skos:altLabel xml:lang="en">public procurement of nutritional</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1958 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1958">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">providing space for river flooding</rdfs:label>
        <skos:altLabel xml:lang="en">providing space for riverine flooding, room for the river</skos:altLabel>
        <cpr:P7 xml:lang="en">Managing higher water levels in rivers by restoring the river’s natural flood plain in places where it is least harmful in order to protect those areas that need to be defended. Actions can include  lowering the levels of flood plains, creating water buffers, relocating levees, increasing the depth of side channels, and the construction of flood bypasses.</cpr:P7>
        <schema:description xml:lang="en">Managing higher water levels in rivers by restoring the river’s natural flood plain in places where it is least harmful in order to protect those areas that need to be defended.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1959 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1959">
