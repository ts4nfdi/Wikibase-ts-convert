        <rdfs:label xml:lang="en">private healthcare sector</rdfs:label>
        <skos:altLabel xml:lang="en">commercial healthcare sector, private health industry, private health service, private health services, private healthcare system, private medical sector, privatised medical services, private health system</skos:altLabel>
        <schema:description xml:lang="en">The segment of the healthcare system provided by private actors. Includes services through private hospitals, clinics, and practitioners</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1651 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1651">
        <rdfs:label xml:lang="en">target</rdfs:label>
        <cpr:P20 xml:lang="en">72tmt7zm</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <cpr:P7 xml:lang="en">A target satisfies three criteria: it (1) contains an aim to achieve a specific outcome, (2) is quantifiable, and (3) has been given a deadline.</cpr:P7>
        <schema:description xml:lang="en">An aim to achieve a quantifiable outcome within a given time-frame, set by an institution such as a national government.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1652 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1652">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1651"/>
        <rdfs:label xml:lang="en">emissions reduction target</rdfs:label>
        <skos:altLabel xml:lang="en">reduction target, GHG reduction target, greenhouse gas reduction target</skos:altLabel>
        <cpr:P20 xml:lang="en">t2gvekg3</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q221"/>
        <cpr:P7 xml:lang="en">A specific type of target: a claim by an institution that refers to a reduction in greenhouse gas emissions by a certain point in time. This can be an absolute (e.g. tonnes of CO₂-eq) or relative reduction (e.g. against business as usual) in any type of greenhouse gas emissions or emission intensity (e.g. CO₂ per capita).</cpr:P7>
        <schema:description xml:lang="en">A target to reduce the prevalence of a greenhouse gas over a specific time frame</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1653 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1653">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1652"/>
        <rdfs:label xml:lang="en">net-zero target</rdfs:label>
        <skos:altLabel xml:lang="en">NZT, net zero target</skos:altLabel>
        <cpr:P20 xml:lang="en">2h5qv7ee</cpr:P20>
        <cpr:P7 xml:lang="en">A specific type of emissions reduction target: a claim by an institution to bring its greenhouse gas emissions balance down to zero by a certain point in time. Balance here refers to difference between greenhouse gas emissions and greenhouse gas uptake, for example by carbon capture or by sequestering carbon through reforestation. These targets can be economy-wide or sectoral.</cpr:P7>
        <schema:description xml:lang="en">A commitment to balance GHG emissions with removal by a certain point in time, effectively reducing the net emissions to zero</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1654 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1654">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1395"/>
        <rdfs:label xml:lang="en">sustainable building code and standard</rdfs:label>
        <skos:altLabel xml:lang="en">green building code and standards, green building codes, sustainable building codes, LEED, green construction code, sustainable building code and standards, sustainable construction standards, BREEAM, EDGE certification, Passive House, Passivhaus</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1480"/>
        <cpr:P7 xml:lang="en">The green building codes establish minimum requirements for sustainable design, construction, and operation of buildings.</cpr:P7>
        <schema:description xml:lang="en">The green building codes establish minimum requirements for sustainable design, construction, and operation of buildings.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1655 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1655">
