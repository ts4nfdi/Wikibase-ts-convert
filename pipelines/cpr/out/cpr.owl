    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1980 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1980">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <rdfs:label xml:lang="en">community-based adaptation</rdfs:label>
        <skos:altLabel xml:lang="en">locally led adaptation, community based adaptation, locally-led adaptation, adaptive community response, adaptive community responses, building local resilience, community climate adaptation, enhance local adaptive capacity, enhancing local adaptive capacity, enhanced local adaptive capacity</skos:altLabel>
        <cpr:P7 xml:lang="en">Community-based adaptation is a participatory approach that puts local people front and centre in climate and development action. Key features of community-based adaptation include the involvement of communities in decision-making processes to ensure adaptation strategies reflect their needs and priorities, combining local/traditional knowledge with scientific data to develop comprehensive adaptation solutions, and strengthening communities’ ability to anticipate, plan for and respond to climate-related challenges.</cpr:P7>
        <schema:description xml:lang="en">Community-based adaptation is a participatory approach that puts local people front and centre in climate and development action.</schema:description>
    </owl:Class>
    


