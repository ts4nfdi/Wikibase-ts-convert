        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q738"/>
        <cpr:P7 xml:lang="en">Shale gas is extracted from shale rock using fracking, or hydraulic fracturing, of the rock</cpr:P7>
        <schema:description xml:lang="en">Shale gas is extracted from shale rock using fracking, or hydraulic fracturing, of the rock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q738 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q738">
