        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q650"/>
        <schema:description xml:lang="en">Gas flaring is the burning of the natural gas associated with oil extraction</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q672 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q672">
        <rdfs:label xml:lang="en">impacted group</rdfs:label>
        <skos:altLabel xml:lang="en">vulnerable community, vulnerable groups, vulnerable people, vulnerable peoples, vulnerable person, people in a vulnerable situation, disproportionally impacted group, disproportionally impacted people, disproportinally impacted community, impacted groups, front line communities, front line community, front line group, front line groups, frontline communities, frontline community, frontline group, frontline groups, most affected community, most affected group, most affected people, most-affect groups, most-affected community, most-affected people, fenceline communities, fenceline community</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P7 xml:lang="en">Groups  of people who are adversely affected by climate change or the response to it. This can be because of social, cultural, or other marginalisation, physical susceptibility, a limited ability to respond, or because of the close links between climate and their livelihoods.</cpr:P7>
        <schema:description xml:lang="en">Groups  of people who are adversely affected by climate change or the response to it</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q676 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q676">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <rdfs:label xml:lang="en">marginalized ethnicity</rdfs:label>
        <skos:altLabel xml:lang="en">ethnic group, ethnic groups, racialized, roma, cultural miniority, cultural minorities, sinti, BAME, BIPOC, non-white, non white, communities of color, community of color, ethnic minority, man of color, men of color, people of color, African diaspora, discrimination based on race, minority ethnic, minority ethnicity, race based discrimination, race-based discrimination, racial discrimination, black child, black children, black communities, black community, black household, black households, black man, black men, black neighborhood, black people, black person, brown child, brown children, brown communities, brown community, brown household, brown households, brown man, brown men, brown neighborhood, brown people, brown person, descendants of enslaved people, descendants of enslaved peoples, formerly enslaved, afro-descendant, ethnic communities, ethnic community, ethnic minorities, afro-american, afro-americans, afro-colombian, afro-colombians, people of African descent</skos:altLabel>
        <cpr:P20 xml:lang="en">4cm2qzvf</cpr:P20>
        <cpr:P7 xml:lang="en">people with different national or cultural traditions from the main population. In practice, this is also used to describe those who face discrimination or exclusion based on the color of their skin.</cpr:P7>
        <schema:description xml:lang="en">People with different national or cultural traditions from the dominant population</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q68 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q68">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">decent work</rdfs:label>
        <skos:altLabel xml:lang="en">decent jobs, high-quality jobs, quality jobs, fair wages, good jobs, secure workplace, security in the workplace, dignified job, dignified jobs, fair working conditions</skos:altLabel>
        <cpr:P20 xml:lang="en">er4eynwx</cpr:P20>
        <cpr:P7 xml:lang="en">Work that is productive and delivers a fair income, security in the workplace and social protection for all, better prospects for personal development and social integration, freedom for people to express their concerns, organize and participate in the decisions that affect their lives and equality of opportunity.</cpr:P7>
        <schema:description xml:lang="en">Work that is productive and delivers a fair income, security in the workplace and social protection for all, better prospects for personal development and social integration, freedom for people to express their concerns, organize and participate in the decisions that affect their lives and equality of opportunity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q683 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q683">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:label xml:lang="en">low income people</rdfs:label>
        <skos:altLabel xml:lang="en">low-income, low income, poor people, below the poverty line, living in poverty, cash poor, cash-poor, lowest income, lowest incomes, poor children, poor communities, poor community, poor household, poor households, poor men, poor women, poorest children, poorest communities, poorest households, poorest men, poorest women, living in extreme poverty, experiencing extreme poverty, disadvantaged due to poverty, poorest people</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1019"/>
        <cpr:P7 xml:lang="en">People who have little or no financial income. This generally negatively affects their ability to respond to the effects of climate change. The lack of income may intersect with other factors, such as marginalisation and historical oppression, to create intersectional impacts which strengthen each other.</cpr:P7>
        <cpr:P9 xml:lang="en">low income countries</cpr:P9>
        <cpr:P9 xml:lang="en">low income country</cpr:P9>
        <cpr:P9 xml:lang="en">low-income countries</cpr:P9>
        <cpr:P9 xml:lang="en">low-income country</cpr:P9>
        <cpr:P9 xml:lang="en">lowest income countries</cpr:P9>
        <schema:description xml:lang="en">People who have little or no financial income</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q684 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q684">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q676"/>
        <rdfs:label xml:lang="en">indigenous people</rdfs:label>
        <skos:altLabel xml:lang="en">aboriginal, indigenous people, local communities, adivasi, first nation, first nations, inuit, janajati, maori, native american, native community, native people, native peoples, sámi, tribal, tribe, indigenous communities, indigenous community, indigenous group, indigenous groups, indigenous men, indigenous peoples, indigenous women, native communities, native groups, native men, native women, ancestral, first-nation, first-nations, indigenous child, indigenous children, native child, native children, tribes, traditional community, traditional population, torre strait islander, torres strait islanders, IPLC, IPLCs, indigenous leader, indigenous leaders, Miwaguno, Waorani, Kaiapô, Munduruku, Panaru, Yanomami, Keha peoples, Mohana peoples, traditional knowledge, traditional communities</skos:altLabel>
        <cpr:P20 xml:lang="en">9adt36v3</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1602"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q172"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1747"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1758"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2001"/>
        <cpr:P7 xml:lang="en">In line with United Nations Permanent Forum on Indigenous Issues, we believe it is better not to delineate an exact definition of Indigenous groups exactly -- instead, Indigenous people should be able to self-identify. In most cases, this refers to social and cultural groups that share collective ancestral ties to the lands and natural resources where they live, occupy or from which they have been displaced, and which consider themselves distinct from other sectors of the societies now prevailing on those lands; however, this is not exhaustive.</cpr:P7>
        <schema:description xml:lang="en">Social and cultural groups that share collective ancestral ties to the lands and natural resources where they live, occupy or from which they have been displaced</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q69 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q69">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <rdfs:label xml:lang="en">green jobs</rdfs:label>
        <skos:altLabel xml:lang="en">green job, eco-friendly jobs, sustainability jobs, sustainable jobs, sustainable skilled jobs, eco-friendly job, sustainable job, sustainable skilled job, jobs for the new economy</skos:altLabel>
        <cpr:P20 xml:lang="en">wt3mgbj4</cpr:P20>
        <cpr:P7 xml:lang="en">Jobs that contribute to preserving or restoring the environment. We include jobs which require a high amount of green skills or which spend much of their time on green activities, as well as jobs transforming polluting industries.</cpr:P7>
        <schema:description xml:lang="en">Jobs that contribute to preserving or restoring the environment. We include jobs which require a high amount of green skills or which spend much of their time on green activities, as well as jobs transforming polluting industries.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q690 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q690">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1172"/>
        <rdfs:label xml:lang="en">people with health conditions</rdfs:label>
        <skos:altLabel xml:lang="en">disabilities, chronic illness, disabled, impaired mobility, limited mobility, mental health condition, mental health conditions, mentally unwell, PwDs, accessibility issues, chronic health, chronic physical health, differently abled, disability, handicaped, ill health, pre-existing health condition, pre-existing health conditions, health problem, health problems, mental disorder, anxiety disorder, anxiety disorders, child with special needs, children with special needs, mood disorder, mood disorders, people with special needs, persons with special needs, substance abuse, substance use, those with special needs, mental suffering, physical suffering, living in a care home, living in care homes, hearing loss, vision loss, person with disabilities</skos:altLabel>
        <cpr:P20 xml:lang="en">eq9x9wsr</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1021"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1567"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1601"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1645"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P7 xml:lang="en">People whose health, both mental and physical, makes them more vulnerable to the effects of climate change. This can be due disruptions to their medical care during weather emergencies. In addition, alerts and instructions may not be accessible for people with certain disabilities, such as hearing loss, vision loss, or some cognitive disabilities. People with limited mobility may also have a harder time getting to safety or accessing medical care or adaptive measures such as storm shelters.</cpr:P7>
        <schema:description xml:lang="en">People whose health, both mental and physical, makes them more vulnerable to the effects of climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q695 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q695">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1172"/>
        <rdfs:label xml:lang="en">youth</rdfs:label>
        <skos:altLabel xml:lang="en">child, children, future generation, future generations, young people, young person, adolescent, school aged, school-aged, young citizens, young persons, young adults, youngster, young adult</skos:altLabel>
        <cpr:P20 xml:lang="en">7ec8m63y</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1109"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q915"/>
        <cpr:P7 xml:lang="en">There is no universally agreed-upon definition of youth -- within the United Nations, generally this means under 25, but various UN agencies have adopted other age limits and the UNFCCC Youth constituency (YOUNGO) even goes as high as 35. We use people under 30, which is commonly used in various governments, but recognise that in certain contexts, the exact age range might be different.</cpr:P7>
        <cpr:P9 xml:lang="en">child project</cpr:P9>
        <cpr:P9 xml:lang="en">el nino</cpr:P9>
        <cpr:P9 xml:lang="en">el niño</cpr:P9>
        <cpr:P9 xml:lang="en">la nina</cpr:P9>
        <cpr:P9 xml:lang="en">la niña</cpr:P9>
        <schema:description xml:lang="en">People under the age of 30</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q701 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q701">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <rdfs:label xml:lang="en">people on the move</rdfs:label>
        <skos:altLabel xml:lang="en">immigrant, migrant, migrants, asylum seeker, asylum seekers, displaced groups, displaced people, immigrants, internally displaced, refugee, refugees, illegal alien, illegal aliens, non-citizen, non-citizens, undocumented people, undocumented person, undocumented persons, undocumented worker, undocumented workers, IDP, IDPs, person of concern, persons of concern, relocated communities, relocated community, returnees, stateless person, stateless persons, statelessness, human trafficking, communities displaced, community displaced, people displaced, displaced individuals, non-voluntary human mobility, displaced communities, displaced community, the displaced, climate related displacement, climate-related displacement, displaced person, displaced persons, internally displaced persons, living in camps</skos:altLabel>
        <cpr:P20 xml:lang="en">nyutpxgp</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1561"/>
        <cpr:P7 xml:lang="en">People who have left their homes, whether through force, voluntarily, or a mixture of both.</cpr:P7>
        <cpr:P9 xml:lang="en">convention related to the status of refugees</cpr:P9>
        <cpr:P9 xml:lang="en">displaced capacity</cpr:P9>
        <cpr:P9 xml:lang="en">displaced grid</cpr:P9>
        <cpr:P9 xml:lang="en">displaced labor</cpr:P9>
        <cpr:P9 xml:lang="en">displaced labour</cpr:P9>
        <cpr:P9 xml:lang="en">migrant species</cpr:P9>
        <cpr:P9 xml:lang="en">refugee agencies</cpr:P9>
        <cpr:P9 xml:lang="en">refugee agency</cpr:P9>
        <cpr:P9 xml:lang="en">refugee convention</cpr:P9>
        <cpr:P9 xml:lang="en">refugee law</cpr:P9>
        <schema:description xml:lang="en">People who have left their homes, whether through force, voluntarily, or a mixture of both</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q704 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q704">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <rdfs:label xml:lang="en">women and minority genders</rdfs:label>
        <skos:altLabel xml:lang="en">gender, woman, women, female, intimate partner, mother, pregnant, femicide, gender-based, females, femme, female genital mutilation, FGM, gender gap, gender expression, gender identity</skos:altLabel>
