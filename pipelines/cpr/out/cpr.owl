    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1418 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1418">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1284"/>
