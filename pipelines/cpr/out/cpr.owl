    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q132 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q132">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1853"/>
        <rdfs:label xml:lang="en">reduced impact logging</rdfs:label>
        <skos:altLabel xml:lang="en">logging with reduced impact</skos:altLabel>
        <skos:altLabel xml:lang="en">low-impact logging</skos:altLabel>
        <skos:altLabel xml:lang="en">reduce impact of logging</skos:altLabel>
        <skos:altLabel xml:lang="en">reduced-impact logging</skos:altLabel>
        <skos:altLabel xml:lang="en">reducing impact of logging</skos:altLabel>
        <skos:altLabel xml:lang="en">responsible logging</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable logging</skos:altLabel>
        <skos:altLabel xml:lang="en">sustainable logging practices</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P7 xml:lang="en">Logging techniques that result in significantly less damage to the surrounding forest and forest ecosystem. Examples of reduced impact logging include directional felling, trimming of inter-crown vines, and careful road planning. Reduced impact logging helps to maintain forest ecosystem integrity and resilience to climate change.</cpr:P7>
        <schema:description xml:lang="en">Logging techniques that result in significantly less damage to the surrounding forest and forest ecosystem. Examples of reduced impact logging include directional felling, trimming of inter-crown vines, and careful road planning.</schema:description>
    </owl:Class>
    


