    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q128 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q128">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1892"/>
        <rdfs:label xml:lang="en">artificial reef</rdfs:label>
        <skos:altLabel xml:lang="en">artificial reefs</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <schema:description xml:lang="en">Artificial reefs have been constructed from discarded human-made materials, such as tires, concrete blocks, or even old subway cars, in areas of oceans where reefs have been depleted. Organisms such as algae and barnacles then attach to these surfaces and lay the ecological groundwork for a reef to bloom.</schema:description>
    </owl:Class>
    


