    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1483">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1244"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1245"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1314"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P4 rdf:resource="https://echa.europa.eu/substance-information/-/substanceinfo/100.028.760"/>
        <cpr:P4 rdf:resource="https://www.iea.org/reports/ammonia-technology-roadmap"/>
        <cpr:P7 xml:lang="en">Ammonia is an inorganic compound of nitrogen and hydrogen, and is a colourless gas. Around 70% of ammonia is used to make fertilisers, with the remainder used for a wide range of industrial applications, such as plastics, explosives and synthetic fibres. Ammonia production accounts for around 2% of total final energy consumption and 1.3% of CO2 emissions from the energy system.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1485">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q765"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1489">
