    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q888 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q888">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1754"/>
        <rdfs:label xml:lang="en">skills recognition</rdfs:label>
        <skos:altLabel xml:lang="en">skill recognition</skos:altLabel>
        <schema:description xml:lang="en">Skills recognition is a process that formally recognises and acknowledgement the skills you have learned from your work, life experiences, or from any previous training.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q889 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q889">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1754"/>
        <rdfs:label xml:lang="en">employable skills</rdfs:label>
        <skos:altLabel xml:lang="en">enhanced employability</skos:altLabel>
        <skos:altLabel xml:lang="en">job training</skos:altLabel>
        <skos:altLabel xml:lang="en">skills for employment</skos:altLabel>
        <skos:altLabel xml:lang="en">soft skills</skos:altLabel>
        <skos:altLabel xml:lang="en">transferable skill</skos:altLabel>
        <skos:altLabel xml:lang="en">transferable skills</skos:altLabel>
        <skos:altLabel xml:lang="en">vocational skills</skos:altLabel>
        <schema:description xml:lang="en">Refer to a set of transferable skills and key personal attributes which are highly valued by employers and essential for effective performance in the workplace.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q89 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q89">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1990"/>
        <rdfs:label xml:lang="en">climate scenario development</rdfs:label>
        <skos:altLabel xml:lang="en">climate scenario development</skos:altLabel>
        <skos:altLabel xml:lang="en">developing climate scenarios</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q93"/>
        <cpr:P4 rdf:resource="https://www.ipcc.ch/site/assets/uploads/2018/03/TAR-13.pdf"/>
        <schema:description xml:lang="en">Climate scenarios often make use of climate projections by manipulating model outputs and combining them with observed climate data. To develop such scenarios various scenario construction methods are used, such as climate model based approaches,temporal and spatial analogues, incremental scenarios for sensitivity studies, and expert judgement.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q891 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q891">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1426"/>
        <rdfs:label xml:lang="en">training system</rdfs:label>
        <skos:altLabel xml:lang="en">training systems</skos:altLabel>
        <schema:description xml:lang="en">A training system is a group or family of coursework that will achieve a stated series of training objectives. A training system typically employs a syllabus or similar document that specifies and outlines the coursework to be followed.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q892 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q892">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1739"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <rdfs:label xml:lang="en">green entrepreneurship</rdfs:label>
        <schema:description xml:lang="en">Green entrepreneurship is a particular subset of entrepreneurship that focuses on developing and putting into practice solutions to environmental issues as well as encouraging social change to prevent ecological damage.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q894 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q894">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:label xml:lang="en">informal workers</rdfs:label>
        <skos:altLabel xml:lang="en">day laborer</skos:altLabel>
        <skos:altLabel xml:lang="en">day laborers</skos:altLabel>
        <skos:altLabel xml:lang="en">informal worker</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P7 xml:lang="en">All economic activities by workers and economic units that are, in law or practice, not covered or are insufficiently covered by formal arrangements is counted as informal work. For workers themselves, this means they lack adequate labor and social protection. This definition excludes illicit activities.</cpr:P7>
        <schema:description xml:lang="en">Informal workers do not have secure employment contracts, workers&apos; benefits, social protection or workers&apos; representation</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q896 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q896">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q68"/>
        <rdfs:label xml:lang="en">labor market information</rdfs:label>
        <skos:altLabel xml:lang="en">LMI</skos:altLabel>
        <skos:altLabel xml:lang="en">labor markets information</skos:altLabel>
        <schema:description xml:lang="en">Labour market information is any information that assists people in making informed decisions about the labour market.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q897 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q897">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1426"/>
        <rdfs:label xml:lang="en">peer learning</rdfs:label>
        <skos:altLabel xml:lang="en">learning from peers</skos:altLabel>
        <skos:altLabel xml:lang="en">peer-to-peer learning</skos:altLabel>
        <schema:description xml:lang="en">Peer learning is essentially the act of learning with and from your colleagues, fellow students or peers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q899 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q899">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1754"/>
        <rdfs:label xml:lang="en">skills needs assessment</rdfs:label>
        <skos:altLabel xml:lang="en">skills needs anticipation</skos:altLabel>
        <skos:altLabel xml:lang="en">skills needs anticipations</skos:altLabel>
        <skos:altLabel xml:lang="en">skills needs assessments</skos:altLabel>
        <schema:description xml:lang="en">Activities to assess future skills needs in the labour market in a strategic way, using consistent and systematic methods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q90 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q90">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1990"/>
        <rdfs:label xml:lang="en">drought forecasting system</rdfs:label>
        <skos:altLabel xml:lang="en">drought forecast</skos:altLabel>
        <skos:altLabel xml:lang="en">drought forecast system</skos:altLabel>
        <skos:altLabel xml:lang="en">drought forecasting</skos:altLabel>
        <skos:altLabel xml:lang="en">drought forecasting systems</skos:altLabel>
        <skos:altLabel xml:lang="en">drought forecasts</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/sites/default/files/resources/drought_forecasting_systems.pdf"/>
        <schema:description xml:lang="en">Drought forecasting systems use models fed by climatic and atmospheric data (historical/seasonal weather patterns, real-time meteorological monitoring, and weather forecasts) to predict the probability of a drought occurring in a region or area of interest in the future (up to approximately three months). Drought forecasting systems are an important part of early warning systems, as they provide lead-time to planners for threat responses, which helps minimize drought impact risk.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q900 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q900">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q68"/>
        <rdfs:label xml:lang="en">occupational safety and health</rdfs:label>
        <skos:altLabel xml:lang="en">OHS</skos:altLabel>
        <skos:altLabel xml:lang="en">OSH</skos:altLabel>
        <skos:altLabel xml:lang="en">OSHA</skos:altLabel>
        <skos:altLabel xml:lang="en">occupational health</skos:altLabel>
        <skos:altLabel xml:lang="en">occupational health and safety</skos:altLabel>
        <skos:altLabel xml:lang="en">occupational safety</skos:altLabel>
        <skos:altLabel xml:lang="en">safe work</skos:altLabel>
        <skos:altLabel xml:lang="en">safe workplace</skos:altLabel>
        <schema:description xml:lang="en">The anticipation, recognition, evaluation and control of hazards arising in or from the workplace that could impair the health and well-being of workers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q901 -->


