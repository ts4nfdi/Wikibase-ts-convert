        <cpr:P9 xml:lang="en">gas-to-liquid diesel</cpr:P9>
        <cpr:P9 xml:lang="en">renewable diesel</cpr:P9>
        <schema:description xml:lang="en">Diesel fuel is a combustible liquid used as fuel for diesel engines, ordinarily obtained from fractions of crude oil that are less volatile than the fractions used in gasoline</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q644 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q644">
