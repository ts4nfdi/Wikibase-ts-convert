        <skos:altLabel xml:lang="en">pasture management</skos:altLabel>
        <skos:altLabel xml:lang="en">reduce degradation of pastures</skos:altLabel>
        <skos:altLabel xml:lang="en">reducing the degradation of pasture</skos:altLabel>
        <cpr:P7 xml:lang="en">Pasture management defines actions to improve pasture quality for livestock. Strategies aim to improve grass health and forage production, reduce production costs and maintain a sustainable ecological balance.</cpr:P7>
        <schema:description xml:lang="en">Pasture management defines actions to improve pasture quality for livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q365 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q365">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1868"/>
