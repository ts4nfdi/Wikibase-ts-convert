        <skos:altLabel xml:lang="en">blackouts</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdown in power plant</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdowns in power plants</skos:altLabel>
        <skos:altLabel xml:lang="en">brownout</skos:altLabel>
        <skos:altLabel xml:lang="en">brownouts</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of power lines</skos:altLabel>
        <skos:altLabel xml:lang="en">damage to energy infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">disruption to electricity</skos:altLabel>
        <skos:altLabel xml:lang="en">disruptions to electricity</skos:altLabel>
        <skos:altLabel xml:lang="en">electricity disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">electricity disruptions</skos:altLabel>
        <skos:altLabel xml:lang="en">electricity failures</skos:altLabel>
        <skos:altLabel xml:lang="en">failures in overhead power lines</skos:altLabel>
