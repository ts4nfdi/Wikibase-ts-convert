    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1802 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1802">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1282"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1755"/>
        <rdfs:label xml:lang="en">participatory land use planning</rdfs:label>
        <skos:altLabel xml:lang="en">PLUP</skos:altLabel>
        <skos:altLabel xml:lang="en">participatory land-use planning</skos:altLabel>
        <schema:description xml:lang="en">The systematic assessment of physical, social and economic factors in such a way as to encourage and assist land users in selecting options that increase their productivity, are sustainable, and meet the needs of society.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1803 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1803">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1760"/>
        <rdfs:label xml:lang="en">indigenous peoples plan</rdfs:label>
        <skos:altLabel xml:lang="en">indigenous peoples&apos; plan</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1804"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P7 xml:lang="en">Indigenous Peoples Plan (IPPs) is a measure to approach Indigenous People and guarantee provisions to mitigate or avoid adverse impacts on indigenous groups. The IPP is a management plan that specifies responsibilities, timeframes, budgetary considerations, monitoring and evaluation agreements as well as engagement and mitigation strategies.</cpr:P7>
        <schema:description xml:lang="en">Indigenous Peoples Plan is a document prepared for projects that may impact indigenous populations. It outlines measures to avoid, minimise or compensate for negative impacts. IPP is a tool for ensuring that projects are planned and implemented in a way that respects the rights, cultures, and well-being of indigenous peoples</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1804 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1804">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1760"/>
        <rdfs:label xml:lang="en">indigenous peoples planning</rdfs:label>
        <skos:altLabel xml:lang="en">IPPF</skos:altLabel>
        <skos:altLabel xml:lang="en">indigenous peoples planning framework</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P7 xml:lang="en">Indigenous Peoples Planning Frameworks provide guidance on safeguard screening, assessment, institutional arrangements, and processes to be followed for subprojects or subsequent tranches that are prepared after Board approval.</cpr:P7>
        <schema:description xml:lang="en">Indigenous Peoples Planning Framework (IPPF) is a strategic, high-level document for a development program. It sets out the policies, procedures, and a &quot;roadmap&quot; for how the project will address potential impacts on Indigenous Peoples when the specific locations and activities are not yet known. It serves as a guide for preparing individual Indigenous Peoples Plans (IPPs) later on.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1805 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1805">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">justice agreements</rdfs:label>
        <skos:altLabel xml:lang="en">justice agreement</skos:altLabel>
        <schema:description xml:lang="en">Justice agreements encompass a variety of arrangements that promote fairness and the rule of law, both within specific jurisdictions and regional and international treaties.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1806 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1806">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1805"/>
        <rdfs:label xml:lang="en">ezcazu agreement</rdfs:label>
        <cpr:P7 xml:lang="en">The objective of the Ezcazú Agreement is to guarantee the full and effective implementation in Latin America and the Caribbean of the rights of access to environmental information, public participation in the environmental decision-making process and access to justice in environmental matters, and the creation and strengthening of capacities and cooperation, contributing to the protection of the right of every person of present and future generations to live in a healthy environment and to sustainable development</cpr:P7>
        <schema:description xml:lang="en">The Escazú Agreement is a regional treaty focused on access to information, public participation, and justice in environmental matters in Latin America and the Caribbean</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1807 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1807">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <rdfs:label xml:lang="en">full and prior agreement</rdfs:label>
        <schema:description xml:lang="en">Full and prior agreement is the process of obtaining consent from affected communities before undertaking any project or activity that may impact their rights, lands, resources, or livelihoods</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1809 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1809">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q886"/>
        <rdfs:label xml:lang="en">cash assistance</rdfs:label>
        <skos:altLabel xml:lang="en">cash benefits</skos:altLabel>
        <skos:altLabel xml:lang="en">cash program</skos:altLabel>
        <skos:altLabel xml:lang="en">cash programme</skos:altLabel>
        <skos:altLabel xml:lang="en">cash programmes</skos:altLabel>
        <skos:altLabel xml:lang="en">cash programs</skos:altLabel>
        <skos:altLabel xml:lang="en">cash transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">cash transfers</skos:altLabel>
        <skos:altLabel xml:lang="en">social cash transfer</skos:altLabel>
        <skos:altLabel xml:lang="en">social cash transfer programmes</skos:altLabel>
        <skos:altLabel xml:lang="en">social cash transfer programs</skos:altLabel>
        <skos:altLabel xml:lang="en">social cash transfers</skos:altLabel>
        <cpr:P7 xml:lang="en">Payments of money to people so that they can buy what they need. These programmes are often used in a crisis, but cash assistance programs are also increasingly seen as a simple to implement tool for social protection.</cpr:P7>
        <cpr:P9 xml:lang="en">non-cash benefits</cpr:P9>
        <schema:description xml:lang="en">Payments of money to people so that they can buy what they need</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1810 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1810">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1823"/>
        <rdfs:label xml:lang="en">grievance redress mechanism</rdfs:label>
        <skos:altLabel xml:lang="en">GRM</skos:altLabel>
        <skos:altLabel xml:lang="en">GRMs</skos:altLabel>
        <skos:altLabel xml:lang="en">grievance mechanism</skos:altLabel>
        <skos:altLabel xml:lang="en">grievance mechanisms</skos:altLabel>
        <skos:altLabel xml:lang="en">grievance process</skos:altLabel>
        <skos:altLabel xml:lang="en">redress mechanism</skos:altLabel>
        <skos:altLabel xml:lang="en">redress mechanisms</skos:altLabel>
        <skos:altLabel xml:lang="en">redress process</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1815"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1816"/>
        <cpr:P7 xml:lang="en">GRMs are defined as organizational systems and resources established by national government agencies (or, as appropriate, by regional or municipal agencies) to receive and address concerns about the impact of their policies, programs and operations on external stakeholders. GRMs are intended to be accessible, collaborative, expeditious, and effective in resolving concerns through dialogue, joint fact-finding, negotiation, and problem solving</cpr:P7>
        <schema:description xml:lang="en">Grievance Redress Mechanisms are defined as organizational systems and resources established by national government agencies (or, as appropriate, by regional or municipal agencies) to receive and address concerns about the impact of their policies, programs and operations on external stakeholders.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1811 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1811">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q53"/>
        <rdfs:label xml:lang="en">energy assistance</rdfs:label>
        <skos:altLabel xml:lang="en">energy support</skos:altLabel>
        <skos:altLabel xml:lang="en">fuel assistance</skos:altLabel>
        <skos:altLabel xml:lang="en">heating assistance</skos:altLabel>
        <cpr:P7 xml:lang="en">Energy Assistance, in its most basic sense, is about providing crucial support to individuals and households to afford essential energy services, ensuring their basic needs are met.</cpr:P7>
        <schema:description xml:lang="en">Energy assistance focuses on improving energy efficiency and affordability of energy. This includes initiatives to reduce energy consumption, lower utility costs, and payment and schemes benefits to combat energy poverty</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1812 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1812">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q650"/>
        <rdfs:label xml:lang="en">still gas</rdfs:label>
        <cpr:P7 xml:lang="en">Any form or mixture of gases produced in refineries by distillation, cracking, reforming, and other processes. The principal constituents are methane and ethane. May contain hydrogen and small/trace amounts of other gases. Still gas is typically consumed as refinery fuel or used as petrochemical feedstock. Still gas burned for refinery fuel may differ in composition from marketed still gas sold to other users.</cpr:P7>
        <schema:description xml:lang="en">Any form or mixture of gases produced in refineries by distillation, cracking, reforming, and other processes. The principal constituents are methane and ethane. May contain hydrogen and small/trace amounts of other gases. Still gas is typically consumed as refinery fuel or used as petrochemical feedstock. Still gas burned for refinery fuel may differ in composition from marketed still gas sold to other users.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1813 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1813">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1733"/>
        <rdfs:label xml:lang="en">compliance frameworks</rdfs:label>
        <skos:altLabel xml:lang="en">compliance framework</skos:altLabel>
        <schema:description xml:lang="en">A compliance framework is a structured set of guidelines, policies, and procedures that an actor uses to ensure it adheres to legal, regulatory, internal policies, and ethical standards</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1814 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1814">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1823"/>
        <rdfs:label xml:lang="en">environmental and social management system</rdfs:label>
        <skos:altLabel xml:lang="en">ESMS</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1815"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1816"/>
        <cpr:P7 xml:lang="en">Environmental and Social Management System (ESMS) is a framework that helps organizations integrate environmental and social objectives into their core business operations through a set of clearly defined and repeatable processes. Its main purpose is to identify and manage a project&apos;s potential environmental and social risks and impacts, ensuring compliance with relevant laws, regulations, and international standards.</cpr:P7>
        <schema:description xml:lang="en">Environmental and Social Management System (ESMS) is a framework that helps organizations integrate environmental and social objectives into their core business operations through a set of clearly defined and repeatable processes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1815 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1815">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1823"/>
        <rdfs:label xml:lang="en">environmental and social impact assessment</rdfs:label>
        <skos:altLabel xml:lang="en">ESIA</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1810"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1814"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1816"/>
        <cpr:P7 xml:lang="en">Environmental and Social Impact Assessment (ESIA) predicts the environmental and social consequences that a future project/intervention might entail. It is carried out before project implementation and proposes measures to mitigate potential negative impacts. An ESIA has two aims: 1) to minimise or avoid adverse environmental and social effects before they occur; 2) to integrate environmental and social concerns into decision-making.  ESIA ought to evaluate alternatives, design appropriate mitigation, management and monitoring measures.</cpr:P7>
        <schema:description xml:lang="en">ESIA is a critical tool used to identify, predict, and evaluate the potential environmental and social impacts of a proposed project before it is implemented. It&apos;s a proactive process that helps decision-makers understand the consequences of their actions, evaluate alternatives and find ways to mitigate negative impacts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1816 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1816">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1823"/>
        <rdfs:label xml:lang="en">environmental and social management plan</rdfs:label>
        <skos:altLabel xml:lang="en">ESMP</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental and social management guidelines</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1810"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1814"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1815"/>
        <cpr:P7 xml:lang="en">The Environmental and Social Management Plan (ESMP) consists of the set of mitigation,monitoring and institutional measures to be taken during the design, construction and operation stages of the project to eliminate adverse environmental and social impacts, to offset them, or to reduce them to acceptable levels. The plan also includes the actions needed for the implementation of these measures. The ESMP will establish measures to prevent and mitigate the risks identified in the Environmental and Social Impact Assessment (ESIA)</cpr:P7>
        <schema:description xml:lang="en">The Environmental and Social Management Plan (ESMP) consists of the set of mitigation, monitoring and institutional measures to be taken during the design, construction and operation stages of the project to eliminate adverse environmental and social impacts, to offset them, or to reduce them to acceptable levels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1817 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1817">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q639"/>
        <rdfs:label xml:lang="en">petroleum</rdfs:label>
        <skos:altLabel xml:lang="en">petcoke</skos:altLabel>
        <skos:altLabel xml:lang="en">petroleum coke</skos:altLabel>
        <skos:altLabel xml:lang="en">petroleum oil</skos:altLabel>
        <cpr:P7 xml:lang="en">Petroleum is a broader term encompassing both crude oil (the unrefined, raw form) and refined petroleum products like gasoline and diesel.</cpr:P7>
        <schema:description xml:lang="en">Petroleum is a broader term encompassing both crude oil (the unrefined, raw form) and refined petroleum products like gasoline and diesel.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1818 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1818">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q639"/>
        <rdfs:label xml:lang="en">oil shale</rdfs:label>
        <cpr:P7 xml:lang="en">Oil shale is a sedimentary rock containing kerogen, a solid organic matter. Different from shale oil which is liquid petroleum produced by heating shale oil.</cpr:P7>
        <schema:description xml:lang="en">Oil shale is a sedimentary rock containing kerogen, a solid organic matter. Different from shale oil which is liquid petroleum produced by heating shale oil.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1819 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1819">
