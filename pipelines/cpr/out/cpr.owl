        <rdfs:label xml:lang="en">hard coal</rdfs:label>
        <schema:description xml:lang="en">The highest rank of coal, it is a hard, brittle, and black lustrous coal, containing a high percentage of fixed carbon and a low percentage of volatile matter.</schema:description>
    </owl:Class>
    


