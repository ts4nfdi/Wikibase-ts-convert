        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <rdfs:label xml:lang="en">terrestrial biodiversity loss</rdfs:label>
        <skos:altLabel xml:lang="en">biological diversity damage, biological diversity destruction, biological diversity loss, damage of biological diversity, damage to biological diversity, destruction of biological diversity, destruction to biological diversity, loss of biological diversity, loss to biological diversity, damage to biodiversity, extinction of biodiversity, extinction to biodiversity, loss of biodiversity, species biodiversity, species biodiversity loss, species damage, species damage of biodiversity, species destruction, species extinction, species loss to biodiversity, ecosystem degradation, reduction of habitat complexity, habitat destruction, loss of desert ecosystems, loss of forest ecosystems, loss of grassland ecosystems, loss of taiga ecosystems, loss of terrestrial biodiversity, loss of tropic rainforest ecosystems, loss of tundra ecosystems, reduce biological diversity, degradation of ecosystem, degradation of ecosystems, decrease in the abundance of species</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1033"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
