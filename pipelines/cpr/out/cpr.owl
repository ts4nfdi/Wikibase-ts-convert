    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1842">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1890"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1937"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <cpr:P7 xml:lang="en">Retreat reduces exposure to coastal hazards by moving people, assets and human activities out of the exposed coastal area.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1843">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q115"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q116"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q117"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q118"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q119"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q120"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q121"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q122"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q129"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <cpr:P7 xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1844">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q123"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q124"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q125"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q126"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <cpr:P7 xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</cpr:P7>
    </rdf:Description>
