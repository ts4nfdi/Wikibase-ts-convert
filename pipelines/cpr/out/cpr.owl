    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q137 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q137">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">prescribed fire</rdfs:label>
        <skos:altLabel xml:lang="en">prescribed burning</skos:altLabel>
        <skos:altLabel xml:lang="en">prescribed fire</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q136"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q140"/>
        <cpr:P7 xml:lang="en">Prescribed fire is a form of land management in which fire is intentionally applied to vegetation. Prescribed fires are conducted under desired conditions to meet specific objectives, such as to restore fire regimes in adapted ecosystems or to limit the amount of dry brush in an area prone to wildfires.</cpr:P7>
        <schema:description xml:lang="en">Prescribed fire is a form of land management in which fire is intentionally applied to vegetation. Prescribed fires are conducted under desired conditions to meet specific objectives, such as to restore fire regimes in adapted ecosystems or to limit the amount of dry brush in an area prone to wildfires.</schema:description>
    </owl:Class>
    


