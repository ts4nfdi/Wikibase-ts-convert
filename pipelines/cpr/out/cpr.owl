        <skos:altLabel xml:lang="en">cap-and-trade</skos:altLabel>
        <skos:altLabel xml:lang="en">cap-and-trade program</skos:altLabel>
        <skos:altLabel xml:lang="en">cap-and-trade programme</skos:altLabel>
        <skos:altLabel xml:lang="en">cap-and-trade schemes</skos:altLabel>
