        <cpr:P7 xml:lang="en">a job where a substantial amount of time is spent on green activities, based on an analysis by Nesta</cpr:P7>
        <schema:description xml:lang="en">a job where a substantial amount of time is spent on green activities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1795 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1795">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q69"/>
        <rdfs:label xml:lang="en">green job in high-emitting industry</rdfs:label>
