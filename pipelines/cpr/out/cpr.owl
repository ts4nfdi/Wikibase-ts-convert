        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1633"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1849"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1850"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q229"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q418"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q788"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">Engages in the cultivation of crops and the rearing of livestock for food, fibre and raw materials. This sector is the backbone of food security and rural economies, encompassing activities from arable farming to animal husbandry and horticultural production.</cpr:P7>
        <cpr:P9 xml:lang="en">wind farm</cpr:P9>
        <cpr:P9 xml:lang="en">wind farms</cpr:P9>
        <schema:description xml:lang="en">Activities that involve the cultivation of crops and raising of livestock for food, fibre, and other products essential for human life and industry.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q787 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q787">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">forestry sector</rdfs:label>
        <skos:altLabel xml:lang="en">forest pest, forest industry, forest management, wood industry, forest fire prevention, silviculture, prevention of forest fires, agri-silviculture, replanting, tree nurseries, wood production, forest management sector, forest-based economy, woodland management, forestry management, forestry operation, forest sector</skos:altLabel>
        <cpr:P20 xml:lang="en">esv3cdac</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1033"/>
