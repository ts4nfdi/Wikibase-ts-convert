        <skos:altLabel xml:lang="en">corporate support service</skos:altLabel>
        <skos:altLabel xml:lang="en">facility management</skos:altLabel>
        <skos:altLabel xml:lang="en">management service</skos:altLabel>
        <skos:altLabel xml:lang="en">office support</skos:altLabel>
