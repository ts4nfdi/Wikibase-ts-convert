        <dcterms:description xml:lang="en">The concept store is an internal tool used to structure and manage key concepts in climate policy. It helps power automated concept detection in our datasets. </dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">Climate Policy Radar - concept store</dcterms:title>
        <rdfs:label xml:lang="en">Climate Policy Radar - concept store</rdfs:label>
        <foaf:homepage xml:lang="en">https://www.climatepolicyradar.org/</foaf:homepage>
    </owl:Ontology>
    


