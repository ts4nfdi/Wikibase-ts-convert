        <schema:description xml:lang="en">Country-driven processes that identify and prioritize technologies for climate change adaptation and mitigation as part of the UNFCCC process.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q19 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q19">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <rdfs:label xml:lang="en">reforestation</rdfs:label>
        <skos:altLabel xml:lang="en">forest regeneration, forest restoration, reforestation plan, reforestation program, tree planting, restore forests, restoring forests, forest rehabilitation, forests regeneration, forests rehabilitation, forests restoration, re-afforestation, reafforestation, regeneration of forest, regeneration of forests, rehabilitation of forest, rehabilitation of forests, restoration of forests, restoration of woodlands, reforesting, rehabilitate forest, rehabilitate forests, rehabilitated forest, rehabilitated forests, rehabilitating forests, restore forest, restoring forest, reverse forest degradation, restoration of damaged forests, restoration of degraded forest, restoration of degraded forests, restore degraded forest, restore degraded forests, restoring damaged forests, restoring degraded forest, restoring degraded forests, planting of native tree species, planting of native trees, planting trees, increase total forest cover</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q17"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q18"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q21"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q23"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P7 xml:lang="en">Reforestation is the direct human-induced conversion of non-forested land to forested land through planting, seeding and/or the human-induced promotion of natural seed sources, on land that was forested but that has been converted to non-forested land. Reforestation can help forests to adapt to climate change by decreasing human pressures (for example by reducing the destruction or degradation of habitats) and enhancing landscape connectivity and reducing fragmentation (thus facilitating species migration under climate change conditions). Reforestation may also contribute to preserve biodiversity hotspots, avoiding soil degradation and protecting other natural resources (e.g. water).</cpr:P7>
        <schema:description xml:lang="en">Reforestation refers to the natural or human-induced restocking of existing forests and woodlands that have been depleted.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1900 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1900">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1839"/>
        <rdfs:label xml:lang="en">quantitative insurance loss model</rdfs:label>
        <skos:altLabel xml:lang="en">quantitative insurance loss, quantifying insurance loss</skos:altLabel>
        <schema:description xml:lang="en">Process of measuring potential losses in monetary terms to inform risk management and insurance strategy decisions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1901 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1901">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1953"/>
        <rdfs:label xml:lang="en">livelihood diversification</rdfs:label>
        <skos:altLabel xml:lang="en">diversifying livelihoods, climate-resilient livelihoods, households with increased income, diversify farmers&apos; livelihoods, diversifying farmers&apos; livelihoods, diversifying fishers&apos; livelihoods, livelihoods diversification, diversify fishers&apos; livelihoods, diversifying farmers&apos; incomes, diversifying fishers&apos; incomes, diversifying incomes, income diversification</skos:altLabel>
        <schema:description xml:lang="en">The process where households or individuals adopt a mix of different economic activities and social support capabilities to improve their standard of living and reduce vulnerability to shocks like low agricultural income or natural disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1902 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1902">
