        <skos:altLabel xml:lang="en">restore degraded land</skos:altLabel>
        <skos:altLabel xml:lang="en">restore degraded lands</skos:altLabel>
        <skos:altLabel xml:lang="en">restore landscapes</skos:altLabel>
        <skos:altLabel xml:lang="en">restored degraded areas</skos:altLabel>
