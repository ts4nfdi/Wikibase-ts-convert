    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q251">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q732"/>
        <cpr:P7 xml:lang="en">Nitrogen trifluoride has an atmospheric lifetime of approximately 550 years. It&apos;s used in electronics manufacturing for etching, cleaning, and other processes due to its stability and ease of use</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2510">
