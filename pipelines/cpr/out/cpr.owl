    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q276">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q253"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q260"/>
