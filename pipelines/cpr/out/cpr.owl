        <skos:altLabel xml:lang="en">power cut</skos:altLabel>
        <skos:altLabel xml:lang="en">power cuts</skos:altLabel>
        <skos:altLabel xml:lang="en">power lines collapsed</skos:altLabel>
        <skos:altLabel xml:lang="en">power loss</skos:altLabel>
        <skos:altLabel xml:lang="en">power losses</skos:altLabel>
        <schema:description xml:lang="en">A loss of power for a short period of time, often caused by technological failure and extreme weather events</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1079 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1079">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">submarine landslide</rdfs:label>
        <skos:altLabel xml:lang="en">submarine landslides</skos:altLabel>
        <skos:altLabel xml:lang="en">turbidity current</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q408"/>
        <schema:description xml:lang="en">A submarine landslide is a downslope movement of sediment or rock under the effect of gravity, which occurs when the stresses acting downslope exceed the available strength of the sediment on the slope.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q108 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q108">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">river restoration</rdfs:label>
        <skos:altLabel xml:lang="en">restoration of river</skos:altLabel>
        <skos:altLabel xml:lang="en">restore river</skos:altLabel>
        <skos:altLabel xml:lang="en">restoring river</skos:altLabel>
        <skos:altLabel xml:lang="en">river restoration</skos:altLabel>
        <skos:altLabel xml:lang="en">watershed restoration</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/river-restoration"/>
        <cpr:P4 rdf:resource="https://www.umweltbundesamt.de/en/topics/water/rivers/river-restoration-start#restoration-measures-improve-the-ecological-status-of-rivers"/>
        <schema:description xml:lang="en">Rivers are dynamic by nature as they carve their own course, distribute sediments and spill onto flood plains during flood events. Ecological river restoration involves ecological, spatial and physical management practices with the aim of returning rivers to their natural state.  Common restoration techniques include reconnecting rivers with floodplains, reestablishment of the river’s meandering form with no barriers along its banks (i.e. removal of built-up embankments), and stabilising surrounding soil to reduce sedimentation and erosion (i.e. bed fixation).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1080 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1080">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">tectonic uplift</rdfs:label>
        <skos:altLabel xml:lang="en">coseismic uplift</skos:altLabel>
        <schema:description xml:lang="en">Tectonic uplift is the geological process where land is raised due to tectonic forces, such as the movement of Earth&apos;s plates.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1082 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1082">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">pyroclastic flow</rdfs:label>
        <skos:altLabel xml:lang="en">ash flow</skos:altLabel>
        <skos:altLabel xml:lang="en">hot avalanche</skos:altLabel>
        <skos:altLabel xml:lang="en">lahar</skos:altLabel>
        <skos:altLabel xml:lang="en">lahars</skos:altLabel>
        <skos:altLabel xml:lang="en">lapilli</skos:altLabel>
        <skos:altLabel xml:lang="en">nuée ardente</skos:altLabel>
        <skos:altLabel xml:lang="en">pyroclast</skos:altLabel>
        <skos:altLabel xml:lang="en">pyroclast density current</skos:altLabel>
        <skos:altLabel xml:lang="en">pyroclast density currents</skos:altLabel>
        <skos:altLabel xml:lang="en">pyroclast flows</skos:altLabel>
        <skos:altLabel xml:lang="en">pyroclasts</skos:altLabel>
        <skos:altLabel xml:lang="en">tephra</skos:altLabel>
        <skos:altLabel xml:lang="en">tephra fall</skos:altLabel>
        <schema:description xml:lang="en">Pyroclastic flow is a dense, fast-moving flow (exceeding 100km/h) of solidified lava pieces, volcanic ash, and hot gases that can reach about 600 to 700 °C.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1085 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1085">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">lava flows</rdfs:label>
        <skos:altLabel xml:lang="en">lava effusion</skos:altLabel>
        <skos:altLabel xml:lang="en">lava flow</skos:altLabel>
        <skos:altLabel xml:lang="en">volcanic mudflow</skos:altLabel>
        <schema:description xml:lang="en">Lava flows are molten rock from a volcano eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q109 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q109">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">artificial lowering of glacial lakes</rdfs:label>
        <skos:altLabel xml:lang="en">GLOF risk reduction</skos:altLabel>
        <skos:altLabel xml:lang="en">artificial lowering of glacial lake</skos:altLabel>
        <skos:altLabel xml:lang="en">artificially lower glacial lake</skos:altLabel>
        <skos:altLabel xml:lang="en">glacial lake outburst flood protection</skos:altLabel>
        <skos:altLabel xml:lang="en">glacial lake outburst flood risk reduction</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against GLOFs</skos:altLabel>
        <skos:altLabel xml:lang="en">protection against glacial lake outburst floods</skos:altLabel>
        <skos:altLabel xml:lang="en">resilience against GLOFs</skos:altLabel>
        <skos:altLabel xml:lang="en">resilience against glacial lake outburst floods</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1006"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/artificial-lowering-glacial-lakes"/>
        <schema:description xml:lang="en">The artificial lowering of glacial lakes is the process of draining water from those vulnerable to overflowing by digging a canal from the lake to a nearby river. Drainage reduces water level and decreases pressure on moraine dams. This in turn reduces the risk of burst events (i.e., GLOFs).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1091 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1091">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">lava dome</rdfs:label>
        <skos:altLabel xml:lang="en">lava domes</skos:altLabel>
        <schema:description xml:lang="en">Lava dome is a pile of relatively viscous lava that cannot flow far from the vent in a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1094 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1094">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic eruption</rdfs:label>
        <skos:altLabel xml:lang="en">volcanic eruptions</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1199"/>
        <schema:description xml:lang="en">A volcanic eruption is when gas and/or lava are released from a volcano.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q110 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q110">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1636"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1938"/>
        <rdfs:label xml:lang="en">flood-proof wells</rdfs:label>
        <skos:altLabel xml:lang="en">flood proof well</skos:altLabel>
        <skos:altLabel xml:lang="en">flood-proof well</skos:altLabel>
        <skos:altLabel xml:lang="en">floodproof well</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/flood-proof-wells"/>
        <schema:description xml:lang="en">Flooding of wells often results in contamination of freshwater. Specialised construction design and planning procedures can be used to protect wells against the risks of flooding, and consequent water contamination. Specific measures can mitigate contaminant infiltration and improve the well’s strength, reducing the risk of collapse during a flooding event.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q111 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q111">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">storm drain</rdfs:label>
        <skos:altLabel xml:lang="en">storm drainage</skos:altLabel>
        <skos:altLabel xml:lang="en">storm drains</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ecologic.eu/19589"/>
        <cpr:P4 rdf:resource="https://www.sciencedirect.com/science/article/abs/pii/S0301479718304481"/>
        <schema:description xml:lang="en">A storm drain is part of the urban storm management system. It is an infrastructure designed to drain excess rain and ground water from impermeable surfaces and prevent or minimise flooding events.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1118 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1118">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">rockfall</rdfs:label>
        <skos:altLabel xml:lang="en">boulder fall</skos:altLabel>
        <skos:altLabel xml:lang="en">boulder falls</skos:altLabel>
        <skos:altLabel xml:lang="en">boulderfall</skos:altLabel>
        <skos:altLabel xml:lang="en">boulderfalls</skos:altLabel>
        <skos:altLabel xml:lang="en">falling rocks</skos:altLabel>
        <skos:altLabel xml:lang="en">rock fall</skos:altLabel>
        <skos:altLabel xml:lang="en">rock falls</skos:altLabel>
        <skos:altLabel xml:lang="en">rockfalls</skos:altLabel>
        <schema:description xml:lang="en">A rockfall is a fragment of rock (a block) detached by sliding, toppling, or falling, that falls along a vertical or sub-vertical cliff, proceeds down slope by bouncing and flying along ballistic trajectories or by rolling on talus or debris slopes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1119 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1119">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic ash</rdfs:label>
        <schema:description xml:lang="en">Volcanic ash is a mixture of rock, mineral, and glass particles expelled from a volcano during a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q112 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q112">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">runoff control structure</rdfs:label>
        <skos:altLabel xml:lang="en">run-off control structure</skos:altLabel>
        <skos:altLabel xml:lang="en">runoff control structures</skos:altLabel>
        <skos:altLabel xml:lang="en">temporary rainfall store</skos:altLabel>
        <skos:altLabel xml:lang="en">temporary rainfall stores</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/run-control-structures-temporarily-store-rainfall"/>
        <schema:description xml:lang="en">Runoff control structures are designed to capture runoff during peak flows, and can function as temporary storage sites. These structures are typically built with a discharge component to slowly release water into the nearby waterway to avoid it overflowing from the storage basin. It can be artificially built, for example by excavating a large area so that it is lower than the surrounding land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1120 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1120">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic gas</rdfs:label>
        <skos:altLabel xml:lang="en">gas-contaminated land</skos:altLabel>
        <skos:altLabel xml:lang="en">magmatic gas</skos:altLabel>
        <skos:altLabel xml:lang="en">magmatic gases</skos:altLabel>
        <skos:altLabel xml:lang="en">radon</skos:altLabel>
        <skos:altLabel xml:lang="en">vog</skos:altLabel>
        <skos:altLabel xml:lang="en">volcanic gases</skos:altLabel>
        <schema:description xml:lang="en">It identifies the fluid gas phase released by active volcanoes, both during eruption and quiescence. Volcanic gases are molecular combinations of four elements (H, C, O, and S) but also include a variety of other components.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1121 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1121">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic lightning</rdfs:label>
        <schema:description xml:lang="en">Volcanic lightning is an electrical discharge caused by a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1122 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1122">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">subsidence</rdfs:label>
        <schema:description xml:lang="en">Subsidence is a general term for downward vertical movement of the Earth&apos;s surface, which can be caused by both natural processes and human activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1123 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1123">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">coseismic subsidence</rdfs:label>
        <skos:altLabel xml:lang="en">tectonic subsidence</skos:altLabel>
        <schema:description xml:lang="en">It is the downward distributed vertical permanent ground deformation (warping) that result from earthquake displacements on a dipping (inclined) fault.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1125 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1125">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">fault scarp</rdfs:label>
        <skos:altLabel xml:lang="en">fault offset</skos:altLabel>
        <schema:description xml:lang="en">A fault scarp is a surface expression of a fault that has shifted the ground surface, ranging from small slopes to high rock escarpments</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1126 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1126">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground movement</skos:altLabel>
        <skos:altLabel xml:lang="en">ground shaking</skos:altLabel>
        <skos:altLabel xml:lang="en">seismicity</skos:altLabel>
        <skos:altLabel xml:lang="en">seismological process</skos:altLabel>
        <skos:altLabel xml:lang="en">temblor</skos:altLabel>
        <skos:altLabel xml:lang="en">tremor</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1152"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1153"/>
        <schema:description xml:lang="en">An earthquake is the shaking of the Earth&apos;s surface resulting from a sudden release of energy in the lithosphere that creates seismic waves.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q113 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q113">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">permeable paving</rdfs:label>
        <skos:altLabel xml:lang="en">permeable car park</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable carpark</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable driveway</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable driveways</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable parking lots</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable paved surface</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable pavement</skos:altLabel>
        <skos:altLabel xml:lang="en">permeable pavements</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/permeable-parking-lots"/>
        <schema:description xml:lang="en">Permeable pavements and parking lots are often constructed in urban settings to facilitate storm water runoff and mitigate urban flooding and storm water overflow risks. The permeable surfaces provide greater water uptake. The water is infiltrated, and to an extent purified, before recharging the groundwater. The resulting retention decreases runoff rates and reduces pressures on urban storm water systems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1134 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1134">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">induced earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground shaking</skos:altLabel>
        <skos:altLabel xml:lang="en">induced earthquakes</skos:altLabel>
        <skos:altLabel xml:lang="en">induced seismicity</skos:altLabel>
        <skos:altLabel xml:lang="en">underground explosion</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1153"/>
        <schema:description xml:lang="en">Induced seismic ground shaking comprises non-tectonic (i.e., nonnatural) earthquakes which result from human activities that alter thestresses and strains on the Earth’s crust.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1136 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1136">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">fissure</rdfs:label>
        <skos:altLabel xml:lang="en">earth fissure</skos:altLabel>
        <skos:altLabel xml:lang="en">fissura</skos:altLabel>
        <skos:altLabel xml:lang="en">fissures</skos:altLabel>
        <skos:altLabel xml:lang="en">ground fissure</skos:altLabel>
        <skos:altLabel xml:lang="en">ground fissures</skos:altLabel>
        <skos:altLabel xml:lang="en">ground fissuring</skos:altLabel>
        <schema:description xml:lang="en">A fissure is a long, narrow crack or linear opening in the Earth&apos;s crust.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1137 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1137">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">surface rupture</rdfs:label>
        <skos:altLabel xml:lang="en">earth surface faulting</skos:altLabel>
        <skos:altLabel xml:lang="en">ground deformation</skos:altLabel>
        <skos:altLabel xml:lang="en">surface faulting</skos:altLabel>
        <schema:description xml:lang="en">Surface rupture occurs when movement on a fault deep within the earth breaks through to the surface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1138 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1138">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">soil creep</rdfs:label>
        <skos:altLabel xml:lang="en">downhill creep</skos:altLabel>
        <skos:altLabel xml:lang="en">landscape creep</skos:altLabel>
        <schema:description xml:lang="en">It is the movement of the soil down a slope under the influence of gravity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1139 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1139">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">soil piping</rdfs:label>
        <schema:description xml:lang="en">Soil piping is a naturally occurring, hydraulic process that leads to the development of macropores (large, air-filled voids) in the subsurface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q114 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q114">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">bioswale</rdfs:label>
        <skos:altLabel xml:lang="en">bioswale</skos:altLabel>
        <cpr:P4 rdf:resource="https://urbangreenbluegrids.com/measures/bioswales/"/>
        <schema:description xml:lang="en">A bioswale is a ditch with vegetation and a porous bottom. The top layer consists of enhanced soil with plants. Below there is a layer of gravel, scoria or baked clay pellets packed in geotextile. These materials have large empty spaces, allowing the rainwater to drain off. An infiltration pipe/drainpipe is situated below the second layer. Rainfall infiltrates into the ground via the ditch and the packed layer. If the water rises above the level of the overflow, the water runs through it to the drainpipe.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1140 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1140">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">solifluction</rdfs:label>
        <schema:description xml:lang="en">It is the slow downslope movement of soil due to recurrent freezing and thawing of the ground.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1141 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1141">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">sinkhole</rdfs:label>
        <skos:altLabel xml:lang="en">doline cenote</skos:altLabel>
        <skos:altLabel xml:lang="en">doline cenotes</skos:altLabel>
        <skos:altLabel xml:lang="en">sink-hole</skos:altLabel>
        <skos:altLabel xml:lang="en">swallet</skos:altLabel>
        <schema:description xml:lang="en">A sinkhole is a closed depression or hole in the ground caused by some form of collapse of the surface layer. It forms when water dissolves surface soluble rock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1148 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1148">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">collapsible soil</rdfs:label>
        <schema:description xml:lang="en">Collapsible soil refers to soil that has the potential to collapse when it becomes saturated, as its fabric is unable to support the weight of the overburden. This type of soil typically consists of a loose skeleton of grains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1149 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1149">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">compressible soil</rdfs:label>
        <skos:altLabel xml:lang="en">compressive soil</skos:altLabel>
        <schema:description xml:lang="en">It is the ease with which a soil decreases in volume when subjected to a mechanical load. Compressive soils are prone to volumetric change when subject to mechanical loading.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q115 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q115">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2019"/>
        <rdfs:label xml:lang="en">storm surge barrier</rdfs:label>
        <skos:altLabel xml:lang="en">closure dam</skos:altLabel>
        <skos:altLabel xml:lang="en">closure dams</skos:altLabel>
        <skos:altLabel xml:lang="en">storm surge barriers</skos:altLabel>
        <skos:altLabel xml:lang="en">tidal barrage</skos:altLabel>
        <skos:altLabel xml:lang="en">tidal barrages</skos:altLabel>
        <skos:altLabel xml:lang="en">tidal barrier</skos:altLabel>
        <skos:altLabel xml:lang="en">tidal barriers</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/sites/www.ctc-n.org/files/resources/storm_surge_barriers_closure_dams.pdf"/>
        <schema:description xml:lang="en">Storm surge barriers and closure dams are hard engineered structures with the primary function of preventing coastal flooding. Storm surge barriers are movable or fixed barriers or gates that are closed to prevent flooding when an extreme water level is forecast. Closure dams are fixed structures that permanently close off a river mouth or estuary.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1150 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1150">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">ground settlement</rdfs:label>
        <schema:description xml:lang="en">A settlement is defined as the vertical movement of the ground, generally caused be changes in stresses within the earth.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1151 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1151">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">ballistics</rdfs:label>
        <schema:description xml:lang="en">Ballistics comprise fragments of magma and old (i.e., pre-existing) rocks ejected during an explosive eruption at variable velocity and angle on cannon ball-like trajectories.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1152 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1152">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">tsunami</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1126"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1197"/>
        <schema:description xml:lang="en">It is a series of travelling waves of extremely long length and period, usually generated by disturbances associated with earthquakes occurring below or near the ocean floor.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1155 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1155">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">riverbank erosion</rdfs:label>
        <skos:altLabel xml:lang="en">stream bank desintegration</skos:altLabel>
        <skos:altLabel xml:lang="en">stream bank deterioration</skos:altLabel>
        <schema:description xml:lang="en">Riverbank erosion is the removal of material from the banks of rivers when flowing water forces exceed bank resisting forces by the soil and vegetation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1156 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1156">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">sand encroachment</rdfs:label>
        <skos:altLabel xml:lang="en">sand dune migration</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q138"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <schema:description xml:lang="en">Sand encroachment occurs generally in arid to semi-arid regions when grains of sand are carried by winds and form sandy accumulation on coasts, along watercourses and on cultivated or uncultivated land causing major material and socioeconomic damage.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1157 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1157">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">alluvial fan</rdfs:label>
        <schema:description xml:lang="en">An alluvial fan is a fan-shaped area where silt, sand, gravel, boulders, and woody debris are deposited by rivers and streams over a long period of time. Alluvial fans are created as flowing water interacts with steep terrains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q116 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q116">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">breakwater</rdfs:label>
        <skos:altLabel xml:lang="en">break water</skos:altLabel>
        <skos:altLabel xml:lang="en">break waters</skos:altLabel>
        <skos:altLabel xml:lang="en">breakwaters</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/breakwaters"/>
        <schema:description xml:lang="en">Breakwaters are shore-parallel structures located just offshore of the surf zone. They are designed to intercept and reduce incoming wave energy at the shoreline. They thereby protect the coastline behind breakwaters. Breakwaters are generally very solid, durable structures and are considered a protection measure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1160 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1160">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">impacted workers</rdfs:label>
        <skos:altLabel xml:lang="en">contractors</skos:altLabel>
        <skos:altLabel xml:lang="en">employee</skos:altLabel>
        <skos:altLabel xml:lang="en">employees</skos:altLabel>
        <skos:altLabel xml:lang="en">labourer</skos:altLabel>
        <skos:altLabel xml:lang="en">labourers</skos:altLabel>
        <skos:altLabel xml:lang="en">workers</skos:altLabel>
        <skos:altLabel xml:lang="en">working man</skos:altLabel>
        <skos:altLabel xml:lang="en">working men</skos:altLabel>
        <skos:altLabel xml:lang="en">working people</skos:altLabel>
        <skos:altLabel xml:lang="en">working woman</skos:altLabel>
        <skos:altLabel xml:lang="en">working women</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q62"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <cpr:P7 xml:lang="en">Working people who are disproportionately impacted by climate change or the response to climate change. This can be because the risks of their profession are elevated by climate change; because their social status in general makes them more vulnerable to climate change; or because their profession is likely to change or even disappear due to the green transition.</cpr:P7>
        <schema:description xml:lang="en">Working people who are disproportionately impacted by climate change or the response to climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1161 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1161">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">glacial surge</rdfs:label>
        <skos:altLabel xml:lang="en">glacier surge</skos:altLabel>
        <skos:altLabel xml:lang="en">glacier surges</skos:altLabel>
        <skos:altLabel xml:lang="en">surging glaciers</skos:altLabel>
        <schema:description xml:lang="en">They are glaciers that suddenly accelerate to ice flow speeds that are up to two orders of magnitude higher, reaching speeds of tens or even over 100 m per day. The high speed results in a total transformation of the surface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1164 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1164">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:label xml:lang="en">high-risk occupations</rdfs:label>
        <skos:altLabel xml:lang="en">construction worker</skos:altLabel>
        <skos:altLabel xml:lang="en">construction workers</skos:altLabel>
        <skos:altLabel xml:lang="en">emergency response worker</skos:altLabel>
        <skos:altLabel xml:lang="en">emergency response workers</skos:altLabel>
        <skos:altLabel xml:lang="en">first responder</skos:altLabel>
        <skos:altLabel xml:lang="en">first responders</skos:altLabel>
        <skos:altLabel xml:lang="en">frontline worker</skos:altLabel>
        <skos:altLabel xml:lang="en">frontline workers</skos:altLabel>
        <skos:altLabel xml:lang="en">health care worker</skos:altLabel>
        <skos:altLabel xml:lang="en">health-care worker</skos:altLabel>
        <skos:altLabel xml:lang="en">health-care workers</skos:altLabel>
        <skos:altLabel xml:lang="en">healthcare worker</skos:altLabel>
        <skos:altLabel xml:lang="en">healthcare workers</skos:altLabel>
        <skos:altLabel xml:lang="en">heavy physical labor</skos:altLabel>
        <skos:altLabel xml:lang="en">heavy physical work</skos:altLabel>
        <skos:altLabel xml:lang="en">high-risk job</skos:altLabel>
        <skos:altLabel xml:lang="en">high-risk jobs</skos:altLabel>
        <skos:altLabel xml:lang="en">high-risk occupation</skos:altLabel>
        <skos:altLabel xml:lang="en">manual laborer</skos:altLabel>
        <skos:altLabel xml:lang="en">manual laborers</skos:altLabel>
        <skos:altLabel xml:lang="en">outdoor workers</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1012"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1571"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q764"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P7 xml:lang="en">People whose occupation makes them more likely to be adversely impacted by climate change. Sometimes, these are jobs which are inherently risky -- for example, fire risk for firefighters or health risks for healthcare workers -- and the magnitude and/or frequency of those risks are increasing due to the effects of climate change. A large share of the increased risk however is due to heat stress from increasing temperatures, as well as air pollution and vector borne diseases.</cpr:P7>
        <schema:description xml:lang="en">People whose occupation makes them more likely to be adversely impacted by climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1165 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1165">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:label xml:lang="en">workers impacted by the transition</rdfs:label>
        <skos:altLabel xml:lang="en">closing factories</skos:altLabel>
        <skos:altLabel xml:lang="en">deindustrialised areas</skos:altLabel>
        <skos:altLabel xml:lang="en">deindustrialised regions</skos:altLabel>
        <skos:altLabel xml:lang="en">factory workers</skos:altLabel>
        <skos:altLabel xml:lang="en">fewer jobs</skos:altLabel>
        <skos:altLabel xml:lang="en">impacted by the energy transition</skos:altLabel>
        <skos:altLabel xml:lang="en">impacted by the green transition</skos:altLabel>
        <skos:altLabel xml:lang="en">impacted by the just transition</skos:altLabel>
        <skos:altLabel xml:lang="en">impacted by the transition</skos:altLabel>
        <skos:altLabel xml:lang="en">lay off</skos:altLabel>
        <skos:altLabel xml:lang="en">lay offs</skos:altLabel>
