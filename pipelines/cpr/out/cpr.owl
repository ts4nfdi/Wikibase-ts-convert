        <skos:altLabel xml:lang="en">VLSFO</skos:altLabel>
        <skos:altLabel xml:lang="en">bunker C</skos:altLabel>
        <skos:altLabel xml:lang="en">bunker fuel</skos:altLabel>
        <skos:altLabel xml:lang="en">bunker oil</skos:altLabel>
        <skos:altLabel xml:lang="en">furnace oil</skos:altLabel>
