        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q847"/>
        <cpr:P7 xml:lang="en">The wholesale and retail trade sector includes the resale of goods without transformation and related services. Wholesale involves resale to businesses and agents, with activities like sorting and storage. Retailing focuses on selling goods to the public through various channels. This sector also includes transit trade and vending machine sales but excludes digital products and utility trade.</cpr:P7>
        <cpr:P9 xml:lang="en">electricity retail</cpr:P9>
        <cpr:P9 xml:lang="en">energy retail</cpr:P9>
        <cpr:P9 xml:lang="en">retail electricity</cpr:P9>
        <cpr:P9 xml:lang="en">retail energy</cpr:P9>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q766">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1494"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1495"/>
