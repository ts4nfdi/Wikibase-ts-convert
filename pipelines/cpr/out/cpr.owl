    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q100">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q98"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/drought-risk-mapping"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1000">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P7 xml:lang="en">Overwash is the flow of water and sediment over a coastal dune or beach crest during storm events. This process can cause significant coastal changes in the landscape of beaches and dunes.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1001">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P7 xml:lang="en">Marine debris refers to any persistent solid material that is manufactured or processed and then directly or indirectly, intentionally or unintentionally, discarded or abandoned into oceans or the Great Lakes. No part of Earth is untouched by this issue today.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1002">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q393"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P7 xml:lang="en">An extended period of unusually high sea temperatures lasting several days to weeks, with temperatures exceeding local thresholds.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1003">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P4 rdf:resource="https://e360.yale.edu/features/climate-change-ocean-circulation-collapse-antarctica"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1004">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P7 xml:lang="en">Changes in a biome as a result of climate change, such as rising temperatures or ocean acidification.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1005">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <cpr:P7 xml:lang="en">Marine toxins are highly toxic organic compounds found in the marine environment, often produced by certain types of algae. An algal bloom or algae bloom is a rapid increase or accumulation in the population of algae in freshwater or marine water systems and is harmful to marine ecosystems.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1006">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q109"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q441"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">A Glacial Lake Outburst Flood (GLOF) is a sudden release of water from a glacier-fed lake, typically caused by the melting of ice or failure of natural barriers like ice dams or moraines. These floods can occur when lakes form on, beneath, or beside glaciers, leading to rapid downstream flooding.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1007">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1032"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1056"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1008">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1033"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1009">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1010"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1513"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q226"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q243"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <cpr:P7 xml:lang="en">Also referred to as short-lived climate forcers, this group of pollutants have high warming potential, and short atmospheric lifetimes. These pollutants can warm the Earth faster than carbon dioxide, as per molecule in the atmosphere they have a stronger warming effect.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q101">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q96"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1523"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q91"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/flood-hazard-mapping"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1010">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1009"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1011">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <cpr:P7 xml:lang="en">Acidification refers to increased acidity in ecosystems due to pollution, harming biodiversity, degrading soils, freshwater systems, and damaging infrastructure. It occurs when pollutants like CO₂, sulfur dioxide (SO₂), and nitrogen oxides (NOx) reduce pH levels in the environment. This leads to risks for plants, animals, and human health, while also contributing to long-term environmental damage.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1012">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1251"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1514"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1083"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1164"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q704"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1013">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <cpr:P7 xml:lang="en">add later</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1014">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <cpr:P7 xml:lang="en">Accelerated warming is rapidly reducing Arctic sea ice, increasing heat absorption by the dark ocean surface and further amplifying global warming. This threatens species adapted to sea ice, such as polar bears, walruses, and seals, while also exacerbating climate change by enhancing the ocean’s uptake of atmospheric carbon dioxide.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1016">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1639"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <cpr:P20 xml:lang="en">g7brun33</cpr:P20>
        <cpr:P7 xml:lang="en">people with diverse (that is, non-heterosexual, non-cisgender or non-binary) sexual orientations, gender identities, gender expressions or sex characteristics. In the context of climate impacts, this should be seen as one of a wider set of intersecting identities and historical power structures that create marginalisation.</cpr:P7>
        <cpr:P9 xml:lang="en">asexual propagation</cpr:P9>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1017">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q994"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q997"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q956"/>
        <cpr:P7 xml:lang="en">The scarcity of resources can be intensified by climate change, affecting the access to basic needs like food, land, and water. It exacerbates the vulnerability of populations, ecosystems, economies, and institutions, with the severity of impacts depending on both climate factors and the magnitude of scarcity itself.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1045">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1050">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1052"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1053"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1054"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1049"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <cpr:P7 xml:lang="en">Micro- to macroplastics are insoluble in water, and can range in size from 1 μm to anything above 5mm. They can originate from primary sources (manufactured at that size) or secondary sources (breakdown from later plastics). Macroplastics can degrade into microplastics over time, and are major pollutants in aquatic ecosystems, posing risks to human and animal health.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1052">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1053">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1064"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1067"/>
        <cpr:P7 xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm. They can be harmful to the environment especially marine life and originate from larger plastic debris that degrades into smaller pieces.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1054">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <cpr:P7 xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q106">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q108"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q109"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1913"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1916"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1955"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1958"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q982"/>
        <cpr:P7 xml:lang="en">A fluvial (riverine) flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate. Riverine flood protection refers to a set of measures and strategies designed to prevent or mitigate the impacts of flooding in areas adjacent to rivers.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1067">
