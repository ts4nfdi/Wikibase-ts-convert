    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1413 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1413">
        <rdfs:label xml:lang="en">moratorium</rdfs:label>
        <skos:altLabel xml:lang="en">moratoria, temporary ban, moratoriums, exploitation freeze, freeze on new, production freeze</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <cpr:P7 xml:lang="en">Technically means &quot;temporary ban&quot; as placing a “moratorium” implies a willingness to continue studying it and potentially revisit it in the future. Examples include moratorium on oil and gas drilling in certain areas.</cpr:P7>
        <schema:description xml:lang="en">Technically means &quot;temporary ban&quot; as placing a “moratorium” implies a willingness to continue studying it and potentially revisit it in the future</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1414 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1414">
        <rdfs:label xml:lang="en">phase-out</rdfs:label>
        <skos:altLabel xml:lang="en">phase-out, phasing out, phasing-out, phased out, phaseout, phases out, managed decline</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1417"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <cpr:P7 xml:lang="en">An approach to catalyse the gradual decline of technologies, substances and practices that compromise environmental sustainability objectives. In climate policy, &quot;phase out&quot; often refers to the complete cessation of fossil fuel use.</cpr:P7>
        <schema:description xml:lang="en">An approach to catalyse the gradual decline of technologies, substances and practices that compromise environmental sustainability objectives. In climate policy, &quot;phase out&quot; often refers to the complete cessation of fossil fuel use.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1415 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1415">
        <rdfs:label xml:lang="en">phase-down</rdfs:label>
