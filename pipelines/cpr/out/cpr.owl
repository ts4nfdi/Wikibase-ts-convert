    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1409">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1408"/>
        <rdfs:label xml:lang="en">peatland protected area</rdfs:label>
        <skos:altLabel xml:lang="en">peatland protected areas, peatland reserve, peatland conservation area, peatland protected site, peatland reserves, peatland Site of Special Scientific Interest, peatland SSSI, peatlands SSSI</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1406"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2542"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q141 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q141">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">land terracing</rdfs:label>
        <skos:altLabel xml:lang="en">terracing, slope terracing</skos:altLabel>
        <cpr:P7 xml:lang="en">In agriculture, terracing refers to the technique of creating flat, stepped areas on slopes to facilitate farming. This method enhances water retention and reduces soil erosion, making it an essential practice in regions with hilly terrains.</cpr:P7>
        <schema:description xml:lang="en">In agriculture, terracing refers to the technique of creating flat, stepped areas on slopes to facilitate farming. This method enhances water retention and reduces soil erosion, making it an essential practice in regions with hilly terrains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1410 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1410">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1402"/>
        <rdfs:label xml:lang="en">wildlife reserve</rdfs:label>
        <skos:altLabel xml:lang="en">wildlife reserves, wildlife sanctuaries, wildlife sanctuary</skos:altLabel>
        <cpr:P7 xml:lang="en">A type of nature reserve, that is an area allocated to both preserve and protect wildlife.</cpr:P7>
        <schema:description xml:lang="en">A type of nature reserve, that is an area allocated to both preserve and protect wildlife.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1413 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1413">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <rdfs:label xml:lang="en">moratorium</rdfs:label>
        <skos:altLabel xml:lang="en">moratoria, temporary ban, moratoriums, exploitation freeze, freeze on new, production freeze</skos:altLabel>
        <cpr:P7 xml:lang="en">Technically means &quot;temporary ban&quot; as placing a “moratorium” implies a willingness to continue studying it and potentially revisit it in the future. Examples include moratorium on oil and gas drilling in certain areas.</cpr:P7>
        <schema:description xml:lang="en">Technically means &quot;temporary ban&quot; as placing a “moratorium” implies a willingness to continue studying it and potentially revisit it in the future</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1414 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1414">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <rdfs:label xml:lang="en">phase-out</rdfs:label>
        <skos:altLabel xml:lang="en">phase-out, phasing out, phasing-out, phased out, phaseout, phases out, managed decline</skos:altLabel>
        <cpr:P7 xml:lang="en">An approach to catalyse the gradual decline of technologies, substances and practices that compromise environmental sustainability objectives. In climate policy, &quot;phase out&quot; often refers to the complete cessation of fossil fuel use.</cpr:P7>
        <schema:description xml:lang="en">An approach to catalyse the gradual decline of technologies, substances and practices that compromise environmental sustainability objectives. In climate policy, &quot;phase out&quot; often refers to the complete cessation of fossil fuel use.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1415 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1415">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <rdfs:label xml:lang="en">phase-down</rdfs:label>
        <skos:altLabel xml:lang="en">phase down, phasing-down, phasing down, phased down, phasedown, phases down</skos:altLabel>
        <cpr:P7 xml:lang="en">The term “Phase Down” refers to structured reduction in the use of fossil fuels, whereas &quot;Phase out&quot; is a complete end to the use of fossil fuels for energy.</cpr:P7>
        <schema:description xml:lang="en">The term “Phase Down” refers to structured reduction in the use of fossil fuels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1416 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1416">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1415"/>
        <rdfs:label xml:lang="en">HFC phase-down</rdfs:label>
        <skos:altLabel xml:lang="en">HFC phase down, phasing down hydrofluorocarbons, Hydrofluorocarbon phase down, Hydrofluorocarbon phase-down, phase down of HFCs, phase-down of HFCs, Kigali Amendment, HFC freeze</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2711"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2712"/>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1417 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1417">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1414"/>
        <rdfs:label xml:lang="en">fossil fuel phase-out</rdfs:label>
        <skos:altLabel xml:lang="en">fossil fuel phase out, fossil fuel phase-out, phase out fossil fuel, phase out fossil fuels, phasing out fossil fuels, phasing out fossil fuel</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q638"/>
        <cpr:P7 xml:lang="en">The complete cessation of fossil fuel use, sometimes only referring to unabated fossil fuels or coal in particular</cpr:P7>
        <schema:description xml:lang="en">The complete cessation of fossil fuel use.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1418 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1418">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1284"/>
        <rdfs:label xml:lang="en">environmental liability</rdfs:label>
        <skos:altLabel xml:lang="en">environment liability policy, environmental liabilities</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q729"/>
        <cpr:P7 xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities. It&apos;s based on the &quot;polluter pays&quot; principle, which means that those who cause environmental damage are financially responsible for it.</cpr:P7>
        <schema:description xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1419 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1419">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1288"/>
        <rdfs:label xml:lang="en">ecolabelling</rdfs:label>
        <skos:altLabel xml:lang="en">eco label, eco labelling, eco-label, eco-labelling, ecolabel, ecolabelling</skos:altLabel>
        <cpr:P4 rdf:resource="https://globalecolabelling.net/about/what-is-ecolabelling/"/>
        <cpr:P7 xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</cpr:P7>
        <schema:description xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q142 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q142">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">integrated nutrient management</rdfs:label>
        <skos:altLabel xml:lang="en">soil nutrient management, cropland nutrient management, soil nutrient conservation, integrated plant nutrients management, integrated soil nutrient management</skos:altLabel>
        <cpr:P7 xml:lang="en">Integrated nutrient management refers to the maintenance of soil fertility and of plant nutrient supply at an optimum level for sustaining the desired productivity through optimization of the benefits from all possible sources of organic, inorganic and biological components in an integrated manner.</cpr:P7>
        <schema:description xml:lang="en">Integrated nutrient management refers to the maintenance of soil fertility and of plant nutrient supply at an optimum level for sustaining the desired productivity through optimization of the benefits from all possible sources of organic, inorganic and biological components in an integrated manner.</schema:description>
    </owl:Class>
    


