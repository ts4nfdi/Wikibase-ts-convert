        <skos:altLabel xml:lang="en">retreat from coastal flooding, planned relocation from areas exposed to coastal, planned relocation from areas exposed to sea-level rise, planned relocation from coastal</skos:altLabel>
        <cpr:P7 xml:lang="en">Retreat reduces exposure to coastal hazards by moving people, assets and human activities out of the exposed coastal area.</cpr:P7>
        <schema:description xml:lang="en">Retreat reduces exposure to coastal hazards by moving people, assets and human activities out of the exposed coastal area.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1843 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1843">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <rdfs:label xml:lang="en">hard coastal protection engineering</rdfs:label>
        <skos:altLabel xml:lang="en">hard coastal engineering, hard engineering, hard coastal protection, hard structure coastal protection, coastal defence structure, coastal defence structures, sea defences, protective sea structure, protective sea structures</skos:altLabel>
        <cpr:P7 xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</cpr:P7>
        <schema:description xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1844 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1844">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <rdfs:label xml:lang="en">soft coastal protection engineering</rdfs:label>
        <skos:altLabel xml:lang="en">soft coastal engineering, soft engineering, soft coastal protection</skos:altLabel>
        <cpr:P7 xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</cpr:P7>
        <schema:description xml:lang="en">Protection reduces coastal risk and impacts by blocking the inland propagation and other effects of mean or extreme sea levels hazards (e.g.,  through dikes, seawalls, storm surge barriers, breakwaters, beach-dune systems, etc.).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1845 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1845">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1831"/>
        <rdfs:label xml:lang="en">forestry adaptation</rdfs:label>
        <skos:altLabel xml:lang="en">climate-resilient tree, climate-resilient trees, adaptation in forestry, resilience in forestry, resilient forestry, climate resilient tree, climate resiliient trees, adaptation of forestry, adaptation of forests, adaptation of plantation, adaptation of plantations, adaptation of tree, adaptation of trees, adaptation of woodland, adaptation of woodlands, adaptation of woods, adaptations of forestry, adaptations of forests, adaptations of plantation, adaptations of plantations, adaptations of tree, adaptations of trees, adaptations of woodland, adaptations of woodlands, adaptations of woods, adapting forestry, adapting forests, adapting plantation, adapting plantations, adapting tree, adapting trees, adapting woodland, adapting woodlands, adapting woods, adaptive capacity of forestry, adaptive capacity of forests, adaptive capacity of plantation, adaptive capacity of plantations, adaptive capacity of tree, adaptive capacity of trees, adaptive capacity of woodland, adaptive capacity of woodlands, adaptive capacity of woods, climate resilient forestry, climate resilient forests, climate resilient plantation, climate resilient plantations, climate resilient trees, climate resilient woodland, climate resilient woodlands, climate resilient woods, climate-smart forestry, climate-smart forests, climate-smart plantation, climate-smart plantations, climate-smart tree, climate-smart trees, climate-smart woodland, climate-smart woodlands, climate-smart woods, resilience of forestry, resilience of forests, resilience of plantation, resilience of plantations, resilience of tree, resilience of trees, resilience of woodland, resilience of woodlands, resilience of woods, resilient forests, resilient plantation, resilient plantations, resilient tree, resilient trees, resilient woodland, resilient woodlands, resilient woods, adaptive forestry</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <schema:description xml:lang="en">Adapting to climate change impacts in the forestry sector.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1846 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1846">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1831"/>
        <rdfs:label xml:lang="en">terrestrial ecosystem-based adaptation</rdfs:label>
        <skos:altLabel xml:lang="en">terrestrial ecosystem management, terrestrial ecosystem-based adaptation, terrestrial ecosystem-based resilience, biodiversity adaptation, terrestrial ecosystem adaptation, terrestrial ecosystem conservation, terrestrial ecosystem restoration</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
        <cpr:P7 xml:lang="en">Terrestrial ecosystem-based adaptation are land-based strategies and activities for adapting to climate change that harness nature-based solutions and ecosystem services. For instance, reforestation can hold back desertification and recharge groundwater supplies in times of drought.</cpr:P7>
        <schema:description xml:lang="en">Terrestrial ecosystem-based adaptation are land-based strategies and activities for adapting to climate change that harness nature-based solutions and ecosystem services.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1847 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1847">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">ecological corridor</rdfs:label>
        <skos:altLabel xml:lang="en">improved ecological connectivity, improved ecological network, improved ecological networks, biodiversity corridor, biodiversity corridors, connectivity corridor, connectivity corridors, conservation corridor, conservation corridors, ecological corridors, habitat corridor, habitat corridors, wildlife corridor, wildlife corridors</skos:altLabel>
        <cpr:P7 xml:lang="en">A thin strip of vegetation used by wildlife and potentially allowing movement of biotic factors between two areas.</cpr:P7>
        <schema:description xml:lang="en">A thin strip of vegetation used by wildlife and potentially allowing movement of biotic factors between two areas.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1848 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1848">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1635"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2794"/>
        <rdfs:label xml:lang="en">inland wetland restoration</rdfs:label>
        <skos:altLabel xml:lang="en">inland wetland rehabilitation, non-tidal wetland rehabilitation, non-tidal wetland restoration, inland wetland management, non-tidal wetland management, inland wetland re-establishment, non-tidal wetland re-establishment, bog re-establishment, bog rehabilitation, bog restoration, freshwater wetland management, freshwater wetland rehabilitation, freshwater wetland restoration, freshwater wetlands management, freshwater wetlands rehabilitation, freshwater wetlands restoration, inland wetlands management, inland wetlands rehabilitation, inland wetlands restoration, restoration of freshwater wetlands</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1406"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1921"/>
        <cpr:P7 xml:lang="en">Inland wetland restoration is the manipulation of a former or degraded inland wetland&apos;s physical, chemical, or biological characteristics to return its natural functions. Restoration practices include re-establishment, the rebuilding a former wetland; and rehabilitation, repairing the functions of a degraded wetland and making it more resilient to climate change.</cpr:P7>
        <schema:description xml:lang="en">Inland wetland restoration is the manipulation of a former or degraded inland wetland&apos;s physical, chemical, or biological characteristics to return its natural functions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1849 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1849">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">grassland restoration</rdfs:label>
        <skos:altLabel xml:lang="en">grassland rehabilitation, savannah rehabilitation, savannah restoration, shrubland rehabilitation, shrubland restoration, savanna rehabilitation, savanna restoration, meadow rehabilitation, meadow restoration, restoring grasslands, restoring meadows, restoring savannah, restoring shrubland, rehabilitate grasslands, rehabilitation of grassland, rehabilitation of grasslands, restoration of grassland, restoration of grasslands, restore grassland, restore grasslands, restore savannah, restore savannas, restored grasslands, restoring grassland</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P7 xml:lang="en">Grassland restoration and rehabilitation include activities to preserve or restore grasslands for agricultural, conservation and carbon storage reasons. Restoration of these grasslands may benefit some mammal species that are associated with them.</cpr:P7>
        <schema:description xml:lang="en">Actions to restore and rehabilitate grasslands, including savannah and shrubland</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q185 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q185">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q182"/>
        <rdfs:label xml:lang="en">resilient port infrastructure</rdfs:label>
        <skos:altLabel xml:lang="en">resilient port, resilient ports, adaptation of dock, adaptation of docks, adaptation of ferryport, adaptation of ferryports, adaptation of marina, adaptation of marinas, adaptation of port, adaptation of ports, adaptation of seaport, adaptation of seaports, adaptation of wharf, adaptation of wharves, adaptations of dock, adaptations of docks, adaptations of ferryport, adaptations of ferryports, adaptations of marina, adaptations of marinas, adaptations of port, adaptations of ports, adaptations of seaport, adaptations of seaports, adaptations of wharf, adaptations of wharves, adapting dock, adapting docks, adapting ferryport, adapting ferryports, adapting marina, adapting marinas, adapting port, adapting ports, adapting seaport, adapting seaports, adapting wharf, adapting wharves, adaptive capacity of dock, adaptive capacity of docks, adaptive capacity of ferryport, adaptive capacity of ferryports, adaptive capacity of marina, adaptive capacity of marinas, adaptive capacity of port, adaptive capacity of ports, adaptive capacity of seaport, adaptive capacity of seaports, adaptive capacity of wharf, adaptive capacity of wharves, climate resilient dock, climate resilient docks, climate resilient ferryport, climate resilient ferryports, climate resilient marina, climate resilient marinas, climate resilient port, climate resilient ports, climate resilient seaport, climate resilient seaports, climate resilient wharf, climate resilient wharves, climate-smart dock, climate-smart docks, climate-smart ferryport, climate-smart ferryports, climate-smart marina, climate-smart marinas, climate-smart port, climate-smart ports, climate-smart seaport, climate-smart seaports, climate-smart wharf, climate-smart wharves, resilience of dock, resilience of docks, resilience of ferryport, resilience of ferryports, resilience of marina, resilience of marinas, resilience of port, resilience of ports, resilience of seaport, resilience of seaports, resilience of wharf, resilience of wharves, resilient dock, resilient docks, resilient ferryport, resilient ferryports, resilient marina, resilient marinas, resilient seaport, resilient seaports, resilient wharf, resilient wharves</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P4 rdf:resource="https://resilientmaritimelogistics.unctad.org/guidebook/14-climate-change"/>
        <cpr:P4 rdf:resource="https://resilientmaritimelogistics.unctad.org/guidebook/21-defining-port-resilience"/>
        <schema:description xml:lang="en">Port resilience is the ability to maintain an acceptable level of service in the face of disruptions. Ports&apos; resilience is largely determined by their ability to remain operational and offer services and infrastructure to ships, cargoes, and other customers during disruptions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1850 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1850">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">avoided grassland and shrubland conversion</rdfs:label>
        <skos:altLabel xml:lang="en">avoided savannah conversion, avoided shrubland conversion, avoided planned grassland conversion, avoided planned savannah conversion, avoided planned shrubland conversion, ACoGS, avoided conversion of grasslands and shrublands, avoided grassland loss, avoided savanna conversion, avoided savanna loss, avoided savannah loss, reduce conversion of grassland, reduce conversion of grasslands, conservation of grassland, conservation of grasslands, grassland conservation, grassland protection, grasslands conservation, grasslands protected, protect grasslands, protection of grassland, protection of grasslands, grassland preservation, maintain grassland, maintain grasslands, preserve grassland, preserve grasslands, meadow protection, protection of meadows, conservation of savannah, conservation of shrubland, conserve grassland, conserve shrubland, conserving grassland, conserving savannah, conserving shrubland, protect grassland, protect savannah, protect shrubland, protecting grasslands, protecting savannah, protecting shrubland, preserved grassland, preserved grasslands, conservation of meadow, conservation of meadows, conservation of shrublands, conserve grasslands, conserve meadow, conserve meadows, conserve shrublands, conserving grasslands, conserving meadow, conserving meadows, conserving shrublands, grassland protected, grasslands preservation, grasslands protection, meadow conservation, meadow preservation, meadow protected, meadows conservation, meadows preservation, meadows protected, meadows protection, preservation of grassland, preservation of grasslands, preservation of meadow, preservation of meadows, preservation of shrubland, preservation of shrublands, preserve meadow, preserve meadows, preserve shrubland, preserve shrublands, preserved meadow, preserved meadows, preserved shrubland, preserved shrublands, preserving grassland, preserving grasslands, preserving meadow, preserving meadows, preserving shrubland, preserving shrublands, protect meadow, protect meadows, protect shrublands, protecting grassland, protecting meadow, protecting meadows, protecting shrublands, protection of meadow, protection of shrubland, protection of shrublands, shrubland conservation, shrubland preservation, shrubland protected, shrubland protection, shrublands conservation, shrublands preservation, shrublands protected, shrublands protection</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2790"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P7 xml:lang="en">Avoided grassland and shrubland conversion refers to activities and measures to prevent grassland and shrubland being converted to other land uses, such as agriculture and crop production, or infrastructure, maintaining ecosystem resilience to climate change. Grassland and shrubland soils are significant reservoirs of organic carbon that will, if left uncultivated, continue to store this carbon below ground.  Grassland and shrubland ecosystems may also support greater plant biomass than annual cropland, especially below ground.</cpr:P7>
        <schema:description xml:lang="en">Avoided grassland and shrubland conversion refers to activities and measures to prevent grassland and shrubland being converted to other land uses, such as agriculture and crop production, or infrastructure, maintaining ecosystem resilience to climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1851 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1851">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">avoided forest conversion</rdfs:label>
        <skos:altLabel xml:lang="en">conserve forests, conserving forests, avoided deforestation, avoided forest degradation, avoided forest loss, avoided forest losses, avoid deforestation, avoid forest degradation, deforestation avoided, forest degradation avoided, maintain forest cover, prevent deforestation, prevent forest degradation, prevents deforestation, avoiding deforestation, preventing deforestation, stop deforestation, stopping deforestation, prohibit logging, prohibits logging, conservation of forest, conservation of forests, forest conservation, forest preservation, forest protected, forest protection, forests protected, preservation of forest, preservation of forests, preserve forest, preserve forests, protect forest, protect forests, protection of forest, protection of forests, limit deforestation, forests protection, preserved forest, preserved forests, apprehend deforestation, deforestation reduction, eliminate deforestation, zero deforestation, zero-deforestation, avoiding cutting down of forests, avoiding forest degradation, jungle protection, preserving forest, preserving forests, protecting forest, protecting forests, slowing deforestation, slowing forest degradation, prevent forest loss, prevent loss of forests, preventing forest loss, prevention of forest loss, stopping forest loss, conserve forest, conserving forest, forests conservation, forests preservation, maintenance of forest, maintenance of forest cover, preserve forest cover, control deforestation, deforestation reduced, minimize deforestation, minimizing deforestation, reduce deforestation, reduce emissions from deforestation, reduce emissions from deforestation and forest degradation, reduce forest loss, reduce GHG emissions from deforestation, reduce GHG emissions from forest degradation, reduce rates of deforestation, reduce the rate of deforestation, reducing deforestation, reducing emissions from deforestation, reducing emissions from deforestation and forest degradation, reducing forest loss, reducing GHG emissions from deforestation, reduction of emissions from deforestation, reduction of emissions from forest degradation, reduced emissions from deforestation, forest degradation reduced, reduce forest degradation, reducing forest degradation</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1404"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P7 xml:lang="en">Avoided forest conversion refers to activities that avoid deforestation and maintain the integrity and resilience of forested ecosystems. This maintains carbon stocks and forest resilience to climate change. Activities include designation of conservation easements on forested land, the use of protective guidelines, such as best management practices, that avoid unintentional loss of forest cover or soil carbon and reducing the amount of forest that is displaced for forest management activities (e.g. designing road systems or landings to minimize their footprint).</cpr:P7>
        <schema:description xml:lang="en">Avoided forest conversion refers to activities that avoid deforestation and maintain the integrity and resilience of forested ecosystems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1853 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1853">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <rdfs:label xml:lang="en">forest stewardship</rdfs:label>
        <skos:altLabel xml:lang="en">close-to-nature forest management, sustainable forest management, ecological forest management, integrated forest management, SFM, responsible forest management, sustainable management of forest, sustainable management of forests, sustainable management of native forests, responsible forestry, sustainable forestry, forests managed sustainably, manage forests sustainably, managing forests sustainably, sustainable management of woodlands, sustainably managed forest, sustainably managed forests, sustainable management of timber, sustainable use of forest products, sustainable use of forests, sustainable use of non-timber forest products, sustainable use of non-timber products from forests, sustainable use of timber, natural forest management</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q134"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1586"/>
        <cpr:P7 xml:lang="en">Forest stewardship is a general approach to forest management that meets the needs of current owners but doesn&apos;t detract from or degrade the use by future generations. Forest stewardship is based on conservation principles that ensure protection of all forest resources including wildlife, timber, soil, water recreational opportunities and makes them more resilient to climate change. Forest stewards actively manage their land on a long-term basis by following management objectives that are based on multiple resources, are economically viable and conserve natural resources.</cpr:P7>
        <schema:description xml:lang="en">Forest stewardship is a general approach to forest management that meets the needs of current owners but doesn&apos;t detract from or degrade the use by future generations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1854 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1854">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:label xml:lang="en">rainguard for rubber trees</rdfs:label>
        <skos:altLabel xml:lang="en">polythene skirt rainguards</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P7 xml:lang="en">Rainguards protect rubber tree tapping, helping to maintain latex rubber tapping yields and prevent the growth of fungi during periods of rainfall.</cpr:P7>
        <schema:description xml:lang="en">Rainguards protect rubber tree tapping, helping to maintain rubber tapping yields and prevent the growth of fungi during periods of rainfall.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1855 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1855">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:label xml:lang="en">agroforestry</rdfs:label>
        <skos:altLabel xml:lang="en">trees in cropland, trees in croplands, agro-sylviculture, agrosilviculture, farm forestry, forest farming, agro-forestry, farming in forest, trees in farming, agro-forest, agro-forests, agroforest, agroforests, silvoarable</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1864"/>
        <cpr:P7 xml:lang="en">Agroforestry refers to land use systems in which trees are grown in combination with agriculture on the same land. Agroforestry exploits the complementarity between perennial species (trees or shrubs) and crops, so that the available resources can be more effectively exploited. Efficient and modern versions of agroforestry allow the diversification of farm activity and make better use of environmental resources. Agroforestry can be implemented in different regions, producing food and fibre for better food and nutritional security, sustaining livelihoods, alleviating poverty and promoting productive, resilient agricultural environments. Moreover, agroforestry can contribute to climate change adaptation by preventing deforestation, increasing biodiversity conservation, producing cleaner water and controlling soil erosion, thus enabling agricultural lands to better cope with floods and drought events.</cpr:P7>
        <schema:description xml:lang="en">Agroforestry refers to land use systems in which trees are grown in combination with agriculture on the same land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1856 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1856">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">climate-resilient crop storage</rdfs:label>
        <skos:altLabel xml:lang="en">grain storage</skos:altLabel>
        <cpr:P7 xml:lang="en">Climate-resilient crop storage refers to methods to store crops post harvest and ensure they remain in good condition that can withstand future climate impacts.</cpr:P7>
        <schema:description xml:lang="en">Climate-resilient crop storage refers to methods to store crops post harvest and ensure they remain in good condition that can withstand future climate impacts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1857 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1857">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">ex situ conservation</rdfs:label>
        <skos:altLabel xml:lang="en">seed bank, artificial propagation of plants, seed banks, preservation of seed, preservation of seeds</skos:altLabel>
        <cpr:P7 xml:lang="en">Ex situ or ‘off-site’ conservation means the conservation of components of biological diversity outside their natural habitats. The main objective of ex situ techniques is to support conservation by ensuring the survival of threatened species and the maintenance of associated genetic diversity. Ex situ techniques should always be seen as complimentary to in situ conservation, aiding species recovery and reintroduction. The main techniques are: gene banks, e.g. seed banks, sperm and ova banks; captive breeding of animals and artificial propagation of plants; and collections of living organisms for zoos, aquaria, and botanic gardens for research and public awareness.</cpr:P7>
        <schema:description xml:lang="en">Ex situ or ‘off-site’ conservation means the conservation of components of biological diversity outside their natural habitats.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1858 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1858">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2579"/>
        <rdfs:label xml:lang="en">food surplus distribution</rdfs:label>
        <skos:altLabel xml:lang="en">food bank, distributing food surplus, distribution of food surplus, distribute food surplus, food banks, redistributing food surplus, redistribution of food surplus</skos:altLabel>
        <cpr:P7 xml:lang="en">Food surplus distribution refers to increasing the availability of food by enabling products to flow from surplus to deficit areas, which can emerge as a consequence of extreme weather events or other disruptions. It is a practice used to reduce emissions related to food waste management and adapt to climate-related food insecurity.</cpr:P7>
        <schema:description xml:lang="en">Food surplus distribution refers to increasing the availability of food by enabling products to flow from surplus to deficit areas, which can emerge as a consequence of extreme weather events or other disruptions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1860 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1860">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">increasing crop resilience and productivity</rdfs:label>
        <skos:altLabel xml:lang="en">improving crop resilience, resilient crops, resistant crops, tolerant crops</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1613"/>
        <cpr:P7 xml:lang="en">Increasing crop resilience refers to activities to improve the ability of plants to withstand and recover from stressors, ensuring consistent yields and overall health.</cpr:P7>
        <schema:description xml:lang="en">Increasing crop resilience refers to activities to improve the ability of plants to withstand and recover from stressors, ensuring consistent yields and overall health.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1861 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1861">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">sustainable fertilizer</rdfs:label>
        <skos:altLabel xml:lang="en">sustainable fertilisers, sustainable fertilizers, sustainable fertiliser, eco-friendly fertilizers, responsible use of fertilizers, sustainable fertilisation, sustainable fertilization, sustainable use of fertilisers, sustainable use of fertilizers, ecological fertilizers, green fertiliser, green fertilisers, green fertilizer, green fertilizers</skos:altLabel>
        <cpr:P7 xml:lang="en">Sustainable fertilizers refer to a biodigester system utilizing organic waste, particularly animal and human excreta, to produce fertilizer and biogas. A biodigester consists of an airtight, high-density polyethylene container within which excreta diluted in water flow continuously and are fermented by microorganisms present in the waste. The fermentation process is anaerobic, i.e., it takes place without oxygen, and the bacteria responsible for decomposition are methanogenic (i.e., they produce methane, also known as biogas). The processed manure is an organic, pathogen-free fertilizer that is rich in nitrogen, phosphorus and potassium. The products are primarily for self-consumption on farms. By producing a nutrient-rich fertilizer, this system reduces the need for agricultural inputs. Adding manure to soils reduces their deterioration and increases their productivity. Soil to which organic fertilizers have been added is less vulnerable to pests, erosion and drought.</cpr:P7>
        <schema:description xml:lang="en">Sustainable fertilizer refers to a biodigester system utilizing organic waste, particularly animal and human excreta, to produce fertilizer and biogas.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1862 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1862">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">fodder crop</rdfs:label>
        <skos:altLabel xml:lang="en">fodder crops, resilient fodder</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <cpr:P7 xml:lang="en">Fodder crops are homegrown crops used to feed livestock. They can help to reduce the reliance on purchased feeds increasing the resilience of farms. Subsistence farmers often rely on fodder crops to sustain healthy herds.</cpr:P7>
        <schema:description xml:lang="en">Fodder crops are homegrown crops used to feed livestock. They can help to reduce the reliance on purchased feeds increasing the resilience of farms.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1863 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1863">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">greenhouse crop management</rdfs:label>
        <skos:altLabel xml:lang="en">agriculture in greenhouse, agriculture in greenhouses, crops in greenhouse, cultivation in greenhouses, greenhouse agriculture, greenhouse crop, greenhouse crops, greenhouse cultivation, greenhouse farm, greenhouse farming, greenhouse growing, greenhouse production, growing in greenhouses, production in greenhouses, greenhouse horticulture, horticulture in greenhouse, horticulture in greenhouses</skos:altLabel>
        <cpr:P7 xml:lang="en">Greenhouse crop management refers to using greenhouse-type structures to create optimal climate, water, pest control, soil fertility and ventilation conditions in order to attain high productivity more quickly, at lower cost and with less of an environmental impact. Climate variables inside the greenhouse are controlled with several devices and materials including, inter alia, shade mesh, windows and openings, forced ventilation and humidifiers. The shape of the structure and the material with which it is covered will vary according to the specific purpose (for example, germination). By providing a space with the most suitable microclimate for cultivation, greenhouses diminish the impact of changing rainfall patterns, strong winds, hail, frost and extreme heat. This raises productivity, avoids crop damage and failure and improves food security.</cpr:P7>
        <schema:description xml:lang="en">Greenhouse crop management refers to using greenhouse-type structures to create optimal climate, water, pest control, soil fertility and ventilation conditions in order to attain high productivity more quickly, at lower cost and with less of an environmental impact.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1864 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1864">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">organic agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">organic farming, organic cultivation, organic farm, organic production, growing organic, organic agricultural produce, organic certification, organic crop, organic crops, organic growing, organic produce, certification of organic products</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1855"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1866"/>
        <cpr:P7 xml:lang="en">Organic agriculture is a production system which avoids or largely excludes the use of synthetic fertilisers, pesticides and growth regulators. It can sequester carbon using crop rotations, crop residues, animal manure, legumes, green manure, and off-farm organic waste. It can also reduce carbon emissions by avoiding the use of fossil fuels used in the manufacture of the chemicals used to make synthetic materials. Organic agriculture increases soil’s water retention capacity, which would enable a crop to go longer into a drought cycle assuming an initial full profile. This provides an adaptation measure to unpredictable climatic conditions. Organic systems are highly adaptive to climate change due to the application of traditional skills and farmers’ knowledge, soil fertility-building techniques and a high degree of diversity.</cpr:P7>
        <schema:description xml:lang="en">Organic agriculture is a production system which avoids or largely excludes the use of synthetic fertilisers, pesticides and growth regulators.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1865 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1865">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">biochar</rdfs:label>
        <skos:altLabel xml:lang="en">biochar technology, bio char</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1784"/>
        <cpr:P7 xml:lang="en">Biochar is a form of charcoal created by heating organic material, known as biomass, in an environment without oxygen at temperatures of 400°C or higher. This  pyrolysis process produces energy-rich gases and liquids as well as a solid product—biochar. It is used as soil enhancer to increase fertility, prevent soil degradation and to sequester carbon in the soil.</cpr:P7>
        <schema:description xml:lang="en">Biochar is a form of charcoal created by heating organic material, known as biomass, in an environment without oxygen at temperatures of 400°C or higher.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1866 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1866">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">pest and disease control</rdfs:label>
        <skos:altLabel xml:lang="en">disease-resistant crops</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1864"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2808"/>
        <cpr:P7 xml:lang="en">Pest and insect control refers to increasing the resilience of crops to pests and insects. For example, disease-resistant early-maturing peanut variety.</cpr:P7>
        <schema:description xml:lang="en">Pest and insect control refers to increasing the resilience of crops to pests and insects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1867 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1867">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">genetically modified crops</rdfs:label>
        <skos:altLabel xml:lang="en">biotechnology for crop adaptation, GMO crops, genetically engineered crops, genetically modified crop, genetically modified food, genetically modified foods, gm crop, gm crops, GMO crop, gmos in agriculture, modified crop genetics, modify crop genetics</skos:altLabel>
        <cpr:P7 xml:lang="en">Biotechnology for crop adaptation refers to breeding crops for improved performance under environmental stresses involving activities which accumulate favourable alleles (different forms of a gene) and increase stress tolerance. Biotechnological contributions to crop adaptation to climate change concern the placement into the crop of one or more genes from an organism with which the crop could not normally breed (i.e. genetically modified crops). Biotechnological tools focus on providing the ability to directly detect and transfer genes of interest from other plant lines or organisms into the crop of interest without the continuing need to use the appearance or stress response of the plant (its phenotype) as a proxy for the presence of that gene.</cpr:P7>
        <schema:description xml:lang="en">Biotechnology for crop adaptation refers to breeding crops for improved performance under environmental stresses involving activities which accumulate favourable alleles (different forms of a gene) and increase stress tolerance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1868 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1868">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">climate-resilient livestock management</rdfs:label>
        <skos:altLabel xml:lang="en">resilient animal husbandry</skos:altLabel>
        <cpr:P7 xml:lang="en">Climate-resilient livestock management refers to activities to adapt livestock farming to climate change.</cpr:P7>
        <schema:description xml:lang="en">Climate-resilient livestock management refers to activities to adapt livestock farming to climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1869 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1869">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">land management training</rdfs:label>
        <skos:altLabel xml:lang="en">land management education</skos:altLabel>
        <schema:description xml:lang="en">Training and education for farmers and agricultural workers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1870 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1870">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">community-based agricultural extension</rdfs:label>
        <skos:altLabel xml:lang="en">local agricultural extension</skos:altLabel>
        <cpr:P7 xml:lang="en">Agricultural extension describes the services that provide rural people with the access to knowledge and information they need to increase productivity and sustainability of their production systems and improve their quality of life and livelihoods. Recent developments in agricultural policies have re-emphasised the importance of extension services (extensionists are technically qualified individuals who provide outreach services to rural areas). However, models of extension based on government services or private agro-dealers and service providers are not sufficient to meet the needs of farmers in less favoured areas. This is due to a number of factors including the necessity to respond to the specific technological needs of farmer in different agroecological zones, high transaction costs of reaching remote areas; the need for localised crop and livestock management solutions suited to tough environmental conditions, which are often not well understood by extension agents trained for work in high potential areas; and the challenges of finding professional extension specialists willing to live and work in remote, and sometimes insecure areas. The community-based rural agricultural extension model is based on the idea of providing specialised and intensive technical training to 1 or 2 people in a community who then promote a variety of appropriate technologies and provide technical services with occasional support and review from a supporting organisation. This model is demand-based in that the providers of service are contracted directly by farmers’ groups or communities to deliver information and related services that are specified by farmers. These models have generally experienced a high degree of success in terms of discovering or identifying productivity enhancing technologies, which are then widely adopted. They have also been able to do so at relatively low cost.</cpr:P7>
        <schema:description xml:lang="en">Agricultural extension describes the services that provide rural people with the access to knowledge and information they need to increase productivity and sustainability of their production systems and improve their quality of life and livelihoods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1871 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1871">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">forest user group</rdfs:label>
        <skos:altLabel xml:lang="en">forest user executive committee</skos:altLabel>
        <cpr:P7 xml:lang="en">In many countries, forest governance has remained a centralised and top-down process. Policies ignore the role of forests in tribal livelihoods and cultures, violating the overlapping laws protecting the rights of these communities. Premises and procedures for identifying and defining forests are poor, resulting in land use conflicts, unclear boundaries, legal disputes and inappropriate management objectives for lands wrongly classified as ‘forest’. Forest User Groups (FUGs) represent one mechanism for decentralising forest management and increasing community-based responsibility and authority. FUGs are based on the three principles of participation, collective action and long-term sustainability. They are formed through democratic processes whereby local residents are elected as community representatives to work as an autonomous body alongside existing government authorities to manage forest resources and to articulate the needs and priorities of local people. FUG members may receive training in resource management and participate in multi-stakeholder forest management mechanisms, develop land-use plans in line with national forest laws and regulations, and undertake forest patrols and awareness-raising with the aim of curbing illegal activities.</cpr:P7>
        <schema:description xml:lang="en">Forest User Groups (FUGs) are a mechanism for decentralising forest management and increasing community-based responsibility and authority.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1872 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1872">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1869"/>
        <rdfs:label xml:lang="en">farmer field school</rdfs:label>
        <skos:altLabel xml:lang="en">farmer field schools</skos:altLabel>
        <cpr:P7 xml:lang="en">The Farmer Field School (FFS) is a group-based learning process that has been used by a number of governments, NGOs and international agencies originally to promote integrated pest management. The first FFS were designed and managed by the Food and Agriculture Organisation (FAO) in Indonesia in 1989. They were developed in response to perception that small farmers were not managing agrochemical-based agriculture well, particularly pest management through the use of pesticides. Many farmers did not have the resources to use pesticides, and sometimes wrong uses and storage caused the problems of poisoning. Furthermore many pests seemed to rapidly develop resistance to the pesticides. FFSs bring together concepts and methods from agro-ecology, experimental education and community development, as a group-based learning process. Overall, FFSs look to reinforce the understanding of farmers about the ecological processes that affect the production of their crops and animals, through conducting field learning exercises such as field observations, simple experiments and group analysis.The knowledge gained from these activities enables participants to make their own locally-specific decisions about crop management practices. Although FFSs were initiated as a training process for pest control in field crops, the principles have now been adapted to all agricultural production systems from livestock to coffee production.</cpr:P7>
        <schema:description xml:lang="en">The Farmer Field School is a group-based learning process that has been used by a number of governments, NGOs and international agencies originally to promote integrated pest management.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1873 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1873">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:label xml:lang="en">food system resilience</rdfs:label>
        <skos:altLabel xml:lang="en">food market distribution resilience, food system resilience</skos:altLabel>
        <cpr:P7 xml:lang="en">Resilience in local and global food systems.</cpr:P7>
        <schema:description xml:lang="en">Measures to increase resilience in local and global food systems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1874 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1874">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:label xml:lang="en">food supply chain resilience</rdfs:label>
        <skos:altLabel xml:lang="en">food supply chain efficiency, cold food supply chain efficiency, cold food supply chain resilience, refrigerated food supply chain, resilience in global flows of food, resilience in international flows of food, global food supply chain resilience, adapting food value chains, food value chain resilience, resilient food value chain, resilient food distribution</skos:altLabel>
        <schema:description xml:lang="en">Measures to increase resilience in local and global food supply chains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1875 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1875">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:label xml:lang="en">agro-processing resilience</rdfs:label>
        <skos:altLabel xml:lang="en">agro-processing efficiency</skos:altLabel>
        <schema:description xml:lang="en">Actions to increase resilience in agro-processing and the transformation of products that originate from agriculture, forestry and fisheries.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1876 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1876">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:label xml:lang="en">food market access resilience</rdfs:label>
        <skos:altLabel xml:lang="en">market access for agricultural, market access for farmers, market access for pastoralist, market access for pastoralists, market access for small-scale farmer, market access for small-scale farmers, market access for smallholders, market access for subsistence farmers, improve market access, improved market access, enhance access to market, enhance access to markets, enhanced access to market, enhanced access to markets, protect access to market, protect access to markets, protection of access to market, protection of access to markets, increase access to market, increased access to market, protecting access to market, protecting access to markets, market access resilience, resilient access to market</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q757"/>
        <schema:description xml:lang="en">Actions to increase resiience in food market access. Food market access refers to the ability for goods to enter and be sold in a target market, involving government policies, regulations, and infrastructure to reduce barriers to trade and facilitate the flow of food products.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1877 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1877">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <rdfs:label xml:lang="en">water efficiency in industry</rdfs:label>
        <cpr:P7 xml:lang="en">Increasing water efficiency in industry can reduce use and produce a number of environmental and socio-economic benefits. Behavioural, operational and technological changes can all contribute to improved water efficiency in industrial production. Significant improvements can be achieved with more effective leak detection and repair of water pipes and use of new and more efficient technologies (e.g. pipes, smart dosage systems, timers, higher efficiency cleaning systems, water monitoring systems). Increasing awareness and changing behavioural patterns can also reduce water consumption amongst workers. On a regulatory level, industrial water efficiency can be encouraged by establishing tariffs as a water conservation incentive. Industrial reuse and recycling also increases efficiency as it creates a new water source that does not require extraction or transportation from elsewhere. This in turn reduces costs, energy use and pressures on freshwater sources.</cpr:P7>
        <schema:description xml:lang="en">Increasing water efficiency in industry can reduce use and produce a number of environmental and socio-economic benefits.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1878 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1878">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <rdfs:label xml:lang="en">progressive water pricing</rdfs:label>
        <cpr:P7 xml:lang="en">Progressive pricing is an instrument to manage water demand and help reduce excessive water consumption through an economic dis-incentive. Progressive pricing means that water price rates per unit of volume increase, as the volume used increases. Thus the largest consumers of water pay higher rates for the volume of water consumed beyond a certain threshold.</cpr:P7>
        <schema:description xml:lang="en">Progressive pricing is an instrument to manage water demand and help reduce excessive water consumption through an economic dis-incentive.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1879 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1879">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1395"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <rdfs:label xml:lang="en">water savings requirement in building codes</rdfs:label>
        <cpr:P7 xml:lang="en">Water savings (or water efficiency) requirements in building codes is a legislative approach to improve efficiency in commercial and residential buildings. The building codes may require installation of modern  technologies such as water pressure control, faucet aerators, leak detectors, water-saving toilets, etc. to maximize use efficiency, but can also require installation of internal water recycling systems or the establishment of infrastructure to provide alternative water sources, for example rainwater harvesting tanks. Water saving requirements are mostly applied to newly constructed buildings, but they may also by applied in existing buildings in the form of  a retrofit of existing facilities.</cpr:P7>
        <schema:description xml:lang="en">Water savings (or water efficiency) requirements in building codes is a legislative approach to improve efficiency in commercial and residential buildings.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1880 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1880">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2011"/>
        <rdfs:label xml:lang="en">water augmentation</rdfs:label>
        <skos:altLabel xml:lang="en">increase water capture, increase water storage, increasing water capture, increasing water storage, increasing water resource, increasing water resources, supplementary resources for water, supplementary water resources, supplementary water supply</skos:altLabel>
        <schema:description xml:lang="en">Increasing capture and storage of surface run-off.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1881 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1881">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:label xml:lang="en">resilient hydropower</rdfs:label>
        <skos:altLabel xml:lang="en">adaptation of hydropower, adapting hydropower, hydropower resilience</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q606"/>
        <schema:description xml:lang="en">Ensuring hydropower infrastucture is built to withstand future climate changes</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1882 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1882">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2012"/>
        <rdfs:label xml:lang="en">storm water management</rdfs:label>
        <skos:altLabel xml:lang="en">stormwater drainage, urban storm water management, urban stormwater management, natural drainage system, sustainable urban drainage system, sustainable urban drainage systems, increase drainage efficiency, storm water management, sponge cities, sponge city, storm water drainage</skos:altLabel>
        <schema:description xml:lang="en">Management of rainwater runoff to minimize flooding, erosion, and water pollution, often through the use of drainage systems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1883 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1883">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2011"/>
        <rdfs:label xml:lang="en">alternative water sources</rdfs:label>
        <skos:altLabel xml:lang="en">unconventional water production, unconventional water source, unconventional water sources</skos:altLabel>
        <schema:description xml:lang="en">Harvesting water from sources other than rainwater.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1884 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1884">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:label xml:lang="en">limiting nutrient leakage</rdfs:label>
        <skos:altLabel xml:lang="en">limiting nutrient runoff</skos:altLabel>
        <schema:description xml:lang="en">Preventing leakage of nutrients from soil to surface water and groundwater</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1885 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1885">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2011"/>
        <rdfs:label xml:lang="en">water allocation</rdfs:label>
        <skos:altLabel xml:lang="en">water distribution, sharing water, water reallocation, distribution of water</skos:altLabel>
        <schema:description xml:lang="en">Practice of sharing water among different uses where there is not enough to satisfy all demands, aiming to maximise societal benefits.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1886 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1886">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1833"/>
        <rdfs:label xml:lang="en">resilient healthcare service</rdfs:label>
        <skos:altLabel xml:lang="en">resilient healthcare services, adaptive healthcare, resilient emergency care, resilient healthcare, resilient primary care, healthcare adaptation, adaptation of medical, adaptation of emergency care, adaptation of healthcare, adaptation of primary care, adaptations of emergency care, adaptations of healthcare, adaptations of medical, adaptations of primary care, adapting emergency care, adapting healthcare, adapting medical, adapting primary care, adaptive capacity of emergency care, adaptive capacity of healthcare, adaptive capacity of medical, adaptive capacity of primary care, climate resilient emergency care, climate resilient healthcare, climate resilient medical, climate resilient primary care, climate-smart emergency care, climate-smart healthcare, climate-smart medical, climate-smart primary care, resilience of emergency care, resilience of healthcare, resilience of medical, resilience of primary care, resilient medical</skos:altLabel>
        <schema:description xml:lang="en">Actions to adapt and increase the resilience of healthcare services to climate change, including primary and emergency care.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1887 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1887">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1833"/>
        <rdfs:label xml:lang="en">resilient healthcare IT system</rdfs:label>
        <skos:altLabel xml:lang="en">IT systems in the health sector, digital healthcare system, resilient healthcare IT system</skos:altLabel>
        <schema:description xml:lang="en">Resilient digital healthcare systems that enable continuous patient care during disruptions such as pandemics, cyber attacks, extreme weather or system outages.</schema:description>
    </owl:Class>
    


