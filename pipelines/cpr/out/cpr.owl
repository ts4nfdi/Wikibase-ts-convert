    <!-- https://climatepolicyradar.wikibase.cloud/entity/P20 -->


    <owl:AnnotationProperty rdf:about="https://climatepolicyradar.wikibase.cloud/entity/P20">
        <rdfs:label xml:lang="en">Classifier ID</rdfs:label>
        <skos:altLabel xml:lang="en">CPR classifier ID, Huggingface ID, Wandb ID, Weights and Biases ID</skos:altLabel>
        <schema:description xml:lang="en">The ID of the classifier used by Climate Policy Radar to identify where the concept is mentioned in documents. Each ID is comprised of 8 lowercase characters and numbers. The ID should match the one seen in the vibe checker, and in our weights and biases account.</schema:description>
    </owl:AnnotationProperty>
    


