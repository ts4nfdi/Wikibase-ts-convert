        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q650"/>
        <cpr:P7 xml:lang="en">LPG is a flammable hydrocarbon mainly made up of propane and butane, and is a byproduct of natural gas processing and crude oil refining.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1307">
