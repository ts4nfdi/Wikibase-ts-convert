        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1975"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1981"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1984"/>
