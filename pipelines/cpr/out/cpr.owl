    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1955 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1955">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">hard river flood protection</rdfs:label>
        <skos:altLabel xml:lang="en">hard river flood defences, protective river structure, protective river structures</skos:altLabel>
        <schema:description xml:lang="en">Measures to prevent river flooding that use artificial structures such as dams and embankments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1956 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1956">
