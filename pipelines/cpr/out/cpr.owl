        <skos:altLabel xml:lang="en">liquified natural gas</skos:altLabel>
        <skos:altLabel xml:lang="en">liquified natural gases</skos:altLabel>
        <schema:description xml:lang="en">LNG is a natural gas, converted into liquid form for ease of storage or transport. The liquefaction process involves cooling the gas to around -162 °C and removing certain impurities, such as dust and carbon dioxide.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q656 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q656">
