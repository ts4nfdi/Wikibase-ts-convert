        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q235"/>
        <schema:description xml:lang="en">A group of synthetic greenhouse gases, used in refrigeration, air conditioning and industrial processes.</schema:description>
    </owl:Class>
    


