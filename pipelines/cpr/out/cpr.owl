    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q100 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q100">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q98"/>
        <rdfs:label xml:lang="en">drought risk mapping</rdfs:label>
        <skos:altLabel xml:lang="en">drought map, drought mapping, drought maps, map drought, mapping drought, mapping drought risk, drought hazard map, drought hazard maps, assessing drought hazard, drought hazard assessment, drought hazard assessments, assess drought hazard, assessed drought hazard</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q385"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/drought-risk-mapping"/>
        <schema:description xml:lang="en">Drought risk mapping helps identify the areas most at risk of droughts, allowing communities to plan, as well as prepare for and mitigate possible impacts. Drought risk is calculated as the probability of negative impact caused by interactions between hazard (probability of future drought events occurring based on past, current and projected drought conditions), exposure (scale of assets and population in the area) and vulnerability (probability of assets and population being affected by droughts in the area).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1000 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1000">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <rdfs:label xml:lang="en">sea overwash</rdfs:label>
        <skos:altLabel xml:lang="en">ocean overwash, wave overwash, overtop, overtopped, overtopping, seawater overwash</skos:altLabel>
        <cpr:P7 xml:lang="en">Overwash is the flow of water and sediment over a coastal dune or beach crest during storm events. This process can cause significant coastal changes in the landscape of beaches and dunes.</cpr:P7>
        <schema:description xml:lang="en">Overwash is the flow of water and sediment over a coastal dune or beach crest during storm events. This process can cause significant coastal changes in the landscape of beaches and dunes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1001 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1001">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">marine waste</rdfs:label>
        <skos:altLabel xml:lang="en">marine debris, marine waste, terrestrial discharge marine debris, storm water discharge, ocean debris, ocean waste</skos:altLabel>
        <cpr:P7 xml:lang="en">Marine debris refers to any persistent solid material that is manufactured or processed and then directly or indirectly, intentionally or unintentionally, discarded or abandoned into oceans or the Great Lakes. No part of Earth is untouched by this issue today.</cpr:P7>
        <schema:description xml:lang="en">Marine debris refers to any persistent solid material that is manufactured or processed and then directly or indirectly, intentionally or unintentionally, discarded or abandoned into oceans or the Great Lakes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1002 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1002">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q393"/>
        <rdfs:label xml:lang="en">marine heatwave</rdfs:label>
        <skos:altLabel xml:lang="en">marine heatwaves, ocean heatwave, ocean heatwaves, abnormal seawater temperature, marine heat wave, marine heat waves, ocean heat wave, ocean heat waves</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q435"/>
        <cpr:P7 xml:lang="en">An extended period of unusually high sea temperatures lasting several days to weeks, with temperatures exceeding local thresholds.</cpr:P7>
        <schema:description xml:lang="en">An extended period of unusually high sea temperatures lasting several days to weeks, with temperatures exceeding local thresholds.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1003 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1003">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">ocean circulation decline</rdfs:label>
        <skos:altLabel xml:lang="en">AMOC collapse, AMOC decline, Atlantic Meridional Overturning Circulation collapse, Atlantic Meridional Overturning Circulation decline, change in ocean circulation, disruption to ocean circulation, ocean circulation change, ocean circulation collapse, ocean circulation disruption, ocean current change, ocean current collapse, AMOC changes, AMOC decrease, AMOC variations, decrease of AMOC, decrease of the AMOC, changes in ocean circulation</skos:altLabel>
        <cpr:P4 rdf:resource="https://e360.yale.edu/features/climate-change-ocean-circulation-collapse-antarctica"/>
        <schema:description xml:lang="en">Disruption to the ocean circulation system could dramatically change climates and temperatures across the globe.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1004 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1004">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:label xml:lang="en">biome shift</rdfs:label>
        <skos:altLabel xml:lang="en">biome change, biome changes, biome shifts, habitat shift, habitat shifts</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q979"/>
        <cpr:P7 xml:lang="en">Changes in a biome as a result of climate change, such as rising temperatures or ocean acidification.</cpr:P7>
        <schema:description xml:lang="en">Changes in a biome as a result of climate change, such as rising temperatures or ocean acidification</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1005 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1005">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">marine toxins</rdfs:label>
        <skos:altLabel xml:lang="en">harmful algal blooms, algal blooms, toxic algae, toxic algae blooms, toxic algal, HABs, algae bloom, algae blooms, biotoxins</skos:altLabel>
        <cpr:P7 xml:lang="en">Marine toxins are highly toxic organic compounds found in the marine environment, often produced by certain types of algae. An algal bloom or algae bloom is a rapid increase or accumulation in the population of algae in freshwater or marine water systems and is harmful to marine ecosystems.</cpr:P7>
        <schema:description xml:lang="en">Marine toxins are highly toxic organic compounds found in the marine environment, often produced by certain types of algae, but also by bacteria. These toxins present a human health hazard.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1006 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1006">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">glacial lake outburst flood</rdfs:label>
        <skos:altLabel xml:lang="en">glacial lake outburst flooding, glacial lake outburst floods, GLOF, GLOFs, glacier hazards, glacier landslide, glacier landslides, glacial lake hazard, glacial lake hazards, glacier hazard, Glacial Lake Outburst Flood, Glacial Lake Outburst Floods, GLOFS, glacier lake flood, glacier lake floods</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q109"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q441"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q974"/>
        <cpr:P7 xml:lang="en">A Glacial Lake Outburst Flood (GLOF) is a sudden release of water from a glacier-fed lake, typically caused by the melting of ice or failure of natural barriers like ice dams or moraines. These floods can occur when lakes form on, beneath, or beside glaciers, leading to rapid downstream flooding.</cpr:P7>
        <schema:description xml:lang="en">A Glacial Lake Outburst Flood (GLOF) is the sudden release of water from a glacier-fed lake, caused by the melting or collapse of surrounding ice or land barriers.</schema:description>
    </owl:Class>
    


