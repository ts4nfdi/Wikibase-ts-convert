    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1381 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1381">
        <rdfs:label xml:lang="en">climate bond</rdfs:label>
        <skos:altLabel xml:lang="en">climate bonds, green bond, green bonds</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1273"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1456"/>
        <cpr:P7 xml:lang="en">Climate bonds are a type of loan used to finance projects that address climate change, in which the debt is to be paid back within a certain amount of time and interest.</cpr:P7>
        <schema:description xml:lang="en">Climate bonds are a type of loan used to finance projects that address climate change, in which the debt is to be paid back within a certain amount of time and interest.</schema:description>
