    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1618 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1618">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1401"/>
        <rdfs:label xml:lang="en">national park</rdfs:label>
        <skos:altLabel xml:lang="en">national parks, national natural park, national natural parks</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1380"/>
        <cpr:P7 xml:lang="en">National parks are protected areas that use zoning and spatial planning to protect biodiversity. Zoning plans, or functional zoning, are a key tool for managing national parks. They help to balance the needs of conservation with human development.</cpr:P7>
        <schema:description xml:lang="en">National parks are protected areas that use zoning and spatial planning to protect biodiversity. Zoning plans, or functional zoning, are a key tool for managing national parks. They help to balance the needs of conservation with human development.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1619 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1619">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1286"/>
        <rdfs:label xml:lang="en">climate-risk early warning system</rdfs:label>
        <skos:altLabel xml:lang="en">climate risk early warning system, climate risk early warning systems, climate-risk early warning systems</skos:altLabel>
        <cpr:P7 xml:lang="en">Early warning system for specific climate-risks, such as extreme weather events like storms or floods.</cpr:P7>
        <schema:description xml:lang="en">Early warning system for specific climate-risks, such as extreme weather events like storms or floods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q162 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q162">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1881"/>
        <rdfs:label xml:lang="en">multi-purpose dams</rdfs:label>
        <skos:altLabel xml:lang="en">multi-purpose dam</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/multipurpose-dams"/>
        <schema:description xml:lang="en">Multipurpose dams combine two or more functions of traditional single-purpose dams into one hydro infrastructure project.  A multipurpose dam may combine storing and supplying water for irrigation, industry and human consumption with other uses such as flood control, power generation, navigation, run-off storage and water discharge regulation.</schema:description>
    </owl:Class>
    


