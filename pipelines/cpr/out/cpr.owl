    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2013 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2013">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1838"/>
        <rdfs:label xml:lang="en">downscaling climate change projections</rdfs:label>
        <skos:altLabel xml:lang="en">downscale climate, downscale climate change, downscale climate change projections, downscaling climate, downscaled climate, downscaled climate change, downscaled projection, downscaled projections, down-scale climate, down-scaled climate, down-scaling climate</skos:altLabel>
        <cpr:P7 xml:lang="en">Extrapolating the effects of large-scale climate processes to regional and local scales of interest. Statistical downscaling encompasses the use of various statistics-based techniques to determine relationships between large-scale climate patterns resolved by global climate models and observed local climate responses. These relationships are applied to GCM results to transform climate model outputs into statistically refined products, often considered to be more appropriate for use as input to regional or local climate impacts studies.</cpr:P7>
        <schema:description xml:lang="en">Extrapolating the effects of large-scale climate processes to regional and local scales of interest.</schema:description>
    </owl:Class>
    


