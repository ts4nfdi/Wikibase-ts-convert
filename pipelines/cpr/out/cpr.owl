    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1726 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1726">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1718"/>
        <rdfs:label xml:lang="en">motor vehicle transport</rdfs:label>
        <skos:altLabel xml:lang="en">motor vehicle transportation</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1728 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1728">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q911"/>
        <rdfs:label xml:lang="en">spatial justice</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1734"/>
        <cpr:P7 xml:lang="en">The just distribution of benefits and impacts related to climate change viewed, through a spatial lens. This can mean, for example, offsetting loss of opportunities in an area with additional investments, providing extra protections for highly vulnerable areas, or ensuring that resources and infrastructure are reaching historically left-behind areas. Often, spatial justice is addressing existing inequalities between rural and urban areas, which may increase due to climate change and the green transition; however, other spatial scales, such as under-invested neighbourhoods, may also be considered relevant.</cpr:P7>
        <schema:description xml:lang="en">The just distribution of benefits and impacts related to climate change viewed through a spatial lens -- for example, rural/urban distributions</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q173 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q173">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">seawater desalination</rdfs:label>
        <skos:altLabel xml:lang="en">desalination of sea water, desalination of seawater, sea water desalination, seawater desalination, desalinisation</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/seawater-desalination"/>
        <schema:description xml:lang="en">Seawater desalination is a process in which salt and other constituents are removed to produce pure water.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1730 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1730">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">transformative justice</rdfs:label>
        <cpr:P7 xml:lang="en">Remaking structural social and institutional inequalities that drive and perpetuate climate change through a whole-of-society transformation. This includes the argument that addressing climate justice requires a fundamental shift away from capitalist, extractivist, and/or neo-colonial systems.</cpr:P7>
        <schema:description xml:lang="en">Remaking structural social and institutional inequalities that drive and perpetuate climate change through a whole-of-society transformation</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1731 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1731">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">recognition justice</rdfs:label>
        <cpr:P7 xml:lang="en">the recognition of underlying systemic injustices and representation of dignity, values and identities of humans and other species. When referencing humans, this dimension refers both to individuals and social groups and entails recognising and respecting how different values, preferences and needs are rooted in diverse histories, identities and cultural backgrounds. For other species, this implies recognising the intrinsic and inherent value of nature regardless of its utility to humans</cpr:P7>
        <schema:description xml:lang="en">recognising and respecting how different values, preferences and needs are rooted in diverse histories, identities and cultural backgrounds</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1732 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1732">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1731"/>
        <rdfs:label xml:lang="en">relational justice</rdfs:label>
        <cpr:P7 xml:lang="en">emphasises the importance of fostering collaborative relationships through dialogue and negotiation, arguing that cooperation between groups and communities must purposely aim to advance climate justice. Fair, equal and respectful relationships are seen as essential in developing equitable climate change responses.</cpr:P7>
        <schema:description xml:lang="en">emphasises the importance of fostering collaborative relationships through dialogue and negotiation, arguing that cooperation between groups and communities must purposely aim to advance climate justice</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1733 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1733">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">justice-informed governance</rdfs:label>
        <skos:altLabel xml:lang="en">just transition governance, human rights-based governance, justice-based governance, transparent governance, accountable governance, HBRA, human-rights based approach, gender-based approach</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q912"/>
        <cpr:P7 xml:lang="en">Governance approaches that promote justice,at minimum by providing a formal opportunity for widespread consultation, but ideally by focussing on institutionalising inclusive principles, creating the conditions for meaningful participation, such as by addressing imbalances in power, access to justice, or the resources to participate effectively</cpr:P7>
        <schema:description xml:lang="en">Promoting a just transition through inclusive and ethical governance initiatives</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1736 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1736">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">equitable rural development</rdfs:label>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1737 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1737">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">climate reparations</rdfs:label>
        <skos:altLabel xml:lang="en">loss and damage reparations, reparations for climate</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q72"/>
        <schema:description xml:lang="en">Seeking redress for the damages of climate change, including historical damages, usually through financial support</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1738 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1738">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">justice-focussed climate solutions</rdfs:label>
        <skos:altLabel xml:lang="en">locally led adaptation</skos:altLabel>
        <schema:description xml:lang="en">Climate actions that explicitly incorporate climate justice principles in their design and implementation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1739 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1739">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <rdfs:label xml:lang="en">economic instruments for a just transition</rdfs:label>
        <cpr:P7 xml:lang="en">Creating new economic opportunities to replace traditional industries or update existing ones, while respecting other elements of climate justice.</cpr:P7>
        <schema:description xml:lang="en">Economic instruments supporting a just transition are financial and policy mechanisms designed to facilitate the shift towards sustainable, low-carbon economies in a way that is equitable, inclusive, and minimises negative socio-economic impacts on communities and workers most affected by this transformation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q174 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q174">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">interbasin transfers</rdfs:label>
        <skos:altLabel xml:lang="en">inter-basin transfer, interbasin transfer, interbasin water transfer</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <schema:description xml:lang="en">Interbasin transfer refers to projects that transport water from one waterbasin or catchment area to another via canals, tunnels, bridges, or stream flow rerouting to usually address water scarcity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1741 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1741">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1763"/>
        <rdfs:label xml:lang="en">deep democracy</rdfs:label>
        <cpr:P7 xml:lang="en">a set of practices as well as a political movement that is radically inclusive, international, class conscious and community-based, to bring about a more equitable world through democratic and self-organised means</cpr:P7>
        <schema:description xml:lang="en">a set of practices as well as a political movement that is radically inclusive, international, class conscious and community-based, to bring about a more equitable world through democratic and self-organised means</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1742 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1742">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1763"/>
        <rdfs:label xml:lang="en">citizens&apos; assembly</rdfs:label>
        <skos:altLabel xml:lang="en">citizen assemblies, citizen assembly, citizens assemblies, citizens assembly, citizens&apos; assemblies, citizen juries, citizen jury, citizens juries, citizens jury, citizens&apos; juries, citizens&apos; jury, mini-public, mini-publics, climate assemblies, climate assembly</skos:altLabel>
        <cpr:P7 xml:lang="en">Creating a representative group of citizens to learn about, deliberate upon, and make recommendations on a given issue. The group is usually randomly selected and their recommendations can have varying levels of political weight, though they are in most cases not binding.</cpr:P7>
        <schema:description xml:lang="en">Creating a representative group of citizens to learn about, deliberate upon, and make recommendations on a given issue.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1744 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1744">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1733"/>
        <rdfs:label xml:lang="en">legal safeguards for vulnerable groups</rdfs:label>
        <skos:altLabel xml:lang="en">human rights legal protection, human-rights legal protection, special legal protection, legal protection for at-risk people, legal protection for at-risk individuals, legal protection of vulnerable, legal safeguards for vulnerable, legal protection for children, legal protection for indigenous, legal protection for migrant, legal protection for migrants, legal protection for people of African descent, legal protection for people with disabilities, legal protection for refugee, legal protection for refugees, legal protection for women, legal protection for youth, legal safeguard for migrant, legal safeguard for migrants, legal safeguard for refugee, legal safeguard for refugees, legal safeguards for children, legal safeguards for indigenous, legal safeguards for people of African descent, legal safeguards for people with disabilities, legal safeguards for women, legal safeguards for youth, legal protection of attention groups, legal safeguard of attention groups, human rights legal protections, legal proctetions for at-risk, legal protection for workers, legal protections for at-risk, legal protections for children, legal protections for indigenous, legal protections for migrants, legal protections for people of African, legal protections for people with disabilities, legal protections for PwDs, legal protections for refugees, legal protections for vulnerable, legal protections for women, legal protections for workers, legal protections for youth, right to legal, right to seek legal, special legal protections</skos:altLabel>
        <cpr:P20 xml:lang="en">7aeap3ca</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1401"/>
        <cpr:P7 xml:lang="en">Certain groups of the population are particularly vulnerable to human rights violations for economic, social, political or historical reasons. Therefore, international law ensures that they receive specific protection.</cpr:P7>
        <schema:description xml:lang="en">Using laws and the legal system more broadly to protect vulnerable entities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1745 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1745">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <rdfs:label xml:lang="en">legal protection for land rights defenders</rdfs:label>
        <skos:altLabel xml:lang="en">legal protection for environmental defender, legal protection for environmental defenders, legal protection for environmental human rights defender, legal protection for environmental human rights defenders, legal protection for land defender, legal protection for land defenders, legal protection for local community defender, legal protection for local community defenders</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1602"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1757"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <schema:description xml:lang="en">A special legal status to protect those who defend the environment and land rights</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1746 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1746">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <rdfs:label xml:lang="en">access to justice</rdfs:label>
        <skos:altLabel xml:lang="en">justice access, access to judicial procedures, public access to justice, social access to justice</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q843"/>
        <cpr:P7 xml:lang="en">Access to justice refers to the public’s right to review by a court or another independent body to ensure that public authorities respect the rights to access to information and public participation, and environmental law in general.</cpr:P7>
        <schema:description xml:lang="en">providing easier access for everyone to legal support and representation, regardless of situation or location</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1747 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1747">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:label xml:lang="en">indigenous self-determination</rdfs:label>
        <skos:altLabel xml:lang="en">self-determination of indigenous, self-determination of first nations, self-determination of maori</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P7 xml:lang="en">Self-determination is an ongoing process of ensuring that peoples are able to make decisions about matters that affect their lives, based on choice, participation and control. Articles 3 and 4 of the United Nations Declaration on the Rights of Indigenous Peoples (UNDRIP) confirms that Indigenous peoples have the right to self-determination under international law. By virtue of that right they freely determine their political status and freely pursue their economic, social and cultural development.</cpr:P7>
        <schema:description xml:lang="en">the right of Indigenous Peoples to freely determine their political status and pursue their economic, social, and cultural development</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1748 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1748">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:label xml:lang="en">indigenous right to object</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1602"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1758"/>
        <schema:description xml:lang="en">The right of Indigenous Peoples to object to developments on their land, or which would otherwise influence their way of life</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q175 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q175">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">solar water distillation</rdfs:label>
        <skos:altLabel xml:lang="en">solar water distillation</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/resources/solar-water-distillation"/>
        <schema:description xml:lang="en">Solar water distillation is the process of using the energy from sunlight to separate freshwater from salts or other contaminants.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1750 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1750">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1254"/>
        <rdfs:label xml:lang="en">non-methane volatile organic compounds</rdfs:label>
        <skos:altLabel xml:lang="en">NMVOCs, non-methane VOCs</skos:altLabel>
        <cpr:P7 xml:lang="en">Non-methane volatile organic compounds (NMVOCs) are the same as volatile organic compounds (VOCs), but with methane excluded. Methane is relatively non-toxic and not directly harmful to human health, although it does significantly contribute to climate change and ozone formation. NMVOCs are air pollutants that can harm human health and typically originate from combustion or the evaporation of fuels and other substances.</cpr:P7>
        <schema:description xml:lang="en">Non-methane volatile organic compounds (NMVOCs) are the same as volatile organic compounds (VOCs), but with methane excluded. Methane is relatively non-toxic and not directly harmful to human health, although it does significantly contribute to climate change and ozone formation. NMVOCs are air pollutants that can harm human health and typically originate from combustion or the evaporation of fuels and other substances.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1751 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1751">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1543"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1754"/>
        <rdfs:label xml:lang="en">green skills development</rdfs:label>
        <skos:altLabel xml:lang="en">re-skill, re-train, retrain, green education, developing green skills, development of green skills, education for green skills, green jobs development, green jobs placement, green jobs placements, green jobs training, green skills development, green skills education, greening the workforce, training for green jobs, training green jobs, green workforce development, net-zero workforce development, sustainable workforce development, training green skills, green vocational training, re-skilling, reskilling, upskilling, up skill, up skilling, up-skill, up-skilling, upskill, address green skill needs, address green skills needs, addressing green skill needs, address the green skills gap, addressing the green skills gap, fill green skills gap, fill the green skills gap, filling the green skills gap, enhancing the skill, skill enhancement, skill-enhancement, capacity building for green jobs, capacity-building for green jobs, train green skills, re-training, retraining, training for green skills</skos:altLabel>
        <schema:description xml:lang="en">Education or training with the specific aim of improving skills that are helpful in a sustainable economy</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1752 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1752">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">quality standard</rdfs:label>
        <skos:altLabel xml:lang="en">quality standards</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1753 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1753">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:label xml:lang="en">involving civil society</rdfs:label>
        <skos:altLabel xml:lang="en">involvement of civil society, engagement with civil society, civil society engagement, empowering civil society, mobilisation of civil society, mobilization of civil society, meaningful public consultation, meaningful public consultations, community engagement, engagement with grassroots, grassroots engagement, grassroots involvement, involve civil society, involve grassroots, involving grassroots, encouraging civil society to participate, mobilising civil society, mobilising grassroots, mobilizing civil society, mobilizing grassroots, participation of civil society, participation of grassroots</skos:altLabel>
        <cpr:P7 xml:lang="en">Civil society engagement refers to the involvement of non-governmental organizations, community groups, and other forms of civic participation in public policy-making and advocacy. This form of engagement plays a crucial role in shaping political agendas, representing diverse interests, and ensuring accountability from governmental institutions.</cpr:P7>
        <schema:description xml:lang="en">A meaningful involvement of civil society in the decision making process</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1754 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1754">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <rdfs:label xml:lang="en">aligning skills</rdfs:label>
        <skos:altLabel xml:lang="en">align competencies, align skills, align the competencies, align the skills, aligned competencies, aligned skills, competency alignment, skills alignment, address skills shortages, address the skills shortage, address the skills shortages, addresses skills shortages, addressing skill gaps, addressing skill shortages, reducing skill gaps, reducing skill shortages, green skills, align skill</skos:altLabel>
        <cpr:P20 xml:lang="en">6y38j2hv</cpr:P20>
        <cpr:P7 xml:lang="en">Achieving climate goals will require different jobs; in most cases, it is possible to modify existing jobs, but this will require training in new skills. Aligning skills in this way can be done through a variety of policy interventions. Moreover, many of these green skills overlap with general employable skills, so we include a number of more generic skill improvement initiatives here too.</cpr:P7>
        <schema:description xml:lang="en">Aligning the skills of the workforce with the requirements of the just transition.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1755 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1755">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1209"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:label xml:lang="en">stakeholder engagement activity</rdfs:label>
        <skos:altLabel xml:lang="en">stakeholder consultation, consultation of stakeholders, stakeholder inclusivity, stakeholder participation, multi-stakeholder participation, engagement of stakeholders, engagement with stakeholders, stakeholder engagement activities, stakeholder engagement plan, stakeholder engagement plans, stakeholder engagement policies, stakeholder engagement policy, stakeholder workshop, stakeholder workshops, consultation with stakeholders</skos:altLabel>
        <cpr:P7 xml:lang="en">Stakeholder engagement or consultation refers to an ongoing process of interaction and dialogue between an organisation and its potentially affected stakeholders that enables the organisation to hear, understand and respond to their interests and concerns, including through collaborative approaches.</cpr:P7>
        <schema:description xml:lang="en">Stakeholder consultation refers to the process of actively gathering input of individuals or groups who are affected by, or can affect, an organisation&apos;s decisions and activities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1757 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1757">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1747"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:label xml:lang="en">demarcation of indigenous territories</rdfs:label>
        <skos:altLabel xml:lang="en">demarcation of indigenous lands, demarcation of indigenous land, indigenous land demarcation, protection of indigenous areas, protection of indigenous lands</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1745"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <schema:description xml:lang="en">Demarcation of indigenous lands refers to the formal process of identifying and physically marking the boundaries of traditional territories occupied by indigenous peoples</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1758 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1758">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1759"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1760"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1813"/>
        <rdfs:label xml:lang="en">free prior and informed consent</rdfs:label>
        <skos:altLabel xml:lang="en">FPIC, free prior and informed consent, free, prior, and informed consent, free prior informed consent, free, prior informed consent, free, prior, informed consent</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1748"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <schema:description xml:lang="en">Free, prior and informed consent (or FPIC) centres on obtaining consent from Indigenous Peoples (IPs) for any activities undertaken on their land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1759 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1759">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <rdfs:label xml:lang="en">protection for indigenous people&apos;s rights</rdfs:label>
        <skos:altLabel xml:lang="en">protection of indigenous rights, protection of indigenous people&apos;s rights, protection for indigenous people, protection of indigenous people, protection for indigenous population, protection of indigenous population</skos:altLabel>
        <schema:description xml:lang="en">Protection for indigenous peoples&apos; rights refers to the measures taken to safeguard the collective and individual rights of indigenous populations, ensuring they can live with dignity, autonomy, and self-determination</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q176 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q176">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">water recycling and reclamation</rdfs:label>
        <skos:altLabel xml:lang="en">reclaim water, reclamation of water, recycle water, recycling of water, water reclamation, water recycling</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/water-recycling-and-reclamation"/>
        <schema:description xml:lang="en">Water recycling and reclamation is an approach that uses municipal wastewater as a vital resource for appropriate applications, including agricultural and other irrigation, industrial and domestic uses.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1760 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1760">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:label xml:lang="en">involving vulnerable groups</rdfs:label>
        <skos:altLabel xml:lang="en">involving people in vulnerable situations, involvement of elderly, involvement of indigenous people, involvement of internally displaced, involvement of marginalised ethnicity, involvement of marginalised groups, involvement of marginalized ethnicity, involvement of marginalized groups, involvement of migrant, involvement of migrants, involvement of vulnerable groups, involvement of youth, involving elderly, involving indigenous people, involving internally displaced, involving marginalised ethnicity, involving marginalized ethnicity, involving migrant, involving migrants, involving youth, participation of elderly, participation of indigenous people, participation of internally displaced, participation of marginalised ethnicity, participation of marginalised groups, participation of marginalized ethnicity, participation of marginalized groups, participation of migrant, participation of migrants, participation of vulnerable groups, participation of youth, involvement of people of African descent, involvement of people with disabilities, involvement of women, involving people of African descent, involving people with disabilities, involving women, participation of people of African descent, participation of people with disabilities, participation of women, involvement of informal workers, involvement of workers affected by just transition, involving informal workers, involving workers affected by just transition, participation of informal workers, participation of workers affected by just transition, involvement of local communities, involving local communities, participation of local communities, engagement with elderly, engagement with informal workers, engagement with internally displaced, engagement with migrant, engagement with people of African descent, engagement with people with disabilities, engagement with vulnerable groups, engagement with women, engagement with workers affected by just transition, engagement with youth, involvement of disabled, involvement of PwD, participation of disabled, participation of PwD, mobilisation of vulnerable groups, mobilization of vulnerable groups, mobilisation of indigenous people, mobilisation of informal workers, mobilisation of local communities, mobilisation of marginalised ethnicity, mobilisation of marginalized ethnicity, mobilisation of people of African descent, mobilisation of people with disability, mobilisation of PwD, mobilisation of women, mobilisation of youth, mobilization of indigenous people, mobilization of informal workers, mobilization of local communities, mobilization of marginalised ethnicity, mobilization of marginalized ethnicity, mobilization of people of African descent, mobilization of people with disability, mobilization of PwD, mobilization of women, mobilization of youth, engagement with PwD, mobilisation of elderly, mobilisation of internally displaced, mobilisation of migrant, mobilisation of workers affected by just transition, mobilization of elderly, mobilization of internally displaced, mobilization of migrant, mobilization of workers affected by just transition, indigenous peoples&apos; participation, local communities&apos; participation, vulnerable groups&apos; participation, women&apos;s participation, youth&apos;s participation, local communities&apos; engagement, local communities&apos; involvement, vulnerable groups&apos; engagement, vulnerable groups&apos; involvement, women&apos;s engagement, women&apos;s involvement, youth&apos;s engagement, youth&apos;s involvement, vulnerable groups to participate, gender equality strategy, empowering marginalised groups, empowering marginalized groups, empowering women, GESI, GESILG</skos:altLabel>
        <schema:description xml:lang="en">Actively including  vulnerable groups in the decision making process, ensuring they are not left behind and that the transition is fair and equitable for everyone</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1763 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1763">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1582"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:label xml:lang="en">transformative governance</rdfs:label>
        <skos:altLabel xml:lang="en">systemic governance, transformation governance</skos:altLabel>
        <cpr:P7 xml:lang="en">Transformative governance is a proactive, systemic approach to addressing profound societal and ecological transitions, such as pandemics, climate change, and economic shifts, by fundamentally reshaping existing systems towards a sustainable common good. It crucially involves the inclusive engagement of diverse civil society actors, alongside academia, industry, and government (the &quot;quadruple helix&quot;), in co-creating solutions and driving a just transition that balances social, environmental, and digital dimensions.</cpr:P7>
        <schema:description xml:lang="en">Transformative governance is a new approach to respond to continuous and profound changes humanity is facing, such as pandemics, climate change, and financial crises. The approach emphasises a &quot;just triple transition&quot; that balances social, environmental (green), and digital dimensions, demanding a radical shift from traditional boundaries to a holistic perspective involving  involves academia, industry, government, and civil society.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1764 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1764">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1739"/>
        <rdfs:label xml:lang="en">just transition fund</rdfs:label>
        <skos:altLabel xml:lang="en">JTF, Just Transition Fund</skos:altLabel>
        <cpr:P7 xml:lang="en">The Just Transition Fund (JTF) is a new financial tool under the EU&apos;s cohesion policy, designed to help regions grappling with significant social and economic difficulties as they shift to a climate-neutral economy. Its core purpose is to ensure that the ambitious goals of the European Green Deal (i.e., making the EU climate-neutral by 2050) are met in a fair way, without leaving any communities behind. The JTF offers grants to regions and areas particularly vulnerable to this transition, especially those heavily reliant on fossil fuels like coal, peat, and oil shale, or those with industries that produce a lot of greenhouse gases.</cpr:P7>
        <schema:description xml:lang="en">The Just Transition Fund (JTF) is a key financial instrument of the European Union. Its primary goal is to ensure that the transition towards a climate-neutral economy by 2050 is fair and leaves no one behind, particularly supporting regions, industries, and workers most affected by the shift away from fossil fuels and carbon-intensive activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1765 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1765">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1562"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q886"/>
        <rdfs:label xml:lang="en">unemployment support</rdfs:label>
        <skos:altLabel xml:lang="en">unemployment insurance, unemployment benefits, unemployment payments, income support to the unemployed, unemployment benefit schemes, statutory unemployment insurance</skos:altLabel>
        <cpr:P7 xml:lang="en">Unemployment benefit schemes provide income support, usually over a limited period, to those who face temporary unemployment. The objective is to provide at least partial income replacement, enabling the beneficiary to maintain a certain standard of living during the transition period until a new employment is available.</cpr:P7>
        <schema:description xml:lang="en">Money that the government pays to unemployed people who are looking for a job</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1766 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1766">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1562"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1809"/>
        <rdfs:label xml:lang="en">conditional cash transfer programmes</rdfs:label>
        <skos:altLabel xml:lang="en">conditional cash transfer programs, conditional cash transfer schemes, conditional cash transfer, conditional cash transfers</skos:altLabel>
        <cpr:P7 xml:lang="en">Conditional Cash Transfer (CCT) programs are a type of social safety net intervention designed to alleviate poverty and promote human capital development by providing regular financial payments directly to low-income households, contingent upon their fulfillment of specific conditions. These conditions typically relate to investments in human capital, such as ensuring children&apos;s regular school attendance, adhering to preventative health check-ups and vaccinations, and participating in nutrition education or other social development activities. The aim is to provide immediate poverty relief while simultaneously breaking the intergenerational cycle of poverty by fostering long-term improvements in health, education, and overall well-being.</cpr:P7>
        <schema:description xml:lang="en">Conditional cash transfer (CCT) programs aim to reduce poverty by making cash transfers conditional upon the receivers&apos; actions. The government only transfers the money to persons who meet certain criteria</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1767 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1767">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q53"/>
        <rdfs:label xml:lang="en">access to healthcare</rdfs:label>
        <skos:altLabel xml:lang="en">just health care, just healthcare, universal health coverage, aged care, access to health care, fair health outcomes, just health outcomes, universal health care system, universal healthcare system</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1649"/>
        <cpr:P7 xml:lang="en">Healthcare in the just transition must also ensure equitable and continuous access to quality healthcare for communities and workers most affected by the economic shifts away from carbon-intensive industries, including robust mental health support, thereby guaranteeing that health outcomes and access to care remain just and do not exacerbate existing or create new inequalities during this profound societal and economic transformation</cpr:P7>
        <schema:description xml:lang="en">Healthcare system ensures equitable access to quality care for communities and workers impacted by economic shifts, prioritising their well-being and needs. This means addressing potential negative impacts of climate action and economic restructuring on healthcare access and quality for those most vulnerable</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1768 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1768">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q572"/>
        <rdfs:label xml:lang="en">solid biofuel</rdfs:label>
        <skos:altLabel xml:lang="en">solid biofuels, solid bio-mass, solid biomass</skos:altLabel>
        <cpr:P7 xml:lang="en">Solid biofuels include crops and animal products in the form of solids. Solid biofuels also include secondary energy carriers, like charcoal and biomass pellets and briquettes. The IRENA classification of biofuels groups them as primary or secondary products, with primary products also divided by source. Splitting primary solid biofuels by source reflects interest in the environmental impacts of the different ways biological resources enter the bioenergy production chain. In energy statistics, solid biofuels should be reported in tonnes, and the energy content should be reported in joules based on measured net calorific values. Biomass pellets and briquettes, as well as charcoal, can be produced with any primary solid biofuel. The sum of all primary and secondary solid biofuels yields the total solid biofuels. When considering secondary products in the energy balance, transformation processes must be accounted for to avoid double counting or the mixing of higher energy content products with lower-energy unprocessed products. Where detailed statistics about the use of recovered wood products for energy are available, these amounts can be counted in this category if they are not included in renewable waste.</cpr:P7>
        <schema:description xml:lang="en">Any solid non-fossil material of biological origin used solely for energy purposes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1769 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1769">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q572"/>
        <rdfs:label xml:lang="en">liquid biofuel</rdfs:label>
        <skos:altLabel xml:lang="en">liquid biofuels</skos:altLabel>
        <cpr:P7 xml:lang="en">Liquid biofuel is mainly used as transport fuel but can also be used for electricity generation (e.g. in diesel generators) or for heating. Liquid biofuels include various alcohols, fatty acid methyl or ethyl esters, synthetic hydrocarbons and vegetable oils used directly as fuel. They are often blended with liquid fossil fuels such as petroleum gasoline and diesel. In these cases, only the biofuel component should be counted as renewable energy. This category comprises biogasoline, biodiesel, bio-jet kerosene and other liquid biofuels. The division into these groups is based on the biofuel’s suitability to blend with similar fossil fuels. Liquid biofuel is primary if the biomass feedstock used to produce it is not part of the energy system and is thus out of the scope of energy statistics (e.g. non-energy crops, waste products or new energy pathways). It is secondary if the biomass feedstock used to produce it is an energy product or biomass that would otherwise be used for energy purposes (e.g. energy crops or wood fuel). When secondary, energy statistics should include the biomass feedstock as a primary energy product, and then record the transformation of the feedstock into the specific liquid or gas biofuel in question.</cpr:P7>
        <schema:description xml:lang="en">Liquid derived from biomass that are used as fuels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q177 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q177">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">fog harvesting</rdfs:label>
        <skos:altLabel xml:lang="en">fog harvesting, harvest fog, harvesting of fog</skos:altLabel>
        <cpr:P4 rdf:resource="https://tech-action.unepccc.org/wp-content/uploads/sites/2/2019/05/tna-guidebook-adaptationagriculture.pdf"/>
        <schema:description xml:lang="en">Fogs have the potential to provide an alternative source of fresh water in dry regions and can be harvested through the use of simple and low-cost collection systems. Captured water can then be used for agricultural irrigation and domestic use. Fog harvesting provides a way of capturing vital water supplies to support farming.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1770 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1770">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q572"/>
        <rdfs:label xml:lang="en">gas biofuel</rdfs:label>
        <skos:altLabel xml:lang="en">biogas, gas biofuels, bio-based gas, renewable gas</skos:altLabel>
        <cpr:P7 xml:lang="en">Gas biofuels are primarily used for heat and power production, but they can also serve as a transport fuel and, in small quantities, as a chemical feedstock for non-energy use. When gas biofuels are mixed with natural gas, only the biological component should be considered as renewable energy. Most gas biofuels are treated as primary energy products, and the energy content of the solid materials used to produce gas biofuels is not recorded in energy balances. Solid biofuels and renewable waste used to manufacture biogas from thermal processes should be shown as a transformation flow, accounting for transformation losses. Division of gas biofuel is based on a mix between the process used to produce them (e.g. anaerobic digestion or thermal processes) and their chemical characteristics (e.g. biomethane, biohydrogen). Gas biolfuels are mostly primary energy products. Gas biofuel is primary if the biomass feedstock used to produce it is not part of the energy system and is thus out of the scope of energy statistics (e.g. non-energy crops, waste products or new energy pathways). It is secondary if the biomass feedstock used to produce it is an energy product or biomass that would otherwise be used for energy purposes (e.g. energy crops or wood fuel). When secondary, energy statistics should include the biomass feedstock as a primary energy product, and then record the transformation of the feedstock into the specific liquid or gas biofuel in question.</cpr:P7>
        <schema:description xml:lang="en">Gas produced from the anaerobic digestion or thermal processes of some solid or liquid biofuels and biological residues.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1771 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1771">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q606"/>
        <rdfs:label xml:lang="en">mixed hydropower</rdfs:label>
        <cpr:P7 xml:lang="en">Water can be pumped into reservoirs used only for the purpose of mixed hydropower (pure pumped hydro), or it can be combined with reservoir hydropower by pumping water into reservoirs that also capture naturally flowing water. Electricity from flowing water that has previously been pumped into reservoirs is not counted as renewable energy but is subtracted from the amount of energy used for pumping, and the net energy consumption is counted as own-use of electricity for the energy industry. During periods of low demand or excess generation from other renewable sources, the plant can use excess electricity to pump water uphill to the reservoir, effectively storing energy for later use. When demand increases or other renewable sources are not available, the stored water can be released to turn turbines and generate electricity. In electricity generation statistics, production from mixed plants is divided into the proportion coming from naturally flowing water and the proportion coming from pumped hydro. The latter is counted as electricity generation from pumped hydro.</cpr:P7>
        <schema:description xml:lang="en">Electrical energy generated by combining pure hydropower with pumped hydro or other technologies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1772 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1772">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q615"/>
        <rdfs:label xml:lang="en">wave energy</rdfs:label>
        <skos:altLabel xml:lang="en">wave power, wave electricity, wave renewable electricity, wave renewable energy, wave renewable power</skos:altLabel>
        <cpr:P7 xml:lang="en">Most wave energy conversion technologies use floating devices that may or may not be anchored to the seabed. These devices move up and down with the waves, using this movement to push water or compressed air through turbines or convert the fluids’ momentum into rotational motion through rack and pinion mechanisms. Other wave energy converters include devices that capture the water at the tops of waves to create short-term differences in water levels (and use this to drive water turbines) and devices on the seabed that use differences in water pressure to drive turbines as waves pass over them. Specific technologies used to harvest wave energy include (a) point absorbers, which are floating buoys; (b) oscillating wave surge converters, which use an oscillating flap to capture energy while mounted on the seabed; and (c) oscillating water columns, which are partially submerged, hollow columns that compress air pockets through an air turbine.</cpr:P7>
        <schema:description xml:lang="en">Electricity produced from devices driven by the motion of waves.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1773 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1773">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q615"/>
        <rdfs:label xml:lang="en">tidal energy</rdfs:label>
        <skos:altLabel xml:lang="en">tidal power, kinetic electricity from tides, kinetic energy from tides, kinetic power from tides, tidal electricity, tidal current electricity, tidal current energy, tidal current power, tidal renewable electricity, tidal renewable energy, tidal renewable power, tidal stream energy</skos:altLabel>
        <cpr:P7 xml:lang="en">Tidal energy can be subdivided into (a) rise and fall tides and (b) ebb and flood currents. Tides involve ocean water moving vertically due to the gravitational pull of the sun and of the moon, and those pulls’ interactions with Earth’s gravitational field. Tides occur twice a day and depend on the Earth’s location and position. Tidal energy is predictable and is a constant source of energy suitable for producing baseload power. Tidal energy is usually generated close (&lt;20km) to the coastline.</cpr:P7>
        <schema:description xml:lang="en">Electricity produced by harnessing kinetic energy from tides.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1774 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1774">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q615"/>
        <rdfs:label xml:lang="en">ocean current energy</rdfs:label>
        <skos:altLabel xml:lang="en">ocean current power, kinetic marine current energy, marine current energy, marine current power, ocean flow energy, ocean flow power, underwater current energy, underwater current power, kinetic marine current power</skos:altLabel>
        <cpr:P7 xml:lang="en">Energy is usually harvested from ocean currents in shallow water and driven by wind flows, density changes, salinity and temperature, with the water flowing in one direction either permanently or over long periods of time. Ocean current energy is typically generated more than 20 km offshore at typical depths over 500m. It&apos;s a constant source of energy suitable for baseload electricity generation. In theory, ebb and flood currents are within the scope of ocean currents, but IRENA categorises them as tidal energy due to their proximity to land.</cpr:P7>
        <schema:description xml:lang="en">Electricity produced by harnessing continuous flows of ocean waters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1775 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1775">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q615"/>
        <rdfs:label xml:lang="en">salinity gradient energy</rdfs:label>
        <skos:altLabel xml:lang="en">salinity gradient power, salinity energy, salinity power, salt gradient energy, salt gradient power, osmotic energy, osmotic power</skos:altLabel>
        <cpr:P7 xml:lang="en">Energy produced this way depends on a phenomenon that occurs when two different solutions mix. In this case, the two solutions are fresh water and salt water, for which the main difference is their salinity concentration. The two main mechanisms for generating salinity gradient energy are pressure-retarded osmosis and reversed electrodialysis. In pressure-retarded osmosis, water with a low salt content moves through membranes through osmotic permeation to reduce the salinity of salt water on the other side of the membranes and then expands inside a turbine to generate electricity. In reversed electrodialysis, the ions in salt water are used to generate an electric charge, which can be used as electricity. Other mechanisms for capturing and using these forces, such as capacity mixing, are also being researched. Salinity gradient is especially useful where rivers connect to the open ocean. Salinity gradient electricity generation has transformation losses, so total energy supply and electricity production will differ. However, the efficiency of such systems is usually high, at around 90% for pressure-retarded osmosis.</cpr:P7>
        <schema:description xml:lang="en">Electrical energy produced by the Gibbs free energy of mixing.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1776 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1776">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q615"/>
        <rdfs:label xml:lang="en">thermal gradient energy</rdfs:label>
        <skos:altLabel xml:lang="en">ocean thermal power, thermal gradient power, deep ocean thermal energy, marine thermal garident energy, ocean heat energy, thermal ocean power, ocean thermal energy conversion, ocean thermal power conversion, OTEC</skos:altLabel>
        <cpr:P7 xml:lang="en">An organic Rankine thermodynamic cycle can generate electricity using heat transfer between these two water flows. Thermal gradient power is more suitable in places where surface water gets warmer than colder deeper water, such as in tropical regions. As ocean thermal energy conversion systems use thermal energy to generate electricity, there are transformation losses in the system, and the amount of primary energy supplied will be more than the amount of electricity generated. In 2024 generally accepted estimate of what the efficiency of such systems might be existed, but it was expected to be relatively low (under 5%).</cpr:P7>
        <schema:description xml:lang="en">Energy that can be harnessed from the thermal difference between cold deep seawater and warmer surface water with a difference of at least 20°C.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1777 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1777">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q618"/>
        <rdfs:label xml:lang="en">solar photovoltaic</rdfs:label>
        <skos:altLabel xml:lang="en">photo-voltaic, photovoltaic, PV, solar PV, solar electricity, solar panel, solar panels</skos:altLabel>
        <cpr:P7 xml:lang="en">Solar cells can be arranged together as solar panels and panels can be arranged as arrays. Solar photovoltaic is either connected to an electricity grid or not. Solar photovoltaic devices may also integrate mechanisms, known as concentrator photovoltaic devices, to focus or concentrate solar irradiation onto solar cells, thus increasing their electricity output. High-concentration photovoltaic devices may also need cooling mechanisms for the solar cells. While electricity production from high-concentration photovoltaic devices may resemble concentrated solar power generation, it is classified as solar photovoltaic energy. But any useful heat recovered from cooling water in such devices should be counted in the appropriate subcategory under solar thermal energy. Due to energy access and grid operation planning, the IRENA categorisation subdivides solar photovoltaic into on-grid solar photovoltaic and off-grid solar photovoltaic.</cpr:P7>
        <schema:description xml:lang="en">Electricity generated through the direct conversion of solar irradiation into electricity via the photovoltaic effect in semiconductor devices, such as solar cells.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1778 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1778">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q620"/>
        <rdfs:label xml:lang="en">solar water heating</rdfs:label>
        <skos:altLabel xml:lang="en">solar hot water, solar thermal water heating, solar water energy, solar water power, solar domestic hot water</skos:altLabel>
        <cpr:P7 xml:lang="en">Solar water heaters (SWHs) have collectors that absorb the energy from the sun and transfer it to a heat transfer fluid. The heated fluid transfers heat to the domestic water. They are most effective in areas with a high level of solar irradiance and a significant demand for hot water, and they are widely used in residential, commercial and industrial settings.</cpr:P7>
        <schema:description xml:lang="en">Conversion of radiative thermal energy from sunlight into thermal energy, which can be used for water heating.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1779 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1779">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q620"/>
        <rdfs:label xml:lang="en">solar air heating</rdfs:label>
        <skos:altLabel xml:lang="en">solar space heating</skos:altLabel>
        <cpr:P7 xml:lang="en">Solar air heating systems typically consist of a collector panel, which absorbs sunlight and heats the air, and potentially a mechanism for circulating the heated air into a building or process. There are three main types of solar air heating process: natural convection, forced convection and radiative heating. The heated air can be used for domestic space heating, ventilation heating, industrial process heating or agricultural drying.</cpr:P7>
        <schema:description xml:lang="en">Use of solar thermal energy to heat air.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1780 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1780">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1777"/>
        <rdfs:label xml:lang="en">utility-scale solar photovoltaic</rdfs:label>
        <skos:altLabel xml:lang="en">on-grid solar photovoltaic, grid connected photovoltaic, grid connected PV, grid tied photovoltaic, grid tied PV, grid tied solar, grid-connected photovoltaic, grid-connected PV, grid-tied photovoltaic, grid-tied PV, grid-tied solar, mains connected photovoltaic, mains connected PV, mains-connected photovoltaic, mains-connected PV, on-grid solar PV, utility-scale solar, utility solar, utility solar photovoltaic</skos:altLabel>
        <cpr:P7 xml:lang="en">Photovoltaic systems and technologies (e.g. panels, arrays) connected to large-scale electricity networks, allowing excess generation to be fed into the grid. Such systems enable net‐metering or feed‑in tariffs, which may enhance economic viability and encourage distributed energy resources.</cpr:P7>
        <schema:description xml:lang="en">Solar photovoltaic systems and technologies connected to the distribution or transmission grid.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1781 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1781">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1777"/>
        <rdfs:label xml:lang="en">distributed solar</rdfs:label>
        <skos:altLabel xml:lang="en">off-grid solar photovoltaic, autonomous solar, independent solar, isolated photovoltaic, isolated PV, off-grid photovoltaic, off-grid PV, off-grid solar PV, stand alone photovoltaic, stand alone PV, stand alone solar, standalone photovoltaic, standalone PV, standalone solar</skos:altLabel>
        <schema:description xml:lang="en">Solar photovoltaic systems and technologies that are not connected to a distribution or transmission grid.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1782 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1782">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1769"/>
        <rdfs:label xml:lang="en">bio-jet kerosene</rdfs:label>
        <skos:altLabel xml:lang="en">bio jet fuel, bio jet kerosene, bio-jet fuel, sustainable aviation fuel, aviation biofuel, SAF, aviation biokerosene</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2722"/>
        <cpr:P7 xml:lang="en">Bio-jet kerosene can be manufactured from any type of biomass, including plant cellulose and algae. It is produced by a range of thermal processes (including gasification followed by Fischer-Tropsch synthesis or pyrolysis followed by hydrogenation) or by the conversion of sugar to hydrocarbons using micro-organisms such as yeast. Jet fuel is a high-specification fuel that must meet the standards defined in ASTM D1655 for Jet A1 or in the Ministry of Defence Standard 91-91 in the United Kingdom. Bio-jet kerosene must meet these same standards and, in addition, have an ASTM D7566 certification. The ASTM certification procedure is rigorous and can take years and millions of US dollars to complete. Bio-jet kerosene may be blended with other fuels or used directly. Where it is blended, energy statisticians should register a transfer or a transformation, from bio-jet kerosene to blended kerosene.</cpr:P7>
        <schema:description xml:lang="en">Liquid biofuel derived from biomass and blended with or replacing jet kerosene.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1783 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1783">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">harvested biomass</rdfs:label>
        <skos:altLabel xml:lang="en">wood fuel, energy crops, firewood, fuel wood</skos:altLabel>
        <cpr:P7 xml:lang="en">Harvested biomass can be used directly or as a feedstock for various bioenergy applications, including combustion for heat and power generation, compression to make biomass pellets and briquettes, and gasification for liquid and gas biofuel production.</cpr:P7>
        <schema:description xml:lang="en">Biomass harvested for energy purposes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1784 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1784">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">harvested residue</rdfs:label>
        <skos:altLabel xml:lang="en">crop residue, agricultural residue, agricultural residues, crop residues, harvest residues, harvesting residue, harvesting residues, biomass residue, biomass residues, agricultural waste, agricultural wastes, crop waste, crop wastes, farm residue, farm residues, farm waste, farm wastes, farming residue, farming residues, farming waste, farming wastes, harvest waste, harvesting waste, plant residue, plant residues, residual biomass, residual crop, field residue, field residues, residues in fields, agriculture residue, agriculture residues, agriculture waste</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1865"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2538"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q572"/>
        <cpr:P7 xml:lang="en">Harvest residues can be left on site for nutrient cycling purposes or used to produce liquid biofuels, such as cellulosic ethanol, which can be blended with gasoline to fuel vehicles. Harvest residues can also be burned directly to produce heat and electricity in biomass-fired power plants.</cpr:P7>
        <schema:description xml:lang="en">Agricultural residues are materials left on cultivated land after the crop has been harvested.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1785 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1785">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">biomass processing residue</rdfs:label>
        <skos:altLabel xml:lang="en">bagasse, black liquor, biomass processing residues, husk, bio mass residue, bio mass residues, biomass residue, biomass residues</skos:altLabel>
        <cpr:P7 xml:lang="en">Includes by-products obtained during the processing of different types of biomass, such as roundwood or agricultural crops, that have significant energy potential. Since these residues are already collected during the processing of biomass, they can be a convenient and inexpensive source of biomass for energy production. These residues can be used for direct combustion or gasification, or they can be further processed into advanced biofuels, such as bio-oil or biogas. Many of these residues have non-energy uses (e.g. as feed, mulch or animal bedding or for the production of reconstituted wood panels), so only the share of these residues used for energy should be counted in energy statistics.</cpr:P7>
        <schema:description xml:lang="en">Residue from biomass processing activities across different economic or energy sectors that use solid biofuels as raw materials.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1786 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1786">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">animal residue</rdfs:label>
        <skos:altLabel xml:lang="en">animal processing residue, animal processing residues, animal residues</skos:altLabel>
        <cpr:P7 xml:lang="en">Solid biofuels baed on animal residue consist of by-products from the slaughter and processing of animals. The use of animal processing residues for energy production can provide economic and environmental benefits by reducing waste disposal costs and providing a source of renewable energy. However, their use must comply with regulations regarding waste disposal and public health.</cpr:P7>
        <schema:description xml:lang="en">Solid biofuel sourced from animal matter.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1787 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1787">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">biomass pellets</rdfs:label>
        <skos:altLabel xml:lang="en">biomass pellet, biomass block, biomass blocks, biomass fuel pellet, biomass fuel pellets, briquette, briquettes, compressed biomass, fuel block, fuel blocks, fuel pellet, fuel pellets, pelletised biomass, pelletized biomass, wood pellet, wood pellets</skos:altLabel>
        <cpr:P7 xml:lang="en">Biomass pellets and briquettes are solid, processed biofuels made from dried, cut, crushed and compressed biomass. Wood pellets, created from fuelwood or wood residues, are the most common, but other solid biomass materials such as rice husks, straw, nut shells and renewable municipal waste can also be used. Producing these biofuels involves compressing the biomass or adding a binder, which typically makes up less than 3% of the final weight. These biofuels have low moisture content (below 10%) and high combustion efficiency. Pellets are cylindrical with diameters under 25mm and lengths under 100mm. Briquettes are also cylindrical but can vary in size. Biomass pellets and briquettes are primarily used for heat production (either sold or for direct use) and are increasingly used for electricity generation in countries that rely on imported biofuels to meet bioenergy targets. Torrefied biomass pellets and briquettes, known as black pellets or bio-coal, are not included in this category and should be classified as charcoal. When reporting biomass pellet and briquette use, data on the primary energy sources (solid biofuels) used for production should be included in their respective categories, with the amounts used for manufacturing indicated as other transformation in the energy balance. If available, the renewable content of pellets and briquettes made from refuse-derived fuel and solid recovered fuel can also be included, with the primary input amounts appearing in the statistics for renewable municipal waste.</cpr:P7>
        <schema:description xml:lang="en">Secondary energy products that can be produced from one or more biofuels after undergoing physical and/or chemical transformations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1788 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1788">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">biomass briquette</rdfs:label>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1789 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1789">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1768"/>
        <rdfs:label xml:lang="en">charcoal</rdfs:label>
        <cpr:P7 xml:lang="en">Charcoal mainly consists of carbon, with small amounts of ash and other impurities. Charcoal is typically made from wood (fuelwood and wood residues) but can be made from almost any type of solid biomass. Carbonisation usually involves slow pyrolysis, where biomass is heated in a controlled environment without air for several days (for artisanal charcoal). Alternatively, charcoal can be produced more quickly in an industrial kiln or retort that operates at high temperatures. Heat for the charcoal-making process can come from partial combustion of the original biomass or other energy sources. Charcoal is primarily used for direct heat, with cooking and iron and steel production being the most common uses, where it substitutes for coke. It also has non-energy uses, such as in medicine and filters as activated carbon. Charcoal comes in various forms, depending on the type of primary solid biofuel used, including lump charcoal from fuelwood, charcoal briquettes, bamboo charcoal and charcoal made from compressed wood pellets and briquettes. Additionally, torrefied biomass pellets and briquettes are classified as charcoal and can be used as a substitute for coal and for co-firing in thermal power plants. Torrefied biomass is different from charcoal produced through the traditional slow pyrolysis process, since it involves heating the biomass at lower temperatures and for shorter periods of time.</cpr:P7>
        <schema:description xml:lang="en">Secondary solid biofuel obtained through the carbonisation of wood or other vegetable matter in an oxygen-free environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q179 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q179">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:label xml:lang="en">grid resilience</rdfs:label>
        <skos:altLabel xml:lang="en">grid resiliency, resilience of grid, resilience of the grid, adaptation of electricity grid, adaptation of electricity grids, adaptation of energy grid, adaptation of energy grids, adaptation of grid, adaptation of grids, adaptation of national grid, adaptation of national grids, adaptation of power grid, adaptation of power grids, adaptation of power system, adaptation of power systems, adaptations of electricity grid, adaptations of electricity grids, adaptations of energy grid, adaptations of energy grids, adaptations of grid, adaptations of grids, adaptations of national grid, adaptations of national grids, adaptations of power grid, adaptations of power grids, adaptations of power system, adaptations of power systems, adapting electricity grid, adapting electricity grids, adapting energy grid, adapting energy grids, adapting grid, adapting grids, adapting national grid, adapting national grids, adapting power grid, adapting power grids, adapting power system, adapting power systems, adaptive capacity of electricity grid, adaptive capacity of electricity grids, adaptive capacity of energy grid, adaptive capacity of energy grids, adaptive capacity of grid, adaptive capacity of grids, adaptive capacity of national grid, adaptive capacity of national grids, adaptive capacity of power grid, adaptive capacity of power grids, adaptive capacity of power system, adaptive capacity of power systems, climate resilient electricity grid, climate resilient electricity grids, climate resilient energy grid, climate resilient energy grids, climate resilient grid, climate resilient grids, climate resilient national grid, climate resilient national grids, climate resilient power grid, climate resilient power grids, climate resilient power system, climate resilient power systems, climate-smart electricity grid, climate-smart electricity grids, climate-smart energy grid, climate-smart energy grids, climate-smart grid, climate-smart grids, climate-smart national grid, climate-smart national grids, climate-smart power grid, climate-smart power grids, climate-smart power system, climate-smart power systems, resilience of electricity grid, resilience of electricity grids, resilience of energy grid, resilience of energy grids, resilience of grids, resilience of national grid, resilience of national grids, resilience of power grid, resilience of power grids, resilience of power system, resilience of power systems, resilient electricity grid, resilient electricity grids, resilient energy grid, resilient energy grids, resilient grid, resilient grids, resilient national grid, resilient national grids, resilient power grid, resilient power grids, resilient power system, resilient power systems</skos:altLabel>
        <cpr:P7 xml:lang="en">The ability of a power system to resist, respond, and recover from a catastrophic event - such as environmental disasters - are key factors commonly used to define the resilience of the power system. Resilience measures reduce damage from outages and hasten restoration and recovery to shorten outage durations.</cpr:P7>
        <schema:description xml:lang="en">The ability of a power system to resist, respond, and recover from a catastrophic event - such as environmental disasters - are key factors commonly used to define the resilience of the power system. Resilience measures reduce damage from outages and hasten restoration and recovery to shorten outage durations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1790 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1790">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1770"/>
        <rdfs:label xml:lang="en">biogas from anaerobic digestion</rdfs:label>
        <skos:altLabel xml:lang="en">AD biogues, anaerobic digestion biogas, animal residue biogas, digester gas, landfill biogas, methane from digestion, vegetable residue biogas, wastewater sludge biogas</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q366"/>
        <cpr:P7 xml:lang="en">Anaerobic digestion is a biochemical process that occurs in low-oxygen environments, where organic matter (made up of the elements C-H-O-N-S) decomposes in contact with water to produce methane and carbon dioxide (biogas). The full process consists of four complex biochemical reactions: hydrolysis, acidogenesis, acetogenesis, and methanogenesis. On a large scale, biogases from anaerobic digestion are primarily used for electricity production (including combined heat and power production) or for mixing with natural gas in gas distribution networks. On a small scale, they are more often used to cook (within the heat rising energy sector). When these biogases are blended with other gases, energy statisticians should register this as a transfer or as a transformation from the biogas to the blended gas. If any of the gases are used in the production process, this should be shown as own-use of the gases and not as biogas consumption.</cpr:P7>
        <schema:description xml:lang="en">Biogas from anaerobic digestion, primarily consisting of methane and carbon dioxide.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1791 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1791">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1770"/>
        <rdfs:label xml:lang="en">biogas from thermal processes</rdfs:label>
        <skos:altLabel xml:lang="en">syngas, synthesis gas</skos:altLabel>
        <cpr:P7 xml:lang="en">Pyrolysis is a thermochemical process where biomass is heated in the absence or near-absence of oxygen to prevent oxidation. This process produces charcoal, pyrolysis gases, and oils. These outputs can be further processed into bioliquids or biogases or used as a heat source for the pyrolysis itself. The yield of solids, liquids, and gases depends on the pyrolysis temperature and residence time—faster pyrolysis favors gas production. Combustion, by contrast, involves burning biomass at high temperatures with excess air (λ &gt; 1), mainly to generate heat. Complete combustion yields CO₂ and water, though incomplete combustion can produce other by-products. Dust is also formed, consisting of coarse fly ash (containing metals and unburned organics) and aerosols—tiny solid and liquid particles. Gasification lies between pyrolysis and combustion. It heats biomass with limited oxygen (λ &lt; 1), producing carbon-rich dust and biogas. Gasification reactors often include combined zones for drying, pyrolysis, combustion, and carbon reduction. The resulting synthesis gas (&quot;syngas&quot;) typically contains CO, CO₂, and H₂, with possible traces of CH₄ and N₂. Its composition depends on the biomass type and process used. Syngas is versatile: it can be used to generate electricity (including combined heat and power), or to produce biomethane, advanced biofuels, and other non-energy chemicals. However, for statistical energy reporting, only the portion of biogas from thermal processes used to generate electricity or biomethane is counted. When biogas is upgraded to biomethane, only the thermal biogas share should be reflected in energy balances, possibly via a transformation flow.</cpr:P7>
        <schema:description xml:lang="en">Biogas from thermal processes produced by the pyrolysis or gasification of solid biomass, or as a by-product of incomplete combustion.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1792 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1792">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1770"/>
        <rdfs:label xml:lang="en">gas biofuel product</rdfs:label>
        <skos:altLabel xml:lang="en">bio-DME, bio-natural gas, biohydrogen, biological hydrogen, biomethane, biothermal hydrogen, renewable natural gas, RNG</skos:altLabel>
        <cpr:P7 xml:lang="en">Gas biofuel products can be categorise according to chemical composition. Biological feedstock undergoes a chemical or physical transformation process to produce biomethane, biohydrogen, biodimethyl ether and other biogas products.</cpr:P7>
        <schema:description xml:lang="en">Secondary energy products mostly stemming from biogas from anaerobic digestion or biogas from thermal processes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1793 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1793">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q69"/>
        <rdfs:label xml:lang="en">job requiring green skills</rdfs:label>
        <skos:altLabel xml:lang="en">animal care services occupation, animal care services occupations, arborist, arborists, asbestos remover, asbestos removers, civil engineer, civil engineers, conservationist, conservationists, demolition operative, demolition operatives, drainage operative, drainage operatives, ecologist, ecologists, electric vehicle charging point installer, electric vehicle charging point installers, elementary cleaning occupation, elementary cleaning occupations, energy engineer, energy engineers, energy manager, energy managers, environmental consultancy director, environmental consultancy directors, environmental consultant, environmental consultants, environmental health professional, environmental health professionals, environmental professional, environmental professionals, environmental scientist, environmental scientists, farm labourer, farm labourers, forest worker, forest workers, forestry manager, forestry managers, foster carer, foster carers, geologist, geologists, hydrographic surveyor, hydrographic surveyors, managers and directors in the production of energy, meteorologist, meteorologists, parking and civil enforcement occupation, parking and civil enforcement occupations, pest control officer, pest control officers, probation service worker, probation service workers, production managers and directors in mining and energy, railway station assistant, railway station assistants, recycling manager, recycling managers, recycling operative, recycling operatives, refuse collector, refuse collectors, sales energy consultant, sales energy consultants, sewage works and water treatment manager, sewage works and water treatment managers, solar panel installer, solar panel installers, sustainability officer, sustainability officers, waste management officer, waste management officers, water engineers, wind turbine technician, wind turbine technicians, zoological scientist, zoological scientists, animal care service provider, animal care service providers, botanical researcher, botanical researchers, botanical scientist, botanical scientists, cleaning and housekeeping manager, cleaning and housekeeping managers, cleaning and housekeeping supervisor, cleaning and housekeeping supervisors, climate change consultant, climate change consultants, climate consultant, climate consultants, countryside ranger, countryside rangers, energy adviser, energy advisers, energy assessor, energy assessors, energy prodcution manager, energy prodcution managers, environmental engineer, environmental engineers, environmental services manager, environmental services managers, geo-environmental engineer, geo-environmental engineers, horticultural scientist, horticultural scientists, hydrogeologist, hydrogeologists, hydrologist, hydrologists, occupational health manager, occupational health managers, occupational health officer, occupational health officers, park officers and ranger, park officers and rangers, park ranger, park rangers, waste disposal manager, waste disposal managers, water engineer, zoological researcher, zoological researchers, energy auditor, energy auditors, ecosystem expert, ecosystem experts, urban planner</skos:altLabel>
        <cpr:P7 xml:lang="en">A job requiring a substantial amount of green skills, largely based on an analysis by Nesta.</cpr:P7>
        <schema:description xml:lang="en">A job requiring a substantial amount of green skills.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1794 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1794">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q69"/>
        <rdfs:label xml:lang="en">job with substantial green activities</rdfs:label>
        <skos:altLabel xml:lang="en">architect, architects, accounts director, accounts directors, advertising and marketing director, advertising and marketing directors, air transport operative, air transport operatives, aircraft engineers, art gallery managers and director, art gallery managers and directors, automotive engineers, beauty salon managers and proprietor, beauty salon managers and proprietors, boiler operative, boiler operatives, carpenter and joinery supervisor, carpenter and joinery supervisors, charitable organisation managers and director, charitable organisation managers and directors, cinema managers and proprietor, cinema managers and proprietors, cleaning and hygiene services managers and proprietor, cleaning and hygiene services managers and proprietors, complaints and customer service director, complaints and customer service directors, compressor operative, compressor operatives, conservationist, conservationists, construction and building trade supervisor, construction and building trade supervisors, construction project and contract manager, construction project and contract managers, construction project managers and related professional, construction project managers and related professionals, delivery operative, delivery operatives, diplomats and foreign office official, diplomats and foreign office officials, directors in consultancy service, directors in consultancy services, dockers, slingers and stevedore, dockers, slingers and stevedores, early education and childcare services proprietor, early education and childcare services proprietors, ecologist, ecologists, educational establishment managers and proprietor, educational establishment managers and proprietors, electronics engineer, electronics engineers, elementary storage occupation, elementary storage occupations, elementary storage supervisor, elementary storage supervisors, energy manager, energy managers, energy plant operative, energy plant operatives, engineering construction rigger, engineering construction riggers, engineering professional, engineering professionals, environmental consultancy director, environmental consultancy directors, environmental consultant, environmental consultants, environmental professional, environmental professionals, environmental scientist, environmental scientists, estimator, estimators, estimators, valuers and assessor, estimators, valuers and assessors, events director, events directors, felt and flat roofer, felt and flat roofers, film and television production manager, film and television production managers, funeral services and crematorium managers and proprietor, funeral services and crematorium managers and proprietors, garage managers and proprietor, garage managers and proprietors, geologist, geologists, geophysicist, geophysicists, golf course manager, golf course managers, gym, fitness and leisure services managers and proprietor, gym, fitness and leisure services managers and proprietors, hairdressing and beauty salon managers and proprietor, hairdressing and beauty salon managers and proprietors, heritage officer, heritage officers, hire services managers and proprietor, hire services managers and proprietors, hotel and accommodation managers and proprietor, hotel and accommodation managers and proprietors, intellectual property managers and director, intellectual property managers and directors, intelligence analyst, intelligence analysts, laboratory manager, laboratory managers, landscape architects and designer, landscape architects and designers, leisure and sports managers and proprietor, leisure and sports managers and proprietors, library manager, library managers, loss adjuster, loss adjusters, management consultancy director, management consultancy directors, managers and directors in the creative industries, managers and directors in the extraction of fossil fuel, managers and directors in the extraction of fossil fuels, managers and directors in the production of energy, m