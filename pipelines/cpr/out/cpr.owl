        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1416"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2706"/>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2654 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2654">
        <rdfs:label xml:lang="en">feebate</rdfs:label>
        <skos:altLabel xml:lang="en">bonus malus, bonus-malus, fee bate, fee-bate, feebate scheme</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1277"/>
        <schema:description xml:lang="en">A feebate is an economic instrument that combines a fee and a rebate system to influence behavior. Actors whose activities exceed a defined threshold (e.g. high emissions or low efficiency) pay a surcharge (&quot;malus&quot;), while those who perform better than the threshold receive a financial reward (&quot;bonus&quot;). The scheme is typically designed to be revenue-neutral.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2655 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2655">
        <rdfs:label xml:lang="en">performance standard</rdfs:label>
        <skos:altLabel xml:lang="en">performance standards</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <schema:description xml:lang="en">a standard that sets required levels of performance (in terms of emissions, efficiency etc), but actors are free to choose the technologies and methods for how they will do so.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2656 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2656">
        <rdfs:label xml:lang="en">public procurement standard</rdfs:label>
        <skos:altLabel xml:lang="en">public procurement standards</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <schema:description xml:lang="en">A standard set by governments for public goods. These can be technology-specific or performance-based.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2658 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2658">
        <rdfs:label xml:lang="en">retirement premium</rdfs:label>
        <skos:altLabel xml:lang="en">scrappage bonus scheme, scrappage bonus schemes, scrappage incentives, scrappage scheme, scrappage schemes, scrappage incentive, scrappage policies, scrappage policy, scrappage bonus, scrappage model, scrappage premium, scrappage program, scrappage programme, scrappage programmes, scrappage programs</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1274"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2728"/>
        <schema:description xml:lang="en">A financial incentive where the government provides support for the early retirement of emissions-intensive or inefficient assets (for example, bonuses for getting rid of dirty vehicles)</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2665 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2665">
        <rdfs:label xml:lang="en">fixed feed-in-premium</rdfs:label>
        <skos:altLabel xml:lang="en">fixed FiP</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1305"/>
        <schema:description xml:lang="en">Under a fixed Feed-In-Premium scheme, the Renewable Energy Sources plant operator receives a fixed support payment on top of the remuneration obtained from selling the produced electricity on the market.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2666 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2666">
        <rdfs:label xml:lang="en">sliding feed-in-premium</rdfs:label>
        <skos:altLabel xml:lang="en">sliding FiP</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1305"/>
        <schema:description xml:lang="en">Under a sliding FIP scheme, the support paid to an awarded project will consist of the difference between the winning price and a reference electricity price. The reference electricity price is usually defined as the average electricity market value of plants in the same technology category over a given period</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2668 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2668">
        <rdfs:label xml:lang="en">Contracts for Difference</rdfs:label>
        <skos:altLabel xml:lang="en">CfD, contract for difference</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <schema:description xml:lang="en">A CfD is a long-term contract between a renewable energy generator and a government or financial counterparty that stabilizes revenue by fixing the price of electricity.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2669 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2669">
        <rdfs:label xml:lang="en">feed in tariff technology specific</rdfs:label>
        <skos:altLabel xml:lang="en">FiTT</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <schema:description xml:lang="en">Same as feed in tariff, but a technology specific policy (generally, a higher support payment for Offshore Wind Power was necessary than for other renewables, like onshore wind power or solar).</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2680 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2680">
        <rdfs:label xml:lang="en">fossil fuel phase-down</rdfs:label>
        <skos:altLabel xml:lang="en">phase down of fossil fuels, phase-down of coal, phase-down of fossil fuel, phasing down coal, phasing-down fossil fuel, phasing-down fossil fuels, unabated coal, unabated fossil fuel, unabated fossil fuels, unabated coal power</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2681"/>
        <schema:description xml:lang="en">decreasing the use of fossil fuels, though not necessarily to 0</schema:description>
    </owl:NamedIndividual>
    


