        <cpr:P4 rdf:resource="https://globalecolabelling.net/about/what-is-ecolabelling/"/>
        <cpr:P7 xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</cpr:P7>
        <schema:description xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</schema:description>
    </owl:NamedIndividual>
    


