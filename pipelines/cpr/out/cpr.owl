        <skos:altLabel xml:lang="en">Loss and Damage Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">MCFs</skos:altLabel>
        <skos:altLabel xml:lang="en">Nature, People and Climate Investment Program</skos:altLabel>
        <skos:altLabel xml:lang="en">Pilot Program for Climate Resilience</skos:altLabel>
        <skos:altLabel xml:lang="en">Renewable Energy Integration Program</skos:altLabel>
        <skos:altLabel xml:lang="en">SCCF</skos:altLabel>
        <skos:altLabel xml:lang="en">SCF</skos:altLabel>
        <skos:altLabel xml:lang="en">SREP</skos:altLabel>
        <skos:altLabel xml:lang="en">Scaling Up Renewable Energy Program for Low Income Countries</skos:altLabel>
        <skos:altLabel xml:lang="en">Scaling up Renewable Energy Program in Low Income Countries</skos:altLabel>
        <skos:altLabel xml:lang="en">Special Climate Change Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Strategic Climate Fund</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1361"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1364"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1583"/>
        <cpr:P7 xml:lang="en">A financial mechanism that pools resources from multiple donor countries and institutions to support climate change mitigation and adaptation projects across developing nations. Typically managed by international organisations or development banks, a multilateral climate fund operates with established governance structures and funding criteria.</cpr:P7>
        <schema:description xml:lang="en">International institution funded by developed countries to distribute climate grants and/or loans.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1364 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1364">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1362"/>
        <rdfs:label xml:lang="en">accredited entity</rdfs:label>
        <skos:altLabel xml:lang="en">implementing agency</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1363"/>
        <cpr:P7 xml:lang="en">An organisation that has been formally approved by a climate fund to receive and manage climate finance resources on behalf of implementing partners. These entities must meet specific fiduciary standards, environmental and social safeguards, and demonstrate capacity to develop and implement climate projects. Accredited entities can be national, regional, or international organisations that serve as intermediaries between climate funds and project executors and can be accredited as implementing, delivery or executing entities.</cpr:P7>
        <schema:description xml:lang="en">An organisation accredited to partner with climate funds to implement projects.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1365 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1365">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1362"/>
        <rdfs:label xml:lang="en">bilateral climate fund or initiative</rdfs:label>
        <skos:altLabel xml:lang="en">AREI</skos:altLabel>
        <skos:altLabel xml:lang="en">Africa Renewable Energy Initiative</skos:altLabel>
        <skos:altLabel xml:lang="en">GCCI</skos:altLabel>
        <skos:altLabel xml:lang="en">GCPF</skos:altLabel>
        <skos:altLabel xml:lang="en">GEEREF</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Climate Change Initiative</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Climate Partnership Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Energy Efficiency and Renewable Energy Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">IKI</skos:altLabel>
        <skos:altLabel xml:lang="en">International Climate Forest Initiative</skos:altLabel>
        <skos:altLabel xml:lang="en">International Climate Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">International Climate Initiative</skos:altLabel>
        <skos:altLabel xml:lang="en">Internationale Klimaschutzinitiative</skos:altLabel>
        <skos:altLabel xml:lang="en">MDG Achievement Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">MDG-F</skos:altLabel>
        <skos:altLabel xml:lang="en">NAMA Facility</skos:altLabel>
        <skos:altLabel xml:lang="en">NICFI</skos:altLabel>
        <skos:altLabel xml:lang="en">Nationally Appropriate Mitigation Action Facility</skos:altLabel>
        <skos:altLabel xml:lang="en">Norway&apos;s International Climate Forest Initiative</skos:altLabel>
        <skos:altLabel xml:lang="en">REDD+ Early Movers</skos:altLabel>
        <skos:altLabel xml:lang="en">REM</skos:altLabel>
        <cpr:P7 xml:lang="en">A climate financing arrangement where one country directly provides climate-related funding to another country or specific projects. These initiatives are typically managed through the donor country&apos;s development agency or dedicated climate programs and reflect the donor&apos;s strategic priorities and interests. Bilateral climate funds often focus on specific regions or types of climate action that align with the donor country&apos;s foreign policy objectives.</cpr:P7>
        <schema:description xml:lang="en">Climate fund or project undertaken through a partnership between two countries.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1366 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1366">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1362"/>
        <rdfs:label xml:lang="en">national climate fund</rdfs:label>
        <skos:altLabel xml:lang="en">Amazon Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Bangladesh Climate Change Resilience Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Bangladesh Climate Change Trust Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Benin National Fund for the Environment and Climate</skos:altLabel>
        <skos:altLabel xml:lang="en">Brazilian National Fund on Climate Change</skos:altLabel>
        <skos:altLabel xml:lang="en">CVF &amp; V20 Joint Multi Donor Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">CVF &amp; V20 Joint Multi-Donor Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">CVF and V20 Joint Multi Donor Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">CVF and V20 Joint Multi-Donor Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Cambodia Climate Change Alliance Trust Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate Resilient Green Economy</skos:altLabel>
        <skos:altLabel xml:lang="en">Climate Resilient Green Economy - Ethiopia</skos:altLabel>
        <skos:altLabel xml:lang="en">Fundo Amazônia</skos:altLabel>
        <skos:altLabel xml:lang="en">Guyana REDD+ Investment Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Indonesia Climate Change Trust Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">JETP</skos:altLabel>
        <skos:altLabel xml:lang="en">JETPs</skos:altLabel>
        <skos:altLabel xml:lang="en">Just Energy Transition Partnership</skos:altLabel>
        <skos:altLabel xml:lang="en">Just Energy Transition Partnerships</skos:altLabel>
        <skos:altLabel xml:lang="en">Maldives Climate Change Trust Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Mali Climate Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Mexico Climate Change Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Philippines People&apos;s Survival Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Rwanda Green Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">Rwanda&apos;s Green Fund</skos:altLabel>
        <skos:altLabel xml:lang="en">South Africa Green Fund</skos:altLabel>
        <cpr:P7 xml:lang="en">A country-specific funding mechanism established to receive and manage climate finance from both domestic and international sources. These funds serve as national entities that coordinate climate-related investments, ensure alignment with national climate strategies and streamline the implementation of climate projects within the country. They often act as central coordinating bodies for climate finance at the national level.</cpr:P7>
        <schema:description xml:lang="en">Fund established by an individual country to meet national climate goals.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1367 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1367">
        <rdfs:label xml:lang="en">public finance actor</rdfs:label>
        <skos:altLabel xml:lang="en">public financial institution</skos:altLabel>
        <skos:altLabel xml:lang="en">state-backed financial body</skos:altLabel>
        <cpr:P7 xml:lang="en">These actors are usually majority-owned, backed or significantly controlled by nation-state governments. Their connection to governmental structures shapes their operation within the climate finance landscape. Their activities are guided by a public mandate and they can deploy a range of financial instruments including grants, loans, equity and guarantees. Public finance actors may operate at a national or international level, and may collaborate with other public and private entities to influence climate action. They can play pivotal roles by directing public resources towards climate projects and by aligning activities with national priorities, but not all are engaged in climate finance activities.</cpr:P7>
        <schema:description xml:lang="en">An enterprise or financial institution that is usually majority-owned, backed or significantly controlled by nation-state governments.</schema:description>
    </owl:Class>
    


