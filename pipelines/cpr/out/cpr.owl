        <rdfs:label xml:lang="en">jetty</rdfs:label>
        <skos:altLabel xml:lang="en">jetties</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/jetties"/>
        <schema:description xml:lang="en">Jetties are hard structures built at the banks of tidal inlets and river mouths aiming to stabilise one or both banks from shifting position and prevent large volumes of sand from filling the inlet/river mouth and preventing channel siltation. Jetties are solid and durable and are considered a protection measure.</schema:description>
    </owl:Class>
    


