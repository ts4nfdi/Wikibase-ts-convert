    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1171 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1171">
        <rdfs:label xml:lang="en">policy instrument</rdfs:label>
        <skos:altLabel xml:lang="en">government instrument</skos:altLabel>
        <skos:altLabel xml:lang="en">government instruments</skos:altLabel>
        <skos:altLabel xml:lang="en">policy instruments</skos:altLabel>
        <skos:altLabel xml:lang="en">policy tool</skos:altLabel>
        <skos:altLabel xml:lang="en">policy tools</skos:altLabel>
        <skos:altLabel xml:lang="en">tools of government</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1651"/>
        <cpr:P7 xml:lang="en">Policy instruments are techniques or tools used by governing authorities to promote certain policies in order to achieve predetermined goals. Put simply, instruments are how a government tries to achieve its goals, with this taxonomy being focused on national policy instruments.</cpr:P7>
        <schema:description xml:lang="en">Policy instruments are techniques or tools used by governing authorities to promote certain policies in order to achieve predetermined goals. Put simply, instruments are how a government tries to achieve its goals, with this taxonomy being focused on national policy instruments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1172 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1172">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">physically vulnerable people</rdfs:label>
        <skos:altLabel xml:lang="en">the physically vulnerable</skos:altLabel>
        <cpr:P7 xml:lang="en">people whose physiology or health makes them more likely to be impacted by climate change. Note that this includes mental health, even though this is not strictly physical</cpr:P7>
        <schema:description xml:lang="en">people whose physiology or health makes them more likely to be impacted by climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1173 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1173">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground shaking</skos:altLabel>
        <schema:description xml:lang="en">A volcanic earthquake is any earthquake that results from tectonic forces which occur in conjunction with volcanic activity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1174 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1174">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">soil liquefaction</rdfs:label>
        <skos:altLabel xml:lang="en">earthquake trigger</skos:altLabel>
        <schema:description xml:lang="en">Soil liquefaction occurs when soil is transformed from a solid to a liquid state as a result of increased pore pressure and reduced effective stress. It is typically caused by rapid loading of the soil during earthquake shaking.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1175 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1175">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">nuclear plant failure</rdfs:label>
        <skos:altLabel xml:lang="en">nucelar plant failures</skos:altLabel>
        <skos:altLabel xml:lang="en">nuclear meltdown</skos:altLabel>
        <skos:altLabel xml:lang="en">nuclear meltdowns</skos:altLabel>
        <skos:altLabel xml:lang="en">nuclear shutdown</skos:altLabel>
        <skos:altLabel xml:lang="en">nuclear shutdowns</skos:altLabel>
        <schema:description xml:lang="en">Nuclear plant failure occurs when the accidental melting of the core of a nuclear reactor results in either the core to have a complete or partial collapse</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1176 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1176">
