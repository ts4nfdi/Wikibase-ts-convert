        <cpr:P20 xml:lang="en">8fj9pk8h</cpr:P20>
        <cpr:P7 xml:lang="en">This section includes specialised professional, scientific and technical activities. These activities require a high degree of training, and make specialised knowledge and skills available to users.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q778">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1591"/>
