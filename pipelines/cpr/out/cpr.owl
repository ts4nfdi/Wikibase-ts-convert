        <skos:altLabel xml:lang="en">labor principles</skos:altLabel>
        <schema:description xml:lang="en">International labour standards on a broad range of subjects related to the world of work, including human rights at work, employment policy and human resources development.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q661 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q661">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q638"/>
        <rdfs:label xml:lang="en">coal</rdfs:label>
        <cpr:P20 xml:lang="en">ty2jvjmp</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1470"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q221"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q223"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q560"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q751"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q760"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q790"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q923"/>
        <cpr:P7 xml:lang="en">Coal is a fossil fuel and non-renewable energy source consisting of solid, carbonised plant material that accumulated and transformed under heat and pressure over millions of years. It is classified into types such as hard coal, brown coal and derived coal products, and is chiefly used for electricity generation, steelmaking and other industrial processes.</cpr:P7>
        <cpr:P9 xml:lang="en">CBM</cpr:P9>
        <cpr:P9 xml:lang="en">coal bed gas</cpr:P9>
        <cpr:P9 xml:lang="en">coal seam gas</cpr:P9>
        <cpr:P9 xml:lang="en">coalbed gas</cpr:P9>
        <cpr:P9 xml:lang="en">coalbed methane</cpr:P9>
        <cpr:P9 xml:lang="en">csg</cpr:P9>
        <cpr:P9 xml:lang="en">virgin coal seam methane</cpr:P9>
        <schema:description xml:lang="en">Coal is a combustible sedimentary rock formed from carbonised plant matter, rich in carbon and hydrocarbons, and occurring in several main types including hard coal and brown coal.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q670 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q670">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q791"/>
