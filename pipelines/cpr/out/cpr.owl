    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1009 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1009">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <rdfs:label xml:lang="en">short-lived climate pollutant</rdfs:label>
        <skos:altLabel xml:lang="en">short lived climate pollutant, short lived climate pollutants, short-lived climate pollutants, SLCP, SLCPs, short lived climate forcer, short lived climate forcers, short-lived climate forcer, short-lived climate forcers, SLCFs, SLCF, super pollutants, superpollutants</skos:altLabel>
        <cpr:P7 xml:lang="en">Also referred to as short-lived climate forcers, this group of pollutants have high warming potential, and short atmospheric lifetimes. These pollutants can warm the Earth faster than carbon dioxide, as per molecule in the atmosphere they have a stronger warming effect.</cpr:P7>
        <schema:description xml:lang="en">Also referred to as short-lived climate forcers, this group of pollutants have high warming potential, and short atmospheric lifetimes. These pollutants can warm the Earth faster than carbon dioxide, as per molecule in the atmosphere they have a stronger warming effect.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q101 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q101">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q96"/>
        <rdfs:label xml:lang="en">flood hazard mapping</rdfs:label>
        <skos:altLabel xml:lang="en">flood hazard mapping, flood hazard map, flood hazard maps, flooding map, flooding maps, mapping flood hazard, mapping flood hazards, mapping flooding, mapping floods, assessing flood hazard, flood hazard assessment, assess flood hazard, assess flood hazards, assess flooding, assess floods, assessed flood hazard, assessed flood hazards, assessing flood hazards, flood risk map, flood risk mapping, flood risk maps, mapping flood risk, mapping flood risks</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1523"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q91"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/flood-hazard-mapping"/>
        <schema:description xml:lang="en">Flood hazard assessment and mapping is used to identify areas at risk of flooding, and consequently to improve flood risk management and disaster preparedness. Flood Hazard Mapping is a vital component for appropriate land use planning in flood-prone areas. It creates easily-read, rapidly-accessible charts and maps which facilitate the identification of areas at risk of flooding.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1010 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1010">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1009"/>
        <rdfs:label xml:lang="en">black carbon</rdfs:label>
        <schema:description xml:lang="en">A short-lived particulate pollutant, mainly produced by incomplete combustion of fossil fuels, biomass and biofuels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1011 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1011">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <rdfs:label xml:lang="en">acidification</rdfs:label>
        <skos:altLabel xml:lang="en">soil acidification, acidification of soil, acidification of the soil, acidify the soil, acid soil, acid soils, acidic soil, acidic soils</skos:altLabel>
        <cpr:P7 xml:lang="en">Acidification refers to increased acidity in ecosystems due to pollution, harming biodiversity, degrading soils, freshwater systems, and damaging infrastructure. It occurs when pollutants like CO₂, sulfur dioxide (SO₂), and nitrogen oxides (NOx) reduce pH levels in the environment. This leads to risks for plants, animals, and human health, while also contributing to long-term environmental damage.</cpr:P7>
        <schema:description xml:lang="en">Acidification refers to increased acidity in ecosystems due to pollution, harming biodiversity, degrading soils, freshwater systems, and damaging infrastructure.</schema:description>
    </owl:Class>
    


