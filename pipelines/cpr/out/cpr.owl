        <skos:altLabel xml:lang="en">HCFCs</skos:altLabel>
        <skos:altLabel xml:lang="en">freon</skos:altLabel>
        <skos:altLabel xml:lang="en">hydrochlorofluorocarbon</skos:altLabel>
        <schema:description xml:lang="en">Transitional, ozone-depleting gases, used as substitutes for chlorofluorocarbons in refrigeration and aerosols.</schema:description>
    </owl:Class>
    


