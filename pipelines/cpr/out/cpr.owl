    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1013 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1013">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">arctic warming</rdfs:label>
        <skos:altLabel xml:lang="en">Arctic temperature change, Arctic temperature increase, warming in the Arctic, warming of the Arctic</skos:altLabel>
        <cpr:P7 xml:lang="en">add later</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1014 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1014">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q983"/>
        <rdfs:label xml:lang="en">sea ice loss</rdfs:label>
        <skos:altLabel xml:lang="en">decline of sea ice, loss of sea ice, sea ice decline, declining sea ice, ice sheet mass loss, reduced sea ice protection, decrease in seasonal sea ice extent, changes in sea ice</skos:altLabel>
        <cpr:P7 xml:lang="en">Accelerated warming is rapidly reducing Arctic sea ice, increasing heat absorption by the dark ocean surface and further amplifying global warming. This threatens species adapted to sea ice, such as polar bears, walruses, and seals, while also exacerbating climate change by enhancing the ocean’s uptake of atmospheric carbon dioxide.</cpr:P7>
        <schema:description xml:lang="en">Accelerated warming is rapidly reducing Arctic sea ice, increasing heat absorption by the dark ocean surface and further amplifying global warming. This threatens species adapted to sea ice, such as polar bears, walruses, and seals, while also exacerbating climate change by enhancing the ocean’s uptake of atmospheric carbon dioxide.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1016 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1016">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <rdfs:label xml:lang="en">sexual minority</rdfs:label>
        <skos:altLabel xml:lang="en">asexual, bisexual, gay, homosexual, intersex, lesbian, LGBT, LGBT+, LGBTQ, LGBTQ+, LGBTQI, LGBTQI+, LGBTQIA, LGBTQIA+, men who have sex with men, pansexual, queer, sexual minorities, sexual preference, women who have sex with women, men who love men, women who love women, men having sex with men, women having sex with women, sexual orientation, 2SLGBTQIA, 2SLGBTQIA+, non hetero, non heterosexual, non-hetero, non-heterosexual</skos:altLabel>
        <cpr:P20 xml:lang="en">g7brun33</cpr:P20>
        <cpr:P7 xml:lang="en">people with diverse (that is, non-heterosexual, non-cisgender or non-binary) sexual orientations, gender identities, gender expressions or sex characteristics. In the context of climate impacts, this should be seen as one of a wider set of intersecting identities and historical power structures that create marginalisation.</cpr:P7>
        <cpr:P9 xml:lang="en">asexual propagation</cpr:P9>
        <schema:description xml:lang="en">People whose sexual orientation, gender identity, or gender expression differs from the majority or societal norms</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1017 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1017">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q956"/>
        <rdfs:label xml:lang="en">resource scarcity</rdfs:label>
        <skos:altLabel xml:lang="en">natural resource scarcity, resource competition, natural-resource competition, natural-resource scarcity, scarcity of resources, resource insecurity, resource security, resource shortage, resource shortages, shortage of resources, shortages of resources</skos:altLabel>
        <cpr:P7 xml:lang="en">The scarcity of resources can be intensified by climate change, affecting the access to basic needs like food, land, and water. It exacerbates the vulnerability of populations, ecosystems, economies, and institutions, with the severity of impacts depending on both climate factors and the magnitude of scarcity itself.</cpr:P7>
        <schema:description xml:lang="en">Natural resource scarcity is the lack of resources needed for human use and consumption, such as water, land, food, energy, and materials.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q102 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q102">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1429"/>
        <rdfs:label xml:lang="en">monitoring systems</rdfs:label>
        <skos:altLabel xml:lang="en">monitoring system</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q103"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q87"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technology-type-group/monitoring-systems"/>
        <schema:description xml:lang="en">A monitoring system refers to a set of tools, technologies, and processes used to continuously collect, track, and analyse data. In the context of climate change, these systems are crucial for observing changes in factors such as temperature, emissions, weather patterns, or resource use.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q103 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q103">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <rdfs:label xml:lang="en">climate change monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">climate change monitoring, climate change risk monitoring, climate risk monitoring, climate monitoring, climate observation, climate observations, observation of the climate</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q102"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/monitoring-technologies"/>
        <schema:description xml:lang="en">A climate change monitoring system integrates satellite observations, ground-based data and forecast models to monitor and forecast changes in the weather and climate. A historical record of spot measurements is built up over time, which provides the data to enable statistical analysis and the identification of mean values, trends and variations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1045 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1045">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <rdfs:label xml:lang="en">saltwater intrusion</rdfs:label>
        <skos:altLabel xml:lang="en">encroachment of salt water, encroachment of saltwater, encroachment of sea water, encroachment of seawater, intrusion of salt water, intrusion of saltwater, intrusion of seawater, salt water encroachment, salt water intrusion, saltwater encroachment, saltwater intrusion, sea water encroachment, sea water intrusion, seawater intrusion</skos:altLabel>
        <cpr:P7 xml:lang="en">add</cpr:P7>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q105 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q105">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1429"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <rdfs:label xml:lang="en">ecosystem monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">ecosystem monitoring, monitoring of ecosystem, environmental monitoring</skos:altLabel>
        <cpr:P4 rdf:resource="https://library.fiveable.me/key-terms/earth-systems-science/ecosystem-monitoring"/>
        <cpr:P4 rdf:resource="https://unece.org/environmental-monitoring"/>
        <schema:description xml:lang="en">Ecosystem monitoring refers to the systematic observation and assessment of ecosystems to track changes, understand ecological processes, and evaluate the health of environmental systems over time. This process often employs various tools and technologies to gather data and supports policymaking.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1050 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1050">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">microplastics</rdfs:label>
        <cpr:P7 xml:lang="en">Micro- to macroplastics are insoluble in water, and can range in size from 1 μm to anything above 5mm. They can originate from primary sources (manufactured at that size) or secondary sources (breakdown from later plastics). Macroplastics can degrade into microplastics over time, and are major pollutants in aquatic ecosystems, posing risks to human and animal health.</cpr:P7>
        <schema:description xml:lang="en">Micro- to macroplastics are insoluble in water, and can range in size from 1 μm to anything above 5mm. They can originate from primary sources (manufactured at that size) or secondary sources (breakdown from later plastics). Macroplastics can degrade into microplastics over time, and are major pollutants in aquatic ecosystems, posing risks to human and animal health.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1052 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1052">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <rdfs:label xml:lang="en">mesoplastic</rdfs:label>
        <skos:altLabel xml:lang="en">large micro plastic, large micro plastics, large microplastic, large microplastics</skos:altLabel>
        <cpr:P7 xml:lang="en">add</cpr:P7>
        <schema:description xml:lang="en">any solid plastic particle insoluble in water with any dimension between 1 mm and 5 mm</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1053 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1053">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <rdfs:label xml:lang="en">microplastic</rdfs:label>
        <skos:altLabel xml:lang="en">microplastics, micro plastic, micro plastics, Nanoparticles Marine debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1064"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1067"/>
        <cpr:P7 xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm. They can be harmful to the environment especially marine life and originate from larger plastic debris that degrades into smaller pieces.</cpr:P7>
        <schema:description xml:lang="en">any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm. They can be harmful to the environment especially marine life and originate from larger plastic debris that degrades into smaller pieces.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1054 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1054">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1050"/>
        <rdfs:label xml:lang="en">nanoplastic</rdfs:label>
        <skos:altLabel xml:lang="en">nano plastic, nano plastics, nanoplastics</skos:altLabel>
        <cpr:P7 xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm.</cpr:P7>
        <schema:description xml:lang="en">Any solid plastic particle insoluble in water with any dimension between 1 µm and 1 000 µm.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q106 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q106">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <rdfs:label xml:lang="en">riverine flood protection</rdfs:label>
        <skos:altLabel xml:lang="en">fluvial flood protection, river flood protection, protection against fluvial flooding, protection against fluvial floods, protection against river flooding, protection against river floods, river floodwall, river floodwalls</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q982"/>
        <cpr:P7 xml:lang="en">A fluvial (riverine) flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate. Riverine flood protection refers to a set of measures and strategies designed to prevent or mitigate the impacts of flooding in areas adjacent to rivers.</cpr:P7>
        <schema:description xml:lang="en">A fluvial (riverine) flood is a rise, usually brief, in the water level of a stream or water body to a peak from which the water level recedes at a slower rate. Riverine flood protection refers to a set of measures and strategies designed to prevent or mitigate the impacts of flooding in areas adjacent to rivers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1067 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1067">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q820"/>
        <rdfs:label xml:lang="en">landfilling</rdfs:label>
        <skos:altLabel xml:lang="en">landfill, landfills, garbage site, land fill, land filling, landfill site, plastic burial, sanitary landfill, sanitary landfills, waste burial, waste site, plastic in landfills, plastics in landfills, landfill leachates</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1053"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1070"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q763"/>
        <cpr:P7 xml:lang="en">The process of depositing waste into or onto the land in a controlled way. The definition covers both landfilling at internal sites (i.e., where a generator of waste is carrying out its own waste disposal at the place of generation) and at external sites.</cpr:P7>
        <schema:description xml:lang="en">The process of depositing waste into or onto the land</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q107 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q107">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1955"/>
        <rdfs:label xml:lang="en">flow-through dam</rdfs:label>
        <skos:altLabel xml:lang="en">flow-through dams, perforated dam</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/flow-through-dam-flood-control"/>
        <schema:description xml:lang="en">The flow-through dam is designed for the sole purpose of flood control, just one of the many possible functions of dams. An opening (spillway) is designed into the dam at about the same height as the river bed, so the structure is intended to let water flow through during normal times.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1078 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1078">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">electricity failure</rdfs:label>
        <skos:altLabel xml:lang="en">blackout, brownout, disruption to electricity, electricity disruption, power cut, power loss, blackouts, brownouts, disruptions to electricity, electricity disruptions, electricity failures, power cuts, power losses, outage, collapse of power lines, power lines collapsed, breakdown in power plant, breakdowns in power plants, failures in overhead power lines, outages, damage to energy infrastructure, partial collapse of power system</skos:altLabel>
        <schema:description xml:lang="en">A loss of power for a short period of time, often caused by technological failure and extreme weather events</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1079 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1079">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">submarine landslide</rdfs:label>
        <skos:altLabel xml:lang="en">submarine landslides, turbidity current</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q408"/>
        <schema:description xml:lang="en">A submarine landslide is a downslope movement of sediment or rock under the effect of gravity, which occurs when the stresses acting downslope exceed the available strength of the sediment on the slope.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q108 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q108">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">river restoration</rdfs:label>
        <skos:altLabel xml:lang="en">restoration of river, restore river, restoring river, river restoration, watershed restoration</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/river-restoration"/>
        <cpr:P4 rdf:resource="https://www.umweltbundesamt.de/en/topics/water/rivers/river-restoration-start#restoration-measures-improve-the-ecological-status-of-rivers"/>
        <schema:description xml:lang="en">Rivers are dynamic by nature as they carve their own course, distribute sediments and spill onto flood plains during flood events. Ecological river restoration involves ecological, spatial and physical management practices with the aim of returning rivers to their natural state.  Common restoration techniques include reconnecting rivers with floodplains, reestablishment of the river’s meandering form with no barriers along its banks (i.e. removal of built-up embankments), and stabilising surrounding soil to reduce sedimentation and erosion (i.e. bed fixation).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1080 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1080">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">tectonic uplift</rdfs:label>
        <skos:altLabel xml:lang="en">coseismic uplift</skos:altLabel>
        <schema:description xml:lang="en">Tectonic uplift is the geological process where land is raised due to tectonic forces, such as the movement of Earth&apos;s plates.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1082 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1082">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">pyroclastic flow</rdfs:label>
        <skos:altLabel xml:lang="en">lahar, lahars, lapilli, pyroclast, tephra fall, ash flow, hot avalanche, nuée ardente, pyroclasts, tephra, pyroclast density current, pyroclast density currents, pyroclast flows</skos:altLabel>
        <schema:description xml:lang="en">Pyroclastic flow is a dense, fast-moving flow (exceeding 100km/h) of solidified lava pieces, volcanic ash, and hot gases that can reach about 600 to 700 °C.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1085 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1085">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">lava flows</rdfs:label>
        <skos:altLabel xml:lang="en">lava effusion, lava flow, volcanic mudflow</skos:altLabel>
        <schema:description xml:lang="en">Lava flows are molten rock from a volcano eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q109 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q109">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
        <rdfs:label xml:lang="en">artificial lowering of glacial lakes</rdfs:label>
        <skos:altLabel xml:lang="en">artificial lowering of glacial lake, artificially lower glacial lake, glacial lake outburst flood protection, protection against glacial lake outburst floods, protection against GLOFs, resilience against glacial lake outburst floods, resilience against GLOFs, glacial lake outburst flood risk reduction, GLOF risk reduction</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1006"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/artificial-lowering-glacial-lakes"/>
        <schema:description xml:lang="en">The artificial lowering of glacial lakes is the process of draining water from those vulnerable to overflowing by digging a canal from the lake to a nearby river. Drainage reduces water level and decreases pressure on moraine dams. This in turn reduces the risk of burst events (i.e., GLOFs).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1091 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1091">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">lava dome</rdfs:label>
        <skos:altLabel xml:lang="en">lava domes</skos:altLabel>
        <schema:description xml:lang="en">Lava dome is a pile of relatively viscous lava that cannot flow far from the vent in a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1094 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1094">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic eruption</rdfs:label>
        <skos:altLabel xml:lang="en">volcanic eruptions</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1199"/>
        <schema:description xml:lang="en">A volcanic eruption is when gas and/or lava are released from a volcano.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q110 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q110">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1636"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1938"/>
        <rdfs:label xml:lang="en">flood-proof wells</rdfs:label>
        <skos:altLabel xml:lang="en">flood proof well, flood-proof well, floodproof well</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/flood-proof-wells"/>
        <schema:description xml:lang="en">Flooding of wells often results in contamination of freshwater. Specialised construction design and planning procedures can be used to protect wells against the risks of flooding, and consequent water contamination. Specific measures can mitigate contaminant infiltration and improve the well’s strength, reducing the risk of collapse during a flooding event.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q111 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q111">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">storm drain</rdfs:label>
        <skos:altLabel xml:lang="en">storm drainage, storm drains</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ecologic.eu/19589"/>
        <cpr:P4 rdf:resource="https://www.sciencedirect.com/science/article/abs/pii/S0301479718304481"/>
        <schema:description xml:lang="en">A storm drain is part of the urban storm management system. It is an infrastructure designed to drain excess rain and ground water from impermeable surfaces and prevent or minimise flooding events.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1118 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1118">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">rockfall</rdfs:label>
        <skos:altLabel xml:lang="en">rock fall, rock falls, rockfalls, boulder fall, falling rocks, boulder falls, boulderfall, boulderfalls</skos:altLabel>
        <schema:description xml:lang="en">A rockfall is a fragment of rock (a block) detached by sliding, toppling, or falling, that falls along a vertical or sub-vertical cliff, proceeds down slope by bouncing and flying along ballistic trajectories or by rolling on talus or debris slopes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1119 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1119">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic ash</rdfs:label>
        <schema:description xml:lang="en">Volcanic ash is a mixture of rock, mineral, and glass particles expelled from a volcano during a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q112 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q112">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">runoff control structure</rdfs:label>
        <skos:altLabel xml:lang="en">run-off control structure, temporary rainfall store, temporary rainfall stores, runoff control structures</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/run-control-structures-temporarily-store-rainfall"/>
        <schema:description xml:lang="en">Runoff control structures are designed to capture runoff during peak flows, and can function as temporary storage sites. These structures are typically built with a discharge component to slowly release water into the nearby waterway to avoid it overflowing from the storage basin. It can be artificially built, for example by excavating a large area so that it is lower than the surrounding land.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1120 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1120">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic gas</rdfs:label>
        <skos:altLabel xml:lang="en">gas-contaminated land, magmatic gases, radon, volcanic gases, magmatic gas, vog</skos:altLabel>
        <schema:description xml:lang="en">It identifies the fluid gas phase released by active volcanoes, both during eruption and quiescence. Volcanic gases are molecular combinations of four elements (H, C, O, and S) but also include a variety of other components.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1121 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1121">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic lightning</rdfs:label>
        <schema:description xml:lang="en">Volcanic lightning is an electrical discharge caused by a volcanic eruption.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1122 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1122">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">subsidence</rdfs:label>
        <schema:description xml:lang="en">Subsidence is a general term for downward vertical movement of the Earth&apos;s surface, which can be caused by both natural processes and human activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1123 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1123">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">coseismic subsidence</rdfs:label>
        <skos:altLabel xml:lang="en">tectonic subsidence</skos:altLabel>
        <schema:description xml:lang="en">It is the downward distributed vertical permanent ground deformation (warping) that result from earthquake displacements on a dipping (inclined) fault.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1125 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1125">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">fault scarp</rdfs:label>
        <skos:altLabel xml:lang="en">fault offset</skos:altLabel>
        <schema:description xml:lang="en">A fault scarp is a surface expression of a fault that has shifted the ground surface, ranging from small slopes to high rock escarpments</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1126 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1126">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground shaking, seismicity, ground movement, tremor, temblor, seismological process</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1152"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1153"/>
        <schema:description xml:lang="en">An earthquake is the shaking of the Earth&apos;s surface resulting from a sudden release of energy in the lithosphere that creates seismic waves.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q113 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q113">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">permeable paving</rdfs:label>
        <skos:altLabel xml:lang="en">permeable car park, permeable carpark, permeable parking lots, permeable pavement, permeable driveway, permeable driveways, permeable pavements, permeable paved surface</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/permeable-parking-lots"/>
        <schema:description xml:lang="en">Permeable pavements and parking lots are often constructed in urban settings to facilitate storm water runoff and mitigate urban flooding and storm water overflow risks. The permeable surfaces provide greater water uptake. The water is infiltrated, and to an extent purified, before recharging the groundwater. The resulting retention decreases runoff rates and reduces pressures on urban storm water systems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1134 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1134">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">induced earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground shaking, underground explosion, induced earthquakes, induced seismicity</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1153"/>
        <schema:description xml:lang="en">Induced seismic ground shaking comprises non-tectonic (i.e., nonnatural) earthquakes which result from human activities that alter thestresses and strains on the Earth’s crust.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1136 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1136">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">fissure</rdfs:label>
        <skos:altLabel xml:lang="en">fissures, ground fissures, ground fissuring, earth fissure, fissura, ground fissure</skos:altLabel>
        <schema:description xml:lang="en">A fissure is a long, narrow crack or linear opening in the Earth&apos;s crust.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1137 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1137">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">surface rupture</rdfs:label>
        <skos:altLabel xml:lang="en">ground deformation, surface faulting, earth surface faulting</skos:altLabel>
        <schema:description xml:lang="en">Surface rupture occurs when movement on a fault deep within the earth breaks through to the surface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1138 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1138">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">soil creep</rdfs:label>
        <skos:altLabel xml:lang="en">landscape creep, downhill creep</skos:altLabel>
        <schema:description xml:lang="en">It is the movement of the soil down a slope under the influence of gravity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1139 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1139">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">soil piping</rdfs:label>
        <schema:description xml:lang="en">Soil piping is a naturally occurring, hydraulic process that leads to the development of macropores (large, air-filled voids) in the subsurface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q114 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q114">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">bioswale</rdfs:label>
        <skos:altLabel xml:lang="en">bioswale</skos:altLabel>
        <cpr:P4 rdf:resource="https://urbangreenbluegrids.com/measures/bioswales/"/>
        <schema:description xml:lang="en">A bioswale is a ditch with vegetation and a porous bottom. The top layer consists of enhanced soil with plants. Below there is a layer of gravel, scoria or baked clay pellets packed in geotextile. These materials have large empty spaces, allowing the rainwater to drain off. An infiltration pipe/drainpipe is situated below the second layer. Rainfall infiltrates into the ground via the ditch and the packed layer. If the water rises above the level of the overflow, the water runs through it to the drainpipe.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1140 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1140">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">solifluction</rdfs:label>
        <schema:description xml:lang="en">It is the slow downslope movement of soil due to recurrent freezing and thawing of the ground.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1141 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1141">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">sinkhole</rdfs:label>
        <skos:altLabel xml:lang="en">doline cenote, swallet, sink-hole, doline cenotes</skos:altLabel>
        <schema:description xml:lang="en">A sinkhole is a closed depression or hole in the ground caused by some form of collapse of the surface layer. It forms when water dissolves surface soluble rock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1148 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1148">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">collapsible soil</rdfs:label>
        <schema:description xml:lang="en">Collapsible soil refers to soil that has the potential to collapse when it becomes saturated, as its fabric is unable to support the weight of the overburden. This type of soil typically consists of a loose skeleton of grains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1149 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1149">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">compressible soil</rdfs:label>
        <skos:altLabel xml:lang="en">compressive soil</skos:altLabel>
        <schema:description xml:lang="en">It is the ease with which a soil decreases in volume when subjected to a mechanical load. Compressive soils are prone to volumetric change when subject to mechanical loading.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q115 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q115">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2019"/>
        <rdfs:label xml:lang="en">storm surge barrier</rdfs:label>
        <skos:altLabel xml:lang="en">closure dam, closure dams, storm surge barriers, tidal barrage, tidal barrages, tidal barrier, tidal barriers</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/sites/www.ctc-n.org/files/resources/storm_surge_barriers_closure_dams.pdf"/>
        <schema:description xml:lang="en">Storm surge barriers and closure dams are hard engineered structures with the primary function of preventing coastal flooding. Storm surge barriers are movable or fixed barriers or gates that are closed to prevent flooding when an extreme water level is forecast. Closure dams are fixed structures that permanently close off a river mouth or estuary.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1150 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1150">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">ground settlement</rdfs:label>
        <schema:description xml:lang="en">A settlement is defined as the vertical movement of the ground, generally caused be changes in stresses within the earth.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1151 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1151">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">ballistics</rdfs:label>
        <schema:description xml:lang="en">Ballistics comprise fragments of magma and old (i.e., pre-existing) rocks ejected during an explosive eruption at variable velocity and angle on cannon ball-like trajectories.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1152 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1152">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">tsunami</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1126"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1197"/>
        <schema:description xml:lang="en">It is a series of travelling waves of extremely long length and period, usually generated by disturbances associated with earthquakes occurring below or near the ocean floor.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1155 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1155">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">riverbank erosion</rdfs:label>
        <skos:altLabel xml:lang="en">stream bank deterioration, stream bank desintegration</skos:altLabel>
        <schema:description xml:lang="en">Riverbank erosion is the removal of material from the banks of rivers when flowing water forces exceed bank resisting forces by the soil and vegetation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1156 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1156">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">sand encroachment</rdfs:label>
        <skos:altLabel xml:lang="en">sand dune migration</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q138"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <schema:description xml:lang="en">Sand encroachment occurs generally in arid to semi-arid regions when grains of sand are carried by winds and form sandy accumulation on coasts, along watercourses and on cultivated or uncultivated land causing major material and socioeconomic damage.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1157 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1157">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1304"/>
        <rdfs:label xml:lang="en">alluvial fan</rdfs:label>
        <schema:description xml:lang="en">An alluvial fan is a fan-shaped area where silt, sand, gravel, boulders, and woody debris are deposited by rivers and streams over a long period of time. Alluvial fans are created as flowing water interacts with steep terrains.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q116 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q116">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">breakwater</rdfs:label>
        <skos:altLabel xml:lang="en">breakwaters, break water, break waters</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/breakwaters"/>
        <schema:description xml:lang="en">Breakwaters are shore-parallel structures located just offshore of the surf zone. They are designed to intercept and reduce incoming wave energy at the shoreline. They thereby protect the coastline behind breakwaters. Breakwaters are generally very solid, durable structures and are considered a protection measure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1160 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1160">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">impacted workers</rdfs:label>
        <skos:altLabel xml:lang="en">employee, employees, workers, working people, working man, working men, working woman, working women, labourer, labourers, contractors</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q62"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <cpr:P7 xml:lang="en">Working people who are disproportionately impacted by climate change or the response to climate change. This can be because the risks of their profession are elevated by climate change; because their social status in general makes them more vulnerable to climate change; or because their profession is likely to change or even disappear due to the green transition.</cpr:P7>
        <schema:description xml:lang="en">Working people who are disproportionately impacted by climate change or the response to climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1161 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1161">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q986"/>
        <rdfs:label xml:lang="en">glacial surge</rdfs:label>
        <skos:altLabel xml:lang="en">glacier surge, glacier surges, surging glaciers</skos:altLabel>
        <schema:description xml:lang="en">They are glaciers that suddenly accelerate to ice flow speeds that are up to two orders of magnitude higher, reaching speeds of tens or even over 100 m per day. The high speed results in a total transformation of the surface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1164 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1164">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:label xml:lang="en">high-risk occupations</rdfs:label>
        <skos:altLabel xml:lang="en">construction worker, construction workers, emergency response worker, emergency response workers, frontline worker, frontline workers, healthcare worker, healthcare workers, high-risk job, high-risk jobs, high-risk occupation, outdoor workers, first responder, first responders, heavy physical work, health care worker, health-care worker, health-care workers, heavy physical labor, manual laborer, manual laborers</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1012"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1571"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q764"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q856"/>
        <cpr:P7 xml:lang="en">People whose occupation makes them more likely to be adversely impacted by climate change. Sometimes, these are jobs which are inherently risky -- for example, fire risk for firefighters or health risks for healthcare workers -- and the magnitude and/or frequency of those risks are increasing due to the effects of climate change. A large share of the increased risk however is due to heat stress from increasing temperatures, as well as air pollution and vector borne diseases.</cpr:P7>
        <schema:description xml:lang="en">People whose occupation makes them more likely to be adversely impacted by climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1165 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1165">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:label xml:lang="en">workers impacted by the transition</rdfs:label>
        <skos:altLabel xml:lang="en">closing factories, fewer jobs, losing employment, losing jobs, lost jobs, factory workers, mine workers, miners, steel workers, steelworkers, workers in heavy industry, workers in the automotive industry, lay off, lay offs, laying off, layoff, layoffs, loss of employment, impacted by the energy transition, impacted by the green transition, impacted by the just transition, impacted by the transition, vulnerable to the energy transition, vulnerable to the green transition, vulnerable to the just transition, vulnerable to the transition, negative effect on employment, negative employment effect, negative employment effects, deindustrialised areas, deindustrialised regions</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q760"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q802"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q804"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q809"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q810"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q814"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q905"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q908"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q909"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q911"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q912"/>
        <cpr:P7 xml:lang="en">People whose job is at risk due to the societal changes necessary to respond to climate change. Often, this is because they work in an industry that either is heavily reliant on fossil fuels, such as the plastics industry, or that creates products which are reliant on fossil fuels, such as cars.</cpr:P7>
        <schema:description xml:lang="en">People whose job is at risk due to the societal changes necessary to respond to climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1166 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1166">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1160"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:label xml:lang="en">working class</rdfs:label>
        <skos:altLabel xml:lang="en">manual labourers, manual laborer, factory workers, blue collar, blue-collar, dalit, low skill jobs, low-skill job, lower caste, lower castes, lower class, lower-class, proletarian, proletariat, working-class, dalits, factory worker, left-behind areas, left-behind regions, menial work, physical labor, contract worker, contract workers, labor hire, temporary worker, temporary workers, who cannot find work</skos:altLabel>
        <cpr:P7 xml:lang="en">People who usually do physical work and usually do not have much money nor a very high level of formal education. This means that, on average, they have more limited means to respond to the effects of climate change and therefore are likely to be impacted more severely by it.</cpr:P7>
        <schema:description xml:lang="en">people who usually do physical work and usually do not have much money nor a very high level of formal education</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1167 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1167">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">people with limited assets</rdfs:label>
        <skos:altLabel xml:lang="en">rural communities, rural community, rural populations, low-income, rural population, deprived household, deprived households, left-behind areas, deprived area, deprived areas, limited assets, low income, underserved, frontline communities, frontline community, low assets, impoverished area, impoverished areas, left behind area, left behind areas, left-behind area, food poverty, front-line communities, front-line community, disadvantaged, persistent poor, unemployed, housinglessness, joblessness, landlessness, do not own property, rural people</skos:altLabel>
        <cpr:P20 xml:lang="en">h5v7ggyq</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q913"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q994"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q997"/>
        <cpr:P7 xml:lang="en">People who are less able to respond to the effects of climate change due to having limited financial or physical assets. In practice, this encompasses a wide variety of people whose vulnerabilities may overlap.</cpr:P7>
        <schema:description xml:lang="en">People who are less able to respond to the effects of climate change due to having limited financial or physical assets</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1168 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1168">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:label xml:lang="en">urban poor</rdfs:label>
        <skos:altLabel xml:lang="en">low income neighborhood, low income neighborhoods, low-income neighborhood, low-income neighborhoods, deprived neighborhood, deprived neighborhoods, fuel poverty, homeless, unhoused, urban poverty, impoverished neighborhood, impoverished neighborhoods, suburban poor, suburban poverty, poor neighborhood, poor neighborhoods, poorest neighborhood, poorest neighborhoods, banlieue, banlieues, favela, favelas, fuel poor, homelessness, informal settlement, informal settlements, shanty town, shanty towns, slum, slums, left-behind neighborhood, left-behind neighborhoods, left behind neighbourhood, food desert, informal settler, informal settlers</skos:altLabel>
        <cpr:P7 xml:lang="en">people living in cities or suburban areas with limited assets, including financial assets. This includes people who are experiencing hardship due to structural underinvestment in their neighbourhood and those who struggle due to a lack of services and a relatively high cost of living.</cpr:P7>
        <schema:description xml:lang="en">people living in cities or suburban areas with limited assets or access to services</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1169 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1169">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <rdfs:label xml:lang="en">people with limited formal education</rdfs:label>
        <skos:altLabel xml:lang="en">non-formal education, least educated, least-educated, limited education, limited formal education, low educaiton, low formal education, low skill, low-skill, low-skilled, minimal education, minimal formal education, no education, no formal education, school drop-out, school drop-outs, school leavers, uneducated, unschooled, unskilled</skos:altLabel>
        <cpr:P7 xml:lang="en">Adults and young adults who have received no or little education from schools or universities. Generally, this makes them more susceptible to climate impacts.</cpr:P7>
        <schema:description xml:lang="en">Adults and young adults who have received no or little education from schools or universities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q117 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q117">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">jetty</rdfs:label>
        <skos:altLabel xml:lang="en">jetties</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/jetties"/>
        <schema:description xml:lang="en">Jetties are hard structures built at the banks of tidal inlets and river mouths aiming to stabilise one or both banks from shifting position and prevent large volumes of sand from filling the inlet/river mouth and preventing channel siltation. Jetties are solid and durable and are considered a protection measure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1170 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1170">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">marginalized people</rdfs:label>
        <skos:altLabel xml:lang="en">minority group, minority groups, under-represented community, under-represented group, under-represented people, underrepresented community, underrepresented people, discriminated against, discriminating against, discrimination, facing marginalization, marginalized, minorities, ostracized, socially excluded, social exclusion, under-represented communities, underrepresented communities, underrepresented groups, voiceless, facing discrimination</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1248"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q913"/>
        <cpr:P7 xml:lang="en">people and groups of people with no or limited power, or who are frequently excluded by other parts of society</cpr:P7>
        <cpr:P9 xml:lang="en">non-discrimination</cpr:P9>
        <schema:description xml:lang="en">people and groups of people with no or limited power, or who are frequently excluded by other parts of society</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1171 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1171">
        <rdfs:label xml:lang="en">policy instrument</rdfs:label>
        <skos:altLabel xml:lang="en">policy instruments, government instrument, government instruments, policy tool, policy tools, tools of government</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1651"/>
        <cpr:P7 xml:lang="en">Policy instruments are techniques or tools used by governing authorities to promote certain policies in order to achieve predetermined goals. Put simply, instruments are how a government tries to achieve its goals, with this taxonomy being focused on national policy instruments.</cpr:P7>
        <schema:description xml:lang="en">Policy instruments are techniques or tools used by governing authorities to promote certain policies in order to achieve predetermined goals. Put simply, instruments are how a government tries to achieve its goals, with this taxonomy being focused on national policy instruments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1172 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1172">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q672"/>
        <rdfs:label xml:lang="en">physically vulnerable people</rdfs:label>
        <skos:altLabel xml:lang="en">the physically vulnerable</skos:altLabel>
        <cpr:P7 xml:lang="en">people whose physiology or health makes them more likely to be impacted by climate change. Note that this includes mental health, even though this is not strictly physical</cpr:P7>
        <schema:description xml:lang="en">people whose physiology or health makes them more likely to be impacted by climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1173 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1173">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q988"/>
        <rdfs:label xml:lang="en">volcanic earthquake</rdfs:label>
        <skos:altLabel xml:lang="en">ground shaking</skos:altLabel>
        <schema:description xml:lang="en">A volcanic earthquake is any earthquake that results from tectonic forces which occur in conjunction with volcanic activity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1174 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1174">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q987"/>
        <rdfs:label xml:lang="en">soil liquefaction</rdfs:label>
        <skos:altLabel xml:lang="en">earthquake trigger</skos:altLabel>
        <schema:description xml:lang="en">Soil liquefaction occurs when soil is transformed from a solid to a liquid state as a result of increased pore pressure and reduced effective stress. It is typically caused by rapid loading of the soil during earthquake shaking.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1175 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1175">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">nuclear plant failure</rdfs:label>
        <skos:altLabel xml:lang="en">nuclear meltdown, nuclear shutdown, nuclear shutdowns, nucelar plant failures, nuclear meltdowns</skos:altLabel>
        <schema:description xml:lang="en">Nuclear plant failure occurs when the accidental melting of the core of a nuclear reactor results in either the core to have a complete or partial collapse</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1176 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1176">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">emergency telecommunications failure</rdfs:label>
        <skos:altLabel xml:lang="en">emergency communication systems failure, emergency communication systems failures, emergency telecommunications failures, failure of emergency communication system, failure of emergency communication systems, failure of emergency telecommunication, failure of emergency telecommunications</skos:altLabel>
        <schema:description xml:lang="en">Emergency telecommunications failure is an umbrella term for telecommunications of an ‘extraordinary nature’ under abnormal and potentially adverse network conditions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1177 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1177">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">radio and other telecommunication failures</rdfs:label>
        <skos:altLabel xml:lang="en">radio failure, communication system failure, communication system failures, failure of communication systems, radio failures, failure of communication system</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q836"/>
        <schema:description xml:lang="en">Radio and other telecommunication failures can be said to occur when there is internal or external interruption of communications by either party that results in difficult to transport the message as it was intended.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1178 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1178">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">water supply failure</rdfs:label>
        <skos:altLabel xml:lang="en">failure of water networks, failure of water supply, water network failure, failure of the water network</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1574"/>
        <schema:description xml:lang="en">Water supply failure is the physical shortage or scarcity in access of water supply due to the failure of institutions to ensure a regular supply or due to a lack of adequate infrastructure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1179 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1179">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">structural failure</rdfs:label>
        <skos:altLabel xml:lang="en">structural collapse, construction failure, structural failures</skos:altLabel>
        <schema:description xml:lang="en">Structural failure refers to the loss of structural integrity, or the loss of load-carrying structural capacity. It is initiated when a material is stressed beyond its strength limit, causing fracture or excessive deformations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q118 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q118">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2010"/>
        <rdfs:label xml:lang="en">coastal dike</rdfs:label>
        <skos:altLabel xml:lang="en">coastal dike, coastal dikes, coastal dyke, coastal dykes, coastal embankment, coastal embankments, sea dike, sea dikes, sea dyke, sea dykes, sea embankment, sea embankments</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1956"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/dikes"/>
        <schema:description xml:lang="en">A coastal dike is a structure made of earth or stone that&apos;s used to hold back seawater.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1180 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1180">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">building collapse</rdfs:label>
        <skos:altLabel xml:lang="en">building failure, collapse of building, catastrophic building failure, collapse of buildings, damage to buildings, damage buildings, catastrophic building failures</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <schema:description xml:lang="en">Building collapse is the failure of load-bearing structural elements, causing a building to fall or fail catastrophically / catastrophic failure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1181 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1181">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">bridge failure</rdfs:label>
        <skos:altLabel xml:lang="en">bridge collapse, collapse of bridge, failure of bridge, collapse of bridges, bridges destroyed, bridge destroyed, failure of bridges</skos:altLabel>
        <schema:description xml:lang="en">Bridge failure is the inability of a bridge, or its components, to perform as specified by its design and construction requirements.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1182 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1182">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">dam failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in dam, break in dam, break of dam, burst of dam, dam breach, dam break, dam burst, failure in dam</skos:altLabel>
        <schema:description xml:lang="en">Dam failure is the collapse or movement of part of a dam or its foundation, such that the dam cannot retain water. In general, a failure results in a release of large quantities of water imposing risks on the people or property downstream.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1183 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1183">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">supply chain failure</rdfs:label>
        <skos:altLabel xml:lang="en">supply chain fail, failure of supply chains, supply chain fails</skos:altLabel>
        <schema:description xml:lang="en">Supply chain failure refers to an event in the supply chain that disrupts the flow of materials on their journey from initial suppliers through to final customers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1184 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1184">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">critical infrastructure failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in critical infrastructure, breach of critical infrastructure, breakdown in critical infrastructure, breakdown of critical infrastructure, collapse in critical infrastructure, collapse of critical infrastructure, failure in critical infrastructure, failure of critical infrastructure</skos:altLabel>
        <schema:description xml:lang="en">Critical Infrastructure failure is defined as the failure in one or more of the physical structures, facilities, networks and other assets which provide services that are essential to the social and economic functioning of a community or society.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1185 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1185">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">storm damage</rdfs:label>
        <skos:altLabel xml:lang="en">damage by wash-aways, storm damages, damage by flooding, hurricane damage, hurricane damages, tornado damage, tornado damages</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q399"/>
        <schema:description xml:lang="en">Storm damage is destruction to property and infrastructure by severe weather like hurricanes, thunderstorms and windstorms. It ranges from minor to severe, affecting buildings and power lines.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1186 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1186">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">road damage</rdfs:label>
        <skos:altLabel xml:lang="en">roads damaged, damage roads</skos:altLabel>
        <schema:description xml:lang="en">Road damage refers to the deterioration or destruction of road structures and systems beyond normal wear and tear, often caused by extreme weather events, natural disasters, or other climate-related hazards, affecting safety and economic activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1187 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1187">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">natech</rdfs:label>
        <schema:description xml:lang="en">Natural hazard triggered technological accident</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1188 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1188">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">explosion</rdfs:label>
        <schema:description xml:lang="en">Explosion-related technological incidents can be defined as accidental or intentional events that result in the actual or potential exposure of responders and/or members of the public to a chemical hazard.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q119 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q119">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">sea wall</rdfs:label>
        <skos:altLabel xml:lang="en">sea walls, seawall, seawalls</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/sea-walls"/>
        <schema:description xml:lang="en">Seawalls are hard engineered structures with a primary function to prevent further erosion of the shoreline. They are built parallel to the shore and aim to hold or prevent erosion and, secondary, function as coastal flood defences.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1190 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1190">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">soil pollution</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1189"/>
        <schema:description xml:lang="en">Soil pollution refers to the presence of a chemical or substance out of place and/or present in a soil at higher than normal concentration that has adverse effects on any non-targeted organism</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1191 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1191">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">chemical leaks</rdfs:label>
        <skos:altLabel xml:lang="en">chemical leaks and spills, chemical spills, chemical leak, chemical spill</skos:altLabel>
        <schema:description xml:lang="en">A chemical incident is an uncontrolled release of toxic substances that can harm public health and the environment, occurring suddenly or gradually due to natural or accidental events.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1192 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1192">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">mining hazard</rdfs:label>
        <schema:description xml:lang="en">Mining hazards can be defined as having major environmental impacts including the production of waste, release of toxic and hazardous waste, air pollution and emissions, water pollution and depletion, and the loss of productive land and ecosystems</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1193 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1193">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">safety hazards associated with oil and gas</rdfs:label>
        <schema:description xml:lang="en">Oil and gas extraction, and associated servicing activities involve many types of equipment and materials. Identifying and controlling hazards is critical to preventing injuries and deaths.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1194 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1194">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">fire related technological incidents</rdfs:label>
        <schema:description xml:lang="en">It can be defined as accidental or intentional events that result in the actual or potential exposure of responders and/or members of the public to a chemical hazard.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1195 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1195">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">water pollution</rdfs:label>
        <skos:altLabel xml:lang="en">pollution of surface and groundwater</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1189"/>
        <schema:description xml:lang="en">Water pollution occurs when harmful substances—often chemicals or microorganisms—contaminate a stream, river, lake, ocean, aquifer, or other body of water, degrading water quality and rendering it toxic to humans or the environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1196 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1196">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">typhoon waste</rdfs:label>
        <skos:altLabel xml:lang="en">cyclone debris, cyclone waste, typhoon debris, hurricane debris, hurricane waste</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q399"/>
        <schema:description xml:lang="en">Typhoon waste is waste generated by the typhoon, both from the event itself and from poor waste management in the aftermath.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1197 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1197">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">tsunami waste</rdfs:label>
        <skos:altLabel xml:lang="en">tsunami debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1152"/>
        <schema:description xml:lang="en">Tsunami debris consists of everything imaginable that was washed away from the large urbanized coastal communities that were destroyed by the tsunami.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1198 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1198">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">flooding waste</rdfs:label>
        <skos:altLabel xml:lang="en">flooding debris, flood debris, flood waste</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <schema:description xml:lang="en">Damage caused by floods to the built environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1199 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1199">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">volcano waste</rdfs:label>
        <skos:altLabel xml:lang="en">volcano debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1094"/>
        <schema:description xml:lang="en">Volcano waste is waste generated by a volcano eruption</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q120 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q120">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">groyne</rdfs:label>
        <skos:altLabel xml:lang="en">groynes, groin, groins</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/groynes"/>
        <schema:description xml:lang="en">A groyne is a rigid hydraulic structure built from an ocean shore (in coastal engineering) or from a bank (in rivers) that interrupts water flow and limits the movement of sediment. It is placed perpendicularly to the shore to trap sediments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1200 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1200">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">tar road debris</rdfs:label>
        <skos:altLabel xml:lang="en">road and street rubble, tar street debris, asphalt road debris, asphalt street waste, pavement debris</skos:altLabel>
        <schema:description xml:lang="en">Tar contains PAH in high concentrations. PAH are known to be carcinogenic. It is a hazardous waste and have been used as a binder in asphalt. In an extreme event, water flows can wash away pavement structure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1201 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1201">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">unpaved road debris</rdfs:label>
        <skos:altLabel xml:lang="en">dirt road debris, mud street debris, unpaved street debris</skos:altLabel>
        <schema:description xml:lang="en">After an event (e.g. heavy rains), the runoff can dislodge the finer particles on the surface along with additional fine particles that are “pumped’ up to the surface by traffic causing stream sedimentation affecting the river ecosystem.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1202 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1202">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">waste clogging the drains</rdfs:label>
        <schema:description xml:lang="en">Debris and objects can flow into the drainage system, building up and cause clogged drains, especially after a heavy rain fall.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1203 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1203">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">woody debris</rdfs:label>
        <skos:altLabel xml:lang="en">wood debris, vegetative debris</skos:altLabel>
        <schema:description xml:lang="en">Woody debris can be defined as any dead, woody plant material, including logs, branches, standing dead trees, and root wads. It may result from hurricanes, tornadoes or coastal storms.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1204 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1204">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">healthcare risk waste</rdfs:label>
        <skos:altLabel xml:lang="en">medical waste in debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1571"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1601"/>
        <schema:description xml:lang="en">Natural disasters can severely disrupt the normal operations of healthcare facilities. These disruptions can lead to an increased volume of medical waste, compromised waste disposal routes, and damaged disposal facilities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1205 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1205">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">building rubble</rdfs:label>
        <skos:altLabel xml:lang="en">building debris</skos:altLabel>
        <schema:description xml:lang="en">Building rubble consists exclusively of mineral waste such as concrete, bricks, ceramics, soil and sand.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1206 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1206">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">water distribution rubble</rdfs:label>
        <skos:altLabel xml:lang="en">debris from waste water treatment plants, debris from water works, debris accumulation in waste water treatment plants</skos:altLabel>
        <schema:description xml:lang="en">An extreme event can cause the accumulation of grit and debris in wastewater system. These materials can find their way into treatment plant systems through inflow and infiltration or due to physical damage to infrastructure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1207 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1207">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">regulatory instrument</rdfs:label>
        <skos:altLabel xml:lang="en">authoritative instrument, regulatory instruments, authoritative instruments</skos:altLabel>
        <cpr:P7 xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, regulate behaviour by setting some kind of boundary. This refers to the power to make rules, which require actors to adopt certain behaviours and prohibit others. In climate policy, these include obligations to disclose emissions, moratoria and bans on fossil fuel production or use, and spatial planning laws.</cpr:P7>
        <schema:description xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, set boundaries on behaviour through rules, like emissions disclosure, fossil fuel bans, and spatial planning laws.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1208 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1208">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">information instrument</rdfs:label>
        <skos:altLabel xml:lang="en">information instruments, nodality instrument, nodality instruments</skos:altLabel>
        <cpr:P7 xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</cpr:P7>
        <schema:description xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1209 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1209">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">organisation and governance instrument</rdfs:label>
        <skos:altLabel xml:lang="en">organisation instrument</skos:altLabel>
        <cpr:P7 xml:lang="en">Allows governments to act directly on individuals, their property, or the environment, focusing on &quot;effecting&quot; rather than detecting. In climate policy, they are designed to enhance institutions’ capacity to address climate change. This includes granting new responsibilities to existing bodies, creating new institutions, and developing governance plans and strategies.</cpr:P7>
        <schema:description xml:lang="en">Organisation and governance instruments let governments act directly on individuals, property, or the environment, enhancing institutions’ capacity for climate action through new roles, bodies, and strategies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q121 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q121">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">geosynthetic</rdfs:label>
        <skos:altLabel xml:lang="en">geosynthetic</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technology-library/protection-hard-engineering/geosynthetics"/>
        <schema:description xml:lang="en">Geosynthetics are human-made products used to stabilize terrain.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1210 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1210">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">air transportation accident</rdfs:label>
        <skos:altLabel xml:lang="en">air disaster, air incident, air transport disruption, air transportation disruption, air transport accident, air transport disaster, air transport incident, air transportation disaster, air transportation incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of air accidents and incidents, or logistical challenges.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1211 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1211">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">marine accident</rdfs:label>
        <skos:altLabel xml:lang="en">marine disaster, marine disruption, marine incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of marine accidents that can seriously endanger the safety of the vessel or another vessel or an individual; and severe damage to the environment, or the potential for severe damage to the environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1212 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1212">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">inland water ways accident</rdfs:label>
        <skos:altLabel xml:lang="en">inland water ways disaster, inland water ways incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of in land water ways accidents. An inland waterway transportation accident is an unwanted or unintended sudden event that brings harmful consequences to the inland water vessel.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1213 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1213">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">rail accident</rdfs:label>
        <skos:altLabel xml:lang="en">rail disaster, rail disruption, rail incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of rail accidents, disruptions in travel or logistical challenges. A rail accident is an unwanted or unintended sudden event with harmful consequences.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1214 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1214">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">road traffic accident</rdfs:label>
        <skos:altLabel xml:lang="en">road accident, road disaster, road disruption, road incident, road traffic disaster, road traffic disruption, road traffic incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of road traffic accidents. A road traffic accident is any accident involving at least one road vehicle in motion on a public road or private road resulting in (an) injured person(s).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1215 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1215">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">misconfiguration of software and hardware</rdfs:label>
        <schema:description xml:lang="en">Misconfiguration of software and hardware is the incorrect or suboptimal configuration of an information system or system component that may lead to vulnerabilities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1216 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1216">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">non-conformity and interoperability</rdfs:label>
        <schema:description xml:lang="en">Non-Conformity occurs when specified requirements relating to a product, process, system, person or body are not fulfilled. Interoperability is a characteristic of a product or system to work with other products or system.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1217 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1217">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">malware</rdfs:label>
        <skos:altLabel xml:lang="en">malicious software, trojan horses, viruses, worms</skos:altLabel>
        <schema:description xml:lang="en">Malware is a summary term for different forms of malevolent software designed to infiltrate and infect computers, typically without the knowledge of the owner.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1218 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1218">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">data breach</rdfs:label>
        <skos:altLabel xml:lang="en">data leak, data spill, intellectual data breach, security breach</skos:altLabel>
        <schema:description xml:lang="en">A data breach is a compromise of security that leads to the accidental or unlawful destruction, loss, alteration, unauthorised disclosure of, or access to protected data transmitted, stored, or otherwise processed.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1219 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1219">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">data security-related hazards</rdfs:label>
        <skos:altLabel xml:lang="en">data security-related hazards impacts</skos:altLabel>
        <schema:description xml:lang="en">Data security-related hazards include risks arising from increased system complexity because this provides opportunities for malicious cyberattacks and data loss in the case of serious incidents, including natural disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q122 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q122">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">revetment</rdfs:label>
        <skos:altLabel xml:lang="en">revetments, rip rap boulder, rip rap boulders, riprap boulder, riprap boulders, rock armour, gabion, gabions</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/revetments"/>
        <schema:description xml:lang="en">A revetment is a slope consisting of loose or interlocking protection units (geotextiles may also be used). Revetments typically protect a soft landform such as a dune area or coastal slope.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1220 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1220">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">cyber outage</rdfs:label>
        <skos:altLabel xml:lang="en">cyber disruption, internet outage</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q838"/>
        <schema:description xml:lang="en">A cyber outage is the unavailability of a service or resource.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1221 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1221">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">personally identifiable information breach</rdfs:label>
        <skos:altLabel xml:lang="en">PII breach, personally identifiable information (PII) breach</skos:altLabel>
        <schema:description xml:lang="en">A personally identifiable information (PII) breach is a situation where PII is processed in violation of one or more relevant PII protection requirements.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1222 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1222">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">Internet of Things-related hazards</rdfs:label>
        <skos:altLabel xml:lang="en">Internet of Things-related impact, Internet of Things (IOT)-related hazards</skos:altLabel>
        <schema:description xml:lang="en">The Internet of Things (IoT) is a global infrastructure for the information society, enabling advanced services by interconnecting (physical and virtual) things based on existing communication technologies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1223 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1223">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">cyberbullying</rdfs:label>
        <skos:altLabel xml:lang="en">cyber harassment, cyber-bullying, harassment online, online bullying, online harassment</skos:altLabel>
        <schema:description xml:lang="en">Cyberbullying is bullying that takes place using digital devices. Cyberbullying includes the deliberate sending, posting, or sharing of negative, harmful, false, or mean content about someone else causing embarrassment or humiliation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1224 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1224">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">phosphine</rdfs:label>
        <skos:altLabel xml:lang="en">phosphorus hydride</skos:altLabel>
        <schema:description xml:lang="en">Phosphine is a colorless and extremely toxic gas to humans and to the environment that is used in industrial synthesis. Pure phosphine is also odorless.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1225 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1225">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">chlorine</rdfs:label>
        <schema:description xml:lang="en">Chlorine is a yellow-green gas at room temperature. It is a disinfectant, used to treat water. It is used in the manufacture of consumer products, such PVC. Chlorine gas is itself very poisonous, and was used as a chemical weapon during the WWI.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1226 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1226">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">arsenic</rdfs:label>
        <schema:description xml:lang="en">Arsenic is a natural component widely distributed throughout the environment. It is highly toxic in its inorganic form, which is a confirmed carcinogen and is the most significant chemical contaminant in drinking-water globally.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1227 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1227">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">cadmium</rdfs:label>
        <schema:description xml:lang="en">It is a metallic element that occurs naturally in tiny amounts in air, water, soil, and food. It is used to make batteries, pigments, plastics, alloys, and electroplate. Exposure to high levels of cadmium may cause certain health problems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1228 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1228">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">mercury</rdfs:label>
        <schema:description xml:lang="en">A silver-white, neurotoxicant metal that is a liquid at room temperature. Human activities, such as gold mining and the burning of coal and other fossil fuels are responsible for the mercury that is released into the air.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1229 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1229">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">pesticide</rdfs:label>
        <skos:altLabel xml:lang="en">PPP, pesticides, agricultural chemical, agricultural chemicals, agro-chemical, agro-chemicals, Plant Protection Products</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1665"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1666"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <schema:description xml:lang="en">Pesticide means any substance, or mixture of substances of chemical or biological ingredients intended for repelling, destroying or controlling any pest, or regulating plant growth. Pesticides are inherently toxic.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q123 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q123">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">cliff stabilisation</rdfs:label>
        <skos:altLabel xml:lang="en">cliff stabilisation, stabilisation of cliff, slope stabilisation</skos:altLabel>
        <cpr:P4 rdf:resource="https://thefloodhub.co.uk/wp-content/uploads/2018/09/FT-Q-R81-Cliff-stabilisation.pdf"/>
        <schema:description xml:lang="en">Cliff stabilisation is a form of soft engineering, using natural processes to protect the shoreline against flooding and erosion. Stabilisation techniques are used to limit the amount of erosion and the potential for landslides,collapse and falling rocks.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1230 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1230">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">highly hazardous pesticides</rdfs:label>
        <skos:altLabel xml:lang="en">HHPs</skos:altLabel>
        <schema:description xml:lang="en">HHPs are those recognized to pose high acute or chronic health or environmental risks per global classifications (e.g., WHO, GHS) or international agreements. Pesticides causing severe or irreversible harm under local use may also qualify.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1231 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1231">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">residue of pesticides</rdfs:label>
        <skos:altLabel xml:lang="en">residue of pesticide</skos:altLabel>
        <schema:description xml:lang="en">Pesticide residue refers to any substance in food, crops, or animal feed from pesticide use, including derivatives like conversion products, metabolites, reaction products, and impurities of toxicological significance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1232 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1232">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">insecticides</rdfs:label>
        <skos:altLabel xml:lang="en">insecticide</skos:altLabel>
        <schema:description xml:lang="en">Insecticides are chemicals used to control insects by killing them.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1233 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1233">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">fungicides</rdfs:label>
        <skos:altLabel xml:lang="en">fungicide</skos:altLabel>
        <schema:description xml:lang="en">Fungicides are chemicals that kill or slow the growth of fungi and their spores. They can be used on plants or other surfaces where mould or mildew grow</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1234 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1234">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">herbicides</rdfs:label>
        <skos:altLabel xml:lang="en">herbicide</skos:altLabel>
        <schema:description xml:lang="en">Herbicides are chemicals used to control unwanted vegetation, mainly in row-crop farming, where they’re applied before or during planting to boost crop productivity by reducing competing plants.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1235 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1235">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">persistent organic pollutants</rdfs:label>
        <skos:altLabel xml:lang="en">persistent organic pollutant, POPs</skos:altLabel>
        <schema:description xml:lang="en">Persistent organic pollutants (POPs) are organic compounds that are resistant to degradation. Widely distributed in the environment, magnified in living organisms up the food chain, they are toxic to humans and wildlife.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1236 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1236">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">hazardous pesticide contamination in soils</rdfs:label>
        <skos:altLabel xml:lang="en">brownfield sites, contaminated land special sites, soil contamination soil pollution</skos:altLabel>
        <schema:description xml:lang="en">Hazardous pesticide contamination in soil often stems from improper agrochemical storage and long-term use of highly toxic, persistent compounds in agriculture, which harm non-target species.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1237 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1237">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">dioxins</rdfs:label>
        <skos:altLabel xml:lang="en">dioxin-like substances, furans, dioxines, dioxin</skos:altLabel>
        <schema:description xml:lang="en">Dioxins and dioxin-like substances are unwanted by-products of combustion and industrial processes like chlorine bleaching and smelting. With similar toxicity and mechanisms, they are grouped together for guideline setting</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1238 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1238">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">benzene</rdfs:label>
        <schema:description xml:lang="en">Benzene is a clear, colourless, highly flammable and volatile, liquid aromatic hydrocarbon (molecular formula C6H6) with a gasoline-like odour.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1239 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1239">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">asbestos</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1443"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <schema:description xml:lang="en">Asbestos refers to a group of natural minerals once widely used in building materials. All types can cause lung cancer, mesothelioma, larynx and ovarian cancer, and asbestosis (lung fibrosis).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q124 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q124">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">beach nourishment</rdfs:label>
        <skos:altLabel xml:lang="en">beach nourishment, shoreface nourishment, beach restoration, restoring beaches, shoreface restoration, sand nourishment</skos:altLabel>
        <cpr:P4 rdf:resource="https://climate-adapt.eea.europa.eu/en/metadata/adaptation-options/beach-and-shoreface-nourishment"/>
        <schema:description xml:lang="en">Beach nourishment or replenishment is the artificial placement of sand on an eroded shore to maintain the amount of sand present in the foundation of the coast, and this way to compensate for natural erosion and to a greater or lesser extent protect the area against storm surge.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1240 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1240">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">aflatoxins</rdfs:label>
        <skos:altLabel xml:lang="en">aflatoxin</skos:altLabel>
        <schema:description xml:lang="en">Aflatoxins are toxic compounds produced by certain moulds (e.g. Aspergillus flavus and A. parasiticus) found in soil, decaying vegetation and grains. They are among the most dangerous mycotoxins, posing serious health risks to humans and livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1241 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1241">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">fluoride</rdfs:label>
        <schema:description xml:lang="en">Fluoride is a naturally occurring mineral to which the public are often exposed via drinking-water. Depending on dose intake fluoride may have both beneficial effects or negative effects (causing tooth enamel and skeletal fluorosis).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1242 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1242">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">methanol</rdfs:label>
        <skos:altLabel xml:lang="en">methyl alcohol</skos:altLabel>
        <schema:description xml:lang="en">Methanol is a primary alcohol (CH₃OH) with low intrinsic toxicity, found in various daily products. However, it metabolizes into highly toxic compounds that can cause blindness, coma, and life-threatening metabolic disturbances</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1243 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1243">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">substandard and falsified medical products</rdfs:label>
        <skos:altLabel xml:lang="en">falsified medical products, substandard medical products</skos:altLabel>
        <schema:description xml:lang="en">Substandard and falsified medical products are defined as those that may cause harm to patients and fail to treat the diseases for which they were intended.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1244 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1244">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1483"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1245 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1245">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">fertilisers</rdfs:label>
        <skos:altLabel xml:lang="en">chemical fertilizers, fertiliser, fertilizer, fertilizers, chemical fertilisers</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1467"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <schema:description xml:lang="en">Chemical fertilizers are the artificially manipulated substances containing known quantities of three macroelements, i.e., nitrogen, potassium, and phosphorous.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1247 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1247">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">carbon monoxide poisoning</rdfs:label>
        <skos:altLabel xml:lang="en">exposure to carbon monoxide</skos:altLabel>
        <schema:description xml:lang="en">Carbon monoxide poisoning happens when carbon monoxide accumulates in the blood, replacing oxygen in red blood cells. High levels of carbon monoxide in the air can cause severe tissue damage or even death.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1249 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1249">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q676"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q704"/>
        <rdfs:label xml:lang="en">woman of color</rdfs:label>
        <skos:altLabel xml:lang="en">women of color, black woman, black women, brown woman, brown women, black girl, black girls, brown girl, brown girls</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1248"/>
        <cpr:P7 xml:lang="en">a woman who does not consider herself to be white</cpr:P7>
        <schema:description xml:lang="en">a woman who does not consider herself to be white</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q125 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q125">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">constructed wetland</rdfs:label>
        <skos:altLabel xml:lang="en">constructed wetlands</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/constructed-wetlands"/>
        <schema:description xml:lang="en">Constructed wetlands protect coastal communities during flooding by absorbing wave energy or storing excess water. In the later, it is a shallow basin filled with some sort of filler material (substrate), usually sand or gravel, and planted with vegetation tolerant of saturated conditions to mimic the function of mangrove forest or salt marshes. In the context of water purification, constructed wetlands make use of the natural purification processes of vegetation, soils and microbes to remove contaminants from discharge and improve water quality.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1250 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1250">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q701"/>
        <rdfs:label xml:lang="en">climate refugees and migrants</rdfs:label>
        <skos:altLabel xml:lang="en">climate change migrant, climate change migrants, climate change refugee, climate change refugees, climate migrant, climate migrants, climate migration, climate refugee, climate refugees, disaster migrant, disaster migrants, environmental migrant, environmental migrants, environmental migration, environmental refugee, environmental refugees, climate change induced migration, climate change migration, climate induced migration, climate-induced migration, climate induced displacement, climate-induced displacement, forced relocation, planned relocation, unplanned relocation, unwanted relocation, eco migrant, eco migrants, eco refugee, eco refugees, eco-migrant, eco-migrants, eco-refugee, eco-refugees, climate displaced individuals</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1561"/>
        <schema:description xml:lang="en">people who were forced to leave their homes by the effects or expected effects of climate change</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1251 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1251">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1012"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q701"/>
        <rdfs:label xml:lang="en">nomadic person</rdfs:label>
        <skos:altLabel xml:lang="en">nomadic, pastoralist, pastoralists, bedouin, bedouins, nomad, nomads</skos:altLabel>
        <schema:description xml:lang="en">a member of a group of people who move from one place to another rather than living in one place all of the time.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1252 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1252">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q695"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q701"/>
        <rdfs:label xml:lang="en">children on the move</rdfs:label>
        <skos:altLabel xml:lang="en">child migrant, child migrants, child refugee, child refugees, unaccompanied minor, unaccompanied minors, young migrant, young migrants, young refugee, young refugees, youth migrant, youth migrants, youth refugee, youth refugees, undocumented child, undocumented children</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1248"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1565"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1253 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1253">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">brown clouds</rdfs:label>
        <skos:altLabel xml:lang="en">black carbon, soot</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1486"/>
        <schema:description xml:lang="en">A layer of air pollution containing aerosols that absorb incoming solar radiation, leading to regional and global climatic effects, posing risks to human health. The cause are emissions associated with the combustion of fossil fuels and biomass.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1254 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1254">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">outdoor air pollution</rdfs:label>
        <skos:altLabel xml:lang="en">ambient air pollution, ambient air-pollution, outdoor air-pollution</skos:altLabel>
        <cpr:P7 xml:lang="en">Outdoor air pollution refers to harmful contaminants released into the atmosphere that can lead to serious health issues, especially to children.</cpr:P7>
        <schema:description xml:lang="en">Outdoor air pollution refers to harmful contaminants released into the atmosphere that can lead to serious health issues, especially to children.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1255 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1255">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">household air pollution</rdfs:label>
        <skos:altLabel xml:lang="en">indoor air pollution, household air-pollution, indoor air-pollution</skos:altLabel>
        <cpr:P7 xml:lang="en">Indoor air pollution is caused by the burning of firewood, crop waste, and dung for cooking and heating. The burning of these fuels poses severe health risks, such as respiratory diseases, and is one of the leading risk factors for premature death.</cpr:P7>
        <schema:description xml:lang="en">Indoor air pollution is caused by the burning of firewood, crop waste, and dung for cooking and heating. The burning of these fuels poses severe health risks, such as respiratory diseases, and is one of the leading risk factors for premature death.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1256 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1256">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">air pollutant</rdfs:label>
        <skos:altLabel xml:lang="en">air pollutants, air-pollutant, air-pollutants</skos:altLabel>
        <schema:description xml:lang="en">Air pollutants refer to anthropogenic or naturally occurring substances such as particulate matter, ozone, sulfur dioxide, nitrogen oxides, and volatile organic compounds that have adverse effects on human health and ecosystems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1257 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1257">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">air polluting</rdfs:label>
        <skos:altLabel xml:lang="en">air-polluting</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1189"/>
        <schema:description xml:lang="en">It refers to the activity, source or process that introduces pollutants into the air, for instance  burning fossil fuels or biomass.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1258 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1258">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">fog</rdfs:label>
        <cpr:P9 xml:lang="en">fog of applicants</cpr:P9>
        <cpr:P9 xml:lang="en">sea fog</cpr:P9>
        <schema:description xml:lang="en">Fog is a suspension of very small, usually microscopic water droplets in the air, reducing visibility at the Earth’s surface.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1259 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1259">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">smoke</rdfs:label>
        <schema:description xml:lang="en">Smoke is a suspension in the air of small particles produced by combustion.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q126 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q126">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">dune construction</rdfs:label>
        <skos:altLabel xml:lang="en">construction of dune, dune stabilisation, stabilisation of dune, dune rehabilitation, dune strengthening, dune fencing, dune grass planting, dune thatching</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q138"/>
        <cpr:P4 rdf:resource="https://climate-adapt.eea.europa.eu/en/metadata/adaptation-options/dune-construction-and-strengthening"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technology-library/protection-hard-engineering/dune-construction-and-stabilisation"/>
        <schema:description xml:lang="en">Dune construction, strengthening and rehabilitation measures intend to restore the sand barrier functions of dunes to gain coastal protection benefits. Artificial dunes are engineered structures created to mimic the functioning of natural dunes aimed at reducing both coastal erosion and flooding in adjacent coastal lowlands.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1260 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1260">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">haze</rdfs:label>
        <schema:description xml:lang="en">Haze is a suspension in the air of extremely small, dry particles invisible to the naked eye and sufficiently numerous to give the air an opalescent appearance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1261 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1261">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">sandstorm</rdfs:label>
        <skos:altLabel xml:lang="en">dust storm</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1516"/>
        <schema:description xml:lang="en">A sandstorm is an ensemble of particles of dust or sand energetically lifted to great heights by a strong and turbulent wind</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1262 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1262">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">sand haze</rdfs:label>
        <schema:description xml:lang="en">Sand haze is reduced visibility in the boundary layer caused by soil particles suspended in strong winds. After sandstorms, larger grains settle quickly, leaving a haze of medium particles, common in desert regions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1263 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1263">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">smog</rdfs:label>
        <schema:description xml:lang="en">Smog originally described a mix of smoke and fog. Smog today is mostly photochemical, formed when sunlight reacts with nitrogen oxides, from vehicle emissions, and VOCs, from gasoline and solvents.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1264 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1264">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">fumes</rdfs:label>
        <skos:altLabel xml:lang="en">fume</skos:altLabel>
        <schema:description xml:lang="en">A &quot;fume&quot; is defined as any airborne solid matter smaller than dust when a solid vapourises and condenses, eg during welding.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1265 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1265">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1254"/>
        <rdfs:label xml:lang="en">particulate matter</rdfs:label>
        <skos:altLabel xml:lang="en">heavy particulate pollution, particulate emissions, primary particulate matter, primary PM, secondary particulate matter, secondary PM</skos:altLabel>
        <schema:description xml:lang="en">Particulate matter (PM) is composed of chemicals such as sulfates, nitrates, carbon, or mineral dusts. Fossil fuel combustion, cigarette smoke, and burning organic matter produce PM and contribute to serious health problems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1266 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1266">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1265"/>
        <rdfs:label xml:lang="en">fine particulate matter</rdfs:label>
        <skos:altLabel xml:lang="en">fine particles</skos:altLabel>
        <schema:description xml:lang="en">Particles smaller than 10 micrometers in diameter pose health problems. Of these, particles less than 2.5 micrometers in diameter, also known as fine particles or PM2.5, pose the greatest risk to health because they can reach the lungs.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1267 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1267">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">poor air quality</rdfs:label>
        <skos:altLabel xml:lang="en">decreased air quality</skos:altLabel>
        <schema:description xml:lang="en">Poor air quality, caused by pollutants such as particulate matter, nitrogen dioxide, and ozone, is an important contributor to disease and premature mortality.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1268 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1268">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <rdfs:label xml:lang="en">point source of air pollution</rdfs:label>
        <skos:altLabel xml:lang="en">air pollution from point sources, point source air pollution</skos:altLabel>
        <schema:description xml:lang="en">A point source of air pollution is an identifiable stationary location or fixed facility from which air pollutants are released, which may be human-made or natural in origin</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1269 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1269">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <rdfs:label xml:lang="en">tax advantage</rdfs:label>
        <skos:altLabel xml:lang="en">tax advantages, tax benefit, tax benefits</skos:altLabel>
        <cpr:P20 xml:lang="en">vtkghc5f</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P7 xml:lang="en">A tax advantage is a fiscal incentive where the government reduces or exempts selected activities, goods or actors from taxes.</cpr:P7>
        <schema:description xml:lang="en">A tax advantage is a fiscal incentive where the government reduces or exempts selected activities, goods or actors from taxes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q127 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q127">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1892"/>
        <rdfs:label xml:lang="en">active motion-damping system</rdfs:label>
        <skos:altLabel xml:lang="en">motion damping system, motion-damping system, motion damping systems</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <schema:description xml:lang="en">Active motion-dampening systems are automated mooring systems that serve alongside or in place of traditional mooring techniques. They can help to minimize the movement of the ship when it is at port, adjusting automatically to tidal changes, swells, or other shifts in the sea level.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1270 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1270">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <rdfs:label xml:lang="en">tax rebate</rdfs:label>
        <skos:altLabel xml:lang="en">tax rebates, tax relief, VAT rebate, VAT rebates, VAT refund, VAT refunds, VAT relief, tax reimbursement, tax reimbursements, VAT reimbursement, VAT reimbursements, tax offset, tax offsets, tax refund, tax refunds</skos:altLabel>
        <cpr:P7 xml:lang="en">A tax rebate is a policy instrument that provides a refund to taxpayers for excess taxes paid, often used to incentivise certain behaviours. In environmental contexts, rebates can encourage eco-friendly actions by reducing tax burdens on individuals or businesses who adopt sustainable practices.</cpr:P7>
        <schema:description xml:lang="en">A tax rebate is a reimbursement made to a taxpayer for an excess amount paid in taxes during the year, which can be used to encourage environmentally conscious behaviour from the private sector.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1271 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1271">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <rdfs:label xml:lang="en">tax incentive</rdfs:label>
        <skos:altLabel xml:lang="en">tax incentives, excise incentive, excise incentives, VAT incentive, VAT incentives, tax subsidies, tax subsidy</skos:altLabel>
        <cpr:P7 xml:lang="en">Tax incentives reduce tax liabilities to promote environmentally beneficial investments and behaviours. Examples include incentives that encourage lower natural resource consumption, a shift to renewable or alternative energy sources, and the development of low-carbon products and manufacturing processes. These incentives aim to support sustainable innovation and reduce environmental impact.</cpr:P7>
        <schema:description xml:lang="en">Tax incentives reduce tax liabilities to promote environmentally beneficial investments and behaviours.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1272 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1272">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <rdfs:label xml:lang="en">grant</rdfs:label>
        <skos:altLabel xml:lang="en">grants, grant funding, grant finance, grant financing, grant funds, grant support, transfer payment, transfer payments, payment of grant, payment of grants, in kind contribution, in kind contributions, in kind payment, in kind payments, in-kind contribution, in-kind contributions, in-kind payment, in-kind payments, payment in kind, payments in kind</skos:altLabel>
        <cpr:P7 xml:lang="en">A grant is a policy instrument in which a sum of money is given by a federal, state, or local government authority or private sector, and is effectively a transfer payment. Unlike loans, grants do not need to be repaid and are often awarded for climate change projects or other beneficial initiatives.</cpr:P7>
        <schema:description xml:lang="en">A grant is a policy instrument in which a sum of money is given by a federal, state, or local government authority or private sector, and is effectively a transfer payment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1273 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1273">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <rdfs:label xml:lang="en">loan</rdfs:label>
        <skos:altLabel xml:lang="en">loans, loan finance, lending, lends</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2404"/>
        <cpr:P20 xml:lang="en">mab9t6ps</cpr:P20>
        <cpr:P7 xml:lang="en">A loan is a policy instrument where funds are provided to a borrower with the expectation of repaying the principal plus interest. Loans may be on commercial terms (market interest rates) or concessional (favourable terms). They can be used as tool to encourage low-emissions investments such as energy efficiency or sustainable development.</cpr:P7>
        <cpr:P9 xml:lang="en">bank</cpr:P9>
        <cpr:P9 xml:lang="en">banks</cpr:P9>
        <cpr:P9 xml:lang="en">concessional loan insurance</cpr:P9>
        <cpr:P9 xml:lang="en">lender</cpr:P9>
        <cpr:P9 xml:lang="en">lenders</cpr:P9>
        <cpr:P9 xml:lang="en">lends itself</cpr:P9>
        <cpr:P9 xml:lang="en">lends support</cpr:P9>
        <cpr:P9 xml:lang="en">loan market</cpr:P9>
        <cpr:P9 xml:lang="en">loan markets</cpr:P9>
        <cpr:P9 xml:lang="en">mortgage</cpr:P9>
        <cpr:P9 xml:lang="en">mortgages</cpr:P9>
        <cpr:P9 xml:lang="en">working capital loan</cpr:P9>
        <cpr:P9 xml:lang="en">working capital loans</cpr:P9>
        <schema:description xml:lang="en">A loan is a policy instrument where funds are provided to a borrower with the expectation of repaying the principal plus interest.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1274 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1274">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <rdfs:label xml:lang="en">subsidy</rdfs:label>
        <skos:altLabel xml:lang="en">subsidies, subsidised, subsidized, subsidy scheme, subsidy schemes, environmentally beneficial subsidies, payment scheme, payment schemes, subsidise, subsidize, subsidising, subsidizing, support payment, support payments</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1275"/>
        <cpr:P20 xml:lang="en">5n5kb8dd</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1275"/>
        <cpr:P7 xml:lang="en">A subsidy is a direct or indirect payment to individuals or businesses, typically provided as a government cash payment or a specific tax reduction. Examples are subsidies to energy efficiency measures, to promote more efficient energy use.</cpr:P7>
        <cpr:P9 xml:lang="en">subsidised loan</cpr:P9>
        <cpr:P9 xml:lang="en">subsidised loans</cpr:P9>
        <cpr:P9 xml:lang="en">subsidized loan</cpr:P9>
        <cpr:P9 xml:lang="en">subsidized loans</cpr:P9>
        <schema:description xml:lang="en">A subsidy is a direct or indirect payment to individuals or businesses, typically provided as a government cash payment or a specific tax reduction.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1275 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1275">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
        <rdfs:label xml:lang="en">subsidy removal</rdfs:label>
