        <cpr:P9 xml:lang="en">vegetable oils</cpr:P9>
        <cpr:P9 xml:lang="en">walnut oil</cpr:P9>
        <schema:description xml:lang="en">Oil is a combustible liquid fossil fuel composed mainly of hydrocarbons, occurring as crude oil and refined into petroleum products such as petrol, diesel and kerosene.</schema:description>
    </owl:Class>
    


