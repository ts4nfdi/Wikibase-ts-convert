        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P7 xml:lang="en">Refers to non‐governmental, not‐for‐profit organisations that address social, cultural and environmental challenges. This sector covers charities, voluntary groups and social enterprises that rely on philanthropy, grants and volunteer support to deliver community services, advocacy and development initiatives.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q76">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
