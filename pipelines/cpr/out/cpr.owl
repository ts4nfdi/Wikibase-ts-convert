    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2792 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2792">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q144"/>
        <rdfs:label xml:lang="en">aeroponics</rdfs:label>
        <skos:altLabel xml:lang="en">aeroponic, air-based agriculture, air-based cultivation, air-based growing</skos:altLabel>
        <cpr:P7 xml:lang="en">Aeroponics is the science of plant cultivation without incorporation of soil or a substrate culture, where plant grows in the air with the assistance of an artificial support. The roots of the plant hanged inside a sealed container in darkness and are exposed to nutrient-rich spray through atomizers. The upper portion of the plant leaves and crown extend above the wet zone.</cpr:P7>
        <schema:description xml:lang="en">Aeroponics is a method of growing plants where the roots are exposed to air and receive nutrients and water through fogging or misting technology.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2793 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2793">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q144"/>
        <rdfs:label xml:lang="en">aquaponics</rdfs:label>
        <skos:altLabel xml:lang="en">aquaponic, pisciponic, pisciponics</skos:altLabel>
        <cpr:P7 xml:lang="en">Aquaponics is the integration of aquaculture and hydroponics in one production system. This method relies on fish waste to be used as an organic nutrient solution to grow vegetables. In a system, water flows from the fish tank into a biofilter where bacteria break down the fish waste into an organic nutrient solution for the growing vegetables. The plants then absorb the nutrients from the water which essentially cleans it before being re-circulated back into the fish tanks.</cpr:P7>
        <schema:description xml:lang="en">Aquaponics is the cultivation of plants and aquatic animals in a recirculating environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2794 -->


