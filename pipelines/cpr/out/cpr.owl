        <rdfs:label xml:lang="en">REDD</rdfs:label>
        <skos:altLabel xml:lang="en">redd, reducing emissions from deforestation and forest degradation in developing countries</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q18"/>
