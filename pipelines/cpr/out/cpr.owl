    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1371 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1371">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1367"/>
        <rdfs:label xml:lang="en">state-owned financial institution</rdfs:label>
        <skos:altLabel xml:lang="en">Norfund, Abu Dhabi Investment Authority, Agricultural Bank of China, Bank Mandiri, Bank of China, Bank Rakyat Indonesia, China Construction Bank, GIC Private, Industrial and Commercial Bank of China, Japan Post Bank, Kuwait Investment Authority, Qatar Investment Authority, Saudi Arabia&apos;s Public Investment Fund, Sberbank, State Bank of India, Temasek, ATB Financial, Bank Negara Indonesia, Bank of Amazon, Bank of the Northeast, Banobras, Bao Viet Holdings, British Business Bank, Caixa, Caixa Geral de Depósitos, China Integrated Circuit Industry Investment Fund, China Orient Asset Management Co., Ltd., Earth Power Bank, HRADF, Inbal Insurance Company, Indonesia Export Import Bank, Investment Corporation of Bangladesh, Katanga Special Committee, Loto-Quebec, Misr Insurance Holding Company, National Insurance Company Limited, Norsk Tipping AS, Österreichische Beteiligungs AG, Pembangunan Perumahan, People&apos;s Bank, Privat Bank, Royal Mint, Rusnano, State Bank of New South Wales, State Trade Bank, UBS Securities Co., Ltd., Union Bank of India</skos:altLabel>
        <cpr:P20 xml:lang="en">v76y24qd</cpr:P20>
        <cpr:P7 xml:lang="en">Government‑controlled bank or financial entity tasked with promoting social and economic development through initiatives that may include sustainable investments.</cpr:P7>
