        <schema:description xml:lang="en">Developing strategies to enhance disaster response and reduce the risks of disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1896 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1896">
