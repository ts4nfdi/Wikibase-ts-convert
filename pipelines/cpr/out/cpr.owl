        <skos:altLabel xml:lang="en">consultation with stakeholders</skos:altLabel>
        <skos:altLabel xml:lang="en">engagement of stakeholders</skos:altLabel>
        <skos:altLabel xml:lang="en">engagement with stakeholders</skos:altLabel>
        <skos:altLabel xml:lang="en">multi-stakeholder participation</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder consultation</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder engagement activities</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder engagement plan</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder engagement plans</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder engagement policies</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder engagement policy</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder inclusivity</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder participation</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder workshop</skos:altLabel>
        <skos:altLabel xml:lang="en">stakeholder workshops</skos:altLabel>
        <cpr:P7 xml:lang="en">Stakeholder engagement or consultation refers to an ongoing process of interaction and dialogue between an organisation and its potentially affected stakeholders that enables the organisation to hear, understand and respond to their interests and concerns, including through collaborative approaches.</cpr:P7>
        <schema:description xml:lang="en">Stakeholder consultation refers to the process of actively gathering input of individuals or groups who are affected by, or can affect, an organisation&apos;s decisions and activities</schema:description>
    </owl:Class>
    


