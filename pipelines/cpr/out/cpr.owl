    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2517">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2461"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2694"/>
