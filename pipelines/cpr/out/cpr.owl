    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q18 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q18">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <rdfs:label xml:lang="en">REDD+</rdfs:label>
        <skos:altLabel xml:lang="en">redd+, reducing emissions from deforestation and forest degradation in developing countries</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q17"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q19"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <schema:description xml:lang="en">Reducing emissions from deforestation and forest degradation in developing countries, the ‘+’ includes additional forest-related activities that protect the climate, e.g. sustainable management of forests, or forest carbon stocks</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q180 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q180">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1968"/>
        <rdfs:label xml:lang="en">decentralised energy transmission</rdfs:label>
        <skos:altLabel xml:lang="en">decentralised energy transmission, decentralized energy transmission</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.unescap.org/sites/default/files/14.%20FS-Decentralized-energy-system.pdf"/>
        <schema:description xml:lang="en">Decentralised energy systems aim to place power generation closer to the consumers. Since end users are distributed across a region, generating energy in a decentralised way can help minimise transmission and distribution losses, along with their associated economic and environmental costs.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1800 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1800">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1799"/>
        <rdfs:label xml:lang="en">reskilling workers in transition industries</rdfs:label>
        <skos:altLabel xml:lang="en">reskill the labor force, reskilling the labor force, reskilling the workforce, transition affected workers, upskill the existing labour force, upskill the labor force, upskill the workforce, upskilling the existing labour force, upskilling the labor force, upskilling the workforce, reskilling miners, retraining miners, upskilling miners, reskill areas, reskill automotive, reskill coal, reskill fossil fuel, reskill laborers, reskill labourers, reskill miners, reskill mining, reskill oil, reskill polluting, reskill steel, reskill those working, reskill workers, reskilling areas, reskilling automotive, reskilling coal, reskilling fossil fuel, reskilling laborers, reskilling labourers, reskilling mining, reskilling oil, reskilling polluting, reskilling steel, reskilling those working, reskilling workers, retrain areas, retrain automotive, retrain coal, retrain fossil fuel, retrain laborers, retrain labourers, retrain miners, retrain mining, retrain oil, retrain polluting, retrain steel, retrain those working, retrain workers, retraining areas, retraining automotive, retraining coal, retraining fossil fuel, retraining laborers, retraining labourers, retraining mining, retraining oil, retraining polluting, retraining steel, retraining those working, retraining workers, upskill areas, upskill automotive, upskill coal, upskill fossil fuel, upskill laborers, upskill labourers, upskill miners, upskill mining, upskill oil, upskill polluting, upskill steel, upskill those working, upskill workers, upskilling areas, upskilling automotive, upskilling coal, upskilling fossil fuel, upskilling laborers, upskilling labourers, upskilling mining, upskilling oil, upskilling polluting, upskilling steel, upskilling those working, upskilling workers</skos:altLabel>
        <schema:description xml:lang="en">Providing training to those working in polluting industries so they are able to transition to greener industries.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1801 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1801">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1799"/>
        <rdfs:label xml:lang="en">transition of polluting industry</rdfs:label>
