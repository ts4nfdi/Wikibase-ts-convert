    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1608">
        <rdfs:label xml:lang="en">tax exemption</rdfs:label>
        <skos:altLabel xml:lang="en">exempt from tax, exempt from taxation, exempt from taxes, exempt from customs duties, exempt from customs duty, exempt from excise duties, exempt from excise duty, exempt from import duties, exempt from import duty, exempt from tariffs, tariff exempt, tax break, tax breaks, tax exemptions, tax deduction, tax write down, tax write downs, tax write off, VAT exemption, VAT exemptions, tariff exemption, tariff waiver, tax allowance, tax allowances, tax holiday, tax holidays, zero rated value added tax, zero rated VAT, exclusion from tax, tax exclusion</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P7 xml:lang="en">A tax exemption or exclusion is a tax incentive where the government does not count certain income or transactions as taxable, or declares certain entities to be fully tax-exempt. Example: income from feed-in tariffs is not taxable; NGOs do not pay taxes.</cpr:P7>
        <schema:description xml:lang="en">A tax exemption or exclusion is a tax incentive where the government does not count certain income or transactions as taxable, or declares certain entities to be fully tax-exempt. Example: income from feed-in tariffs is not taxable; NGOs do not pay taxes.</schema:description>
    </owl:NamedIndividual>
    


