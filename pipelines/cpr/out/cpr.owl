        <skos:altLabel xml:lang="en">failure of emergency communication systems</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of emergency telecommunication</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of emergency telecommunications</skos:altLabel>
        <schema:description xml:lang="en">Emergency telecommunications failure is an umbrella term for telecommunications of an ‘extraordinary nature’ under abnormal and potentially adverse network conditions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1177 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1177">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">radio and other telecommunication failures</rdfs:label>
        <skos:altLabel xml:lang="en">communication system failure</skos:altLabel>
        <skos:altLabel xml:lang="en">communication system failures</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of communication system</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of communication systems</skos:altLabel>
        <skos:altLabel xml:lang="en">radio failure</skos:altLabel>
        <skos:altLabel xml:lang="en">radio failures</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q836"/>
        <schema:description xml:lang="en">Radio and other telecommunication failures can be said to occur when there is internal or external interruption of communications by either party that results in difficult to transport the message as it was intended.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1178 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1178">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">water supply failure</rdfs:label>
        <skos:altLabel xml:lang="en">failure of the water network</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of water networks</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of water supply</skos:altLabel>
        <skos:altLabel xml:lang="en">water network failure</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1574"/>
        <schema:description xml:lang="en">Water supply failure is the physical shortage or scarcity in access of water supply due to the failure of institutions to ensure a regular supply or due to a lack of adequate infrastructure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1179 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1179">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">structural failure</rdfs:label>
        <skos:altLabel xml:lang="en">construction failure</skos:altLabel>
        <skos:altLabel xml:lang="en">structural collapse</skos:altLabel>
        <skos:altLabel xml:lang="en">structural failures</skos:altLabel>
        <schema:description xml:lang="en">Structural failure refers to the loss of structural integrity, or the loss of load-carrying structural capacity. It is initiated when a material is stressed beyond its strength limit, causing fracture or excessive deformations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q118 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q118">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2010"/>
        <rdfs:label xml:lang="en">coastal dike</rdfs:label>
        <skos:altLabel xml:lang="en">coastal dike</skos:altLabel>
        <skos:altLabel xml:lang="en">coastal dikes</skos:altLabel>
        <skos:altLabel xml:lang="en">coastal dyke</skos:altLabel>
        <skos:altLabel xml:lang="en">coastal dykes</skos:altLabel>
        <skos:altLabel xml:lang="en">coastal embankment</skos:altLabel>
        <skos:altLabel xml:lang="en">coastal embankments</skos:altLabel>
        <skos:altLabel xml:lang="en">sea dike</skos:altLabel>
        <skos:altLabel xml:lang="en">sea dikes</skos:altLabel>
        <skos:altLabel xml:lang="en">sea dyke</skos:altLabel>
        <skos:altLabel xml:lang="en">sea dykes</skos:altLabel>
        <skos:altLabel xml:lang="en">sea embankment</skos:altLabel>
        <skos:altLabel xml:lang="en">sea embankments</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1956"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/dikes"/>
        <schema:description xml:lang="en">A coastal dike is a structure made of earth or stone that&apos;s used to hold back seawater.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1180 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1180">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">building collapse</rdfs:label>
        <skos:altLabel xml:lang="en">building failure</skos:altLabel>
        <skos:altLabel xml:lang="en">catastrophic building failure</skos:altLabel>
        <skos:altLabel xml:lang="en">catastrophic building failures</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of building</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of buildings</skos:altLabel>
        <skos:altLabel xml:lang="en">damage buildings</skos:altLabel>
        <skos:altLabel xml:lang="en">damage to buildings</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <schema:description xml:lang="en">Building collapse is the failure of load-bearing structural elements, causing a building to fall or fail catastrophically / catastrophic failure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1181 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1181">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">bridge failure</rdfs:label>
        <skos:altLabel xml:lang="en">bridge collapse</skos:altLabel>
        <skos:altLabel xml:lang="en">bridge destroyed</skos:altLabel>
        <skos:altLabel xml:lang="en">bridges destroyed</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of bridge</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of bridges</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of bridge</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of bridges</skos:altLabel>
        <schema:description xml:lang="en">Bridge failure is the inability of a bridge, or its components, to perform as specified by its design and construction requirements.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1182 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1182">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1179"/>
        <rdfs:label xml:lang="en">dam failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in dam</skos:altLabel>
        <skos:altLabel xml:lang="en">break in dam</skos:altLabel>
        <skos:altLabel xml:lang="en">break of dam</skos:altLabel>
        <skos:altLabel xml:lang="en">burst of dam</skos:altLabel>
        <skos:altLabel xml:lang="en">dam breach</skos:altLabel>
        <skos:altLabel xml:lang="en">dam break</skos:altLabel>
        <skos:altLabel xml:lang="en">dam burst</skos:altLabel>
        <skos:altLabel xml:lang="en">failure in dam</skos:altLabel>
        <schema:description xml:lang="en">Dam failure is the collapse or movement of part of a dam or its foundation, such that the dam cannot retain water. In general, a failure results in a release of large quantities of water imposing risks on the people or property downstream.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1183 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1183">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">supply chain failure</rdfs:label>
        <skos:altLabel xml:lang="en">failure of supply chains</skos:altLabel>
        <skos:altLabel xml:lang="en">supply chain fail</skos:altLabel>
        <skos:altLabel xml:lang="en">supply chain fails</skos:altLabel>
        <schema:description xml:lang="en">Supply chain failure refers to an event in the supply chain that disrupts the flow of materials on their journey from initial suppliers through to final customers.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1184 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1184">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">critical infrastructure failure</rdfs:label>
        <skos:altLabel xml:lang="en">breach in critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breach of critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdown in critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">breakdown of critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse in critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">collapse of critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">failure in critical infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">failure of critical infrastructure</skos:altLabel>
        <schema:description xml:lang="en">Critical Infrastructure failure is defined as the failure in one or more of the physical structures, facilities, networks and other assets which provide services that are essential to the social and economic functioning of a community or society.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1185 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1185">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">storm damage</rdfs:label>
        <skos:altLabel xml:lang="en">damage by flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">damage by wash-aways</skos:altLabel>
        <skos:altLabel xml:lang="en">hurricane damage</skos:altLabel>
        <skos:altLabel xml:lang="en">hurricane damages</skos:altLabel>
        <skos:altLabel xml:lang="en">storm damages</skos:altLabel>
        <skos:altLabel xml:lang="en">tornado damage</skos:altLabel>
        <skos:altLabel xml:lang="en">tornado damages</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q399"/>
        <schema:description xml:lang="en">Storm damage is destruction to property and infrastructure by severe weather like hurricanes, thunderstorms and windstorms. It ranges from minor to severe, affecting buildings and power lines.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1186 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1186">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q519"/>
        <rdfs:label xml:lang="en">road damage</rdfs:label>
        <skos:altLabel xml:lang="en">damage roads</skos:altLabel>
        <skos:altLabel xml:lang="en">roads damaged</skos:altLabel>
        <schema:description xml:lang="en">Road damage refers to the deterioration or destruction of road structures and systems beyond normal wear and tear, often caused by extreme weather events, natural disasters, or other climate-related hazards, affecting safety and economic activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1187 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1187">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">natech</rdfs:label>
        <schema:description xml:lang="en">Natural hazard triggered technological accident</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1188 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1188">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">explosion</rdfs:label>
        <schema:description xml:lang="en">Explosion-related technological incidents can be defined as accidental or intentional events that result in the actual or potential exposure of responders and/or members of the public to a chemical hazard.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q119 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q119">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">sea wall</rdfs:label>
        <skos:altLabel xml:lang="en">sea walls</skos:altLabel>
        <skos:altLabel xml:lang="en">seawall</skos:altLabel>
        <skos:altLabel xml:lang="en">seawalls</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/sea-walls"/>
        <schema:description xml:lang="en">Seawalls are hard engineered structures with a primary function to prevent further erosion of the shoreline. They are built parallel to the shore and aim to hold or prevent erosion and, secondary, function as coastal flood defences.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1190 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1190">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">soil pollution</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1189"/>
        <schema:description xml:lang="en">Soil pollution refers to the presence of a chemical or substance out of place and/or present in a soil at higher than normal concentration that has adverse effects on any non-targeted organism</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1191 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1191">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">chemical leaks</rdfs:label>
        <skos:altLabel xml:lang="en">chemical leak</skos:altLabel>
        <skos:altLabel xml:lang="en">chemical leaks and spills</skos:altLabel>
        <skos:altLabel xml:lang="en">chemical spill</skos:altLabel>
        <skos:altLabel xml:lang="en">chemical spills</skos:altLabel>
        <schema:description xml:lang="en">A chemical incident is an uncontrolled release of toxic substances that can harm public health and the environment, occurring suddenly or gradually due to natural or accidental events.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1192 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1192">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">mining hazard</rdfs:label>
        <schema:description xml:lang="en">Mining hazards can be defined as having major environmental impacts including the production of waste, release of toxic and hazardous waste, air pollution and emissions, water pollution and depletion, and the loss of productive land and ecosystems</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1193 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1193">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">safety hazards associated with oil and gas</rdfs:label>
        <schema:description xml:lang="en">Oil and gas extraction, and associated servicing activities involve many types of equipment and materials. Identifying and controlling hazards is critical to preventing injuries and deaths.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1194 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1194">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">fire related technological incidents</rdfs:label>
        <schema:description xml:lang="en">It can be defined as accidental or intentional events that result in the actual or potential exposure of responders and/or members of the public to a chemical hazard.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1195 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1195">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q989"/>
        <rdfs:label xml:lang="en">water pollution</rdfs:label>
        <skos:altLabel xml:lang="en">pollution of surface and groundwater</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1189"/>
        <schema:description xml:lang="en">Water pollution occurs when harmful substances—often chemicals or microorganisms—contaminate a stream, river, lake, ocean, aquifer, or other body of water, degrading water quality and rendering it toxic to humans or the environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1196 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1196">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">typhoon waste</rdfs:label>
        <skos:altLabel xml:lang="en">cyclone debris</skos:altLabel>
        <skos:altLabel xml:lang="en">cyclone waste</skos:altLabel>
        <skos:altLabel xml:lang="en">hurricane debris</skos:altLabel>
        <skos:altLabel xml:lang="en">hurricane waste</skos:altLabel>
        <skos:altLabel xml:lang="en">typhoon debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q399"/>
        <schema:description xml:lang="en">Typhoon waste is waste generated by the typhoon, both from the event itself and from poor waste management in the aftermath.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1197 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1197">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">tsunami waste</rdfs:label>
        <skos:altLabel xml:lang="en">tsunami debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1152"/>
        <schema:description xml:lang="en">Tsunami debris consists of everything imaginable that was washed away from the large urbanized coastal communities that were destroyed by the tsunami.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1198 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1198">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">flooding waste</rdfs:label>
        <skos:altLabel xml:lang="en">flood debris</skos:altLabel>
        <skos:altLabel xml:lang="en">flood waste</skos:altLabel>
        <skos:altLabel xml:lang="en">flooding debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <schema:description xml:lang="en">Damage caused by floods to the built environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1199 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1199">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">volcano waste</rdfs:label>
        <skos:altLabel xml:lang="en">volcano debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1094"/>
        <schema:description xml:lang="en">Volcano waste is waste generated by a volcano eruption</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q120 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q120">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">groyne</rdfs:label>
        <skos:altLabel xml:lang="en">groin</skos:altLabel>
        <skos:altLabel xml:lang="en">groins</skos:altLabel>
        <skos:altLabel xml:lang="en">groynes</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/groynes"/>
        <schema:description xml:lang="en">A groyne is a rigid hydraulic structure built from an ocean shore (in coastal engineering) or from a bank (in rivers) that interrupts water flow and limits the movement of sediment. It is placed perpendicularly to the shore to trap sediments.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1200 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1200">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">tar road debris</rdfs:label>
        <skos:altLabel xml:lang="en">asphalt road debris</skos:altLabel>
        <skos:altLabel xml:lang="en">asphalt street waste</skos:altLabel>
        <skos:altLabel xml:lang="en">pavement debris</skos:altLabel>
        <skos:altLabel xml:lang="en">road and street rubble</skos:altLabel>
        <skos:altLabel xml:lang="en">tar street debris</skos:altLabel>
        <schema:description xml:lang="en">Tar contains PAH in high concentrations. PAH are known to be carcinogenic. It is a hazardous waste and have been used as a binder in asphalt. In an extreme event, water flows can wash away pavement structure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1201 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1201">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">unpaved road debris</rdfs:label>
        <skos:altLabel xml:lang="en">dirt road debris</skos:altLabel>
        <skos:altLabel xml:lang="en">mud street debris</skos:altLabel>
        <skos:altLabel xml:lang="en">unpaved street debris</skos:altLabel>
        <schema:description xml:lang="en">After an event (e.g. heavy rains), the runoff can dislodge the finer particles on the surface along with additional fine particles that are “pumped’ up to the surface by traffic causing stream sedimentation affecting the river ecosystem.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1202 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1202">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">waste clogging the drains</rdfs:label>
        <schema:description xml:lang="en">Debris and objects can flow into the drainage system, building up and cause clogged drains, especially after a heavy rain fall.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1203 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1203">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">woody debris</rdfs:label>
        <skos:altLabel xml:lang="en">vegetative debris</skos:altLabel>
        <skos:altLabel xml:lang="en">wood debris</skos:altLabel>
        <schema:description xml:lang="en">Woody debris can be defined as any dead, woody plant material, including logs, branches, standing dead trees, and root wads. It may result from hurricanes, tornadoes or coastal storms.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1204 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1204">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">healthcare risk waste</rdfs:label>
        <skos:altLabel xml:lang="en">medical waste in debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1571"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1601"/>
        <schema:description xml:lang="en">Natural disasters can severely disrupt the normal operations of healthcare facilities. These disruptions can lead to an increased volume of medical waste, compromised waste disposal routes, and damaged disposal facilities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1205 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1205">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">building rubble</rdfs:label>
        <skos:altLabel xml:lang="en">building debris</skos:altLabel>
        <schema:description xml:lang="en">Building rubble consists exclusively of mineral waste such as concrete, bricks, ceramics, soil and sand.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1206 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1206">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q750"/>
        <rdfs:label xml:lang="en">water distribution rubble</rdfs:label>
        <skos:altLabel xml:lang="en">debris accumulation in waste water treatment plants</skos:altLabel>
        <skos:altLabel xml:lang="en">debris from waste water treatment plants</skos:altLabel>
        <skos:altLabel xml:lang="en">debris from water works</skos:altLabel>
        <schema:description xml:lang="en">An extreme event can cause the accumulation of grit and debris in wastewater system. These materials can find their way into treatment plant systems through inflow and infiltration or due to physical damage to infrastructure.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1207 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1207">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">regulatory instrument</rdfs:label>
        <skos:altLabel xml:lang="en">authoritative instrument</skos:altLabel>
        <skos:altLabel xml:lang="en">authoritative instruments</skos:altLabel>
        <skos:altLabel xml:lang="en">regulatory instruments</skos:altLabel>
        <cpr:P7 xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, regulate behaviour by setting some kind of boundary. This refers to the power to make rules, which require actors to adopt certain behaviours and prohibit others. In climate policy, these include obligations to disclose emissions, moratoria and bans on fossil fuel production or use, and spatial planning laws.</cpr:P7>
        <schema:description xml:lang="en">Regulatory instruments, or &quot;authority&quot; in Hood and Margetts&apos; NATO scheme, set boundaries on behaviour through rules, like emissions disclosure, fossil fuel bans, and spatial planning laws.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1208 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1208">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">information instrument</rdfs:label>
        <skos:altLabel xml:lang="en">information instruments</skos:altLabel>
        <skos:altLabel xml:lang="en">nodality instrument</skos:altLabel>
        <skos:altLabel xml:lang="en">nodality instruments</skos:altLabel>
        <cpr:P7 xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</cpr:P7>
        <schema:description xml:lang="en">Information instruments, or &quot;nodality&quot; in Hood and Margetts&apos; NATO schema, are tools that give power of governments over information. In climate policy these tools raise awareness of climate change issues, enhance research and development efforts, and increase transparency through things like ecolabeling or energy efficiency labels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1209 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1209">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <rdfs:label xml:lang="en">organisation and governance instrument</rdfs:label>
        <skos:altLabel xml:lang="en">organisation instrument</skos:altLabel>
        <cpr:P7 xml:lang="en">Allows governments to act directly on individuals, their property, or the environment, focusing on &quot;effecting&quot; rather than detecting. In climate policy, they are designed to enhance institutions’ capacity to address climate change. This includes granting new responsibilities to existing bodies, creating new institutions, and developing governance plans and strategies.</cpr:P7>
        <schema:description xml:lang="en">Organisation and governance instruments let governments act directly on individuals, property, or the environment, enhancing institutions’ capacity for climate action through new roles, bodies, and strategies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q121 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q121">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">geosynthetic</rdfs:label>
        <skos:altLabel xml:lang="en">geosynthetic</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technology-library/protection-hard-engineering/geosynthetics"/>
        <schema:description xml:lang="en">Geosynthetics are human-made products used to stabilize terrain.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1210 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1210">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">air transportation accident</rdfs:label>
        <skos:altLabel xml:lang="en">air disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">air incident</skos:altLabel>
        <skos:altLabel xml:lang="en">air transport accident</skos:altLabel>
        <skos:altLabel xml:lang="en">air transport disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">air transport disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">air transport incident</skos:altLabel>
        <skos:altLabel xml:lang="en">air transportation disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">air transportation disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">air transportation incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of air accidents and incidents, or logistical challenges.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1211 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1211">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">marine accident</rdfs:label>
        <skos:altLabel xml:lang="en">marine disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">marine disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">marine incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of marine accidents that can seriously endanger the safety of the vessel or another vessel or an individual; and severe damage to the environment, or the potential for severe damage to the environment.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1212 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1212">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">inland water ways accident</rdfs:label>
        <skos:altLabel xml:lang="en">inland water ways disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">inland water ways incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of in land water ways accidents. An inland waterway transportation accident is an unwanted or unintended sudden event that brings harmful consequences to the inland water vessel.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1213 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1213">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">rail accident</rdfs:label>
        <skos:altLabel xml:lang="en">rail disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">rail disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">rail incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of rail accidents, disruptions in travel or logistical challenges. A rail accident is an unwanted or unintended sudden event with harmful consequences.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1214 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1214">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q990"/>
        <rdfs:label xml:lang="en">road traffic accident</rdfs:label>
        <skos:altLabel xml:lang="en">road accident</skos:altLabel>
        <skos:altLabel xml:lang="en">road disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">road disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">road incident</skos:altLabel>
        <skos:altLabel xml:lang="en">road traffic disaster</skos:altLabel>
        <skos:altLabel xml:lang="en">road traffic disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">road traffic incident</skos:altLabel>
        <schema:description xml:lang="en">Extreme weather events can increase the risks of road traffic accidents. A road traffic accident is any accident involving at least one road vehicle in motion on a public road or private road resulting in (an) injured person(s).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1215 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1215">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">misconfiguration of software and hardware</rdfs:label>
        <schema:description xml:lang="en">Misconfiguration of software and hardware is the incorrect or suboptimal configuration of an information system or system component that may lead to vulnerabilities</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1216 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1216">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">non-conformity and interoperability</rdfs:label>
        <schema:description xml:lang="en">Non-Conformity occurs when specified requirements relating to a product, process, system, person or body are not fulfilled. Interoperability is a characteristic of a product or system to work with other products or system.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1217 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1217">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">malware</rdfs:label>
        <skos:altLabel xml:lang="en">malicious software</skos:altLabel>
        <skos:altLabel xml:lang="en">trojan horses</skos:altLabel>
        <skos:altLabel xml:lang="en">viruses</skos:altLabel>
        <skos:altLabel xml:lang="en">worms</skos:altLabel>
        <schema:description xml:lang="en">Malware is a summary term for different forms of malevolent software designed to infiltrate and infect computers, typically without the knowledge of the owner.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1218 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1218">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">data breach</rdfs:label>
        <skos:altLabel xml:lang="en">data leak</skos:altLabel>
        <skos:altLabel xml:lang="en">data spill</skos:altLabel>
        <skos:altLabel xml:lang="en">intellectual data breach</skos:altLabel>
        <skos:altLabel xml:lang="en">security breach</skos:altLabel>
        <schema:description xml:lang="en">A data breach is a compromise of security that leads to the accidental or unlawful destruction, loss, alteration, unauthorised disclosure of, or access to protected data transmitted, stored, or otherwise processed.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1219 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1219">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">data security-related hazards</rdfs:label>
        <skos:altLabel xml:lang="en">data security-related hazards impacts</skos:altLabel>
        <schema:description xml:lang="en">Data security-related hazards include risks arising from increased system complexity because this provides opportunities for malicious cyberattacks and data loss in the case of serious incidents, including natural disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q122 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q122">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1843"/>
        <rdfs:label xml:lang="en">revetment</rdfs:label>
        <skos:altLabel xml:lang="en">gabion</skos:altLabel>
        <skos:altLabel xml:lang="en">gabions</skos:altLabel>
        <skos:altLabel xml:lang="en">revetments</skos:altLabel>
        <skos:altLabel xml:lang="en">rip rap boulder</skos:altLabel>
        <skos:altLabel xml:lang="en">rip rap boulders</skos:altLabel>
        <skos:altLabel xml:lang="en">riprap boulder</skos:altLabel>
        <skos:altLabel xml:lang="en">riprap boulders</skos:altLabel>
        <skos:altLabel xml:lang="en">rock armour</skos:altLabel>
        <cpr:P4 rdf:resource="https://unfccc.int/resource/docs/tp/tp0199.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/revetments"/>
        <schema:description xml:lang="en">A revetment is a slope consisting of loose or interlocking protection units (geotextiles may also be used). Revetments typically protect a soft landform such as a dune area or coastal slope.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1220 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1220">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">cyber outage</rdfs:label>
        <skos:altLabel xml:lang="en">cyber disruption</skos:altLabel>
        <skos:altLabel xml:lang="en">internet outage</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q838"/>
        <schema:description xml:lang="en">A cyber outage is the unavailability of a service or resource.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1221 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1221">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">personally identifiable information breach</rdfs:label>
        <skos:altLabel xml:lang="en">PII breach</skos:altLabel>
        <skos:altLabel xml:lang="en">personally identifiable information (PII) breach</skos:altLabel>
        <schema:description xml:lang="en">A personally identifiable information (PII) breach is a situation where PII is processed in violation of one or more relevant PII protection requirements.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1222 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1222">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">Internet of Things-related hazards</rdfs:label>
        <skos:altLabel xml:lang="en">Internet of Things (IOT)-related hazards</skos:altLabel>
        <skos:altLabel xml:lang="en">Internet of Things-related impact</skos:altLabel>
        <schema:description xml:lang="en">The Internet of Things (IoT) is a global infrastructure for the information society, enabling advanced services by interconnecting (physical and virtual) things based on existing communication technologies.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1223 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1223">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q985"/>
        <rdfs:label xml:lang="en">cyberbullying</rdfs:label>
        <skos:altLabel xml:lang="en">cyber harassment</skos:altLabel>
        <skos:altLabel xml:lang="en">cyber-bullying</skos:altLabel>
        <skos:altLabel xml:lang="en">harassment online</skos:altLabel>
        <skos:altLabel xml:lang="en">online bullying</skos:altLabel>
        <skos:altLabel xml:lang="en">online harassment</skos:altLabel>
        <schema:description xml:lang="en">Cyberbullying is bullying that takes place using digital devices. Cyberbullying includes the deliberate sending, posting, or sharing of negative, harmful, false, or mean content about someone else causing embarrassment or humiliation.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1224 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1224">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">phosphine</rdfs:label>
        <skos:altLabel xml:lang="en">phosphorus hydride</skos:altLabel>
        <schema:description xml:lang="en">Phosphine is a colorless and extremely toxic gas to humans and to the environment that is used in industrial synthesis. Pure phosphine is also odorless.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1225 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1225">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">chlorine</rdfs:label>
        <schema:description xml:lang="en">Chlorine is a yellow-green gas at room temperature. It is a disinfectant, used to treat water. It is used in the manufacture of consumer products, such PVC. Chlorine gas is itself very poisonous, and was used as a chemical weapon during the WWI.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1226 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1226">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">arsenic</rdfs:label>
        <schema:description xml:lang="en">Arsenic is a natural component widely distributed throughout the environment. It is highly toxic in its inorganic form, which is a confirmed carcinogen and is the most significant chemical contaminant in drinking-water globally.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1227 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1227">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">cadmium</rdfs:label>
        <schema:description xml:lang="en">It is a metallic element that occurs naturally in tiny amounts in air, water, soil, and food. It is used to make batteries, pigments, plastics, alloys, and electroplate. Exposure to high levels of cadmium may cause certain health problems.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1228 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1228">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">mercury</rdfs:label>
        <schema:description xml:lang="en">A silver-white, neurotoxicant metal that is a liquid at room temperature. Human activities, such as gold mining and the burning of coal and other fossil fuels are responsible for the mercury that is released into the air.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1229 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1229">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">pesticide</rdfs:label>
        <skos:altLabel xml:lang="en">PPP</skos:altLabel>
        <skos:altLabel xml:lang="en">Plant Protection Products</skos:altLabel>
        <skos:altLabel xml:lang="en">agricultural chemical</skos:altLabel>
        <skos:altLabel xml:lang="en">agricultural chemicals</skos:altLabel>
        <skos:altLabel xml:lang="en">agro-chemical</skos:altLabel>
        <skos:altLabel xml:lang="en">agro-chemicals</skos:altLabel>
        <skos:altLabel xml:lang="en">pesticides</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1665"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1666"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <schema:description xml:lang="en">Pesticide means any substance, or mixture of substances of chemical or biological ingredients intended for repelling, destroying or controlling any pest, or regulating plant growth. Pesticides are inherently toxic.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q123 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q123">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">cliff stabilisation</rdfs:label>
        <skos:altLabel xml:lang="en">cliff stabilisation</skos:altLabel>
        <skos:altLabel xml:lang="en">slope stabilisation</skos:altLabel>
        <skos:altLabel xml:lang="en">stabilisation of cliff</skos:altLabel>
        <cpr:P4 rdf:resource="https://thefloodhub.co.uk/wp-content/uploads/2018/09/FT-Q-R81-Cliff-stabilisation.pdf"/>
        <schema:description xml:lang="en">Cliff stabilisation is a form of soft engineering, using natural processes to protect the shoreline against flooding and erosion. Stabilisation techniques are used to limit the amount of erosion and the potential for landslides,collapse and falling rocks.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1230 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1230">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">highly hazardous pesticides</rdfs:label>
        <skos:altLabel xml:lang="en">HHPs</skos:altLabel>
        <schema:description xml:lang="en">HHPs are those recognized to pose high acute or chronic health or environmental risks per global classifications (e.g., WHO, GHS) or international agreements. Pesticides causing severe or irreversible harm under local use may also qualify.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1231 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1231">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">residue of pesticides</rdfs:label>
        <skos:altLabel xml:lang="en">residue of pesticide</skos:altLabel>
        <schema:description xml:lang="en">Pesticide residue refers to any substance in food, crops, or animal feed from pesticide use, including derivatives like conversion products, metabolites, reaction products, and impurities of toxicological significance.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1232 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1232">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">insecticides</rdfs:label>
        <skos:altLabel xml:lang="en">insecticide</skos:altLabel>
        <schema:description xml:lang="en">Insecticides are chemicals used to control insects by killing them.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1233 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1233">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">fungicides</rdfs:label>
        <skos:altLabel xml:lang="en">fungicide</skos:altLabel>
        <schema:description xml:lang="en">Fungicides are chemicals that kill or slow the growth of fungi and their spores. They can be used on plants or other surfaces where mould or mildew grow</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1234 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1234">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1229"/>
        <rdfs:label xml:lang="en">herbicides</rdfs:label>
        <skos:altLabel xml:lang="en">herbicide</skos:altLabel>
        <schema:description xml:lang="en">Herbicides are chemicals used to control unwanted vegetation, mainly in row-crop farming, where they’re applied before or during planting to boost crop productivity by reducing competing plants.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1235 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1235">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">persistent organic pollutants</rdfs:label>
        <skos:altLabel xml:lang="en">POPs</skos:altLabel>
        <skos:altLabel xml:lang="en">persistent organic pollutant</skos:altLabel>
        <schema:description xml:lang="en">Persistent organic pollutants (POPs) are organic compounds that are resistant to degradation. Widely distributed in the environment, magnified in living organisms up the food chain, they are toxic to humans and wildlife.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1236 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1236">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">hazardous pesticide contamination in soils</rdfs:label>
        <skos:altLabel xml:lang="en">brownfield sites</skos:altLabel>
        <skos:altLabel xml:lang="en">contaminated land special sites</skos:altLabel>
        <skos:altLabel xml:lang="en">soil contamination soil pollution</skos:altLabel>
        <schema:description xml:lang="en">Hazardous pesticide contamination in soil often stems from improper agrochemical storage and long-term use of highly toxic, persistent compounds in agriculture, which harm non-target species.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1237 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1237">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1235"/>
        <rdfs:label xml:lang="en">dioxins</rdfs:label>
        <skos:altLabel xml:lang="en">dioxin</skos:altLabel>
        <skos:altLabel xml:lang="en">dioxin-like substances</skos:altLabel>
        <skos:altLabel xml:lang="en">dioxines</skos:altLabel>
        <skos:altLabel xml:lang="en">furans</skos:altLabel>
        <schema:description xml:lang="en">Dioxins and dioxin-like substances are unwanted by-products of combustion and industrial processes like chlorine bleaching and smelting. With similar toxicity and mechanisms, they are grouped together for guideline setting</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1238 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1238">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">benzene</rdfs:label>
        <schema:description xml:lang="en">Benzene is a clear, colourless, highly flammable and volatile, liquid aromatic hydrocarbon (molecular formula C6H6) with a gasoline-like odour.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1239 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1239">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">asbestos</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1443"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q443"/>
        <schema:description xml:lang="en">Asbestos refers to a group of natural minerals once widely used in building materials. All types can cause lung cancer, mesothelioma, larynx and ovarian cancer, and asbestosis (lung fibrosis).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q124 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q124">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">beach nourishment</rdfs:label>
        <skos:altLabel xml:lang="en">beach nourishment</skos:altLabel>
        <skos:altLabel xml:lang="en">beach restoration</skos:altLabel>
        <skos:altLabel xml:lang="en">restoring beaches</skos:altLabel>
        <skos:altLabel xml:lang="en">sand nourishment</skos:altLabel>
        <skos:altLabel xml:lang="en">shoreface nourishment</skos:altLabel>
        <skos:altLabel xml:lang="en">shoreface restoration</skos:altLabel>
        <cpr:P4 rdf:resource="https://climate-adapt.eea.europa.eu/en/metadata/adaptation-options/beach-and-shoreface-nourishment"/>
        <schema:description xml:lang="en">Beach nourishment or replenishment is the artificial placement of sand on an eroded shore to maintain the amount of sand present in the foundation of the coast, and this way to compensate for natural erosion and to a greater or lesser extent protect the area against storm surge.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1240 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1240">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">aflatoxins</rdfs:label>
        <skos:altLabel xml:lang="en">aflatoxin</skos:altLabel>
        <schema:description xml:lang="en">Aflatoxins are toxic compounds produced by certain moulds (e.g. Aspergillus flavus and A. parasiticus) found in soil, decaying vegetation and grains. They are among the most dangerous mycotoxins, posing serious health risks to humans and livestock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1241 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1241">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">fluoride</rdfs:label>
        <schema:description xml:lang="en">Fluoride is a naturally occurring mineral to which the public are often exposed via drinking-water. Depending on dose intake fluoride may have both beneficial effects or negative effects (causing tooth enamel and skeletal fluorosis).</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1242 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1242">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">methanol</rdfs:label>
        <skos:altLabel xml:lang="en">methyl alcohol</skos:altLabel>
        <schema:description xml:lang="en">Methanol is a primary alcohol (CH₃OH) with low intrinsic toxicity, found in various daily products. However, it metabolizes into highly toxic compounds that can cause blindness, coma, and life-threatening metabolic disturbances</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1243 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1243">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">substandard and falsified medical products</rdfs:label>
        <skos:altLabel xml:lang="en">falsified medical products</skos:altLabel>
        <skos:altLabel xml:lang="en">substandard medical products</skos:altLabel>
        <schema:description xml:lang="en">Substandard and falsified medical products are defined as those that may cause harm to patients and fail to treat the diseases for which they were intended.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1244 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1244">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1483"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1245 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1245">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">fertilisers</rdfs:label>
        <skos:altLabel xml:lang="en">chemical fertilisers</skos:altLabel>
        <skos:altLabel xml:lang="en">chemical fertilizers</skos:altLabel>
        <skos:altLabel xml:lang="en">fertiliser</skos:altLabel>
        <skos:altLabel xml:lang="en">fertilizer</skos:altLabel>
        <skos:altLabel xml:lang="en">fertilizers</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1467"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1625"/>
        <schema:description xml:lang="en">Chemical fertilizers are the artificially manipulated substances containing known quantities of three macroelements, i.e., nitrogen, potassium, and phosphorous.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1247 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1247">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <rdfs:label xml:lang="en">carbon monoxide poisoning</rdfs:label>
        <skos:altLabel xml:lang="en">exposure to carbon monoxide</skos:altLabel>
        <schema:description xml:lang="en">Carbon monoxide poisoning happens when carbon monoxide accumulates in the blood, replacing oxygen in red blood cells. High levels of carbon monoxide in the air can cause severe tissue damage or even death.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1249 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1249">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q676"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q704"/>
        <rdfs:label xml:lang="en">woman of color</rdfs:label>
        <skos:altLabel xml:lang="en">black girl</skos:altLabel>
        <skos:altLabel xml:lang="en">black girls</skos:altLabel>
        <skos:altLabel xml:lang="en">black woman</skos:altLabel>
        <skos:altLabel xml:lang="en">black women</skos:altLabel>
        <skos:altLabel xml:lang="en">brown girl</skos:altLabel>
        <skos:altLabel xml:lang="en">brown girls</skos:altLabel>
        <skos:altLabel xml:lang="en">brown woman</skos:altLabel>
        <skos:altLabel xml:lang="en">brown women</skos:altLabel>
        <skos:altLabel xml:lang="en">women of color</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1248"/>
        <cpr:P7 xml:lang="en">a woman who does not consider herself to be white</cpr:P7>
        <schema:description xml:lang="en">a woman who does not consider herself to be white</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q125 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q125">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1844"/>
        <rdfs:label xml:lang="en">constructed wetland</rdfs:label>
        <skos:altLabel xml:lang="en">constructed wetlands</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.adb.org/sites/default/files/publication/149400/technologies-climate-change-adaptation.pdf"/>
        <cpr:P4 rdf:resource="https://www.ctc-n.org/technologies/constructed-wetlands"/>
        <schema:description xml:lang="en">Constructed wetlands protect coastal communities during flooding by absorbing wave energy or storing excess water. In the later, it is a shallow basin filled with some sort of filler material (substrate), usually sand or gravel, and planted with vegetation tolerant of saturated conditions to mimic the function of mangrove forest or salt marshes. In the context of water purification, constructed wetlands make use of the natural purification processes of vegetation, soils and microbes to remove contaminants from discharge and improve water quality.</schema:description>
    </owl:Class>
    


