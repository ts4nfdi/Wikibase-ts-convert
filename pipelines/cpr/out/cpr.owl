        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q645"/>
        <cpr:P7 xml:lang="en">Coal bed methane (CBM) is an unconventional form of natural gas found in coal deposits or coal seams, and contains contains 97% of methane.</cpr:P7>
        <cpr:P9 xml:lang="en">coal</cpr:P9>
    </rdf:Description>
