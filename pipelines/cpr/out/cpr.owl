        <skos:altLabel xml:lang="en">engagement with grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">grassroots engagement</skos:altLabel>
        <skos:altLabel xml:lang="en">grassroots involvement</skos:altLabel>
        <skos:altLabel xml:lang="en">involve civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">involve grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">involvement of civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">involving grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">meaningful public consultation</skos:altLabel>
        <skos:altLabel xml:lang="en">meaningful public consultations</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilisation of civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilising civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilising grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilization of civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilizing civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">mobilizing grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">participation of civil society</skos:altLabel>
        <skos:altLabel xml:lang="en">participation of grassroots</skos:altLabel>
        <cpr:P7 xml:lang="en">Civil society engagement refers to the involvement of non-governmental organizations, community groups, and other forms of civic participation in public policy-making and advocacy. This form of engagement plays a crucial role in shaping political agendas, representing diverse interests, and ensuring accountability from governmental institutions.</cpr:P7>
        <schema:description xml:lang="en">A meaningful involvement of civil society in the decision making process</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1754 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1754">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q65"/>
        <rdfs:label xml:lang="en">aligning skills</rdfs:label>
        <skos:altLabel xml:lang="en">address skills shortages</skos:altLabel>
        <skos:altLabel xml:lang="en">address the skills shortage</skos:altLabel>
        <skos:altLabel xml:lang="en">address the skills shortages</skos:altLabel>
        <skos:altLabel xml:lang="en">addresses skills shortages</skos:altLabel>
        <skos:altLabel xml:lang="en">addressing skill gaps</skos:altLabel>
        <skos:altLabel xml:lang="en">addressing skill shortages</skos:altLabel>
        <skos:altLabel xml:lang="en">align competencies</skos:altLabel>
        <skos:altLabel xml:lang="en">align skill</skos:altLabel>
        <skos:altLabel xml:lang="en">align skills</skos:altLabel>
        <skos:altLabel xml:lang="en">align the competencies</skos:altLabel>
        <skos:altLabel xml:lang="en">align the skills</skos:altLabel>
        <skos:altLabel xml:lang="en">aligned competencies</skos:altLabel>
        <skos:altLabel xml:lang="en">aligned skills</skos:altLabel>
        <skos:altLabel xml:lang="en">competency alignment</skos:altLabel>
        <skos:altLabel xml:lang="en">green skills</skos:altLabel>
        <skos:altLabel xml:lang="en">reducing skill gaps</skos:altLabel>
        <skos:altLabel xml:lang="en">reducing skill shortages</skos:altLabel>
        <skos:altLabel xml:lang="en">skills alignment</skos:altLabel>
        <cpr:P20 xml:lang="en">6y38j2hv</cpr:P20>
        <cpr:P7 xml:lang="en">Achieving climate goals will require different jobs; in most cases, it is possible to modify existing jobs, but this will require training in new skills. Aligning skills in this way can be done through a variety of policy interventions. Moreover, many of these green skills overlap with general employable skills, so we include a number of more generic skill improvement initiatives here too.</cpr:P7>
        <schema:description xml:lang="en">Aligning the skills of the workforce with the requirements of the just transition.</schema:description>
    </owl:Class>
    


