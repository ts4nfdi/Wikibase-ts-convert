    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1255">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q412"/>
        <cpr:P7 xml:lang="en">Indoor air pollution is caused by the burning of firewood, crop waste, and dung for cooking and heating. The burning of these fuels poses severe health risks, such as respiratory diseases, and is one of the leading risk factors for premature death.</cpr:P7>
    </rdf:Description>
