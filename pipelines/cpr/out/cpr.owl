    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q920 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q920">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q919"/>
        <rdfs:label xml:lang="en">bromochlorodifluoromethane</rdfs:label>
