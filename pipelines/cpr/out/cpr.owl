        <cpr:P7 xml:lang="en">Oil extracted from shale rock using fracking or hydraulic fracturing of the rock.</cpr:P7>
        <schema:description xml:lang="en">Oil extracted from shale rock using fracking or hydraulic fracturing of the rock, creating liquid petroleum produced by heating shale oil.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q739 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q739">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q650"/>
        <rdfs:label xml:lang="en">coal bed methane</rdfs:label>
        <skos:altLabel xml:lang="en">CBM, coalbed methane, methane gas, CSG, coal bed gas, coalbed gas, coal seam gas, virgin coal seam methane</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1470"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q645"/>
        <cpr:P7 xml:lang="en">Coal bed methane (CBM) is an unconventional form of natural gas found in coal deposits or coal seams, and contains contains 97% of methane.</cpr:P7>
        <cpr:P9 xml:lang="en">coal</cpr:P9>
        <schema:description xml:lang="en">Coal bed methane (CBM) is an unconventional form of natural gas found in coal deposits or coal seams, and contains contains 97% of methane.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q75 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q75">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
        <rdfs:label xml:lang="en">cool roof</rdfs:label>
        <skos:altLabel xml:lang="en">white roof, white roofs, cool roofs</skos:altLabel>
        <cpr:P4 rdf:resource="https://build-up.ec.europa.eu/sites/default/files/content/Cool%20Roofs_EN_1.pdf"/>
        <schema:description xml:lang="en">A cool roof is a roofing system able to reflect solar heat and keep roof surfaces cool.This is due to the properties of the reflective materials used which reflect solar radiation back into the atmosphere. As the roof stays cooler, this reduces the amount of heat transferred to the building below, keeping a cooler temperature in the interior.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q750 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q750">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q954"/>
        <rdfs:label xml:lang="en">disaster waste impact</rdfs:label>
        <skos:altLabel xml:lang="en">disaster waste, disaster waste generation, generation of disaster waste, post disaster waste, post-disaster waste, waste in times of a disaster, disaster debris</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1576"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q298"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q324"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q328"/>
        <cpr:P7 xml:lang="en">Disaster waste is waste generated by the impact of a disaster, both from the disaster itself and during the response and recovery phase due to poor waste management. Examples are the waste following extreme weather events, such as flooding or storms.</cpr:P7>
        <schema:description xml:lang="en">Disaster waste is waste generated by the impact of a disaster, both from the disaster itself and from poor waste management in the aftermath.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q756 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q756">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">international affairs sector</rdfs:label>
        <skos:altLabel xml:lang="en">cross-border organizational activities, extraterritorial entity operations, global institutional functions, international organisation, international organisations, international organization, international organizations, transnational entity operations, extraterritorial organisation, extraterritorial organisations, extraterritorial organization, extraterritorial organizations, foreign mission, international NGO, international organisational, international organizational, transnational entities, transnational entity, intergovernmental, diplomacy, diplomatic, international affairs</skos:altLabel>
        <cpr:P7 xml:lang="en">This class includes activities of international organizations under treaties between states, such as the UN and its agencies, regional bodies, the IMF, World Bank, WCO, OECD, OPEC, EFTA, and EU institutions. It also encompasses activities of foreign government agencies like embassies, consulates, military, and scientific bases.</cpr:P7>
        <schema:description xml:lang="en">The activities of international entities, such as the UN and intergovernmental organisations, that influence global affairs.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q757 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q757">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">informal sector</rdfs:label>
        <skos:altLabel xml:lang="en">household production, subsistence sector, informal economy, informal services, casual work, informal work, small-scale rural entrepreneur</skos:altLabel>
        <cpr:P20 xml:lang="en">n4t9ec5y</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1068"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1862"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1876"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q418"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q894"/>
        <cpr:P7 xml:lang="en">This section encompasses households hiring domestic workers and engaging in activities to produce goods and services for their own use, without differentiating between types. It covers tasks like cleaning, cooking, child-rearing, and subsistence farming, where production is intended solely for the household&apos;s consumption, rather than for sale in the market.</cpr:P7>
        <schema:description xml:lang="en">Households employing domestic workers, for activities like cooking, cleaning and subsistence farming, for their own use.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q758 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q758">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">third sector</rdfs:label>
        <skos:altLabel xml:lang="en">civic sector, community sector, voluntary sector, nonprofit, not-for-profit, charities, charity, philanthropic, philanthropy, voluntary sectors, social sector, civil society, development aid, CSO, NFP, NGO, civil society organisation, civil society organization, non-governmental organisation, non-governmental organization, non-profit organisation, non-profit organization</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P7 xml:lang="en">Refers to non‐governmental, not‐for‐profit organisations that address social, cultural and environmental challenges. This sector covers charities, voluntary groups and social enterprises that rely on philanthropy, grants and volunteer support to deliver community services, advocacy and development initiatives.</cpr:P7>
        <schema:description xml:lang="en">Activities of national and sub-national non-profit organizations, charities, and voluntary groups.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q76 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q76">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
        <rdfs:label xml:lang="en">disaster-resilient building</rdfs:label>
        <skos:altLabel xml:lang="en">disaster-resistant building, disaster-resilient buildings, disaster-resistant buildings</skos:altLabel>
        <cpr:P4 rdf:resource="https://illustrarch.com/articles/15401-resilient-architecture-for-natural-disasters.html"/>
        <cpr:P4 rdf:resource="https://www.planradar.com/gb/everything-you-need-to-know-about-disaster-resilient-architecture/"/>
        <schema:description xml:lang="en">It refers to buildings that are built to withstand and quickly recover from various hazards, including natural disasters.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q760 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q760">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">extractive sector</rdfs:label>
        <skos:altLabel xml:lang="en">extractive industries, extractive industry, extraction of raw materials, extraction of raw material, harvesting raw material, quarrying raw materials, raw material extraction, raw materials extraction, raw materials quarrying, primary industry, primary resource industry, primary sector, raw materials sector</skos:altLabel>
        <cpr:P20 xml:lang="en">fvdwz7cn</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1046"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1165"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1435"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1438"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q43"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q661"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q663"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q955"/>
        <cpr:P7 xml:lang="en">This sector includes extracting solid minerals (coal, ores), liquid (petroleum), and gas (natural gas) from mines, seabeds, and water. Methods include underground/surface mining, well operation, and seabed mining. It covers activities like crushing, grinding, cleaning, and drying, and includes fossil fuels, metal ores, minerals, quarry products, and hydrocarbon extraction services.</cpr:P7>
        <schema:description xml:lang="en">Activities of industries that extract natural resources, such as mining, oil, and gas, for commercial use.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q761 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q761">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">manufacturing sector</rdfs:label>
        <skos:altLabel xml:lang="en">manufacturing sector, manufacturing industry, manufacturing, industrial process, industrial production, industrial sector, manufacture activities, manufacture activity, industrial sectors, manufacturing sectors</skos:altLabel>
        <cpr:P20 xml:lang="en">grw5x8ee</cpr:P20>
        <cpr:P7 xml:lang="en">This sector includes transforming materials into new products through physical, chemical, or biological processes, including alteration, renovation, or reconstruction of goods. Outputs can be finished or semi-finished. It includes factoryless goods producers who control production and provide intellectual property. Assembly of components and waste recovery into secondary products are included.</cpr:P7>
        <schema:description xml:lang="en">The activities of industries that transforms raw materials into finished goods through industrial processes.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q762 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q762">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">energy supply sector</rdfs:label>
        <skos:altLabel xml:lang="en">renewable energy, renewables, hydroelectricity, hydropower, marine energy, wind energy, green hydrogen, heat pumps, energy industry, power sector, solar energy, energy supply, geothermal energy, power supply sector, energy provision industry, energy provision sector, energy supply activities, energy supply activity, low-emissions fuels</skos:altLabel>
        <cpr:P20 xml:lang="en">qa22cf6s</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1024"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1066"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1478"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q281"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q286"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q638"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q868"/>
        <cpr:P7 xml:lang="en">Covers the generation, transmission and distribution of energy, including electricity, gas, steam and air conditioning. This sector supports modern economies by providing power from both traditional fossil fuels and renewable sources, and by managing the infrastructure necessary for centralised and distributed energy supply.</cpr:P7>
        <cpr:P9 xml:lang="en">extreme</cpr:P9>
        <cpr:P9 xml:lang="en">increased</cpr:P9>
        <cpr:P9 xml:lang="en">waves</cpr:P9>
        <schema:description xml:lang="en">The activities of industries involved in the production, distribution, and sale of energy, including electricity, gas, and renewables.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q763 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q763">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">environmental management sector</rdfs:label>
        <skos:altLabel xml:lang="en">waste industry, waste sector, waste services, WASH sector, waste upcycling, waste by upcycling</skos:altLabel>
        <cpr:P20 xml:lang="en">s3cc4cdt</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1048"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1063"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1067"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1068"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1069"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1576"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q333"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q975"/>
        <cpr:P7 xml:lang="en">This sector includes water collection, treatment, and supply, sewerage systems, waste collection, treatment, disposal activities, and remediation services. It covers the operation of sewage plants, treatment of solid and hazardous waste, and environmental cleanup. Excluded are the management of electric power, gaseous fuels, and heating and cooling supply networks.</cpr:P7>
        <schema:description xml:lang="en">This sector involves managing waste treatment, sanitation, pollution control and environmental cleanup.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q764 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q764">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">construction sector</rdfs:label>
        <skos:altLabel xml:lang="en">building industry, building sector, construction, renovation, building construction, construction services, infrastructure development, building retrofitting, constructing, retrofitting, building repairs, construction industry, infrastructure development sector, real estate development sector, infrastructure development industry, retrofitting service</skos:altLabel>
        <cpr:P20 xml:lang="en">nxt8v557</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1164"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P7 xml:lang="en">The construction sector includes general and specialised activities for buildings and civil engineering works, such as new work, repairs, and alterations. It covers building homes, offices, utilities, and projects like roads and bridges. Activities include subcontracting, maintenance, and installing building equipment. Equipment rental with operators and renovating historical sites are included.</cpr:P7>
        <schema:description xml:lang="en">Activities that involve planning, designing and building infrastructure, residential, and commercial structures.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q765 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q765">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">trade sector</rdfs:label>
        <skos:altLabel xml:lang="en">trade services, commerce transactions, commercial sector, commerce industry, market sector, trade industry, trading sector, trading industry, commerce activities</skos:altLabel>
        <cpr:P20 xml:lang="en">mqmq7qz7</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1047"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1590"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q847"/>
        <cpr:P7 xml:lang="en">The wholesale and retail trade sector includes the resale of goods without transformation and related services. Wholesale involves resale to businesses and agents, with activities like sorting and storage. Retailing focuses on selling goods to the public through various channels. This sector also includes transit trade and vending machine sales but excludes digital products and utility trade.</cpr:P7>
        <cpr:P9 xml:lang="en">electricity retail</cpr:P9>
        <cpr:P9 xml:lang="en">energy retail</cpr:P9>
        <cpr:P9 xml:lang="en">retail electricity</cpr:P9>
        <cpr:P9 xml:lang="en">retail energy</cpr:P9>
        <schema:description xml:lang="en">This sector involves the wholesale and retail selling of goods.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q766 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q766">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">transportation and logistics sector</rdfs:label>
        <skos:altLabel xml:lang="en">mobility sector, transport sector, transportation, transit system, transport service, transportation service, transport system, transport services, transport systems, mobility system, mobility systems, transit systems, transport and logistics sector</skos:altLabel>
        <cpr:P20 xml:lang="en">auwqx2qx</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1572"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P7 xml:lang="en">The transportation and storage sector includes passenger and freight transport by rail, pipeline, road, water, or air. It covers rental of transport equipment with drivers, postal and courier activities, terminal operations, cargo handling, and storage. Intermediation services linking customers to transport providers are included, but major repair of transport equipment is excluded.</cpr:P7>
        <cpr:P9 xml:lang="en">human mobility</cpr:P9>
        <schema:description xml:lang="en">This sector involves activities to move goods and people, alongside the storage of products.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q767 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q767">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">hospitality sector</rdfs:label>
        <skos:altLabel xml:lang="en">hospitality industry, hospitality, hospitality service</skos:altLabel>
        <cpr:P20 xml:lang="en">dfk2cka7</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1307"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q370"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q415"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q419"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q432"/>
        <cpr:P7 xml:lang="en">This sector includes the provision of short-term (less than one year) accommodation in buildings, camping grounds and recreational vehicle parks for visitors and other travelers and the provision of meals and drinks fit for immediate consumption. This section excludes food preparation through manufacturing, or resale through wholesale or retail trade activities.</cpr:P7>
        <schema:description xml:lang="en">Activities that provide lodging, food, and entertainment services to guests, including hotels, restaurants, and resorts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q768 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q768">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">media sector</rdfs:label>
        <skos:altLabel xml:lang="en">communication sector, media industry, journalism, electronic media, media coverage, communications industry, communications sector, content creation industry, information industry, social media sector, communication industry</skos:altLabel>
        <cpr:P20 xml:lang="en">pgqzewd7</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1676"/>
        <cpr:P7 xml:lang="en">The sector includes production, publishing, broadcasting, and distribution of information products. It covers book, newspaper, software publishing, motion picture, video, TV production, sound recording, music publishing, and radio and TV broadcasting. This includes streaming, online gaming, and social media platforms. Publishing involves acquiring copyrights and distributing content.</cpr:P7>
        <schema:description xml:lang="en">This sector creates and distributes information and entertainment through television, radio, print, and digital platforms.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q769 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q769">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">information communication technology sector</rdfs:label>
        <skos:altLabel xml:lang="en">ICT, telecommunications, telematic, telematics, cyber, information communication technology, information technology, software, information and communication technology, information, communication technology, information and communication technologies, computer programming, ict, icts, digital economies, digital technologies, digitalisation, compute, computer cluster, computing cluster, cybersecurity, digital technology, GPU, Graphics Processing Unit, IT services, ICT sector, digital transition, digitalization</skos:altLabel>
        <cpr:P20 xml:lang="en">bjgn2n7c</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1286"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1578"/>
        <cpr:P7 xml:lang="en">The sector includes telecommunications services (voice, data, text, sound, video), computer programming, consultancy, computing infrastructure, data processing, hosting, and other information services. Excluded are activities related to publishing, broadcasting, content production, financial and insurance tech, gambling sites, and repair of computers and communications equipment.</cpr:P7>
        <schema:description xml:lang="en">This sector provides communication services, software development, and IT solutions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q77 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q77">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
        <rdfs:label xml:lang="en">elevated buildings</rdfs:label>
        <skos:altLabel xml:lang="en">elevated building, elevated home, elevated homes, elevated house, elevated houses, elevated housing, raised building, raised home, raised homes, raised house, raised houses</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q382"/>
        <cpr:P4 rdf:resource="https://2030palette.org/elevated-structures/"/>
        <schema:description xml:lang="en">An elevated building, with regards to flooding, is a building that is raised on columns (or stilts) so that the floor level is higher than the potential level of the flood water.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q772 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q772">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">recreation sector</rdfs:label>
        <skos:altLabel xml:lang="en">recreational sector</skos:altLabel>
        <cpr:P7 xml:lang="en">Diverse cultural, sports, and recreational activities catering to varied interests, from live performances to heritage site management and gambling. Sports associations, though often non-profit, are justified by promoting sports. Ancillary activities like education and advertising support the primary purpose of sports promotion. Services facilitating entertainment events are included.</cpr:P7>
        <schema:description xml:lang="en">Arts involve visual and performing expressions like painting and theater. Sports focus on physical competition and teamwork. Recreation includes activities for enjoyment and relaxation such as hiking or gaming.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q774 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q774">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">education sector</rdfs:label>
        <skos:altLabel xml:lang="en">education, educational, teaching, academic sector, educational service, educational system, knowledge sector</skos:altLabel>
        <cpr:P20 xml:lang="en">5yw5ubwr</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1022"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1109"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1116"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1117"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1570"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q47"/>
        <cpr:P7 xml:lang="en">Education delivered through various mediums including radio, TV, internet and correspondence. Includes formal initial education within regular school systems, adult education, and specialized education for disabled people and activities provided by military and prison schools. Covers public and private education, formal and non-formal education and coordinating sports programs.</cpr:P7>
        <schema:description xml:lang="en">This sector involves activities that impart knowledge and skills to individuals, including formal schooling, vocational training and educational support.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q775 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q775">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">public sector</rdfs:label>
        <skos:altLabel xml:lang="en">civil service, government services, public service, public services, state sector</skos:altLabel>
        <cpr:P20 xml:lang="en">tphrygrm</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1334"/>
        <cpr:P7 xml:lang="en">Encompasses governmental activities such as law enactment, taxation, national defense, and public order administration. It includes activities irrespective of legal status if they align with governmental functions, like immigration services, foreign affairs, and social security. Activities not explicitly governmental, like teaching or healthcare in specific contexts, are classified elsewhere.</cpr:P7>
        <schema:description xml:lang="en">Activities of government agencies and institutions that provide public services, enforce laws and manage public resources.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q776 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q776">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q777"/>
        <rdfs:label xml:lang="en">administrative and support service activities</rdfs:label>
        <skos:altLabel xml:lang="en">facility management, operational efficiency, office support, administrative assistance, administrative assistance service, administrative service, business support service, management service, office support activities, office support activity, corporate support service</skos:altLabel>
        <cpr:P7 xml:lang="en">This section includes a variety of activities that support general business operations. These activities differ from those in section N, since their primary purpose is not the transfer of specialised knowledge.</cpr:P7>
        <schema:description xml:lang="en">A wide array of tasks supporting businesses and organizations. These activities include office administration, facility management, and outsourced services such as cleaning and security, optimizing operational efficiency and enabling core functions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q777 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q777">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">professional services sector</rdfs:label>
        <skos:altLabel xml:lang="en">consultancy, professional services, consultancies, business development services, consultant sector, auditor service</skos:altLabel>
        <cpr:P20 xml:lang="en">8fj9pk8h</cpr:P20>
        <cpr:P7 xml:lang="en">This section includes specialised professional, scientific and technical activities. These activities require a high degree of training, and make specialised knowledge and skills available to users.</cpr:P7>
        <schema:description xml:lang="en">This sector includes firms and individuals offering specialised expertise in fields such as law, accounting, consulting, science and engineering.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q778 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q778">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">real estate sector</rdfs:label>
        <skos:altLabel xml:lang="en">property business, property industry, property market, property sector</skos:altLabel>
        <cpr:P20 xml:lang="en">bgrd72hx</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P7 xml:lang="en">Encompasses property-related activities such as ownership, rental, buying, selling, and development. It includes entities like real estate investment firms, agents, brokers, and development companies. These activities may involve various real estate services and construction projects, whether on owned or leased property, and can be fee-based or contractual.</cpr:P7>
        <schema:description xml:lang="en">Activities involving the management, development, and sale of property assets.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q779 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q779">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">finance and insurance sector</rdfs:label>
        <skos:altLabel xml:lang="en">finance industry, finance services, financial industry, financial sector, financial services, financing service, financing services, financial market, financial markets, financial service, financing, financing funds, sustainable finance, finance development, finance sector, investment sector, financed</skos:altLabel>
        <cpr:P20 xml:lang="en">y5d5v37k</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1337"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1342"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1343"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q372"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q374"/>
        <cpr:P7 xml:lang="en">Covers financial services, insurance activities, and related support services, regardless of the technology employed. It includes funding acquisition, insurance underwriting, and specialized services supporting financial and insurance activities. Additionally, it encompasses asset holding activities, including those of holding companies, trusts, funds, reinsurance, and pension funds.</cpr:P7>
        <schema:description xml:lang="en">Activities of businesses and institutions that provide financial services and products to individuals and organisations.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q78 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q78">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1990"/>
        <rdfs:label xml:lang="en">hydrological modelling</rdfs:label>
        <skos:altLabel xml:lang="en">hydrological model, hydrological modelling</skos:altLabel>
        <cpr:P4 rdf:resource="https://geoscienceletters.springeropen.com/articles/10.1186/s40562-018-0113-z"/>
        <cpr:P4 rdf:resource="https://www.geo.fu-berlin.de/en/v/iwrm/Implementation/tools/Models/Hydrological-models/index.html"/>
        <schema:description xml:lang="en">A hydrologic model is a simplification of a real-world system (e.g., surface water, soil water, wetland, groundwater, estuary) that aids in understanding, predicting, and managing water resources. Both the flow and quality of water are commonly studied using hydrologic models.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q780 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q780">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1821"/>
        <rdfs:label xml:lang="en">lignite</rdfs:label>
        <skos:altLabel xml:lang="en">brown coal</skos:altLabel>
        <schema:description xml:lang="en">Lignite is brown in colour, and the lowest quality of coal with a carbon content ranging from 65-70%. Lignite is the most hazardous to one&apos;s health, and almost solely utilised to generate electricity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q781 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q781">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1821"/>
        <rdfs:label xml:lang="en">sub-bituminous coal</rdfs:label>
        <skos:altLabel xml:lang="en">sub-bituminous, black lignite</skos:altLabel>
        <schema:description xml:lang="en">Sub-bituminous coal ranges from hard to soft as intermediate stage between lignite and bituminous coal, with a carbon content varying from 70-76%.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q782 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q782">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1819"/>
        <rdfs:label xml:lang="en">bituminous coal</rdfs:label>
        <skos:altLabel xml:lang="en">bituminous</skos:altLabel>
        <cpr:P9 xml:lang="en">bitumen</cpr:P9>
        <cpr:P9 xml:lang="en">bituminous pavement</cpr:P9>
        <cpr:P9 xml:lang="en">bituminous pavements</cpr:P9>
        <cpr:P9 xml:lang="en">bituminous products</cpr:P9>
        <cpr:P9 xml:lang="en">paved bituminous</cpr:P9>
        <schema:description xml:lang="en">Bituminous is considered the second highest quality of coal, with a carbon content ranging from 76-86%. It is principally utilised as a fuel in the production of coke and in the manufacture of steam-electric power.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q783 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q783">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1819"/>
        <rdfs:label xml:lang="en">anthracite</rdfs:label>
        <skos:altLabel xml:lang="en">dark black coal, hard coal</skos:altLabel>
        <schema:description xml:lang="en">Anthracite is the highest quality coal with a carbon content of nearly 95%. It is very hard, with a low moisture content and is one of the cleanest types of coal to burn.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q786 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q786">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q709"/>
        <rdfs:label xml:lang="en">agriculture sector</rdfs:label>
        <skos:altLabel xml:lang="en">agri-business, agriculture, farming, agricultural practices, farming systems, agriculture industry, agroforestry sector, agronomy industry, arable agriculture sector, agrarian sector, agricultural industry, agronomy sector, farming sector</skos:altLabel>
        <cpr:P20 xml:lang="en">e8kmyvfc</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1012"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1020"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1033"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1070"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1088"/>
