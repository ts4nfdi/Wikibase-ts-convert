        <skos:altLabel xml:lang="en">environment liability policy</skos:altLabel>
        <skos:altLabel xml:lang="en">environmental liabilities</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q729"/>
        <cpr:P7 xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities. It&apos;s based on the &quot;polluter pays&quot; principle, which means that those who cause environmental damage are financially responsible for it.</cpr:P7>
        <schema:description xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1419 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1419">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1288"/>
        <rdfs:label xml:lang="en">ecolabelling</rdfs:label>
        <skos:altLabel xml:lang="en">eco label</skos:altLabel>
        <skos:altLabel xml:lang="en">eco labelling</skos:altLabel>
        <skos:altLabel xml:lang="en">eco-label</skos:altLabel>
        <skos:altLabel xml:lang="en">eco-labelling</skos:altLabel>
        <skos:altLabel xml:lang="en">ecolabel</skos:altLabel>
        <skos:altLabel xml:lang="en">ecolabelling</skos:altLabel>
        <cpr:P4 rdf:resource="https://globalecolabelling.net/about/what-is-ecolabelling/"/>
        <cpr:P7 xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</cpr:P7>
        <schema:description xml:lang="en">Ecolabelling is a voluntary method of environmental performance certification and labelling that is practised around the world. An ecolabel identifies products or services proven to be environmentally preferable within a specific category.</schema:description>
    </owl:Class>
    


