        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q738"/>
        <schema:description xml:lang="en">Hydraulic fracturing is a technique used to enable the extraction of natural gas or oil from shale and other forms of “tight” rock.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q647 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q647">
