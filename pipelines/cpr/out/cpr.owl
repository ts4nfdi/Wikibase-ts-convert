    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2795">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2801"/>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2797 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2797">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1867"/>
        <rdfs:label xml:lang="en">genetically modified rice</rdfs:label>
        <skos:altLabel xml:lang="en">GM rice</skos:altLabel>
        <skos:altLabel xml:lang="en">GMO crops in rice cultivation</skos:altLabel>
        <skos:altLabel xml:lang="en">GMO rice</skos:altLabel>
        <skos:altLabel xml:lang="en">gene edited rice</skos:altLabel>
        <skos:altLabel xml:lang="en">gene-edited rice</skos:altLabel>
        <skos:altLabel xml:lang="en">genetically engineered rice</skos:altLabel>
        <skos:altLabel xml:lang="en">low methane rice</skos:altLabel>
        <skos:altLabel xml:lang="en">low-emission rice</skos:altLabel>
        <skos:altLabel xml:lang="en">low-emissions rice</skos:altLabel>
        <skos:altLabel xml:lang="en">low-methane rice</skos:altLabel>
        <skos:altLabel xml:lang="en">methane mitigating rice strains</skos:altLabel>
        <skos:altLabel xml:lang="en">methane mitigating rice varieties</skos:altLabel>
        <cpr:P7 xml:lang="en">Modifying rice genetics to mitigate methane emissions while ensuring yields in extreme weather conditions. Developing low-emissions varieties of rice and growing rice with fewer stomata, tiny openings used for gas exchange, are example of genetic modifications resulting in lower methane emissions and better performance in exceptionally hot or wet conditions.</cpr:P7>
        <schema:description xml:lang="en">Modifying rice genetics to mitigate methane emissions while ensuring yields in extreme weather conditions.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2798 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2798">
