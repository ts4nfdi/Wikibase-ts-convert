    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1753 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1753">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q58"/>
        <rdfs:label xml:lang="en">involving civil society</rdfs:label>
        <skos:altLabel xml:lang="en">civil society engagement</skos:altLabel>
        <skos:altLabel xml:lang="en">community engagement</skos:altLabel>
        <skos:altLabel xml:lang="en">empowering civil society</skos:altLabel>
