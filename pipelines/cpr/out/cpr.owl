    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1280">
        <rdfs:label xml:lang="en">tradable permit</rdfs:label>
        <skos:altLabel xml:lang="en">tradable permits, tradable certificate, tradable certificates, tradable credit, tradable credits</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1336"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1372"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1373"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1374"/>
