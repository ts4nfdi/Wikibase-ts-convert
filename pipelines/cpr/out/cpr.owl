        <rdfs:label xml:lang="en">securing land tenure</rdfs:label>
        <skos:altLabel xml:lang="en">better access to land, better land ownership, better land rights, better land tenure, better ownership of land, fair access to land, fair land ownership, fair land rights, fair land tenure, fair ownership of land, improved access to land, improved land ownership, improved land rights, improved land tenure, improved ownership of land, improving access to land, improving land ownership, improving land rights, improving land tenure, improving ownership of land, increased access to land, increased land ownership, increased land rights, increased land tenure, increased ownership of land, protecting access to land, protecting land ownership, protecting land rights, protecting land tenure, protecting ownership of land, reforming access to land, reforming land ownership, reforming land rights, reforming land tenure, reforming ownership of land, secure access to land, secure land ownership, secure land rights, secure land tenure, secure ownership of land, securing access to land, securing land ownership, securing land rights, securing ownership of land, land tenure reform, reform land tenure</skos:altLabel>
        <schema:description xml:lang="en">Actions to protect land rights and ownership.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1964 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1964">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <rdfs:label xml:lang="en">gender-sensitive adaptation</rdfs:label>
        <skos:altLabel xml:lang="en">gender-sensitive adaptation, adaptive capacity of women, gender sensitive adaptation, women&apos;s resilience, adaptive capacity of girls, resilience of girls, resilience of women</skos:altLabel>
        <cpr:P7 xml:lang="en">Gender-sensitive approaches and tools for understanding and assessing impacts, vulnerability and adaptation to climate change refer to methodologies and practices applied to ensure that both men’s and women’s concerns, aspirations, opportunities and capacities are taken into account. Women are disproportionately affected by climate change, owing in particular to unequal access to resources and decision-making.</cpr:P7>
        <schema:description xml:lang="en">Practices applied to ensure that both men’s and women’s concerns, aspirations, opportunities and capacities related to climate change adaptation are taken into account.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1965 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1965">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1927"/>
        <rdfs:label xml:lang="en">cool space</rdfs:label>
        <skos:altLabel xml:lang="en">cool spaces, cool place, cool places, cool shelters, climate shelter, climate shelters, heat shelter, heat shelters, cooling shelters, public cooling centers, public cooling center</skos:altLabel>
        <cpr:P7 xml:lang="en">Indoor public spaces for people to shelter from the sun, cool down, rest and take respite on hot days. They help reduce health risks from hot weather.</cpr:P7>
        <schema:description xml:lang="en">Indoor public spaces for people to shelter from the sun, cool down, rest and take respite on hot days.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1966 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1966">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:label xml:lang="en">cool pavement</rdfs:label>
        <skos:altLabel xml:lang="en">cool pavements, reflective pavement, reflective pavements, white pavement, white pavements</skos:altLabel>
        <cpr:P7 xml:lang="en">Cool pavements are reflective/permeable pavements that help lower surface temperatures and reduce the amount of heat absorbed into the pavement. Pavement reflectance can be enhanced by using reflective aggregate, reflective or clearbinder or reflective surface coating.</cpr:P7>
        <schema:description xml:lang="en">Cool pavements are reflective/permeable pavements that help lower surface temperatures and reduce the amount of heat absorbed into the pavement.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1967 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1967">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1955"/>
        <rdfs:label xml:lang="en">culvert</rdfs:label>
        <skos:altLabel xml:lang="en">culverts</skos:altLabel>
        <schema:description xml:lang="en">A covered channel or large pipe to convey water, or a water course, below ground level.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1968 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1968">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:label xml:lang="en">resilient energy infrastructure</rdfs:label>
        <skos:altLabel xml:lang="en">diversify energy supply, diversify power supply, energy infrastructure adaptation, resilience of energy supply, resilience of power supply, resilient energy, protect power lines, protected power lines, protecting power lines, resilient distribution, resilient electricity transmission, resilient power lines, resilient power transmission</skos:altLabel>
        <schema:description xml:lang="en">Designing energy infrastructure, including power lines and energy transmission, to adapt and be resilient to climate change impacts.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1969 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1969">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1834"/>
        <rdfs:label xml:lang="en">improving water supply infrastructure</rdfs:label>
        <skos:altLabel xml:lang="en">improving water supply, rehabilitating water supply, upgrading water supply</skos:altLabel>
        <schema:description xml:lang="en">Actions to increase the resilience of water supply infrastructure (e.g. dams, reservoirs, water distribution pipes) to the impacts of climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1970 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1970">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1873"/>
        <rdfs:label xml:lang="en">resilient food storage</rdfs:label>
        <skos:altLabel xml:lang="en">adapting cold food storage, resilient cold food storage</skos:altLabel>
        <schema:description xml:lang="en">Methods and systems to maintain food in good condition and protected from the impacts of climate change until it is needed, including refrigeration and cold food storage.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1972 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1972">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1840"/>
        <rdfs:label xml:lang="en">passive cooling</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical cooling</skos:altLabel>
        <cpr:P7 xml:lang="en">Passive cooling refers to a set of design principles and techniques that utilise natural processes to help maintain comfortable indoor temperatures without the need for active, energy consuming, mechanical systems, such as electrically powered air conditioning units.</cpr:P7>
        <schema:description xml:lang="en">Passive cooling refers to a set of design principles and techniques that utilise natural processes to help maintain comfortable indoor temperatures without the need for active, energy consuming, mechanical systems, such as electrically powered air conditioning units.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1973 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1973">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1994"/>
        <rdfs:label xml:lang="en">controlling overfishing</rdfs:label>
        <skos:altLabel xml:lang="en">reducing overfishing, control overfishing, fishing quota, fishing quotas, reduced overfishing, address overfishing, avoid overfishing, avoiding overfishing, end overfishing, ending overfishing, overfishing is avoided, prevent overfishing, preventing overfishing, reduce overfishing, catch limits, catch quota, catch quotas, fishing limits, limit overfishing, avoid bycatch, bycatch reduction, reduce bycatch, reducing bycatch, reduction of bycatch, reduction of overfishing</skos:altLabel>
        <schema:description xml:lang="en">Actions to ensure that fishing does not deplete fish stocks to unsustainable levels.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1974 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1974">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <rdfs:label xml:lang="en">assisted migration</rdfs:label>
        <skos:altLabel xml:lang="en">species translocation, translocation of species, assisted conservation translocation, assisted tree migration, species relocation, managed translocation</skos:altLabel>
        <cpr:P7 xml:lang="en">The human assisted movement of representatives of a species or population to more climatically-suitable areas within or outside of their current species range to help species respond to climate change.</cpr:P7>
