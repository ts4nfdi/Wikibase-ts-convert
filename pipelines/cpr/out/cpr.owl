    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q170 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q170">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1635"/>
        <rdfs:label xml:lang="en">water reservoir</rdfs:label>
        <skos:altLabel xml:lang="en">reservoir of water, water reservoirs, reservoir, reservoirs</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.sciencedirect.com/science/article/abs/pii/S0167564808706294"/>
        <cpr:P7 xml:lang="en">Surface reservoirs are built structures for water storage that help improve water security for local communities. The types and sizes of reservoirs vary, from damming natural water bodies for storage to ground excavation in low-lying plains fed either by rainwater or diverted rivers. Stored water can be used for numerous purposes, including irrigation, industry, domestic use, hydropower generation and flood control. Surface reservoirs are particularly important in regions with lengthy dry seasons and high rainfall variability, as well as areas where seasonal water availability is predicted to increase as a result of a changing climate. Surface reservoirs are therefore one of the most important adaptation technologies in regions with limited and varying water availability.</cpr:P7>
        <cpr:P9 xml:lang="en">GHG reservoir</cpr:P9>
        <cpr:P9 xml:lang="en">GHG reservoirs</cpr:P9>
        <cpr:P9 xml:lang="en">carbon reservoir</cpr:P9>
        <cpr:P9 xml:lang="en">carbon reservoirs</cpr:P9>
        <cpr:P9 xml:lang="en">gas reservoir</cpr:P9>
        <cpr:P9 xml:lang="en">gas reservoirs</cpr:P9>
        <cpr:P9 xml:lang="en">greenhouse gas reservoir</cpr:P9>
        <cpr:P9 xml:lang="en">greenhouse gas reservoirs</cpr:P9>
        <cpr:P9 xml:lang="en">oil reservoir</cpr:P9>
        <cpr:P9 xml:lang="en">oil reservoirs</cpr:P9>
        <cpr:P9 xml:lang="en">reservoir of greenhouse gases</cpr:P9>
        <cpr:P9 xml:lang="en">reservoirs of greenhouse gases</cpr:P9>
        <cpr:P9 xml:lang="en">sequestration reservoirs</cpr:P9>
        <schema:description xml:lang="en">A water reservoir is an enclosed area for the storage of water to be used at a later date. Reservoirs are an important feature of many water supply systems around the world.</schema:description>
    </owl:Class>
    


