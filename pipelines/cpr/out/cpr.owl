        <skos:altLabel xml:lang="en">diversified farming, integrated farming, mixed agriculture</skos:altLabel>
        <schema:description xml:lang="en">Mixed farming combines crop and animal production on the same farm.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1623 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1623">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <rdfs:label xml:lang="en">sustainable agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">eco-agriculture, environmental friendly agriculture, regenerative agriculture, responsible farming, sustainable farming</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2574"/>
        <schema:description xml:lang="en">Farming that meets the needs of existing and future generations, while also ensuring profitability, environmental health and social and economic equity.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1624 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1624">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1623"/>
        <rdfs:label xml:lang="en">climate smart agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">climate-smart agriculture, climate smart farming, climate-smart agricultural, climate-smart farm, climate-smart farmers, climate-smart farms, climate-smart farmer, CSA, climate-smart horticultural, climate-smart horticulture</skos:altLabel>
        <cpr:P7 xml:lang="en">Approach that sustainably increases agricultural productivity and incomes, adapts and builds resilience to climate change, and reduces greenhouse gas emissions where possible. CSA systematically considers the synergies and tradeoffs that exist between productivity, adaptation, and mitigation. It encompasses a range of practices and technologies that are tailored to specific agro-ecological conditions and socio-economic contexts including the adoption of climate-resilient crop varieties, conservation agriculture techniques, agroforestry, precision farming, water management strategies, and improved livestock management.</cpr:P7>
        <schema:description xml:lang="en">Approach that sustainably increases agricultural productivity and incomes, adapts and builds resilience to climate change, and reduces greenhouse gas emissions where possible</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1625 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1625">
