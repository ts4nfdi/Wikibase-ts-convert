    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q737 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q737">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q650"/>
