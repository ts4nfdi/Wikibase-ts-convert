        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <cpr:P7 xml:lang="en">Actions or measures to adapt terrestrial systems to climate change, including agriculture, forestry, and land-based ecosystems.</cpr:P7>
    </rdf:Description>
