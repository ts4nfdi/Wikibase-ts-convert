        <skos:altLabel xml:lang="en">citizens assemblies</skos:altLabel>
        <skos:altLabel xml:lang="en">citizens assembly</skos:altLabel>
        <skos:altLabel xml:lang="en">citizens juries</skos:altLabel>
        <skos:altLabel xml:lang="en">citizens jury</skos:altLabel>
        <skos:altLabel xml:lang="en">citizens&apos; assemblies</skos:altLabel>
