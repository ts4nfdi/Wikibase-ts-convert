    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q147 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q147">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1613"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1860"/>
        <rdfs:label xml:lang="en">crop diversification and new varieties</rdfs:label>
        <skos:altLabel xml:lang="en">crop diversification, diversification of crop, new crop varieties, resilient crop varieties, resistant crop varieties, climate smart crops, climate-smart crops, mixed cropping, improved cultivars, stress-tolerant crop, stress-tolerant crops, crop diversity, crop portfolio diversification, crop species diversification, diversification of cropping, diversification of crops, diversified crop, diversified cropping, multi-crop, multi-cropping, multiple cropping, diversified crops, diversify crop, diversify crops, mixed crop, mixed crops</skos:altLabel>
        <cpr:P7 xml:lang="en">Crop diversification refers to the practice of growing a variety of different crops on the same agricultural land, rather than focusing on a single crop. This strategy is used to reduce the risks associated with farming, such as those caused by pests, diseases, or unpredictable weather patterns. It also helps improve soil health, increase biodiversity, and provide a more stable income for farmers.</cpr:P7>
        <schema:description xml:lang="en">Crop diversification refers to the practice of growing a variety of different crops on the same agricultural land, rather than focusing on a single crop. This strategy is used to reduce the risks associated with farming, such as those caused by pests, diseases, or unpredictable weather patterns. It also helps improve soil health, increase biodiversity, and provide a more stable income for farmers.</schema:description>
    </owl:Class>
    


