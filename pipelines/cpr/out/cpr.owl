        <skos:altLabel xml:lang="en">resilient WaSH, resilient water sanitation, WaSH adaptation, WASH adaptation, adaptive WASH, resilience in the WASH, resilience in the water, sanitation and hygiene, access to clean water, access to sanitation, resilient sanitation, wash-related adaptation, expand  access to sanitation, expanded access to sanitation, expanding access to sanitation, improve access to sanitation, improved access to sanitation, improving access to sanitation, increase access to sanitation, increased access to sanitation, increasing access to sanitation, improved sanitation, improved hygiene, resilient hygiene, improve hygiene, improving hygiene</skos:altLabel>
        <schema:description xml:lang="en">Actions to increase the resilience of water, sanitation and hygiene to the impacts of climate change.</schema:description>
    </owl:Class>
    


