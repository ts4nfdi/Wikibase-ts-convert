        <skos:altLabel xml:lang="en">river dikes, canal dike, river dyke, spur dike, wing dam, wing dams</skos:altLabel>
        <schema:description xml:lang="en">A river dike is a structure made of earth or stone that&apos;s used to hold back river water.</schema:description>
    </owl:Class>
    


