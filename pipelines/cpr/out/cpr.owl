    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1879 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1879">
        <rdfs:label xml:lang="en">water savings requirement in building codes</rdfs:label>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1395"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1634"/>
        <cpr:P7 xml:lang="en">Water savings (or water efficiency) requirements in building codes is a legislative approach to improve efficiency in commercial and residential buildings. The building codes may require installation of modern  technologies such as water pressure control, faucet aerators, leak detectors, water-saving toilets, etc. to maximize use efficiency, but can also require installation of internal water recycling systems or the establishment of infrastructure to provide alternative water sources, for example rainwater harvesting tanks. Water saving requirements are mostly applied to newly constructed buildings, but they may also by applied in existing buildings in the form of  a retrofit of existing facilities.</cpr:P7>
        <schema:description xml:lang="en">Water savings (or water efficiency) requirements in building codes is a legislative approach to improve efficiency in commercial and residential buildings.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1928 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1928">
        <rdfs:label xml:lang="en">heatwave surveillance</rdfs:label>
        <skos:altLabel xml:lang="en">surveillance of heatwaves, surveillance for heat-related health impacts, monitoring heat impacts on health</skos:altLabel>
