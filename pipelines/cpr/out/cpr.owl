    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q18 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q18">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <rdfs:label xml:lang="en">REDD+</rdfs:label>
        <skos:altLabel xml:lang="en">redd+</skos:altLabel>
        <skos:altLabel xml:lang="en">reducing emissions from deforestation and forest degradation in developing countries</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q16"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q17"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q19"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q4"/>
        <schema:description xml:lang="en">Reducing emissions from deforestation and forest degradation in developing countries, the ‘+’ includes additional forest-related activities that protect the climate, e.g. sustainable management of forests, or forest carbon stocks</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q180 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q180">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1968"/>
        <rdfs:label xml:lang="en">decentralised energy transmission</rdfs:label>
        <skos:altLabel xml:lang="en">decentralised energy transmission</skos:altLabel>
        <skos:altLabel xml:lang="en">decentralized energy transmission</skos:altLabel>
        <cpr:P4 rdf:resource="https://www.unescap.org/sites/default/files/14.%20FS-Decentralized-energy-system.pdf"/>
        <schema:description xml:lang="en">Decentralised energy systems aim to place power generation closer to the consumers. Since end users are distributed across a region, generating energy in a decentralised way can help minimise transmission and distribution losses, along with their associated economic and environmental costs.</schema:description>
    </owl:Class>
    


