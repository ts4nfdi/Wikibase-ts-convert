        <cpr:P7 xml:lang="en">A tax reduction is a tax incentive where the government reduces taxes for selected activities, goods or actors. Example: A lower VAT rate for renewable energy equipment.</cpr:P7>
        <schema:description xml:lang="en">A tax reduction is a tax incentive where the government reduces taxes for selected activities, goods or actors. Example: A lower VAT rate for renewable energy equipment.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1610 -->


