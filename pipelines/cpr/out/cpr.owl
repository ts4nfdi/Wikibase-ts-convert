    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1624 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1624">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1623"/>
        <rdfs:label xml:lang="en">climate smart agriculture</rdfs:label>
        <skos:altLabel xml:lang="en">CSA</skos:altLabel>
        <skos:altLabel xml:lang="en">climate smart farming</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart agricultural</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart agriculture</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart farm</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart farmer</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart farmers</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart farms</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart horticultural</skos:altLabel>
        <skos:altLabel xml:lang="en">climate-smart horticulture</skos:altLabel>
        <cpr:P7 xml:lang="en">Approach that sustainably increases agricultural productivity and incomes, adapts and builds resilience to climate change, and reduces greenhouse gas emissions where possible. CSA systematically considers the synergies and tradeoffs that exist between productivity, adaptation, and mitigation. It encompasses a range of practices and technologies that are tailored to specific agro-ecological conditions and socio-economic contexts including the adoption of climate-resilient crop varieties, conservation agriculture techniques, agroforestry, precision farming, water management strategies, and improved livestock management.</cpr:P7>
        <schema:description xml:lang="en">Approach that sustainably increases agricultural productivity and incomes, adapts and builds resilience to climate change, and reduces greenhouse gas emissions where possible</schema:description>
    </owl:Class>
    


