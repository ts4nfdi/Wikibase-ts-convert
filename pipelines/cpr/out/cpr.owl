        <schema:description xml:lang="en">Any compulsory, unrequited payment to the government levied on corporations or individuals. This can be for environmental reasons, such as introducing a Carbon tax to set a price that emitters must pay for the greenhouse gases they emit.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q716 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q716">
        <rdfs:label xml:lang="en">carbon tax</rdfs:label>
        <skos:altLabel xml:lang="en">taxes on green house gases, carbon taxation, carbon taxes, taxation on carbon, taxes on carbon, taxes on GHG, taxes on greenhouse gases, carbon dioxide tax, carbon dioxide taxes, tax on GHG, CO2 tax, CO2 taxes</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q725"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q728"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1299"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1556"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q221"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q723"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q724"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q729"/>
        <cpr:P7 xml:lang="en">A carbon tax requires emitters to pay a fee for each ton of greenhouse gas emissions they produce. This tax incentivises businesses and consumers to reduce emissions by switching to cleaner fuels or adopting low-carbon technologies. Unlike an emissions trading scheme, a carbon tax provides certainty on carbon pricing but does not guarantee specific emission reduction levels.</cpr:P7>
        <schema:description xml:lang="en">A carbon tax charges emitters per ton of greenhouse gas emissions, creating an economy-wide price signal that incentivises emission reductions. It offers price certainty but no fixed reduction target.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q717 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q717">
        <rdfs:label xml:lang="en">energy tax</rdfs:label>
        <skos:altLabel xml:lang="en">energy taxation, energy taxes, tax on energy, taxation on energy, taxes on energy</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1300"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1556"/>
        <cpr:P7 xml:lang="en">Taxes on energy products for both transport and stationary purposes, which includes vehicle fuels and fuel for transport such as petrol and diesel. Carbon taxes are included under energy tax.</cpr:P7>
        <schema:description xml:lang="en">Taxes on energy products (including vehicle fuels/fuel for transport)</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q718 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q718">
        <rdfs:label xml:lang="en">transport tax</rdfs:label>
        <skos:altLabel xml:lang="en">taxes on transport, tax on transport, transport taxes, mobility tax, mobility taxes, road tax</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P7 xml:lang="en">A transport tax (excluding fuel) applies mainly to the ownership and use of vehicles, such as annual road taxes or one-off taxes on vehicle imports or sales. It also includes taxes on other transport equipment, like planes, and services like air passenger duties, provided they meet the definition of environmental taxes. Fuel taxes, however, are classified separately under energy taxes.</cpr:P7>
        <schema:description xml:lang="en">Includes taxes on transport equipment, motor vehicles and transport services (excluding fuel for transport)</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q719 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q719">
        <rdfs:label xml:lang="en">pollution tax</rdfs:label>
        <skos:altLabel xml:lang="en">taxes on pollution, tax on pollution, taxation on pollution, pollution taxes</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1316"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q728"/>
        <cpr:P7 xml:lang="en">Includes taxes on pollution, including measured or estimated emissions to air and water, ozone-depleting substances, certain non-point sources of water pollution, solid waste and noise.</cpr:P7>
        <schema:description xml:lang="en">Includes taxes on pollution, including measured or estimated emissions to air and water, ozone-depleting substances, certain non-point sources of water pollution, solid waste and noise.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q720 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q720">
        <rdfs:label xml:lang="en">resource tax</rdfs:label>
        <skos:altLabel xml:lang="en">resources tax, tax on resources, tax on natural resources, taxes on natural resources</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P7 xml:lang="en">A resource tax is applied to the extraction or use of natural resources, covering areas like water, land, soil, forests, biodiversity, wildlife, fish stocks, mining, and quarrying. This tax encourages sustainable resource management by creating a cost associated with resource use and depletion, aiming to reduce environmental impact and conserve natural assets.</cpr:P7>
        <schema:description xml:lang="en">Includes taxes on resources, such as management of water, land, soil, forests, biodiversity, wildlife and fish stocks, including mining and quarrying.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q721 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q721">
        <rdfs:label xml:lang="en">environmental taxes</rdfs:label>
        <skos:altLabel xml:lang="en">environmental tax, environmentally related tax, environmentally related taxes, ecological tax, ecological taxes</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q716"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q717"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q718"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q719"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q720"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q728"/>
        <cpr:P7 xml:lang="en">Environmental taxes are compulsory, unrequited payments to the government, levied on tax bases with environmental relevance. As a policy instrument, they increase the costs of a polluting product or activity, encouraging environmental protection by addressing negative impacts or externalities.</cpr:P7>
        <schema:description xml:lang="en">Environmental taxes are defined as any compulsory, unrequited payment to the government levied on tax bases deemed to be of environmental relevance.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q722 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q722">
        <rdfs:label xml:lang="en">economic instrument</rdfs:label>
        <skos:altLabel xml:lang="en">economic instruments, treasury instrument, treasure instruments, pecuniary instrument, pecuniary instruments, pecuniary policy instrument, pecuniary policy instruments</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1272"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1273"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1274"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1275"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1276"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1277"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1280"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1171"/>
        <cpr:P7 xml:lang="en">Economic instruments, or &quot;treasury&quot; in Hood and Margetts&apos; NATO scheme, are tools used to spend or raise money and influence markets, with authority over areas such as taxation and spending. In climate policy, economic instruments are often employed to incentivise behavioural change by introducing subsidies or carbon pricing.</cpr:P7>
        <schema:description xml:lang="en">Economic instruments, or &quot;treasury&quot; in Hood and Margetts&apos; NATO scheme, are instruments that have the power over money, taxation, and spending or influencing markets. Examples are Carbon taxes or cap-and-trade schemes.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q723 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q723">
        <rdfs:label xml:lang="en">Emission Trading System</rdfs:label>
        <skos:altLabel xml:lang="en">cap-and-trade, Cap-and-Trade, carbon trading, Emission Trading Systems, ETS, cap and trade program, cap and trade programme, cap-and-trade program, cap-and-trade programme, cap-and-trade schemes, emission trading, emissions trading, cap and trade, emission allowance trading system, emission allowance trading, emissions cap, emissions allowance trading, emissions allowance trading system, tradable ghg emission quota, tradable GHG emission quota, tradable ghg emission quotas, tradable GHG emission quotas, tradable greenhouse gas emission quota, tradable greenhouse gases emission quota, carbon credit, carbon credits, emission allowance, emission permit, emission trading allowance, emission trading allowances, emissions allowance, emissions allowances, emissions permit, emissions trading allowance</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1280"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q725"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q716"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q724"/>
        <cpr:P7 xml:lang="en">An Emissions Trading System (ETS) sets a cap on greenhouse gas emissions. Entities must hold one allowance per tonne of emissions and can trade these allowances. The cap size limits the total allowances, and the carbon price is determined by supply (available units) and demand (total emissions), creating flexibility while controlling overall emissions.</cpr:P7>
        <cpr:P9 xml:lang="en">non ETS</cpr:P9>
        <cpr:P9 xml:lang="en">non-ETS</cpr:P9>
        <cpr:P9 xml:lang="en">non-emissions trading</cpr:P9>
        <schema:description xml:lang="en">A tradable-permit system for greenhouse gas emissions, setting a  limit on the GHG emissions that can be emitted.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q728 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q728">
        <rdfs:label xml:lang="en">Pigouvian tax</rdfs:label>
        <skos:altLabel xml:lang="en">Pigouvian taxes, Pigovian tax, Pigovian taxes</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q716"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q719"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P7 xml:lang="en">The principle of Pigouvian taxes is balancing the harm done by the activity generating the externality with a price charged to the agent undertaking that activity. This means Pigouvian taxes internalise externalities by putting prices on them.</cpr:P7>
        <schema:description xml:lang="en">A tax assessed against businesses and private individuals that engage in activities that create adverse side effects for society (including on the environment)</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q891 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q891">
        <rdfs:label xml:lang="en">training system</rdfs:label>
        <skos:altLabel xml:lang="en">training systems</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1426"/>
        <schema:description xml:lang="en">A training system is a group or family of coursework that will achieve a stated series of training objectives. A training system typically employs a syllabus or similar document that specifies and outlines the coursework to be followed.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q897 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q897">
        <rdfs:label xml:lang="en">peer learning</rdfs:label>
        <skos:altLabel xml:lang="en">learning from peers, peer-to-peer learning</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1426"/>
        <schema:description xml:lang="en">Peer learning is essentially the act of learning with and from your colleagues, fellow students or peers.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q92 -->


