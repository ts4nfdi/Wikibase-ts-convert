        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q148"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q149"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q152"/>
