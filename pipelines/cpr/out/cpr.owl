        <skos:altLabel xml:lang="en">blockchain node hosting</skos:altLabel>
        <skos:altLabel xml:lang="en">decentralised IT infrastructure</skos:altLabel>
        <skos:altLabel xml:lang="en">distributed ledger services</skos:altLabel>
        <skos:altLabel xml:lang="en">smart contract platforms</skos:altLabel>
        <schema:description xml:lang="en">Activities related to the design, implementation, and management of blockchain systems and distributed ledgers</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1711 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1711">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <rdfs:label xml:lang="en">environmental standard</rdfs:label>
        <skos:altLabel xml:lang="en">environmental standards</skos:altLabel>
        <skos:altLabel xml:lang="en">national environmental standard</skos:altLabel>
        <skos:altLabel xml:lang="en">national environmental standards</skos:altLabel>
        <cpr:P7 xml:lang="en">Environmental standards are legal tools used by governments to limit pollution and enforce climate action. They set thresholds for air, water, emissions, and waste, ensuring industries comply. Examples include air quality limits, emissions caps, and energy efficiency rules, promoting sustainability.</cpr:P7>
        <schema:description xml:lang="en">Environmental standards are legal tools used by governments to limit pollution and enforce climate action. They set thresholds for air, water, emissions, and waste, ensuring industries comply. Examples include air quality limits, emissions caps, and energy efficiency rules, promoting sustainability.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1712 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1712">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
