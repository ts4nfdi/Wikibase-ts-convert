        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q829"/>
        <schema:description xml:lang="en">Aviation fuels are petroleum-based fuels, or petroleum and synthetic fuel blends, used to power aircraft. They have more stringent requirements than fuels used for ground use, and contain additives important to fuel performance or handling.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q645 -->


