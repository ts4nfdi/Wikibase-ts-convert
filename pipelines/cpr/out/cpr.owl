        <skos:altLabel xml:lang="en">legal framework for adaptation, adaptation act, climate resilience act, climate resilience law, legal framework for climate resilience, legal provision for adaptation, legal provision for climate resilience</skos:altLabel>
        <schema:description xml:lang="en">Activites related to developing laws and legal frameworks for adapting to climate change.</schema:description>
    </owl:Class>
    


