        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2400"/>
        <cpr:P7 xml:lang="en">A fee is a compulsory, requited payment to the government, levied in proportion to the services provided, such as fees for access to natural parks.</cpr:P7>
        <cpr:P9 xml:lang="en">export fee</cpr:P9>
