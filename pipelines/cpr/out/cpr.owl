        <skos:altLabel xml:lang="en">acpc, acri, african climate policy centre, arab climate resilience initiative, caribbean community climate change centre, ccccc, climate-adapt, european climate adaptation platform, latin american energy organization, nordic council of ministers, olade, pacific islands forum</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q931 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q931">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q756"/>
        <rdfs:label xml:lang="en">activities of international courts and tribunals</rdfs:label>
        <skos:altLabel xml:lang="en">international criminal court, african court on human and peoples, echr, ecj, european court of human rights, european court of justice, icc, icj, inter-american court of human rights, international court, international court of justice, international courts, international tribunal, international tribunal for the law of the sea, international tribunals, itlos</skos:altLabel>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q932 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q932">
