        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2008">
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1832"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2009"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2794"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q557"/>
        <cpr:P20 xml:lang="en">tw8tdwrf</cpr:P20>
        <cpr:P7 xml:lang="en">Actions or measures to adapt freshwater, coastal and marine systems to climate change.</cpr:P7>
    </rdf:Description>
