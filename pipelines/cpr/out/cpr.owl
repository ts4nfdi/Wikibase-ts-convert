        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1470"/>
        <cpr:P7 xml:lang="en">This phase includes the production and manufacturing of plastic products through the refinement of raw materials, which includes the classification of plastic resins.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q91">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1990"/>
