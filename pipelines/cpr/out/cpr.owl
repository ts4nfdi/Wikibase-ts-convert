        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q791"/>
        <schema:description xml:lang="en">Crude oil is unrefined petroleum that comes from natural deposits in the earth. Other types of oil, like motor oil or gasoline, are made from refined crude oil along with other substances.</schema:description>
    </owl:Class>
    


