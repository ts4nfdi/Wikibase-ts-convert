    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1897 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1897">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1839"/>
        <rdfs:label xml:lang="en">national adaptation plan</rdfs:label>
        <skos:altLabel xml:lang="en">country-level adaptation plan, country-level adaptation planning, country-level adaptation plans, national adaptation planning, national adaptation plans, national adaptation strategies, national adaptation strategy, NAPA, NAPAs, national adaptation program, national adaptation programme, national climate resilience plan, national climate resilience planning, national climate resilience program, national resilience plan</skos:altLabel>
        <cpr:P7 xml:lang="en">National plans outlining how a country will adapt to climate change in the medium- and long-term, submitted to the UNFCCC.</cpr:P7>
        <schema:description xml:lang="en">National plans outlining how a country will adapt to climate change in the medium- and long-term, submitted to the UNFCCC.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1898 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1898">
