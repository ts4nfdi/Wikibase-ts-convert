    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2018 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2018">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1883"/>
        <rdfs:label xml:lang="en">borehole</rdfs:label>
        <skos:altLabel xml:lang="en">boreholes, tubewell, tubewells, tube well, tube wells</skos:altLabel>
        <cpr:P7 xml:lang="en">Boreholes and tubewells are important adaptation technology measures for providing a domestic water supply during times of water shortages and drought. They extract freshwater from subsurface or deeper groundwater aquifers.</cpr:P7>
        <schema:description xml:lang="en">Boreholes and tubewells are important adaptation technology measures for providing a domestic water supply during times of water shortages and drought. They extract freshwater from subsurface or deeper groundwater aquifers.</schema:description>
    </owl:Class>
    


