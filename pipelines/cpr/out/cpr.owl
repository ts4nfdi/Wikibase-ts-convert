    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q911 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q911">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">distributive justice</rdfs:label>
        <skos:altLabel xml:lang="en">a fair and just transition</skos:altLabel>
        <skos:altLabel xml:lang="en">balancing needs</skos:altLabel>
        <skos:altLabel xml:lang="en">common but differentiated responsibilities</skos:altLabel>
        <skos:altLabel xml:lang="en">compensation mechanism</skos:altLabel>
        <skos:altLabel xml:lang="en">considering the unequal impacts of climate change</skos:altLabel>
        <skos:altLabel xml:lang="en">equitable access</skos:altLabel>
        <skos:altLabel xml:lang="en">equity</skos:altLabel>
        <skos:altLabel xml:lang="en">fair outcomes</skos:altLabel>
        <skos:altLabel xml:lang="en">fair share</skos:altLabel>
        <skos:altLabel xml:lang="en">increasing access to finance</skos:altLabel>
        <skos:altLabel xml:lang="en">justice</skos:altLabel>
        <skos:altLabel xml:lang="en">most affected people</skos:altLabel>
        <skos:altLabel xml:lang="en">polluter pays</skos:altLabel>
        <skos:altLabel xml:lang="en">progressive policy</skos:altLabel>
        <skos:altLabel xml:lang="en">protecting frontline communities</skos:altLabel>
        <skos:altLabel xml:lang="en">protecting the most vulnerable</skos:altLabel>
        <skos:altLabel xml:lang="en">reparations</skos:altLabel>
        <cpr:P20 xml:lang="en">xaxa59eg</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1165"/>
        <cpr:P7 xml:lang="en">Distributive justice asks &apos;Who gets what?&apos; based on Equity (need/vulnerability), Responsibility (causal), and Reparation (historical). In the context of climate change, nature and development, this means ensuring the fair distribution of risks and opportunities of resource exploitation, climate change and the transition to a regenerative economy, cognisant in particular of disproportionate impacts on vulnerable communities and the working class.</cpr:P7>
        <schema:description xml:lang="en">the fair distribution of risks and opportunities of climate change and the transition to a regenerative economy, cognisant in particular of disproportionate impacts on vulnerable communities and the working class</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q912 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q912">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q32"/>
        <rdfs:label xml:lang="en">procedural justice</rdfs:label>
        <skos:altLabel xml:lang="en">FPIC</skos:altLabel>
        <skos:altLabel xml:lang="en">accountability to impacted people</skos:altLabel>
        <skos:altLabel xml:lang="en">bottom-up</skos:altLabel>
        <skos:altLabel xml:lang="en">bottom-up approach</skos:altLabel>
        <skos:altLabel xml:lang="en">broad stakeholder engagement</skos:altLabel>
        <skos:altLabel xml:lang="en">co-design</skos:altLabel>
        <skos:altLabel xml:lang="en">co-designed</skos:altLabel>
        <skos:altLabel xml:lang="en">co-management</skos:altLabel>
        <skos:altLabel xml:lang="en">community</skos:altLabel>
        <skos:altLabel xml:lang="en">community-led participation</skos:altLabel>
        <skos:altLabel xml:lang="en">consent</skos:altLabel>
        <skos:altLabel xml:lang="en">consultation</skos:altLabel>
        <skos:altLabel xml:lang="en">consultations</skos:altLabel>
        <skos:altLabel xml:lang="en">consulted</skos:altLabel>
        <skos:altLabel xml:lang="en">decision making</skos:altLabel>
        <skos:altLabel xml:lang="en">duty of care</skos:altLabel>
        <skos:altLabel xml:lang="en">empowering affected communities</skos:altLabel>
        <skos:altLabel xml:lang="en">good governance</skos:altLabel>
        <skos:altLabel xml:lang="en">grassroots</skos:altLabel>
        <skos:altLabel xml:lang="en">impartial process</skos:altLabel>
        <skos:altLabel xml:lang="en">including affected communities in decision-making</skos:altLabel>
        <skos:altLabel xml:lang="en">including the most vulnerable</skos:altLabel>
        <skos:altLabel xml:lang="en">inclusive</skos:altLabel>
        <skos:altLabel xml:lang="en">inclusive decision-making</skos:altLabel>
        <skos:altLabel xml:lang="en">independent oversight</skos:altLabel>
        <skos:altLabel xml:lang="en">mainstreaming</skos:altLabel>
        <skos:altLabel xml:lang="en">meaningful participation</skos:altLabel>
        <skos:altLabel xml:lang="en">participatory</skos:altLabel>
        <skos:altLabel xml:lang="en">public participation</skos:altLabel>
        <skos:altLabel xml:lang="en">right to self-determination</skos:altLabel>
        <skos:altLabel xml:lang="en">transparent decision-making</skos:altLabel>
        <cpr:P20 xml:lang="en">trrqcen3</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1165"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1733"/>
        <cpr:P7 xml:lang="en">Nominally, procedural justice is focussed on fair decisions, but in practice, this means changing the structural mechanisms of influence.This sets a high bar:It is defined by four pillars: 1) Voice: Impacted groups have a formal seat at the table and participate actively and meaningfully in decision making. If decisions go wrong, there are accessible, community-specific channels to appeal or seek redress. 2) Respect: Treating all participants with respect and dignity. 3) Neutrality: Decisions are unbiased and guided by unbiased transparent reasoning. 4) Transparency: Decision-making is transparent enough that external groups can audit and challenge the logic behind a choice.These four elements are all necessary and build on each other; though they may not always be mentioned concurrently, they contribute to improving the real agency of those most impacted and legitimacy of decision-making.</cpr:P7>
        <schema:description xml:lang="en">Procedural justice means ensuring that decision making is safe, transparent and inclusive, emphasizing the agency and influence of vulnerable groups and those most impacted.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q913 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q913">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q911"/>
        <rdfs:label xml:lang="en">restorative justice</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1167"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1170"/>
        <cpr:P7 xml:lang="en">Seeking redress for historical damages and healing the land and people that have been impacted by climate change or harmed by the extractive practices that led to the climate crisis. Typically, redress is demanded from those who benefited from those extractive practices -- for example, reparations payments from fossil fuel companies. Like other climate justice types, there is a strong ethical component; demands, claims and analyses can all be considered relevant, even if no redress has taken place (yet), as long as the argument is rooted in righting historical wrongs at the root of the climate crisis.</cpr:P7>
        <schema:description xml:lang="en">Seeking redress for historical social, economic and/or environmental damages associated with climate change.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q915 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q915">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q911"/>
        <rdfs:label xml:lang="en">intergenerational justice</rdfs:label>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q695"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q708"/>
        <cpr:P7 xml:lang="en">The idea that present generations have certain duties towards future generations in protecting them from future impacts of climate change, which need to be balanced with the rights of those alive today. Arguments and actions that seek to improve the situation of current younger generations can also be included, as long as they speak to a moral duty of those currently in power to provide a future that is as safe and fair as possible.</cpr:P7>
        <schema:description xml:lang="en">The duty of present generations towards future generations to protect them from future impacts of climate change, which need to be balanced with the rights of those alive today.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q917 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q917">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <rdfs:label xml:lang="en">carbon tetrachloride</rdfs:label>
        <skos:altLabel xml:lang="en">carbon tet</skos:altLabel>
        <schema:description xml:lang="en">A toxic, ozone-depleting solvent, historically used in industrial cleaning and refrigerant production.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q918 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q918">
