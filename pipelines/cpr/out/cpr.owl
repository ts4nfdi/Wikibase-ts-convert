        <skos:altLabel xml:lang="en">ad valorem tariff, ad valorem tariffs, applied tariff, applied tariffs, bound tariff, bound tariffs, customs tariff, customs tariffs, export tariff, export tariffs, import tariff, import tariffs, MFN tariff, MFN tariffs, punitive tariff, punitive tariffs, reciprocal tariff, reciprocal tariffs, retaliatory tariff, retaliatory tariffs, tariff barrier, tariff barriers, tariff escalation, tariff line, tariff lines, tariff peak, tariff peaks, tariff quota, tariff quotas, trade tariff, trade tariffs</skos:altLabel>
