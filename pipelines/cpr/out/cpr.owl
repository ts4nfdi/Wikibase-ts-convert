    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1942 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1942">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1891"/>
        <rdfs:label xml:lang="en">seagrass bed management</rdfs:label>
        <skos:altLabel xml:lang="en">conservation of seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">conserving seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">manage seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">management of seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">management of seagrass beds</skos:altLabel>
        <skos:altLabel xml:lang="en">management of seagrass meadows</skos:altLabel>
        <skos:altLabel xml:lang="en">protect seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">protecting seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">protection of seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">rehabilitation of seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">restoration of seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">restore seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">restoring seagrass</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass bed conservation</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass bed protection</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass bed restoration</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass beds protected</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass beds restored</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass conservation</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass management</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadow management</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadow protection</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadow restoration</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadows conservation</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadows managed</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadows protected</skos:altLabel>
        <skos:altLabel xml:lang="en">seagrass meadows restored</skos:altLabel>
        <cpr:P7 xml:lang="en">Seagrasses are submerged marine flowering plants forming extensive meadows in many shallow coastal waters worldwide. The leafy shoots of these highly productive plants provide food and shelter for many animals (including commercially important species, e.g. prawns), and their roots and rhizomes are important for oxygenating and stabilising bottom sediments and preventing erosion. Seagrass bed management is protecting seagrass meadows from sediment loading and disturbances caused by storms, eutrophication, temperature increases and other light restrictions due to sea-level rise and increased cloudiness.</cpr:P7>
        <schema:description xml:lang="en">Protecting and managing seagrass beds.</schema:description>
    </owl:Class>
    


