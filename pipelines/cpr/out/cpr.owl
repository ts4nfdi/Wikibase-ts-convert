    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1375 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1375">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1374"/>
        <rdfs:label xml:lang="en">carbon offset</rdfs:label>
        <skos:altLabel xml:lang="en">carbon offset project</skos:altLabel>
        <skos:altLabel xml:lang="en">carbon offset projects</skos:altLabel>
        <skos:altLabel xml:lang="en">carbon offset scheme</skos:altLabel>
