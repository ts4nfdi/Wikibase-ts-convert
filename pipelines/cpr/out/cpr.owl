    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q922 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q922">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <rdfs:label xml:lang="en">methyl bromide</rdfs:label>
        <skos:altLabel xml:lang="en">CH3Br</skos:altLabel>
