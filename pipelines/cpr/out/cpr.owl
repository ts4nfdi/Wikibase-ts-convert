        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q684"/>
        <cpr:P7 xml:lang="en">People protecting natural rights through activism, often from indigenous communities.</cpr:P7>
    </rdf:Description>
    <rdf:Description rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1603">
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q676"/>
        <cpr:P7 xml:lang="en">People who face discrimination or are otherwise excluded because of their religious beliefs. In the context of climate impacts, this should be seen as one of a wider selection of intersecting identities and power structures which create marginalisation.</cpr:P7>
    </rdf:Description>
