    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1946 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1946">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">green roof</rdfs:label>
        <skos:altLabel xml:lang="en">green roofs</skos:altLabel>
        <cpr:P7 xml:lang="en">Green roofs are contained areas of vegetation – such as trees, shrubs, crops, or grasses– planted on human-made structures, such as government buildings, schools, libraries, community centres, private residences, and commercial buildings. Green roofs can help cool the air, absorb excess water, and reduce energy use while supporting biodiversity and making our cities more liveable.</cpr:P7>
        <schema:description xml:lang="en">Green roofs are contained areas of vegetation – such as trees, shrubs, crops, or grasses– planted on human-made structures, such as government buildings, schools, libraries, community centres, private residences, and commercial buildings.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1948 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1948">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1882"/>
        <rdfs:label xml:lang="en">rain garden</rdfs:label>
        <skos:altLabel xml:lang="en">rain gardens, rainwater garden, rainwater gardens, pocket park, pocket parks</skos:altLabel>
        <schema:description xml:lang="en">A shallow area of ground or dip, planted with vegetation, which receives run-off from roofs and other hard surfaces, reducing risk of flash flooding.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1949 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1949">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:label xml:lang="en">non-timber forest product</rdfs:label>
        <skos:altLabel xml:lang="en">non-wood forest products, non-timber forest products, non-wood forest product, NTFP, NTFPs, NWFPs, non-timber forest produce, non-wood forest produce</skos:altLabel>
        <cpr:P7 xml:lang="en">Non-timber forest products are products other than timber that are naturally produced in forests and can be harvested for human use without cutting down trees. They can help increase the climate-resilience of forest-dependent communities by diversifying their livelihoods and enhancing food security.</cpr:P7>
        <schema:description xml:lang="en">Non-timber forest products are products other than timber that are naturally produced in forests and can be harvested for human use without cutting down trees.</schema:description>
    </owl:Class>
    


