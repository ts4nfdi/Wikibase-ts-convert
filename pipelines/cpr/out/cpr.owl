        <rdfs:label xml:lang="en">waste tax</rdfs:label>
        <skos:altLabel xml:lang="en">waste taxes, incineration tax, incineration taxes, landfill tax, tax on landfilling, taxes on waste</skos:altLabel>
        <cpr:P7 xml:lang="en">add</cpr:P7>
        <schema:description xml:lang="en">Tax on waste, such as taxes on landfilling and incineration</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q132 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q132">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1845"/>
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1853"/>
        <rdfs:label xml:lang="en">reduced impact logging</rdfs:label>
        <skos:altLabel xml:lang="en">reduced-impact logging, low-impact logging, responsible logging, sustainable logging, sustainable logging practices, reduce impact of logging, reducing impact of logging, logging with reduced impact</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P7 xml:lang="en">Logging techniques that result in significantly less damage to the surrounding forest and forest ecosystem. Examples of reduced impact logging include directional felling, trimming of inter-crown vines, and careful road planning. Reduced impact logging helps to maintain forest ecosystem integrity and resilience to climate change.</cpr:P7>
        <schema:description xml:lang="en">Logging techniques that result in significantly less damage to the surrounding forest and forest ecosystem. Examples of reduced impact logging include directional felling, trimming of inter-crown vines, and careful road planning.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1320 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1320">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q661"/>
        <rdfs:label xml:lang="en">coal gas</rdfs:label>
        <schema:description xml:lang="en">Coal gas is a flammable gaseous fuel made from coal and supplied to the user via a piped distribution system, produced when coal is heated strongly without air.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1333 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1333">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1273"/>
        <rdfs:label xml:lang="en">non-concessional loan</rdfs:label>
        <skos:altLabel xml:lang="en">hard loan, hard loans, non concessional loan, non concessional loans, non-concessional loans, market loan, market loans</skos:altLabel>
        <cpr:P7 xml:lang="en">A loan that is offered at or near market interest rates, and has less favorable terms than a concessional loan or soft loan.</cpr:P7>
        <schema:description xml:lang="en">A loan that is offered at or near market interest rates, and has less favorable terms than a concessional loan or soft loan.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1334 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1334">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1276"/>
        <rdfs:label xml:lang="en">public finance</rdfs:label>
        <skos:altLabel xml:lang="en">public funding, public financing, domestic public funding, public funded scheme, public funded schemes, publicly funded, publicly-funded, public financing instrument, public finance flow, public finance flows, public funding flows, domestic finance, government budget investment, government budget investments</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1309"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1310"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1554"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q775"/>
        <cpr:P7 xml:lang="en">Public funding for climate policy is the use of public funds to support climate initiatives and integrate climate into other projects. Examples are investing in climate-smart infrastructure, technologies, and social welfare.</cpr:P7>
        <schema:description xml:lang="en">Public funding for climate policy is the use of public funds to support climate initiatives and integrate climate into other projects. Examples are investing in climate-smart infrastructure, technologies, and social welfare.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1335 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1335">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1276"/>
        <rdfs:label xml:lang="en">research and development investment</rdfs:label>
        <skos:altLabel xml:lang="en">RD&amp;D investments, rd&amp;d investment, rd&amp;d investments, research and development investment, research and development investments, r&amp;d investment, R&amp;D investment, r&amp;d investments, R&amp;D investments</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q846"/>
        <cpr:P7 xml:lang="en">Research and development (R&amp;D) investment is the money spent on finding new or improved knowledge and ideas, and applying that knowledge.</cpr:P7>
        <schema:description xml:lang="en">Research and development (R&amp;D) investment is the money spent on finding new or improved knowledge and ideas, and applying that knowledge.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1336 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1336">
        <rdfs:subClassOf rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1280"/>
        <rdfs:label xml:lang="en">individual transferable quota</rdfs:label>
        <skos:altLabel xml:lang="en">individual transferable quotas, ITQ, ITQs, tradable development right, tradable development rights, tradable fishing right, tradable fishing rights, tradable hunting right, tradable hunting rights, tradable quota, transferable fishing quota, transferable fishing quotas, transferable hunting quota, transferable hunting quotas</skos:altLabel>
        <cpr:P7 xml:lang="en">Includes individual transferable quotas (ITQs) for fisheries, tradable development rights, and tradable hunting rights. These policy instruments set a limit on the total amount of a natural resource that can be exploited, and then allocate individual permits to users that they can also trade.</cpr:P7>
        <schema:description xml:lang="en">These policy instruments set a limit on the total amount of a natural resource that can be exploited, and then allocate individual permits to users that they can also trade.</schema:description>
    </owl:Class>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1339 -->


    <owl:Class rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1339">
