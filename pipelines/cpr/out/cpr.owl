        <skos:altLabel xml:lang="en">snowmelt-runoff flood</skos:altLabel>
        <skos:altLabel xml:lang="en">snowmelt-runoff flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">snowmelt-runoff floods</skos:altLabel>
        <skos:altLabel xml:lang="en">storm-driven flood</skos:altLabel>
        <skos:altLabel xml:lang="en">storm-driven flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">storm-driven floods</skos:altLabel>
        <skos:altLabel xml:lang="en">surface water flood</skos:altLabel>
        <skos:altLabel xml:lang="en">surface water flooding</skos:altLabel>
        <skos:altLabel xml:lang="en">surface water floods</skos:altLabel>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q106"/>
