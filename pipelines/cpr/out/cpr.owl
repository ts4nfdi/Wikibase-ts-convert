        <skos:altLabel xml:lang="en">citizens&apos; jury</skos:altLabel>
        <skos:altLabel xml:lang="en">climate assemblies</skos:altLabel>
        <skos:altLabel xml:lang="en">climate assembly</skos:altLabel>
        <skos:altLabel xml:lang="en">mini-public</skos:altLabel>
        <skos:altLabel xml:lang="en">mini-publics</skos:altLabel>
        <cpr:P7 xml:lang="en">Creating a representative group of citizens to learn about, deliberate upon, and make recommendations on a given issue. The group is usually randomly selected and their recommendations can have varying levels of political weight, though they are in most cases not binding.</cpr:P7>
        <schema:description xml:lang="en">Creating a representative group of citizens to learn about, deliberate upon, and make recommendations on a given issue.</schema:description>
    </owl:Class>
    


