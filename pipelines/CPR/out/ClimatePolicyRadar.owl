    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1384 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1384">
        <rdfs:label xml:lang="en">reinsurance</rdfs:label>
        <skos:altLabel xml:lang="en">re-insurance, re-insurers, re/insurance, re/insurers, reinsurers, reinsurance assessment, reinsurance operation, reinsurance service</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1599"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <cpr:P7 xml:lang="en">Reinsurance for climate risk is the process by which reinsurers, who insure insurance companies, help to manage the financial fallout from natural disasters caused by climate change.</cpr:P7>
        <schema:description xml:lang="en">Reinsurance for climate risk is the process by which reinsurers, who insure insurance companies, help to manage the financial fallout from natural disasters caused by climate change.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1386 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1386">
        <rdfs:label xml:lang="en">flood insurance</rdfs:label>
        <skos:altLabel xml:lang="en">flooding insurance, floods insurance, insuring flooding</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1388"/>
        <cpr:P7 xml:lang="en">Flood insurance is a type of property insurance that protects a home against losses from water damage specifically caused by flooding. Floods can result from heavy or prolonged rain, melting snow, coastal storm surges, blocked drainage systems, or the failure of levees and dams.</cpr:P7>
        <schema:description xml:lang="en">Flood insurance covers a property for water damage due to flooding, caused by events like heavy rain, storm surges, blocked drainage, or dam and levee failure.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1387 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1387">
        <rdfs:label xml:lang="en">drought insurance</rdfs:label>
        <skos:altLabel xml:lang="en">rainfall index insurance, RFP insurance, Soil Moisture Deficit Index Insurance</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1388"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q150"/>
        <cpr:P7 xml:lang="en">Drought insurance is a type of insurance that protects against losses caused by drought. Droughts can lead to losses for farmers, such as crop failures. An example is the Swiss Soil Moisture Deficit Index Insurance.</cpr:P7>
        <schema:description xml:lang="en">Drought insurance is a type of insurance that protects against losses caused by drought. Droughts can lead to losses for farmers.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1388 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1388">
        <rdfs:label xml:lang="en">climate risk insurance</rdfs:label>
        <skos:altLabel xml:lang="en">extreme weather insurance, climate change insurance, climate disaster insurance, climate impacts insurance, climate insurance</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1386"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1387"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q886"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1599"/>
        <cpr:P7 xml:lang="en">Climate risk insurance (CRI) is an efficient financial tool to help agricultural producers and governments to cope with the consequences of extreme weather events by addressing this residual risk element.</cpr:P7>
        <cpr:P9 xml:lang="en">Carbon Recycling International (CRI)</cpr:P9>
        <cpr:P9 xml:lang="en">color rendering index (CRI)</cpr:P9>
        <schema:description xml:lang="en">Climate risk insurance (CRI) is an efficient financial tool to help agricultural producers and governments to cope with the consequences of extreme weather events by addressing this residual risk element.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1389 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1389">
        <rdfs:label xml:lang="en">disaster insurance</rdfs:label>
        <skos:altLabel xml:lang="en">disaster risk insurance, catastrophe risk insurance, insurance against natural disasters, insurance against catastrophe risk, insurance against catastrophe risks</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q886"/>
        <cpr:P7 xml:lang="en">Catastrophe insurance, also known as disaster insurance, protects homes and businesses from high-cost, low-probability natural and human-made disasters. These events are usually not covered by standard homeowners insurance policies. These can be both climate-related and unrelated.</cpr:P7>
        <schema:description xml:lang="en">Catastrophe insurance, also known as disaster insurance, protects homes and businesses from high-cost, low-probability natural and human-made disasters. These events are usually not covered by standard homeowners insurance policies.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1390 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1390">
        <rdfs:label xml:lang="en">agricultural insurance</rdfs:label>
        <skos:altLabel xml:lang="en">agricultural insurance, insuring agriculture, farm insurance, farming insurance, insuring farming, insurance of crops and livestock, insurance of livestock and crops</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1391"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q150"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1278"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q131"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1836"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q886"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1613"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q786"/>
        <cpr:P7 xml:lang="en">Insurance has become even more important as extreme weather events and climate change have increased the risks and uncertainties of farmers and agriculture-based enterprises. By reducing the financial risks associated with farming, agriculture insurance can help to promote stability and growth in the industry.</cpr:P7>
        <schema:description xml:lang="en">Insurance has become even more important as extreme weather events and climate change have increased the risks and uncertainties of farmers and agriculture-based enterprises, creating the need for agricultural insurance to protect from losses.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1391 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1391">
        <rdfs:label xml:lang="en">livestock insurance</rdfs:label>
        <skos:altLabel xml:lang="en">live-stock insurance, climate-oriented livestock insurance, live stock insurance</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1390"/>
        <cpr:P7 xml:lang="en">Livestock insurance protects against unexpected events that happen to different types of farm animals and farm property, including losses from climate-related weather extremes.</cpr:P7>
        <schema:description xml:lang="en">Livestock insurance protects against unexpected events that happen to different types of farm animals and farm property, including losses from climate-related weather extremes.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1392 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1392">
        <rdfs:label xml:lang="en">white certificate</rdfs:label>
        <skos:altLabel xml:lang="en">white certificates, energy efficiency credit, energy savings certificate</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1280"/>
        <cpr:P7 xml:lang="en">A white certificate is a tradable asset which proofs that a certain percentage of energy savings has been achieved relative to a baseline. It is also referred to as Energy Savings Certificate (ESC) or Energy Efficiency Credit (EEC).</cpr:P7>
        <schema:description xml:lang="en">A white certificate is a tradable asset which proofs that a certain percentage of energy savings has been achieved relative to a baseline. It is also referred to as Energy Savings Certificate (ESC) or Energy Efficiency Credit (EEC).</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1393 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1393">
        <rdfs:label xml:lang="en">air pollution standard</rdfs:label>
        <skos:altLabel xml:lang="en">air pollution standards, air quality standard, air quality standards, air-pollution standard, air-pollution standards, air-quality standard, air-quality standards</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P7 xml:lang="en">There are national or regional policies setting limit values to the concentration of different pollutants in the air to protect the public health and the environment.</cpr:P7>
        <schema:description xml:lang="en">There are national or regional policies setting limit values to the concentration of different pollutants in the air to protect the public health and the environment.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1394 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1394">
        <rdfs:label xml:lang="en">zero-emission vehicle standard</rdfs:label>
        <skos:altLabel xml:lang="en">zero emission vehicle standard, zero emission vehicle standards, zero-emission vehicle standards, ZEV standard, ZEV standards</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1712"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q277"/>
        <cpr:P7 xml:lang="en">Zero-emission vehicle standards require vehicle sellers to achieve minimum requirements for sales of zero-emission vehicles in the jurisdiction.</cpr:P7>
        <schema:description xml:lang="en">Zero-emission vehicle standards require vehicle sellers to achieve minimum requirements for sales of zero-emission vehicles in the jurisdiction.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1395 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1395">
        <rdfs:label xml:lang="en">building code and standard</rdfs:label>
        <skos:altLabel xml:lang="en">building code, building codes, building energy code, building energy codes, building standard, building standards, building regulation, national construction code, national construction standard, building regulations, Energy Performance of Buildings Directive, EPBD, Future Homes Standard, nearly zero-energy building, nearly zero-energy buildings, nZEB, NZEB, zero-emission building, zero-emission buildings</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1654"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1879"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P7 xml:lang="en">The term &apos;building codes&apos; refers to regulations that set out the standards to which all buildings and other structures must conform. They cover design, construction, alteration, repair and maintenance, and specify the minimum requirements necessary to safeguard the health, as well as other impacts on the environment.</cpr:P7>
        <schema:description xml:lang="en">The term &apos;building codes&apos; refers to regulations that set out the standards to which all buildings and other structures must conform. They cover design, construction, alteration, repair and maintenance, and specify the minimum requirements necessary to safeguard the health, as well as other impacts on the environment.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1396 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1396">
        <rdfs:label xml:lang="en">energy efficiency standard</rdfs:label>
        <skos:altLabel xml:lang="en">energy efficiency standards, MEES, minimum energy efficiency standard, minimum energy efficiency standards, appliance efficiency standard, appliance efficiency standards, MEPS, minimum energy performance standard, minimum energy performance standards</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P7 xml:lang="en">Energy efficiency standards are government regulations that set a minimum level of energy performance for buildings or appliances, typically measured by an energy rating scale (like A-G), meaning that products or properties must meet a certain level of efficiency to be sold or rented, aiming to reduce energy consumption and carbon emissions; in practice, this often means landlords must ensure their rental properties reach a minimum energy efficiency rating.</cpr:P7>
        <schema:description xml:lang="en">Energy efficiency standards are government regulations that set a minimum level of energy performance. This can be, for example, for buildings or appliances, typically measured by an energy rating scale (like A-G), meaning that products or properties must meet a certain level of efficiency to be sold or rented, aiming to reduce energy consumption and carbon emissions; in practice, this often means landlords must ensure their rental properties reach a minimum energy efficiency rating.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1397 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1397">
        <rdfs:label xml:lang="en">renewable portfolio standard</rdfs:label>
        <skos:altLabel xml:lang="en">renewable portfolio standards, RPS</skos:altLabel>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2675"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P7 xml:lang="en">Renewable Portfolio Standards (RPS) require that a minimum percentage of electricity is generated from specified renewable sources.</cpr:P7>
        <cpr:P9 xml:lang="en">rps (required policy scenario)</cpr:P9>
        <cpr:P9 xml:lang="en">rps group</cpr:P9>
        <cpr:P9 xml:lang="en">source: rps</cpr:P9>
        <schema:description xml:lang="en">Renewable Portfolio Standards (RPS) require that a minimum percentage of electricity is generated from specified renewable sources.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1398 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1398">
        <rdfs:label xml:lang="en">low carbon fuel standard</rdfs:label>
        <skos:altLabel xml:lang="en">LCFS, low carbon fuel standards, low-carbon fuel standard, low-carbon fuel standards, fuel efficiency standard, fuel efficiency standards, blending mandate, blending mandates, FuelEU, ReFuelEU, renewable fuel standard</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1712"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1655"/>
        <cpr:P7 xml:lang="en">Low carbon fuel standards require that the average life-cycle carbon intensity of energy to 24 decline over time. These can be applied to petroleum products, natural gas, hydrogen, and electricity.</cpr:P7>
        <schema:description xml:lang="en">Low carbon fuel standards require that the average life-cycle carbon intensity of energy declines over time.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1399 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1399">
        <rdfs:label xml:lang="en">technology standard</rdfs:label>
        <skos:altLabel xml:lang="en">technology standards, equipment performance standard, equipment performance standards, equipment standard, equipment standards, technology performance standard, technology performance standards, Energy Star</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1281"/>
        <cpr:P7 xml:lang="en">Technology standards take a more prescriptive approach by requiring a specific technology, process or product. They typically feature one of three approaches: requirements for specific pollution abatement technologies; requirements for specific production methods; or requirements for specific goods such as energy efficient appliances</cpr:P7>
        <schema:description xml:lang="en">Technology standards take a more prescriptive approach by requiring a specific technology, process or product than performance standards.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1400 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1400">
        <rdfs:label xml:lang="en">low-emission zone</rdfs:label>
        <skos:altLabel xml:lang="en">ULEZ, ultra low emission zone, ultra-low emission zone, low emission zone, low emission zones, ultra-low emission zones, ultralow emission zones, ultralow emission zone, LEZ</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1282"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2728"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1716"/>
        <cpr:P7 xml:lang="en">A low-emission zone (LEZ) is a defined area where access by some polluting vehicles is restricted or deterred with the aim of improving air quality.</cpr:P7>
        <schema:description xml:lang="en">A low-emission zone (LEZ) is a defined area where access by some polluting vehicles is restricted or deterred with the aim of improving air quality.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1401 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1401">
        <rdfs:label xml:lang="en">protected area</rdfs:label>
        <skos:altLabel xml:lang="en">protected areas, nature reserve, nature reserves, conservation area, conservation areas, protected habitat, protected habitats, 30 by 30, 30x30, area-based conservation, conserved area, conserved areas, ICCA, ICCAs, OECM, OECMs, other effective area-based conservation measure, other effective area-based conservation measures, territories of life, 30by30, biosphere reserve, biosphere reserves, ecologic reserve, ecological reserve</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1403"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1405"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1408"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1598"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1618"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1282"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1744"/>
        <cpr:P7 xml:lang="en">Protected areas are specifically delineated areas, designated and managed with the aim of conserving nature, and ecosystem services. These systems are policy measures that help safeguard biodiversity. They play a key role in the storage of carbon stocks, and can protect a wide range of threats, including providing a haven for species as they shift ranges in response to climate change.</cpr:P7>
        <cpr:P9 xml:lang="en">management effectiveness of protected area</cpr:P9>
        <cpr:P9 xml:lang="en">management effectiveness of protected areas</cpr:P9>
        <cpr:P9 xml:lang="en">protected area connectedness index</cpr:P9>
        <cpr:P9 xml:lang="en">protected area management effectiveness</cpr:P9>
        <cpr:P9 xml:lang="en">rotected areas management effectiveness</cpr:P9>
        <schema:description xml:lang="en">Protected areas are specifically delineated areas, designated and managed with the aim of conserving nature, and ecosystem services. These systems are policy measures that help safeguard biodiversity. They play a key role in the storage of carbon stocks, and can protect a wide range of threats, including providing a haven for species as they shift ranges in response to climate change.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1402 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1402">
        <rdfs:label xml:lang="en">nature reserve</rdfs:label>
        <skos:altLabel xml:lang="en">nature reserves, strict nature reserve, strict nature reserves, natural resources reserve, natural resources reserves, nature conversation area, nature conversation areas, nature reserve area, nature reserve areas, sanctuary</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1410"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1282"/>
        <cpr:P7 xml:lang="en">Nature reserves are areas that are allocated to both preserve and protect specific animal and/or plant species.</cpr:P7>
        <schema:description xml:lang="en">Nature reserves are areas that are allocated to both preserve and protect specific animal and/or plant species.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1403 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1403">
        <rdfs:label xml:lang="en">marine protected area</rdfs:label>
        <skos:altLabel xml:lang="en">marine protected areas, MPA, MPAs, marine reserve, marine reserves, marine conservation zone, marine conservation zones, highly protected marine area, highly protected marine areas, HPMA, HPMAs, protected marine areas, LMMA, locally managed marine area, no-take zone, no-take zones, marine area protected, marine area protection, marine areas protected, marine areas protection, marine protected zones, protected marine area, locally managed marine areas</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1401"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1892"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2674"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1405"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q368"/>
        <cpr:P7 xml:lang="en">A marine protected area is a designated region within the ocean, estuaries or great lakes, aimed at conserving marine habitats and resources. MPAs protect biodiversity, sustain fisheries, and preserve critical ecosystems by limiting or managing human activities that could harm the marine environment.</cpr:P7>
        <schema:description xml:lang="en">A marine protected area is a designated region within the ocean, estuaries or great lakes, aimed at conserving marine habitats and resources. MPAs protect biodiversity, sustain fisheries, and preserve critical ecosystems by limiting or managing human activities that could harm the marine environment.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1404 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1404">
        <rdfs:label xml:lang="en">forest protected area</rdfs:label>
        <skos:altLabel xml:lang="en">forest conservation area, forest conservation areas, forest protected areas, forest reserve, forests reserve, protected forest</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1408"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1851"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q787"/>
        <cpr:P7 xml:lang="en">Forest ecosystems, covering about one third of the global land area, are among the most biologically rich ecosystems on earth and are vital carbon sinks and stores, buffering the rate of climate change. Continued deforestation has highlighted the importance of effective protection of tropical forests for reducing biodiversity loss and enhancing carbon storage.</cpr:P7>
        <schema:description xml:lang="en">Effective protection of tropical forests can reduce biodiversity loss and enhance carbon storage, as they are among the most biologically rich ecosystems on earth.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1405 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1405">
        <rdfs:label xml:lang="en">coastal protected area</rdfs:label>
        <skos:altLabel xml:lang="en">coastal protected areas, coastal zone protection, coastal reserve, coastal area protected, coastal area protection, coastal areas protected, coastal areas protection, coastal conservation zone, coastal conservation zones, coastal protected zones, coastal reserves, conservation of coastal areas, preservation of coastal areas, protect coastal areas, protected coastal area, protected coastal areas, protection of coastal areas</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1401"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1891"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2674"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1403"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1517"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2587"/>
        <cpr:P7 xml:lang="en">Protected areas such as coastal ones can both combat climate change through the storage of carbon, as well as preserve a different range of species to reduce the risk of biodiversity loss.</cpr:P7>
        <schema:description xml:lang="en">Protected areas such as coastal ones can both combat climate change through the storage of carbon, as well as preserve a different range of species to reduce the risk of biodiversity loss.</schema:description>
    </owl:NamedIndividual>
    


