    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1652 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1652">
        <rdfs:label xml:lang="en">emissions reduction target</rdfs:label>
        <skos:altLabel xml:lang="en">reduction target, GHG reduction target, greenhouse gas reduction target</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1653"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1651"/>
        <cpr:P20 xml:lang="en">t2gvekg3</cpr:P20>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q218"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q221"/>
        <cpr:P7 xml:lang="en">A specific type of target: a claim by an institution that refers to a reduction in greenhouse gas emissions by a certain point in time. This can be an absolute (e.g. tonnes of CO₂-eq) or relative reduction (e.g. against business as usual) in any type of greenhouse gas emissions or emission intensity (e.g. CO₂ per capita).</cpr:P7>
        <schema:description xml:lang="en">A target to reduce the prevalence of a greenhouse gas over a specific time frame</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1653 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1653">
        <rdfs:label xml:lang="en">net-zero target</rdfs:label>
        <skos:altLabel xml:lang="en">NZT, net zero target</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1652"/>
        <cpr:P20 xml:lang="en">2h5qv7ee</cpr:P20>
        <cpr:P7 xml:lang="en">A specific type of emissions reduction target: a claim by an institution to bring its greenhouse gas emissions balance down to zero by a certain point in time. Balance here refers to difference between greenhouse gas emissions and greenhouse gas uptake, for example by carbon capture or by sequestering carbon through reforestation. These targets can be economy-wide or sectoral.</cpr:P7>
        <schema:description xml:lang="en">A commitment to balance GHG emissions with removal by a certain point in time, effectively reducing the net emissions to zero</schema:description>
    </owl:NamedIndividual>
    


