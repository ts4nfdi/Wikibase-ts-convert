    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1418 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1418">
        <rdfs:label xml:lang="en">environmental liability</rdfs:label>
        <skos:altLabel xml:lang="en">environment liability policy, environmental liabilities</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1284"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q729"/>
        <cpr:P7 xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities. It&apos;s based on the &quot;polluter pays&quot; principle, which means that those who cause environmental damage are financially responsible for it.</cpr:P7>
        <schema:description xml:lang="en">Environmental liability is the responsibility of a person or company for environmental damage caused by their activities.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1419 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1419">
