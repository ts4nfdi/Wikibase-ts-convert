        <cpr:P9 xml:lang="en">tax burden</cpr:P9>
        <cpr:P9 xml:lang="en">tax collector</cpr:P9>
        <cpr:P9 xml:lang="en">tax department</cpr:P9>
        <cpr:P9 xml:lang="en">tax departments</cpr:P9>
