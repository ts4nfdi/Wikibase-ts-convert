    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1408 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1408">
        <rdfs:label xml:lang="en">terrestrial protected area</rdfs:label>
        <skos:altLabel xml:lang="en">terrestrial protected areas, terrestrial reserve, terrestrial reserves, land conservation areas, terrestrial conservation areas, conserved land, protected terrestrial area, protected terrestrial areas, SSSI, terrestrial nature reserve</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1404"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1406"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1409"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2790"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1401"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1846"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2539"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q404"/>
        <cpr:P7 xml:lang="en">Terrestrial ecosystems, including forests, wetlands, and peatlands store carbon stocks, and play an role in combatting the twin crises of climate change and biodiversity loss simultaneously. Protecting these areas safeguards biodiversity and enhances carbon storage.</cpr:P7>
        <schema:description xml:lang="en">Terrestrial ecosystems, including forests, wetlands, and peatlands store carbon stocks, and play an role in combating the twin crises of climate change and biodiversity loss simultaneously.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1409 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1409">
