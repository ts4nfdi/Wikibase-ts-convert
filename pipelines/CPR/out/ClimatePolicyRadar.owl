    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1297 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1297">
        <rdfs:label xml:lang="en">levy</rdfs:label>
        <skos:altLabel xml:lang="en">levies</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1299"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P7 xml:lang="en">A levy is an economic instrument that consists of a compulsory financial charge imposed on an agent or institution by a governmental organisation. These can be unrequited payments.</cpr:P7>
        <schema:description xml:lang="en">A levy is an economic instrument that consists of a compulsory financial charge imposed on an agent or institution by a governmental organisation. These can be unrequited payments.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1298 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1298">
        <rdfs:label xml:lang="en">carbon border adjustment mechanism</rdfs:label>
        <skos:altLabel xml:lang="en">carbon border adjustment, carbon border adjustment mechanisms, carbon border adjustment tax, CBAM</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q715"/>
        <cpr:P7 xml:lang="en">A fee or tariff on imported goods based on their emissions of greenhouse gases during their production. This policy instrument aims to reduce global emissions, level the playing field between countries with different climate policies, and motivate cleaner industrial practices worldwide, ultimately supporting efforts to fight climate change.</cpr:P7>
        <schema:description xml:lang="en">Fee or tariff levied on imported goods based on the greenhouse gases emitted during their production</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1299 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1299">
        <rdfs:label xml:lang="en">CO2 levy</rdfs:label>
        <skos:altLabel xml:lang="en">carbon dioxide levy, co2 levy, levy on CO2, emissions levy, fossil fuel levy, levies on CO2, levies on fossil fuel, levy on emissions, levy on fossil fuel, carbon levy</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1297"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q716"/>
        <cpr:P7 xml:lang="en">CO2 levies are a tool to achieve statutory CO2 emission targets, and targets industry that imports fossil fuel. By making fossil fuels more expensive it creates the incentive to move to greener and less polluting alternatives.</cpr:P7>
        <schema:description xml:lang="en">CO2 levies are a tool to achieve statutory CO2 emission targets, and targets industry that imports fossil fuel.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q130 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q130">
        <rdfs:label xml:lang="en">marine monitoring</rdfs:label>
        <skos:altLabel xml:lang="en">marine monitoring, ocean monitoring, ocean surface monitoring, monitoring sea-level rise, monitoring sea-levels, sea-level monitoring, sea-level rise monitoring</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1835"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1841"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q83"/>
        <cpr:P4 rdf:resource="https://mcc.jrc.ec.europa.eu/documents/201702065840.pdf"/>
        <schema:description xml:lang="en">Marine monitoring can be defined as the systematic measurement of biotic and abiotic parameters of the marine environment, with predefined spatial and temporal schedule, having the purpose to provide the data to allow assessment to classify a marine area as reaching or failing to reach Good Environmental Status.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1300 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1300">
        <rdfs:label xml:lang="en">fuel excise tax</rdfs:label>
        <skos:altLabel xml:lang="en">fuel excise taxes, fuel duties, fuel duty, fuel excise, fuel tax, fuel taxes, gas tax, gas taxes, gasoline tax, gasoline taxes, petrol tax, petrol taxes, tax on fuel, tax on gas, tax on gasoline, tax on petrol, taxes on fuel</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q717"/>
        <cpr:P7 xml:lang="en">Fuel excise taxes are also known as petrol, gasoline or gas taxes, and are excise taxes imposed on the sale of fuel. These are indirect taxes imposed on the sale of fuel for transport or heating.</cpr:P7>
        <schema:description xml:lang="en">Fuel excise taxes are also known as petrol, gasoline or gas taxes, and are excise taxes imposed on the sale of fuel. These are indirect taxes imposed on the sale of fuel for transport or heating.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1301 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1301">
        <rdfs:label xml:lang="en">tax credit</rdfs:label>
        <skos:altLabel xml:lang="en">tax credits</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1302"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1303"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P7 xml:lang="en">A tax credit is a tax incentive where the calculated taxes owed to the government are reduced, either as a percentage of taxes owed, or as a currency amount. Example: Companies that make investments in solar or bioenergy can reduce their tax burden by 8% of the investment costs. In this way, the tax burden can be reduced by a maximum of 35%.</cpr:P7>
        <schema:description xml:lang="en">A tax credit is a tax incentive where the calculated taxes owed to the government are reduced, either as a percentage of taxes owed, or as a currency amount. Example: Companies that make investments in solar or bioenergy can reduce their tax burden by 8% of the investment costs. In this way, the tax burden can be reduced by a maximum of 35%.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1302 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1302">
        <rdfs:label xml:lang="en">production tax credit</rdfs:label>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1301"/>
        <cpr:P7 xml:lang="en">A type of tax credit used to accelerate the green energy transition, such as the manufacturing of solar panels, wind turbines, and support the production of biofuels.</cpr:P7>
        <schema:description xml:lang="en">A type of tax credit used to accelerate the green energy transition, such as the manufacturing of solar panels, wind turbines, and support the production of biofuels.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1303 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1303">
        <rdfs:label xml:lang="en">investment tax credit</rdfs:label>
        <skos:altLabel xml:lang="en">investment tax credit</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1301"/>
        <cpr:P7 xml:lang="en">These are used to incentivise business investment, returning financial capital to companies to deploy directly into greener investments, such as renewable energy.</cpr:P7>
        <schema:description xml:lang="en">These are used to incentivise business investment, returning financial capital to companies to deploy directly into greener investments, such as renewable energy.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1305 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1305">
        <rdfs:label xml:lang="en">feed-in-premium</rdfs:label>
        <skos:altLabel xml:lang="en">feed in premium, feed in premiums, feed-in-premiums, FIP scheme, FiP scheme, FiP schemes, FIP schemes</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2665"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <cpr:P7 xml:lang="en">Under a feed-in premium (FIP) scheme, electricity from renewable energy sources (RES) is typically sold on the electricity spot market and RES producers receive a premium on top of the market price of their electricity production.</cpr:P7>
        <schema:description xml:lang="en">Under a feed-in premium (FIP) scheme, electricity from renewable energy sources (RES) is typically sold on the electricity spot market and RES producers receive a premium on top of the market price of their electricity production.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1309 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1309">
        <rdfs:label xml:lang="en">concessional loan</rdfs:label>
        <skos:altLabel xml:lang="en">soft loan, soft loans, concessional loans, soft-loan, soft-loans, subsidised loan, subsidised loans</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1273"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1334"/>
        <cpr:P7 xml:lang="en">A concessional loan is offered on more favourable terms than loans at market interest rates. Such loans feature lower-than-market interest rates and/or extended repayment and grace periods, though they must still be repaid. An example includes concessional loan schemes for adaptation, like those supporting farmers affected by drought.</cpr:P7>
        <schema:description xml:lang="en">Loans given for the purpose of addressing climate change, which are characterized with longer repayment terms and lower interest rates, offering more favourable terms than loans at market interest rates.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1310 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1310">
        <rdfs:label xml:lang="en">loan guarantee</rdfs:label>
        <skos:altLabel xml:lang="en">loan guarantees</skos:altLabel>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1273"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1334"/>
        <cpr:P7 xml:lang="en">A loan guarantee is a legally binding agreement where a third party, known as the guarantor, agrees to pay off a loan if the borrower defaults.</cpr:P7>
        <schema:description xml:lang="en">A loan guarantee is a legally binding agreement where a third party, known as the guarantor, agrees to pay off a loan if the borrower defaults.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1313 -->


