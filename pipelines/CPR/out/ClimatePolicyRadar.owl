        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1285"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2420"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1417"/>
        <cpr:P3 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q2680"/>
        <schema:description xml:lang="en">Transitioning away from fossil fuels in favour of renewable energy sources.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q2722 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q2722">
