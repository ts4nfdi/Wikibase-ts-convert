        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1207"/>
        <cpr:P7 xml:lang="en">Environmental permits and licenses regulate business activities that could impact the environment or human health, including climate change. Business activities that may cause pollution or that pose another risk to the environment are regulated.</cpr:P7>
        <schema:description xml:lang="en">Environmental permits and licenses regulate business activities that could impact the environment or human health, including climate change.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1284 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1284">
        <rdfs:label xml:lang="en">due diligence</rdfs:label>
        <skos:altLabel xml:lang="en">duty of care, duty of vigilance, ESDD, HRDD, HREDD, CS3D, CSDDD, EUDR, vigilance plan</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1418"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1207"/>
        <cpr:P20 xml:lang="en">v58nzb77</cpr:P20>
        <cpr:P7 xml:lang="en">The processes through which enterprises can identify, prevent, mitigate and account for how they address their actual and potential adverse impacts. Due diligence is the idea that reasonable precautions should be taken to avoid causing harm to people, the environment, or society. It also involves identifying and mitigating risks before they occur.</cpr:P7>
        <schema:description xml:lang="en">The processes through which enterprises can identify, prevent, mitigate and account for how they address their actual and potential adverse impacts. Due diligence is the idea that reasonable precautions should be taken to avoid causing harm to people, the environment, or society. It also involves identifying and mitigating risks before they occur.</schema:description>
    </owl:NamedIndividual>
    


