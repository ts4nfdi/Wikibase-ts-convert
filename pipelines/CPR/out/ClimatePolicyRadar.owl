        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q721"/>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q728"/>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1269"/>
        <cpr:P11 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1279"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q722"/>
