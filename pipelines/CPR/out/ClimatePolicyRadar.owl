    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q715 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q715">
        <rdfs:label xml:lang="en">tax</rdfs:label>
        <skos:altLabel xml:lang="en">taxation, taxes, customs duties, customs duty, excise duties, excise duty, import duties, import duty, VAT, value added tax, value added taxes</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1297"/>
