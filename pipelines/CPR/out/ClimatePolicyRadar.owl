        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1402"/>
        <cpr:P2 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1207"/>
        <cpr:P20 xml:lang="en">z7cnc9cz</cpr:P20>
        <cpr:P7 xml:lang="en">Zoning and spatial planning are both methods for guiding the distribution of people and activities in a space, and are regulatory restrictions. Zoning helps manage multiple uses within protected areas, such as biodiversity conservation and human development.</cpr:P7>
        <schema:description xml:lang="en">Zoning and spatial planning are both methods for guiding the distribution of people and activities in a space, and are regulatory restriction.</schema:description>
    </owl:NamedIndividual>
    


    <!-- https://climatepolicyradar.wikibase.cloud/entity/Q1283 -->


    <owl:NamedIndividual rdf:about="https://climatepolicyradar.wikibase.cloud/entity/Q1283">
        <rdfs:label xml:lang="en">permits and licenses</rdfs:label>
        <skos:altLabel xml:lang="en">environmental permits and licenses, environmental permits and Licensing</skos:altLabel>
        <cpr:P1 rdf:resource="https://climatepolicyradar.wikibase.cloud/entity/Q1430"/>
