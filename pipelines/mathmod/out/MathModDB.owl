  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775722">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (Henry's isotherm)</rdfs:label>
    <schema:description xml:lang="en">determine Henry's constant from experimental data</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775761</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine Henry’s constant by fitting the linear Henry’s equation to measured solute concentration and adsorbed amount data. The results quantify the proportional relationship between solute concentration and adsorption at low concentrations, characterizing the initial adsorption behavior of the adsorbent.</mathmoddb:P1459>
  </rdf:Description>
