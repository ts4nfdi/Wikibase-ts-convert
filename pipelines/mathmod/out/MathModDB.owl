    <rdfs:label xml:lang="en">interaction potential</rdfs:label>
    <schema:description xml:lang="en">potential modeling pairwise interactions between particles</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821358">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">solar radiation interception model</rdfs:label>
    <schema:description xml:lang="en">model estimating canopy-intercepted solar radiation</schema:description>
    <mathmoddb:P1459 xml:lang="en">This model estimates the fraction of incoming solar radiation that is intercepted by a plant canopy. Interception is computed as a function of incoming radiation and canopy structural properties, particularly leaf area index. The model represents attenuation of radiation within the canopy using an exponential formulation derived from physical light extinction principles. It produces an estimate of photosynthetically active radiation available for photosynthesis. The intercepted radiation serves as a key input to biomass production and other radiation-driven processes.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7a4455ebf5e24728bc232b0294d5d2bc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674332"/>
    <owl:annotatedTarget>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;V&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;m&lt;/mi&gt;&lt;mi&gt;a&lt;/mi&gt;&lt;mi&gt;x&lt;/mi&gt;&lt;mo&gt;,&lt;/mo&gt;&lt;mi&gt;f&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
