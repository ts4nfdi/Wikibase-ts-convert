  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775768">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (Langmuir adsorption model)</rdfs:label>
    <schema:description xml:lang="en">Langmuir adsorption model</schema:description>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Langmuir adsorption constant and maximum monolayer adsorption capacity by fitting the linearized Langmuir equation to measured solute concentration and adsorbed amount data. The results characterize the adsorption capacity and surface homogeneity of the adsorbent.</mathmoddb:P1459>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q74562"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775769"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775770"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775771"/>
  </rdf:Description>
