  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684569">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">H2 optimal approximation</rdfs:label>
    <schema:description xml:lang="en">model order reduction by interpolation of the Volterra series representation of the system's transfer function</schema:description>
    <mathmoddb:P1459 xml:lang="en">This approach is based on the interpolation of the Volterra series representation of the system's transfer function and gives a local H2-optimal approximation, because the interpolation is chosen so that the system satisfies the necessary H2-optimality conditions upon convergence of the algorithm. Note that H2 stands for Hardy space.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684558</mathmoddb:P1684>
  </rdf:Description>
