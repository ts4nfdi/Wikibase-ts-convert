    <mathmoddb:P984 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673697"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfb593940afec48758855b0a9a35915e1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674201"/>
    <owl:annotatedTarget xml:lang="en">&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;K&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;msub&gt;&lt;mi&gt;S&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="https://portal.mardi4nfdi.de/entity/P983"/>
    <mathmoddb:P984 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674061"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821285">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">radiation use efficiency parameter</rdfs:label>
    <schema:description xml:lang="en">converts radiation into biomass</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">This crop-specific parameter defines the efficiency with which intercepted photosynthetically active radiation is converted into dry matter biomass. It represents physiological and biochemical characteristics of the crop. Higher values indicate more efficient biomass production per unit of absorbed radiation. The parameter is assumed constant under optimal growth conditions.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/P983">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">in defining formula</rdfs:label>
    <schema:description xml:lang="en">any symbol used in the defining formula (P989)</schema:description>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc5669516330646388f9555c1cd923810">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6773489"/>
    <owl:annotatedTarget xml:lang="en">&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;f&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;7&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="https://portal.mardi4nfdi.de/entity/P983"/>
    <mathmoddb:P984 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6773611"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821184">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Fritz-Schlunder 3-parameter isotherm model</rdfs:label>
    <schema:description xml:lang="en">three-parameter empirical adsorption isotherm</schema:description>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821186"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821185"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821201"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">The Fritz–Schlunder 3-parameter isotherm model is an empirical adsorption model designed to flexibly fit equilibrium data over a broad concentration range. It extends the Langmuir formulation by introducing an additional exponent describing surface heterogeneity. The model is frequently used when simpler isotherms such as Langmuir or Freundlich provide poor agreement with experimental data. It is suitable for both homogeneous and heterogeneous adsorption systems. The model does not rely on a specific adsorption mechanism and is primarily used for data correlation.</mathmoddb:P1459>
  </rdf:Description>
