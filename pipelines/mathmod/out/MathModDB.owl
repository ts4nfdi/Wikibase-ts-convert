  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674077">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">normal coordinate (dimensionless)</rdfs:label>
    <schema:description xml:lang="en">nondimensionalized positions of atoms away from their equilibrium positions, wrt a normal mode of vibration</schema:description>
