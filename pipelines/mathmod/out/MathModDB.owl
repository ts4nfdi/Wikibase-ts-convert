  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684698">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">celestial mechanics</rdfs:label>
    <schema:description xml:lang="en">branch of astronomy that deals with the motions of objects in outer space</schema:description>
    <mathmoddb:P12 xml:lang="en">Q184274</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Celestial_mechanics"/>
    <mathmoddb:P356 rdf:resource="http://commons.wikimedia.org/wiki/Special:FilePath/Angular%20Parameters%20of%20Elliptical%20Orbit.png"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684681"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Historically, celestial mechanics applies principles of physics (classical mechanics) to astronomical objects, such as stars and planets, to produce ephemeris data.</mathmoddb:P1459>
  </rdf:Description>
