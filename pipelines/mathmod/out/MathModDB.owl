  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821363">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of crop height</rdfs:label>
    <schema:description xml:lang="en">calculates crop height from phenological development</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task computes crop height as a function of phenological progress during the growing season. It uses a normalized development factor to scale crop height between emergence and maturity. The task produces a deterministic estimate of crop height at each time step. The resulting height can be used to parameterize canopy structure and related processes.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821379">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">plant water use rate in soil layer</rdfs:label>
    <schema:description xml:lang="en">plant water use rate in soil layer considering soil moisture</schema:description>
    <mathmoddb:P1459 xml:lang="en">This quantity represents the amount of water extracted by plant roots from a specific soil layer on a specific day. It reflects both root presence and soil water availability in that layer. Water use is reduced when soil moisture is limiting or when root stress factors restrict root function.</mathmoddb:P1459>
  </rdf:Description>
