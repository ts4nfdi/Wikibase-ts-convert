  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684551">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">balanced truncation (linear)</rdfs:label>
    <schema:description xml:lang="en">powerful technique to reduce the state-space dimension of a dynamical system with linear input equation</schema:description>
    <mathmoddb:P1459 xml:lang="en">In the case of a linear control system, a useful property of balanced truncation is that it admits easy control of the approximation error when truncating states.</mathmoddb:P1459>
  </rdf:Description>
