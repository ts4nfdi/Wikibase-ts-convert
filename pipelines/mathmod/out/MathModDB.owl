  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675434">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">normal mode (anharmonic)</rdfs:label>
    <schema:description xml:lang="en">molecular (or other) vibrations of many-body systems in terms of normal modes, beyond the harmonic approximation</schema:description>
    <mathmoddb:P1459 xml:lang="en">Describing molecular (or other) vibrations of many-body systems in terms of normal modes, beyond the harmonic approximation.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675435</mathmoddb:P1684>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Anharmonicity</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Toth model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Toth model parameters</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q1110333</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task involves estimating the parameters of the Toth adsorption isotherm model from equilibrium adsorption data. The model is nonlinear in its parameters, so numerical regression techniques are required to obtain optimal values for the maximum adsorption capacity, equilibrium constant, and heterogeneity exponent. The goal is to minimize prediction error between experimental uptake data and the theoretical Toth curve. The task is typically implemented using nonlinear least-squares optimization. Estimated parameters are then used to characterize adsorption behavior on heterogeneous surfaces.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775767</mathmoddb:P1684>
  </rdf:Description>
