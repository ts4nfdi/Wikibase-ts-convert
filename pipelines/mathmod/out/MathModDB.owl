  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820978">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Volmer model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Volmer affinity constant</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q4479187</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Volmer affinity constant. The nonlinear Volmer equation is fitted directly to fractional surface coverage and equilibrium concentration values, capturing the effect of adsorbate mobility on the adsorbent surface. The results quantify adsorption affinity while assuming no lateral interactions among adsorbed molecules. This approach avoids distortions caused by data linearization and is suitable for systems exhibiting mobile monolayer adsorption.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N400bb49888354e29886b0ca79340626e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821055"/>
    <owl:annotatedTarget>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;C&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
    <owl:annotatedProperty rdf:resource="https://portal.mardi4nfdi.de/entity/P983"/>
    <mathmoddb:P984>https://portal.mardi4nfdi.de/entity/Q6775716</mathmoddb:P984>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775377">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">joint probability</rdfs:label>
    <schema:description xml:lang="en">joint probability that Aᵢ(t) = nᵢ and Bᵢ(t) = mᵢ for all i = 1, 2, …, K</schema:description>
    <mathmoddb:P1459 xml:lang="en">The number of particles in the i-th compartment at time t≥0 is denoted by Aᵢ(t) and Bᵢ(t). 𝓃 = [n₁, n₂, …, nₖ] ∈ ℕᵏ and 𝓂 = [m₁, m₂, …, mₖ] ∈ ℕᵏ are used to define the system state.</mathmoddb:P1459>
  </rdf:Description>
