  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775754">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">free fall solution (vacuum)</rdfs:label>
    <schema:description xml:lang="en">analytical solution to the free fall equation, neglecting aerodynamic drag and assuming a uniform gravitational field</schema:description>
