    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822038"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822039"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822040"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822041"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model simulates crop nitrogen use using a supply–demand framework. Crop nitrogen demand is computed from accumulated biomass and an ideal nitrogen concentration that varies with crop development. Soil nitrogen supply is estimated from nitrate transport to roots by mass flow, distributed across soil layers according to plant water uptake. Actual nitrogen uptake is obtained by adjusting soil nitrogen supply to match crop demand while respecting soil nitrate availability. The model links crop growth, soil water use, and nitrogen dynamics in a mechanistic way.</mathmoddb:P1459>
  </rdf:Description>
