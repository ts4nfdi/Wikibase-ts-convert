  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775830">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Hill model (adsorption)</rdfs:label>
    <schema:description xml:lang="en">empirical model describing cooperative adsorption on surfaces</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">The Hill model in adsorption is an empirical isotherm used to describe cooperative uptake of solutes on solid surfaces. It represents systems in which the adsorption of one molecule increases or decreases the likelihood of subsequent adsorption events, producing a sigmoidal equilibrium curve. The model captures saturation behavior and incorporates a cooperativity exponent to reflect positive or negative interaction among adsorbed species. When the cooperativity exponent equals one, the model reduces to the non-cooperative Langmuir isotherm. The Hill adsorption model is applied to systems exhibiting S-shaped adsorption behavior in water treatment, materials science, and surface chemistry.</mathmoddb:P1459>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775832"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775831"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821166">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">Toth heterogeneity exponent</rdfs:label>
    <schema:description xml:lang="en">heterogeneity parameter controlling deviation from Langmuir behavior</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q1110333"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821390">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">root biomass partitioning model</rdfs:label>
    <schema:description xml:lang="en">model allocating biomass growth to the root system</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model computes the potential daily increase in crop root biomass by allocating a fraction of total biomass growth to the root system. The allocation fraction decreases linearly with phenological development, reflecting a shift in carbon partitioning from roots to aboveground organs as the crop matures. At emergence, a larger share of biomass is allocated to roots, while at maturity this share is reduced. The model represents empirical knowledge of crop biomass partitioning in a simplified and deterministic manner. The resulting root biomass increment serves as input for root distribution and soil interaction models.</mathmoddb:P1459>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821315"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821383"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821387"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
