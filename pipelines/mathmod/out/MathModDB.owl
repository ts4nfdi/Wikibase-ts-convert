    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674552"/>
    <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Hamiltonian_(quantum_mechanics)"/>
  </rdf:Description>
