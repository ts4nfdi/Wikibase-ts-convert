    <rdfs:label xml:lang="en">quantum damping rate</rdfs:label>
    <schema:description xml:lang="en">rate at which quantum coherence is lost in a system due to interactions with its environment</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Quantum damping rates can be used - together with quantum jump operators - to describe the dissipation and/or decoherence of the quantum dynamics in a Lindblad equation (for open quantum systems).</mathmoddb:P1459>
