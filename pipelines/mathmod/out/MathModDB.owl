  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821281">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">intercepted photosynthetically active radiation</rdfs:label>
    <schema:description xml:lang="en">radiation intercepted by the crop canopy</schema:description>
    <mathmoddb:P1459 xml:lang="en">Intercepted photosynthetically active radiation represents the portion of incoming solar radiation that is absorbed by the crop canopy and available for photosynthesis. It is computed as a function of total solar radiation and canopy leaf area. This quantity determines the energy input for potential biomass growth. It is a central driver of radiation-based crop growth models.</mathmoddb:P1459>
  </rdf:Description>
