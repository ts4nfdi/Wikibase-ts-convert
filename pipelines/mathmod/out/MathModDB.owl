  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775635">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">electric discharge</rdfs:label>
    <schema:description xml:lang="en">flow of electric charge through a gas, liquid or solid</schema:description>
    <mathmoddb:P12 xml:lang="en">Q488071</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Electric_discharge"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822116"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822147"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822188"/>
    <mathmoddb:P339 rdf:resource="https://github.com/INP-SDT/MCPlas"/>
    <mathmoddb:P339 rdf:resource="https://github.com/plasma-mds/adamant"/>
    <mathmoddb:P339 rdf:resource="https://inp-sdt.github.io/MCPlas/_build/html/index.html"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775639"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822205"/>
    <mathmoddb:P1459 xml:lang="en">The properties and effects of electric discharges are useful over a wide range of magnitudes. Tiny pulses of current are used to detect ionizing radiation in a Geiger–Müller tube. A low steady current can illustrate the gas spectrum in a gas-filled tube. A neon lamp is an example of a gas-discharge lamp, useful both for illumination and as a voltage regulator. A flashtube generates a short pulse of intense light useful for photography by sending a heavy current through a gas arc discharge. Corona discharges are used in photocopiers.</mathmoddb:P1459>
    <mathmoddb:P1463 rdf:resource="https://portal.mardi4nfdi.de/entity/Q13313"/>
    <mathmoddb:P1463 rdf:resource="https://portal.mardi4nfdi.de/entity/Q16278"/>
    <mathmoddb:P1640 rdf:resource="https://portal.mardi4nfdi.de/wiki/File:FEDM_spatial_profiles.png"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4e9f12df3fb648dda5fb0a3cc7685936">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674268"/>
