  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821391">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">root depth model</rdfs:label>
    <schema:description xml:lang="en">model simulating crop rooting depth development</schema:description>
    <mathmoddb:P1459 xml:lang="en">This model simulates the temporal development of crop rooting depth during the growing season. Root depth increases as a function of phenological development and approaches a crop-specific maximum under ideal soil conditions. The model assumes that rooting depth expands rapidly early in the growing season and reaches its maximum well before physiological maturity. Root depth is constrained by the depth of the soil profile, preventing unrealistic penetration beyond available soil layers. The simulated rooting depth limits the spatial extent of root biomass distribution and soil resource uptake.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc690f650af2d405ea3c1a63c215dabb5">
