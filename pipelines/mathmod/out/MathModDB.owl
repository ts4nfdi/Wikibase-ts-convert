  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674198">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Michaelis Menten equation (bi bi reaction ping pong with product 2 - Michaelis Menten model - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">equation for bi bi reaction with ping pong mechanism with products 2 following steady state assumption</schema:description>
