  <rdf:Description rdf:nodeID="Na02e0df840464015852aced803354ec3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674066"/>
