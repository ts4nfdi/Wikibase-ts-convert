    <rdfs:label xml:lang="en">time</rdfs:label>
    <schema:description xml:lang="en">dimension in which events can be ordered from the past through the present into the future</schema:description>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6673735</mathmoddb:P1684>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Time_in_physics</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821184">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Fritz-Schlunder 3-parameter isotherm model</rdfs:label>
    <schema:description xml:lang="en">three-parameter empirical adsorption isotherm</schema:description>
    <mathmoddb:P1459 xml:lang="en">The Fritz–Schlunder 3-parameter isotherm model is an empirical adsorption model designed to flexibly fit equilibrium data over a broad concentration range. It extends the Langmuir formulation by introducing an additional exponent describing surface heterogeneity. The model is frequently used when simpler isotherms such as Langmuir or Freundlich provide poor agreement with experimental data. It is suitable for both homogeneous and heterogeneous adsorption systems. The model does not rely on a specific adsorption mechanism and is primarily used for data correlation.</mathmoddb:P1459>
  </rdf:Description>
