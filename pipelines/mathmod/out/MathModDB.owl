  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674098">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">optimal control penalty factor</rdfs:label>
    <schema:description xml:lang="en">balance between maximizing the target versus minimizing the cost</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">In optimal control theory, a penalty factor can be used to balance between the two objectives: maximizing the target function[al] versus minimizing the cost function[al].</mathmoddb:P1459>
  </rdf:Description>
