  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675337">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">bi bi reaction ordered mechanism with single central complex (ODE model)</rdfs:label>
    <schema:description xml:lang="en">bi bi reaction with single central complex model following an ordered mechanism</schema:description>
    <mathmoddb:P1459 xml:lang="en">Ordinary differential equations for the rates of change of all chemical species (substrate 1 and 2, enzyme, enzyme - substrate 1 - complex, enzyme - substrate 1 - substrate 2 = enzyme - product 1 - product 2 - complex, enzyme - product 1 - complex and product 1 and 2 in a Bi Bi Reaction following the Ordered Mechanism with a Single Central Complex. kᵢ with positive or negative i represents the rate constant of the forward- or backward-reaction i-th reaction step.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675336</mathmoddb:P1684>
  </rdf:Description>
