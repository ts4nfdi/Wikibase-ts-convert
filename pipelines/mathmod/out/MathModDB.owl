    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Michaelis constant substrate 2 (bi bi reaction Theorell-Chance - Michaelis Menten model - steady state assumption)</rdfs:label>
