  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821380">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">rooting depth</rdfs:label>
    <schema:description xml:lang="en">depth of roots</schema:description>
    <mathmoddb:P1459 xml:lang="en">This quantity represents the vertical extent of the crop root system on a specific day. It defines the maximum soil depth from which roots can extract water and nutrients. Rooting depth increases as the crop develops and is capped by the soil profile depth. The value constrains root biomass distribution and soil–plant exchange processes. It is expressed as a length.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6821381</mathmoddb:P1684>
  </rdf:Description>
