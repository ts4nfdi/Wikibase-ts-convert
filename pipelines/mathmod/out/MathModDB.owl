  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675331">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">control system</rdfs:label>
    <schema:description xml:lang="en">system that manages the behavior of other systems</schema:description>
    <mathmoddb:P1459 xml:lang="en">In general, there are there are two types of controls: open-loop control (feedforward), and closed-loop control (feedback). In many applications of practical relevance, the state vector x is very high-dimensional, even though input u and output y may be low-dimensional.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675332</mathmoddb:P1684>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Control_theory</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb18bc545eea245779012aeda1cdfe8d5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674307"/>
    <owl:annotatedTarget>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;Ω&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
