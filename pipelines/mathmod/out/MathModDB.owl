    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">damping coefficient</rdfs:label>
    <schema:description xml:lang="en">quantifies energy dissipation in dynamic systems, inverse of the time constant of an exponentially decaying quantity</schema:description>
    <mathmoddb:P1459 xml:lang="en">Damping describes the loss of energy of an oscillating system by dissipation.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Damping</mathmoddb:P1690>
  </rdf:Description>
