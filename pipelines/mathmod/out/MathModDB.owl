    <rdfs:label xml:lang="en">birth rate</rdfs:label>
    <schema:description xml:lang="en">total number of live births per 1,000 population divided by the length of a given period in years</schema:description>
    <mathmoddb:P12 xml:lang="en">Q203516</mathmoddb:P12>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Birth_rate"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Birth Rate to be used in the SIR and SIS Models with Births and Deaths. Note that, it is assumed that death rate = birth rate.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775428">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">mean-field PDE model</rdfs:label>
    <schema:description xml:lang="en">for large population sizes particle-based dynamics may be approximated by a mean-field PDE model</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6738150"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775456"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775461"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">These equations describe the spatiotemporal evolution of the concentration of particles, depending on position and time, and approximate the empirical measure of the particle-based dynamics in the case of large N.</mathmoddb:P1459>
  </rdf:Description>
