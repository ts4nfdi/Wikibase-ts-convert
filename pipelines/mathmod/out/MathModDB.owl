  <rdf:Description rdf:nodeID="N0732f34283b042a4b40d375845685925">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775465"/>
