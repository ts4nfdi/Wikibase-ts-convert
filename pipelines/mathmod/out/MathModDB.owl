  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6824236">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of soil phosphorus supply</rdfs:label>
    <schema:description xml:lang="en">root-weighted phosphorus supply estimation</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task estimates the phosphorus supply available to the crop from the soil based on plant phosphorus demand, root biomass distribution across soil layers, and labile phosphorus availability. A nonlinear labile phosphorus uptake factor modulates root-weighted supply, allowing enhanced uptake under phosphorus-deficient conditions.</mathmoddb:P1459>
  </rdf:Description>
