  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821264">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">UNILAN isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical adsorption model with uniform energy distribution</schema:description>
    <mathmoddb:P1459 xml:lang="en">The UNILAN isotherm model is an empirical adsorption model derived by assuming a uniform distribution of adsorption energies over a heterogeneous surface. It is based on a patchwise surface concept, where each patch follows a local Langmuir isotherm, and the overall adsorption behavior is obtained by integrating over all patches. The model provides correct asymptotic behavior at both low and high solute concentrations. UNILAN is particularly useful for describing heterogeneous adsorption systems where energy variation is bounded and uniformly distributed. In the limit of vanishing heterogeneity, the model reduces to the classical Langmuir isotherm.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775766</mathmoddb:P1684>
  </rdf:Description>
