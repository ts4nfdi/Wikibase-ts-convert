  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821116">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Redlich-Peterson isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical hybrid adsorption model combining Langmuir and Freundlich</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q4760921"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821142"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821126"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821337"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821604"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821611"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821613"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821119"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821117"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821118"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">The Redlich-Peterson isotherm model is a three-parameter empirical adsorption model that combines features of both the Langmuir monolayer isotherm and the Freundlich heterogeneous isotherm. It describes adsorption using a linear dependence on concentration in the numerator and a nonlinear term in the denominator, enabling accurate representation over a wide concentration range. The model does not assume ideal monolayer adsorption and can be applied to both homogeneous and heterogeneous surfaces. Its exponent parameter controls the degree to which the model behaves like Langmuir (β close to 1) or Henry (β close to 0). Because of its versatility, the Redlich-Peterson model frequently provides excellent agreement with experimental data in chemical wastewater treatment and other adsorption applications.</mathmoddb:P1459>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775713"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775721"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
  </rdf:Description>
