  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821222">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Koble-Corrigan model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of hybrid isotherm parameters</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821215"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821216"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821217"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821218"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821221"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775714"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775722"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775767"/>
    <mathmoddb:P1459 xml:lang="en">This task involves nonlinear regression of equilibrium adsorption data to estimate the parameters of the Koble-Corrigan isotherm model. Experimental measurements of equilibrium adsorbed amount and solute concentration are fitted to the model equation. The fitting procedure determines the constants, which control adsorption capacity and saturation behavior, as well as the heterogeneity exponent. The task is commonly used when adsorption occurs on heterogeneous surfaces and cannot be adequately described by simpler Langmuir or Freundlich models alone.</mathmoddb:P1459>
  </rdf:Description>
