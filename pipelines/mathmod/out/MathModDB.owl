  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821387">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of root biomass allocation</rdfs:label>
    <schema:description xml:lang="en">allocates daily biomass growth to the root system</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task computes the fraction of daily crop biomass growth that is allocated to the root system. The allocation fraction is determined as a linear function of phenological development. The task produces a deterministic estimate of daily root biomass increment, which is used to update root system mass.</mathmoddb:P1459>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
