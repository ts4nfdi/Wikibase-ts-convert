  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684608">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">model order reduction</rdfs:label>
    <schema:description xml:lang="en">technique in mathematical modeling to effectively reduce the dimensionality of a model</schema:description>
    <mathmoddb:P12 xml:lang="en">Q12202921</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Model_order_reduction"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6672316"/>
    <mathmoddb:P1459 xml:lang="en">After spatial discretization of PDEa, solving the resulting large-scale systems of ODEs can therefore become incredibly time-consuming. Developed from well established mathematical theory and robust numerical algorithms, Model Order Reduction (MOR) has been recognized as very efficient for reducing the simulation time of large-scale systems.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684550"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684551"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684552"/>
