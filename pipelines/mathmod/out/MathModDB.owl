  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775815">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (Elovich isotherm)</rdfs:label>
    <schema:description xml:lang="en">linear estimation of Elovich adsorption parameters from equilibrium data</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Elovich equilibrium constant and the Elovich maximum adsorption capacity by fitting the linearized form of the Elovich isotherm to measured values of adsorbed amount and equilibrium solution concentration. The linearization expresses the ratio of adsorbed amount to equilibrium concentration in logarithmic form, allowing the model parameters to be obtained from the slope and intercept of a straight-line plot. The resulting parameters describe the surface heterogeneity and the exponential energy distribution assumed by the empirical Elovich model.</mathmoddb:P1459>
  </rdf:Description>
