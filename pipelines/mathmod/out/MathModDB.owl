  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821392">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of root biomass partitioning</rdfs:label>
    <schema:description xml:lang="en">quantify allocation of crop biomass to roots</schema:description>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821390"/>
    <mathmoddb:P1459 xml:lang="en">This research problem addresses the estimation of how total crop biomass growth is partitioned between aboveground and belowground components. Biomass allocation to roots varies systematically over the growing season and influences soil resource uptake. Representing this allocation is essential for modeling crop growth and plant–soil interactions. The problem focuses on capturing empirically observed shifts in partitioning as crops develop from emergence to maturity.</mathmoddb:P1459>
  </rdf:Description>
