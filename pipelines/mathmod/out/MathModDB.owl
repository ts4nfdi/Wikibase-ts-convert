  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821381">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">maximum root depth</rdfs:label>
    <schema:description xml:lang="en">crop-specific maximum rooting depth under ideal soil conditions</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">This quantity represents the maximum rooting depth attainable by a crop under ideal soil conditions. It is a crop-specific parameter reflecting genetic potential for root system expansion.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbd2ba1b02b1846af838e91b4d1bd7443">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775826"/>
    <owl:annotatedTarget xml:lang="en">&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;K&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
