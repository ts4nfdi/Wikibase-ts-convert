  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674123">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">wave vector of an electron</rdfs:label>
    <schema:description xml:lang="en">vector pointing in the direction of propagation of an electron wave and whose magnitude is equal to the wavenumber</schema:description>
    <mathmoddb:P1459 xml:lang="en">Vector pointing in the direction of a wave and whose magnitude is equal to the wavenumber. In quantum mechanics/condensed matter physics, a wave vector is the quotient of the momentum vector of particles or quasi particles and the reduced Planck constant.</mathmoddb:P1459>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Wave_vector"/>
    <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q657009"/>
  </rdf:Description>
