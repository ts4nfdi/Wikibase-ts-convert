  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821192">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Fritz-Schlunder 5-parameter isotherm model</rdfs:label>
    <schema:description xml:lang="en">high-flexibility five-parameter adsorption isotherm model</schema:description>
    <mathmoddb:P1459 xml:lang="en">The Fritz-Schlunder 5-parameter isotherm model is the most flexible member of the Fritz-Schlunder family, designed to accurately represent highly curved or complex adsorption isotherms. By combining a saturation capacity, two affinity constants, and two exponents, the model can match a wide range of heterogeneous adsorption behaviors, including systems where multilayer formation or strong site-energy diversity is present. It is fully empirical and places no mechanistic restrictions on surface behavior. It is primarily used in cases where simpler models show poor agreement with experimental data, such as in wastewater treatment adsorption studies involving highly heterogeneous adsorbents.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6316f86bede94d209ee839baa7a54e57">
