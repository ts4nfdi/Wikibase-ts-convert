    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">optimal control</rdfs:label>
    <schema:description xml:lang="en">branch of control theory that deals with finding a control for a dynamical system over a period of time such that an objective function is optimized</schema:description>
    <mathmoddb:P1459 xml:lang="en">Finding controls, e.g. external forces|fields, such that they drive a given control system from a given initial state to a specific final state (target), typically with constraints such as using not too high fields (cost).</mathmoddb:P1459>
    <mathmoddb:P12 xml:lang="en">Q1971426</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Optimal_control"/>
