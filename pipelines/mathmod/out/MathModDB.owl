  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821430">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of crop economic yield</rdfs:label>
    <schema:description xml:lang="en">calculates harvestable crop yield</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task computes crop economic yield by multiplying above-ground biomass by harvest index. It produces a final yield estimate at maturity. The task assumes non-stressed conditions unless modified by additional stress models.</mathmoddb:P1459>
  </rdf:Description>
