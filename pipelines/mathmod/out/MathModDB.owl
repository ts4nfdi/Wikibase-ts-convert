  <rdf:Description rdf:nodeID="N3f7bb05e59474996a096146272b334a4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6823150"/>
