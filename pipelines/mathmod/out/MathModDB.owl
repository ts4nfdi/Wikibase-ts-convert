  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821223">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Koble-Corrigan isotherm model</rdfs:label>
    <schema:description xml:lang="en">three-parameter hybrid adsorption isotherm</schema:description>
    <mathmoddb:P1459 xml:lang="en">The Koble-Corrigan isotherm model is an empirical adsorption model that combines features of the Langmuir and Freundlich isotherms. It is designed to describe equilibrium adsorption on heterogeneous surfaces over a wide concentration range. The model introduces an exponent to capture surface heterogeneity while retaining a saturation behavior at high concentrations. Unlike ideal monolayer models, it does not assume uniform adsorption energies. The Koble-Corrigan model is frequently applied when simpler two-parameter models fail to adequately fit experimental adsorption data.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775713</mathmoddb:P1684>
  </rdf:Description>
