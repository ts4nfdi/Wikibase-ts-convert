  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821602">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of crop water use</rdfs:label>
    <schema:description xml:lang="en">quantify plant water uptake from soil</schema:description>
    <mathmoddb:P1459 xml:lang="en">This research problem addresses how crops extract water from the soil to meet atmospheric demand. Plant water use depends on canopy development, soil moisture availability, and the ability of plants to compensate for local water deficits. The problem links soil hydrology with plant physiological demand.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684587">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (uni uni reaction without product and competitive complete inhibition - Hanes Woolf model - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">linear fit to determine the limiting reaction rate, michaelis constant and inhibition constants</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q3241536</mathmoddb:P558>
  </rdf:Description>
