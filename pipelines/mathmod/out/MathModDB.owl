    <rdfs:label xml:lang="en">uni uni reaction with reversible complete inhibition</rdfs:label>
    <schema:description xml:lang="en">uni uni reaction with inhibition</schema:description>
    <mathmoddb:P1459 xml:lang="en">Uni Uni Reaction with reversible inhibition. The enzyme-inhibitor-substrate complex (EIS) cannot form product, the inhibition is thus complete.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684685</mathmoddb:P1684>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674445">
