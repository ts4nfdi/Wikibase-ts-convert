  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674191">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">substrate 1 concentration ODE (bi bi reaction ordered with single central complex)</rdfs:label>
    <schema:description xml:lang="en">ordinary differential equation describing the concentration over time in an ordered bi bi reaction with a Single Central complex</schema:description>
