    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">quantum model (closed system)</rdfs:label>
    <schema:description xml:lang="en">quantum dynamics of a closed system, i.e., a system that is not interacting with its environment</schema:description>
    <mathmoddb:P1459 xml:lang="en">A famous example is Schrödinger's cat, but only as long as the box is not opened!</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6534342</mathmoddb:P1684>
  </rdf:Description>
