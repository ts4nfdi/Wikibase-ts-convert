  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674355">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">finite volume method</rdfs:label>
    <schema:description xml:lang="en">method for representing and evaluating partial differential equations in the form of algebraic equations</schema:description>
    <mathmoddb:P1459 xml:lang="en">In the finite volume method, volume integrals in a partial differential equation that contain a divergence term are converted to surface integrals, using the divergence theorem. These terms are then evaluated as fluxes at the surfaces of each finite volume.</mathmoddb:P1459>
    <mathmoddb:P1459 xml:lang="en">Finite volume methods can be compared and contrasted with the finite difference methods, which approximate derivatives using nodal values, or finite element methods, which create local approximations of a solution using local data, and construct a global approximation by stitching them together.</mathmoddb:P1459>
    <mathmoddb:P12 xml:lang="en">Q1401936</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Finite_volume_method"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q5981696"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
