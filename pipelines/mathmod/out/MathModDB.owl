  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820971">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Kiselev model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Kiselev model parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820973"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820974"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820976"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820992"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Kiselev equilibrium constant and the complex formation constant. The nonlinear Kiselev equation is fitted directly to coverage and concentration values to capture the formation of complexes between adsorbed molecules. The results quantify adsorption affinity and the strength of lateral associative interactions. This method avoids potential distortions caused by linearization.</mathmoddb:P1459>
    <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820972"/>
  </rdf:Description>
