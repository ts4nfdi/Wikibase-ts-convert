  <rdf:Description rdf:nodeID="N21eb3c0bea8e493989f529521659972f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674498"/>
