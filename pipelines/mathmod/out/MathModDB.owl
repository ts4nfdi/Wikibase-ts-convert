  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821160">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Toth isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical adsorption isotherm for heterogeneous surfaces</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q1110333</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">The Toth isotherm model is an empirical adsorption model developed to improve discrepancies between Langmuir predictions and experimental equilibrium data for heterogeneous adsorbents. It accounts for an asymmetric quasi-Gaussian distribution of adsorption energies and is suitable for Type I isotherms and for some multilayer adsorption situations. The model behaves correctly in both low- and high-concentration limits. It approaches the Langmuir isotherm when the heterogeneity parameter equals one. The Toth model is commonly used to represent adsorption processes in porous or energetically non-uniform materials.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775766</mathmoddb:P1684>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775648">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">Monod constant</rdfs:label>
    <schema:description xml:lang="en">concentration at which the growth rate is half the maximum growth rate</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775763</mathmoddb:P558>
  </rdf:Description>
