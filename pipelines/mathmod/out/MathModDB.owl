  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821355">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">leaf area index model</rdfs:label>
    <schema:description xml:lang="en">model simulating temporal development of canopy leaf area</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821278"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821306"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821310"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821311"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821354"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model simulates the temporal evolution of leaf area index for a crop canopy over the growing season. Leaf area development is driven by phenological progress and constrained by crop-specific maximum values. During early growth stages, the model represents leaf expansion, while during later stages it accounts for leaf senescence and decline. Crop stress factors may reduce the rate of leaf area development relative to potential conditions. The simulated leaf area index is used to control canopy processes such as radiation interception and energy exchange.</mathmoddb:P1459>
  </rdf:Description>
