  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675444">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">symmetric top (combined)</rdfs:label>
    <schema:description xml:lang="en">modeling a polar oblate or prolate molecule as a rigid symmetric top, interacting with electric fields</schema:description>
    <mathmoddb:P1459 xml:lang="en">Modeling a polar oblate (e.g. C6H6) or prolate (e.g. CH3Cl) molecule as a rigid symmetric top, interacting through both its permanent and induced electric dipole moment with electric fields. Note that analytical solutions to the TISE are available, see corresponding Task.</mathmoddb:P1459>
  </rdf:Description>
