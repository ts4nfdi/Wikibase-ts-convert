    <rdfs:label xml:lang="en">pair function</rdfs:label>
    <schema:description xml:lang="en">non-negative pair function used to weight interaction between two individuals</schema:description>
    <mathmoddb:P1459 xml:lang="en">Non-negative pair function used to weight interaction between two individuals, e.g., placing exponentially more weight on close-by individuals or having interactions irrespective of the opinion distance between individuals.</mathmoddb:P1459>
  </rdf:Description>
