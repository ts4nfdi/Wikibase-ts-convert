  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6773489">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">internalised receptor recycled to the cell membrane</rdfs:label>
