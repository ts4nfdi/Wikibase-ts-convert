  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820978">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Volmer model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Volmer affinity constant</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q4479187"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820979"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820980"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Volmer affinity constant. The nonlinear Volmer equation is fitted directly to fractional surface coverage and equilibrium concentration values, capturing the effect of adsorbate mobility on the adsorbent surface. The results quantify adsorption affinity while assuming no lateral interactions among adsorbed molecules. This approach avoids distortions caused by data linearization and is suitable for systems exhibiting mobile monolayer adsorption.</mathmoddb:P1459>
  </rdf:Description>
