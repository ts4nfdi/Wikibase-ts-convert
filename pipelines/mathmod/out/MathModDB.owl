  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675383">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Langevin dynamics</rdfs:label>
    <schema:description xml:lang="en">mathematical model typically used to describe the dynamics of systems subject to a combination of deterministic and fluctuating forces</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775520</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">The approach is characterized by the use of simplified models while accounting for omitted degrees of freedom only implicitly, i.e., by the use of stochastic differential equations.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675382</mathmoddb:P1684>
  </rdf:Description>
