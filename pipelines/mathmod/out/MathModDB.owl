    <rdfs:label xml:lang="en">Michaelis Menten equation (bi bi reaction ping pong without products - Michaelis Menten model - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">equation for bi bi reaction with ping pong mechanism without products following steady state assumption</schema:description>
