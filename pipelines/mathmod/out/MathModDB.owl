  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6534341">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">semiconductor charge neutrality</rdfs:label>
    <schema:description xml:lang="en">concept of local charge neutrality in semiconductor</schema:description>
    <mathmoddb:P1459 xml:lang="en">The physical concept of local charge neutrality in semiconductor is characterized by the absence of space charge regions. Hence, the Poisson equation for the electric field potential simplifies to the Laplace equation.</mathmoddb:P1459>
  </rdf:Description>
