  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821431">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">harvest index development model</rdfs:label>
    <schema:description xml:lang="en">model simulating temporal development of harvest index</schema:description>
    <mathmoddb:P1459 xml:lang="en">This model simulates the development of harvest index over the growing season. Harvest index represents the fraction of above-ground biomass allocated to crop yield. The model assumes that harvest index increases non-linearly from planting to maturity under non-stressed conditions. Development is controlled by phenological progress using a heat unit based scaling factor. The simulated harvest index is used to compute final crop yield.</mathmoddb:P1459>
  </rdf:Description>
