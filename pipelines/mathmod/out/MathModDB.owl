  <rdf:Description rdf:nodeID="N6d48ec4403dc44c2b748e7ae0d35b1b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673902"/>
