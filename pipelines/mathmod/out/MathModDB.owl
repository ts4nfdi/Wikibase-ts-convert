  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775818">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">linear Elovich isotherm equation</rdfs:label>
    <schema:description xml:lang="en">empirical adsorption equation based on exponential energy variation</schema:description>
