    <rdfs:label xml:lang="en">Baudu affinity exponent</rdfs:label>
    <schema:description xml:lang="en">exponent governing concentration dependence of affinity</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
