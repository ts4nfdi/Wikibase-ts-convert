  <rdf:Description rdf:nodeID="Nf67580b0ebd947099ffdd5bd4918b3af">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674515"/>
