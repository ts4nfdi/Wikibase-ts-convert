  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820982">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Flory-Huggins model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Flory–Huggins parameters</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6820990</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task fits the nonlinear Flory–Huggins equation to adsorption data to estimate the Flory–Huggins equilibrium constant and the occupancy number. It uses experimental initial and equilibrium concentrations and measured uptake to directly obtain parameter estimates without data linearization. The outputs quantify the effective site occupancy per adsorbate and the equilibrium parameter used to evaluate spontaneity.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675410">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Gamma-Gompertz-Makeham model</rdfs:label>
    <schema:description xml:lang="en">mathematical model for the mortality based on a Gamma-Gompertz-Makeham law</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775521</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">We assume that death counts at age x are Poisson-distributed and the underlying population level hazard function follows a Gamma-Gompertz-Makeham model.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://www.wikidata.org/wiki/Q2734378</mathmoddb:P1690>
  </rdf:Description>
