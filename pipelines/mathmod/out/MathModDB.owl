    <rdfs:label xml:lang="en">generalized Poisson distribution</rdfs:label>
    <schema:description xml:lang="en">obtained by solving the stationary mgRDME for the generalized compartment based model</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775559</mathmoddb:P558>
