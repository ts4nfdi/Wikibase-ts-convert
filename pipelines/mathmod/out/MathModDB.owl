  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673864">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">mass diffusivity</rdfs:label>
    <schema:description xml:lang="en">proportionality constant between the molar flux  and the negative value of the gradient in the concentration of the species</schema:description>
    <mathmoddb:P1459 xml:lang="en">Diffusion coefficient is usually written as the proportionality constant between the molar flux due to molecular diffusion and the negative value of the gradient in the concentration of the species.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6673917</mathmoddb:P1684>
  </rdf:Description>
