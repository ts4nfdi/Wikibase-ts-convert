  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674132">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">anharmonicity constant (perturbation theory)</rdfs:label>
    <schema:description xml:lang="en">anharmonicity constants, derived by using second order (non-degenerate) perturbation theory</schema:description>
    <mathmoddb:P1459 xml:lang="en">Considering the comparable magnitude of contributions of cubic anharmonicity in second order and  quartic anharmonicity in first order.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Anharmonicity</mathmoddb:P1690>
    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mtable displaystyle="true"&gt;&lt;mtr&gt;&lt;mtd class="mwe-math-columnalign-r"&gt;&lt;msub&gt;&lt;mi&gt;χ&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mtd&gt;&lt;mtd class="mwe-math-columnalign-l"&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;/mtd&gt;&lt;mtd class="mwe-math-columnalign-r"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mfrac&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;16&lt;/mn&gt;&lt;/mrow&gt;&lt;/mfrac&gt;&lt;/mrow&gt;&lt;msub&gt;&lt;mi&gt;ϕ&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;−&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mfrac&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;16&lt;/mn&gt;&lt;/mrow&gt;&lt;/mfrac&gt;&lt;/mrow&gt;&lt;munderover&gt;&lt;mo movablelimits="false" stretchy="false"&gt;∑&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;s&lt;/mi&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;3&lt;/mn&gt;&lt;mi&gt;N&lt;/mi&gt;&lt;mo stretchy="false"&gt;−&lt;/mo&gt;&lt;mn&gt;6&lt;/mn&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/munderover&gt;&lt;msubsup&gt;&lt;mi&gt;ϕ&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;r&lt;/mi&gt;&lt;mi&gt;s&lt;/mi&gt;