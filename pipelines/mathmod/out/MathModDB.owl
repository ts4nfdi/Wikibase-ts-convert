  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821056">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Jovanovic model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Jovanovic model parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775770"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821055"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821062"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775722"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Jovanovic equilibrium constant and the Jovanovic maximum adsorption capacity by directly fitting the nonlinear Jovanovic equation to measured solute concentration and adsorbed amount data. The nonlinear approach avoids distortions introduced by linear transformations and preserves the exponential saturation behavior characteristic of the model. The results describe the adsorption affinity and the gradual approach to saturation predicted by the Jovanovic isotherm.</mathmoddb:P1459>
  </rdf:Description>
