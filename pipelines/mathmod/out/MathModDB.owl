  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821298">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">heat unit response shape parameters</rdfs:label>
    <schema:description xml:lang="en">shape parameters of HUF sigmoid curve</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">These crop-specific parameters determine the shape and steepness of the sigmoid relationship between heat unit index and heat unit factor. They are computed by fitting the heat unit factor equation to two predefined calibration points. The parameters remain constant throughout the simulation. They reflect phenological characteristics specific to each crop.</mathmoddb:P1459>
  </rdf:Description>
