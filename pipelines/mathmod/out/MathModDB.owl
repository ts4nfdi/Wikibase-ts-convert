    <rdfs:label xml:lang="en">muscle spindle firing rate</rdfs:label>
    <schema:description xml:lang="en">frequency at which sensory neurons within the muscle spindle transmit signals to the central nervous system</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
