  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821315">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">potential crop growth model (biomass)</rdfs:label>
    <schema:description xml:lang="en">radiation-driven crop biomass production under optimal conditions</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821314"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821307"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821313"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821352"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821358"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model determines crop biomass production assuming no limitations from water, nutrients, pests, or diseases. Growth is driven by intercepted solar radiation and a crop-specific radiation use efficiency parameter. The model represents the maximum achievable growth rate under prevailing weather conditions. Phenological development controls the timing and partitioning of growth but does not constrain resource availability. The resulting biomass represents potential growth against which stress effects are later applied.</mathmoddb:P1459>
  </rdf:Description>
