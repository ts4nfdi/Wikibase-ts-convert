    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msubsup&gt;&lt;mo stretchy="false"&gt;∫&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi data-mjx-variant="-tex-mathit"&gt;𝛺&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;/mrow&gt;&lt;/msubsup&gt;&lt;mrow data-mjx-texclass="INNER"&gt;&lt;mo data-mjx-texclass="OPEN"&gt;(&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mfrac&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;∂&lt;/mi&gt;&lt;mi&gt;w&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;∂&lt;/mi&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/mfrac&gt;&lt;/mrow&gt;&lt;mi&gt;v&lt;/mi&gt;&lt;mo stretchy="false"&gt;−&lt;/mo&gt;&lt;mi&gt;Q&lt;/mi&gt;&lt;mo stretchy="false"&gt;⋅&lt;/mo&gt;&lt;mi mathvariant="normal"&gt;∇&lt;/mi&gt;&lt;mi&gt;v&lt;/mi&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;mi&gt;E&lt;/mi&gt;&lt;mo stretchy="false"&gt;⋅&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;𝐣&lt;/mi&gt;&lt;/mrow&gt;&lt;mi&gt;v&lt;/mi&gt;&lt;mo stretchy="false"&gt;−&lt;/mo&gt;&lt;mover&gt;&lt;mi&gt;S&lt;/mi&gt;&lt;mo&gt;~&lt;/mo&gt;&lt;/mover&gt;&lt;mi&gt;v&lt;/mi&gt;&lt;mo data-mjx-texclass="CLOSE"&gt;)&lt;/mo&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi mathvariant="normal"&gt;d&lt;/mi&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi data-mjx-variant="-tex-mathit"&gt;𝛺&lt;/mi&gt;&lt;/mrow&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;msubsup&gt;&lt;mo stretchy="false"&gt;∫&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;∂&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi data-mjx-variant="-tex-mathit"&gt;𝛺&lt;/mi&gt;&lt;/mrow&