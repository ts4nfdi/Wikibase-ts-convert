    <rdfs:label xml:lang="en">continuity equation for electrons (finite volume)</rdfs:label>
    <schema:description xml:lang="en">used within the Scharfetter-Gummel finite volume disretization scheme</schema:description>
    <mathmoddb:P1459 xml:lang="en">Used within the Scharfetter-Gummel finite volume disretization scheme which is the standard numerical method for solving the van Roosbroeck system.</mathmoddb:P1459>
