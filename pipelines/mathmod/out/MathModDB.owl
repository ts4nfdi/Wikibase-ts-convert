    <rdfs:label xml:lang="en">enzyme - substrate 1 - substrate 2 - complex concentration ODE (bi bi reaction ordered)</rdfs:label>
    <schema:description xml:lang="en">ordinary differential equation describing the concentration over time in an ordered bi bi reaction</schema:description>
