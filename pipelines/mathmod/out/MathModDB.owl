    <schema:description xml:lang="en">describes how a density operator (for pure or for mixed states) evolves in time</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q564712</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Note the similarity with the classical Liouville equation where the commutator brackets [.,.] are replaced by Poisson brackets {.,.}</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6534305</mathmoddb:P1684>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Density_matrix#Von_Neumann_equation_for_time_evolution</mathmoddb:P1690>
