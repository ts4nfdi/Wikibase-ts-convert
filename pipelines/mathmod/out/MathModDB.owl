    <rdfs:label xml:lang="en">ELSST Thesaurus ID (Version 4 - 2023)</rdfs:label>
    <schema:description xml:lang="en">identifier for a term in the ELSST (European Language Social Science) Thesaurus (Version 4 - 2023)</schema:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674235">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
