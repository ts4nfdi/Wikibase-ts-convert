  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820956">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Temkin isotherm model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Temkin isotherm parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820958"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820959"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820961"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820993"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820957"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data based on the Temkin isotherm model. It determines the Temkin equilibrium constant and the adsorption-energy variation by fitting the nonlinear Temkin equation directly to measured adsorbate concentrations and fractional coverage values. Nonlinear regression provides unbiased estimates by avoiding distortions introduced through logarithmic linearization. The resulting parameters describe how adsorption energy decreases with increasing surface coverage. This method is commonly applied in environmental chemistry and materials analysis for systems involving significant adsorbate–adsorbent interactions.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N03d36eb1c48941b4bc6f89d36c4dbd9a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q7284044"/>
    <owl:annotatedTarget xml:lang="en">&lt;math class="mwe-math-element mwe-math-element-inline" xmlns="http://www.w3.org/1998/Math/MathML"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;T&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
