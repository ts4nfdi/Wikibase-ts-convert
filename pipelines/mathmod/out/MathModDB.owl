    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">far field radiation</rdfs:label>
    <schema:description xml:lang="en">electromagnetic radiation behaviors that predominate at greater distances</schema:description>
    <mathmoddb:P1459 xml:lang="en">The far field is a region of the electromagnetic (EM) field around an object, such as a transmitting antenna, or the result of radiation scattering off an object. Electromagnetic radiation far-field behaviors predominate at greater distances.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Near_and_far_field</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N93938f13d414436fb43700517588d8ad">
