    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Verlet integration</rdfs:label>
    <schema:description xml:lang="en">sympletic, reversible time-discretization of Newton's equations of motion</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q3258992</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Originally discovered already by Newton: Essentially a symmetric (and symplectic!) combination of Euler forward and backward methods.</mathmoddb:P1459>
