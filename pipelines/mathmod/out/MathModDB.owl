    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">opinion model with influencers and media</rdfs:label>
    <schema:description xml:lang="en">general opinion model considering individuals, traditional media and social media influencers</schema:description>
    <mathmoddb:P1459 xml:lang="en">General opinion model resulting from a large number of individuals adapting their opinions through interaction with each other as well as due to the influence of a few specific agents with particular roles, namely traditional media and social media influencers.</mathmoddb:P1459>
  </rdf:Description>
