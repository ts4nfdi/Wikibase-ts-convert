  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821130">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Dubinin-Radushkevich model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Dubinin-Radushkevich parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821129"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821131"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821132"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using equilibrium adsorption data to determine the theoretical Dubinin-Radushkevich isotherm saturation capacity and the Dubinin-Radushkevich isotherm constant . The nonlinear Dubinin-Radushkevich equation is fitted directly to equilibrium adsorption values determined by experimental adsorption measurements, using the Polanyi potential to capture the effective adsorption work. Because the Dubinin-Radushkevich model is temperature-dependent, it can consolidate multi-temperature data into a single characteristic curve that describes micropore filling behavior.</mathmoddb:P1459>
  </rdf:Description>
