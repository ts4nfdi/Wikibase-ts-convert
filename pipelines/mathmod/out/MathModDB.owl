  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684646">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">molecular reaction dynamics</rdfs:label>
    <schema:description xml:lang="en">branch of physical chemistry that deals with observing and understang chemical reactions in real time and on an atomistic basis</schema:description>
    <mathmoddb:P1459 xml:lang="en">Although there were first attempts in the 1930s (first trajectory calculations for H+H2 reaction calculated by Polanyi in Berlin-Dahlem), this field has strongy evolved since the 1970s and 1980s with the upcoming of short laser pulses.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://www.nobelprize.org/prizes/chemistry/1999/summary</mathmoddb:P1690>
  </rdf:Description>
