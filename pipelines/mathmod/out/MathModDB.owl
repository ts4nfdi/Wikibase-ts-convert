  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q7270342">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">governing equation</rdfs:label>
    <schema:description xml:lang="en">equations describing behavior of a model</schema:description>
    <mathmoddb:P12 xml:lang="en">Q3730895</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Governing_equation"/>
