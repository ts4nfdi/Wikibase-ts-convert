  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822041">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">adjustment of nitrogen uptake to crop demand</rdfs:label>
    <schema:description xml:lang="en">scaling nitrogen uptake to match crop demand</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task adjusts the potential nitrogen supply from each soil layer to ensure consistency with crop nitrogen demand. It enforces upper bounds based on soil nitrate availability and allows compensation when mass flow alone is insufficient. The result represents the actual nitrogen uptake used in crop growth calculations.</mathmoddb:P1459>
  </rdf:Description>
