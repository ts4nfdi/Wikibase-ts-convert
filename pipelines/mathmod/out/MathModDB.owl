  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775766">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Langmuir isotherm model</rdfs:label>
    <schema:description xml:lang="en">equation that relates the coverage or adsorption of molecules on a solid surface to gas pressure or concentration of a medium above the solid surface at a fixed temperature in equilibrium</schema:description>
  </rdf:Description>
