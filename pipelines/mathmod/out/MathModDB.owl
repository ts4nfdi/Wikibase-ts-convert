  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775645">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Monod equation)</rdfs:label>
    <schema:description xml:lang="en">Monod equation</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775763</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental data for substrate concentration and specific growth rate. The objective is to determine the maximum specific growth rate and Monod constant by fitting the model to the data.</mathmoddb:P1459>
  </rdf:Description>
