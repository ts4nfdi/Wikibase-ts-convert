  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684609">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">near field radiation</rdfs:label>
    <schema:description xml:lang="en">electromagnetic radiation behaviors that predominate at shorter distances</schema:description>
    <mathmoddb:P1459 xml:lang="en">The near field is a region of the electromagnetic (EM) field around an object, such as a transmitting antenna, or the result of radiation scattering off an object. Non-radiative near-field behaviors dominate close to the antenna or scatterer.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Near_and_far_field"/>
    <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Near-field_optics"/>
    <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q6984336"/>
  </rdf:Description>
