  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673882">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">number of susceptible individuals</rdfs:label>
    <schema:description xml:lang="en">number</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">The number of susceptible individuals. When a susceptible and an infectious individual come into infectious contact, the susceptible individual contracts the disease and transitions to the infectious compartment.</mathmoddb:P1459>
  </rdf:Description>
