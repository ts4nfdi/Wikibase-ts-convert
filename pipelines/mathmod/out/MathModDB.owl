  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684676">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">molecular spectroscopy</rdfs:label>
    <schema:description xml:lang="en">measurement (or simulation) of interactions between electromagnetic waves and matter</schema:description>
    <mathmoddb:P1459 xml:lang="en">Rotations are collective motions of the atomic nuclei and typically lead to spectra in the microwave and millimeter-wave spectral regions. Vibrations are relative motions of the atomic nuclei and are studied by both infrared and Raman spectroscopy. Electronic excitations are studied using visible and ultraviolet spectroscopy as well as fluorescence spectroscopy.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684647</mathmoddb:P1684>
  </rdf:Description>
