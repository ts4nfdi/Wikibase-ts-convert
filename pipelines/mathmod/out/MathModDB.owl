    <rdfs:label xml:lang="en">time-dependent Schrödinger equation (Strang-Marchuk)</rdfs:label>
    <schema:description xml:lang="en">second order (Strang-Marchuk) split operator scheme for numerical integration of the time-dependent Schrödinger equation</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q1565702</mathmoddb:P558>
