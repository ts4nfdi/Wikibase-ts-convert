    <mathmoddb:P12 xml:lang="en">Q377930</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Classical_electromagnetism"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
    <mathmoddb:P1459 xml:lang="en">Branch of theoretical physics that studies electromagnetic fields, waves, and forces between electric charges and currents.</mathmoddb:P1459>
  </rdf:Description>
