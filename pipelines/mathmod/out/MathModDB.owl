    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">s̃₂, ẽ₂, ĩ₂, r̃₂ are assumed to to be approximately zero, since they become vanishingly small as D (Diffusion Coefficient) becomes large.</mathmoddb:P1459>
