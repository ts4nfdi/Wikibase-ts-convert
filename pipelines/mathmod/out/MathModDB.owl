  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821576">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">hydrology</rdfs:label>
    <schema:description xml:lang="en">science that deals with the water above, on and below the land surface of the earth</schema:description>
    <mathmoddb:P1459 xml:lang="en">Hydrology is the scientific study of the occurrence, movement, distribution, and quality of water on Earth and in the atmosphere. It examines the processes of the water cycle, including precipitation, evaporation, infiltration, runoff, and groundwater flow. Hydrology provides the theoretical and methodological basis for understanding water availability in natural and managed systems. The discipline supports applications in water resource management, agriculture, ecology, and environmental protection.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6821603</mathmoddb:P1684>
  </rdf:Description>
