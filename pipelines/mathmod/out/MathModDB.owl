    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;W&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;o&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;≡&lt;/mo&gt;&lt;msubsup&gt;&lt;mo stretchy="false"&gt;∫&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi mathvariant="normal"&gt;∞&lt;/mi&gt;&lt;/mrow&gt;&lt;/msubsup&gt;&lt;msup&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;msup&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mo stretchy="false"&gt;*&lt;/mo&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;msup&gt;&lt;mi&gt;C&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mo stretchy="false"&gt;*&lt;/mo&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;mi&gt;C&lt;/mi&gt;&lt;msup&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi mathvariant="normal"&gt;d&lt;/mi&gt;&lt;/mrow&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
