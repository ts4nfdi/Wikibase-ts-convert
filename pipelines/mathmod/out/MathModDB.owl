  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820964">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (Fowler-Guggenheim isotherm model)</rdfs:label>
    <schema:description xml:lang="en">linear estimation of Fowler–Guggenheim parameters</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q561111</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task estimates the Fowler–Guggenheim equilibrium constant and the interaction energy using the linearized form of the isotherm. Experimental equilibrium data are transformed and fitted using linear regression, providing a simplified estimation method. While computationally efficient, this approach may introduce bias from linearization. The results characterize the adsorption affinity and the sign and magnitude of lateral adsorption interactions.</mathmoddb:P1459>
  </rdf:Description>
