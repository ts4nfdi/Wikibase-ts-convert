  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675396">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">drift-diffusion model</rdfs:label>
    <schema:description xml:lang="en">mathematical model for semiclassical transport of free electrons and holes in a self-consistent electric field</schema:description>
    <mathmoddb:P1459 xml:lang="en">Semiconductor drift-diffusion models are closely related to reaction–diffusion systems and Poisson–Nernst–Planck models. The latter are used in biological applications to model electro-diffusive ion transport through ion channels across cell membranes.</mathmoddb:P1459>
    <mathmoddb:P1656 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675388</mathmoddb:P1656>
    <mathmoddb:P1690 xml:lang="en">https://archive.org/details/bstj29-4-560</mathmoddb:P1690>
  </rdf:Description>
