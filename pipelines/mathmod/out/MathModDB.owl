  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775644">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Monod equation</rdfs:label>
    <schema:description xml:lang="en">Empirical model for microorganisms growth</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775763</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">The Monod model explains how the specific growth rate of microorganisms depends on the availability of a limiting nutrient. It shows that the specific growth rate increases with nutrient concentration but eventually levels off when the microorganisms reach their maximum specific growth rate.</mathmoddb:P1459>
  </rdf:Description>
