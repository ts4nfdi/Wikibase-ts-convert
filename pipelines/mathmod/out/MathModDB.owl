  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775435">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">mean-field Ehrenfest</rdfs:label>
    <schema:description xml:lang="en">mean-field or Ehrenfest approach to quantum-classical dynamics</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q561166</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">The trajectories for the heavy particle(s) are propagated on a weighted average of potential energy surfaces of the light particle(s). The weights are determined by the amount of nonadiabatic mixing.</mathmoddb:P1459>
    <mathmoddb:P1656 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q7257548</mathmoddb:P1656>
  </rdf:Description>
