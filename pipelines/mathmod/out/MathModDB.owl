    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">enzyme conservation</rdfs:label>
    <schema:description xml:lang="en">enzyme molecules are neither formed nor destroyed during the reaction</schema:description>
