    <rdfs:label xml:lang="en">computation of crop nitrogen demand</rdfs:label>
    <schema:description xml:lang="en">determine daily nitrogen demand of the crop</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
