  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775822">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Hill-de Boer model)</rdfs:label>
    <schema:description xml:lang="en">Hill-de Boer model</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775777"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775821"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775825"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Hill–de Boer constant and the interaction energy constant by fitting the nonlinear Hill–de Boer equation directly to measured equilibrium concentration and fractional surface coverage data. The results quantify adsorption affinity and the magnitude of lateral interactions between adsorbed molecules without the distortions introduced by linearization. This approach provides a more accurate representation of nonideal adsorption behavior described by the model.</mathmoddb:P1459>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q577036"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
    <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775823"/>
  </rdf:Description>
