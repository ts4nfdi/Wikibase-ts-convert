    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">integral of the total population density (initial condition)</rdfs:label>
    <schema:description xml:lang="en">integral of the total population density initial condition</schema:description>
