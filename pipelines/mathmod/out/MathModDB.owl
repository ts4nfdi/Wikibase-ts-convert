  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673865">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">white noise</rdfs:label>
    <schema:description xml:lang="en">delta-correlated stationary Gaussian process with zero-mean</schema:description>
    <mathmoddb:P12 xml:lang="en">Q381287</mathmoddb:P12>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/White_noise"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1459 xml:lang="en">Delta-correlated stationary Gaussian process with zero-mean, i.e., a random signal with equal intensity at all frequencies, yielding a constant power spectral density.</mathmoddb:P1459>
    <mathmoddb:P1994 xml:lang="en">white noise</mathmoddb:P1994>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
