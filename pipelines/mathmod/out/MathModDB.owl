    <rdfs:label xml:lang="en">birth rate</rdfs:label>
    <schema:description xml:lang="en">total number of live births per 1,000 population divided by the length of a given period in years</schema:description>
    <mathmoddb:P1459 xml:lang="en">Birth Rate to be used in the SIR and SIS Models with Births and Deaths. Note that, it is assumed that death rate = birth rate.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674191">
