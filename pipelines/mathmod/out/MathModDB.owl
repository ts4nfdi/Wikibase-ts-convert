    <rdfs:label xml:lang="en">inhibition constant product 1 (bi bi reaction ping pong - Michaelis Menten model - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">inhibition constant</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6773641</mathmoddb:P558>
