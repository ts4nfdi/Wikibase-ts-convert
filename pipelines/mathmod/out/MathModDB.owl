    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">susceptible infectious susceptible model with births and deaths</rdfs:label>
    <schema:description xml:lang="en">discrete-time SIS model with births and deaths</schema:description>
  </rdf:Description>
