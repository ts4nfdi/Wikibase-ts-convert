  <rdf:Description rdf:nodeID="N6370ebdba56742aa97d7e265d55bd014">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674241"/>
