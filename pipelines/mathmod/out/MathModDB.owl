    <rdfs:label xml:lang="en">quantum model (open system)</rdfs:label>
    <schema:description xml:lang="en">quantum dynamics of an open system, i.e., a system that interacts with its environment</schema:description>
    <mathmoddb:P1459 xml:lang="en">Quantum dynamics of an open system, i.e., a system that can exchange phase (e.g. in elastic collisions) and/or energy (e.g. in inelastic collisions) with its environment.</mathmoddb:P1459>
