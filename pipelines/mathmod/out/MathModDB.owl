  <rdf:Description rdf:nodeID="Nff80e6c0f26e47a792f02b00b6c376f5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775461"/>
