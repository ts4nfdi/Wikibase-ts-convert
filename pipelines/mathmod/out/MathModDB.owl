  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6534343">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">spin qbit shuttling</rdfs:label>
    <schema:description xml:lang="en">novel functional elements in modular architectures of semiconductor quantum processors</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6672211"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534342"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6675331"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6675332"/>
    <mathmoddb:P1640 rdf:resource="https://portal.mardi4nfdi.de/wiki/File:3082a.jpg"/>
    <mathmoddb:P1640 rdf:resource="https://portal.mardi4nfdi.de/wiki/File:3082b.jpg"/>
    <mathmoddb:P1459 xml:lang="en">Spin-qubit shuttles are novel functional elements in modular architectures of semiconductor quantum processors, that have the capability of solving the scalability problem. Such coherent quantum links serve to interconnect different processor units and enable the transfer of quantum information over longer distances across the chip by physical transport of electrons.</mathmoddb:P1459>
  </rdf:Description>
