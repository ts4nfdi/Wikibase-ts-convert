gt;&lt;/mtr&gt;&lt;/mtable&gt;&lt;mo fence="true" stretchy="true" symmetric="true" data-mjx-texclass="CLOSE"&gt;)&lt;/mo&gt;&lt;/mrow&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
