  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821282">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">canopy light attenuation coefficient</rdfs:label>
    <schema:description xml:lang="en">attenuation of light within a plant canopy</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">This coefficient quantifies the exponential attenuation of incoming radiation as it passes through a plant canopy. It represents the combined effects of absorption and scattering by leaves and other plant organs. The parameter is used in Beer–Lambert type equations to estimate radiation interception from leaf area index. Its value depends on canopy architecture and leaf orientation. It is a specialization of a general attenuation coefficient applied to plant canopies.</mathmoddb:P1459>
  </rdf:Description>
