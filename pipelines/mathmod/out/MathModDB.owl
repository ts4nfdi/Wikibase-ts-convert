  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775642">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">microbiology</rdfs:label>
    <schema:description xml:lang="en">study of microscopic organisms</schema:description>
    <mathmoddb:P12 xml:lang="en">Q7193</mathmoddb:P12>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775643"/>
    <mathmoddb:P356 rdf:resource="http://commons.wikimedia.org/wiki/Special:FilePath/Agar%20plate%20with%20colonies.jpg"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Microbiology is the scientific study of microorganisms, including bacteria, viruses, fungi, and other microscopic life forms. It explores their structure, function, ecology, and roles in health, disease, and the environment. The discipline connects fundamental biology with applications in medicine, biotechnology, and industry.</mathmoddb:P1459>
  </rdf:Description>
