  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821351">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of daylength</rdfs:label>
    <schema:description xml:lang="en">calculates daily daylight duration</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6480497"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821287"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821289"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821302"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821303"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task computes the duration of daylight for a given day and geographic location using latitude and solar declination angle. The task produces a deterministic estimate of photoperiod for each simulation day. The resulting daylength is used to modulate radiation-driven and phenology-dependent biological processes.</mathmoddb:P1459>
  </rdf:Description>
