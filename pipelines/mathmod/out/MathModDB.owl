  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6824237">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">plant phosphorus uptake and demand model</rdfs:label>
    <schema:description xml:lang="en">supply-demand model of plant phosphorus uptake</schema:description>
    <mathmoddb:P1459 xml:lang="en">A deterministic agroecosystem model that estimates daily plant phosphorus demand based on biomass accumulation and optimal phosphorus concentration, and compares it with soil phosphorus supply determined by root distribution and labile soil phosphorus availability.</mathmoddb:P1459>
  </rdf:Description>
