  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674269">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">backward Euler method</rdfs:label>
    <schema:description xml:lang="en">one of the most basic numerical methods in numerical analysis and scientific computing for the solution of ordinary differential equations</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6480817</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Similar to the (standard, forward, explicit) Euler method, but differs in that it is an implicit method. The backward Euler method has error of order one in time.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6674305</mathmoddb:P1684>
    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;y&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;msub&gt;&lt;mi&gt;y&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mi&gt;h&lt;/mi&gt;&lt;mi&gt;f&lt;/mi&gt;&lt;mrow data-mjx-texclass="INNER"&gt;&lt;mo data-mjx-texclass="OPEN"&gt;(&lt;/mo&gt;&lt;msub&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo&gt;,&lt;/mo&gt;&lt;msub&gt;&lt;mi&gt;y&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo data-mjx-texclass="CLOSE"&gt;)&lt;/mo&gt;&lt;/mrow&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;f&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;y&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;h&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
  </rdf:Description>
