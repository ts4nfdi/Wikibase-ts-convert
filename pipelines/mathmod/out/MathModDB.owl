    <rdfs:label xml:lang="en">Radke-Prausnitz isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical isotherm model for low adsorbate concentrations</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821181"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821176"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821174"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821175"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775713"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775721"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775766"/>
    <mathmoddb:P1459 xml:lang="en">The Radke-Prausnitz isotherm is an empirical three-parameter adsorption model which is typically applied in adsorption systems when the concentration of the adsorbate is relatively low. Under certain conditions it reduces the Henry, Freundlich, or Langmuir isotherm model</mathmoddb:P1459>
  </rdf:Description>
