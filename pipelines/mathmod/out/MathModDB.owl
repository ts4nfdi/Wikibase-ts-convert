  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821058">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Jovanovic multilayer isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical multilayer adsorption model with exponential layer growth</schema:description>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821060"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821059"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821064"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821054"/>
    <mathmoddb:P1459 xml:lang="en">The Jovanovich multilayer isotherm model is an empirical adsorption model that extends the Jovanovich monolayer equation to allow adsorption in second and higher layers through an exponential layer-growth term. It introduces separate constants to describe the first-layer adsorption and the contribution of multilayer formation. The model assumes mobile adsorbate molecules and does not incorporate explicit lateral interactions.</mathmoddb:P1459>
  </rdf:Description>
