  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">aggregation of soil nitrogen supply</rdfs:label>
    <schema:description xml:lang="en">compute total nitrogen supply from all soil layers</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822024"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822027"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822035"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822039"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task aggregates nitrogen supply across all soil layers to determine the total nitrogen available for uptake by the crop on a given day. The result is used to assess whether soil nitrogen supply is sufficient to meet crop nitrogen demand.</mathmoddb:P1459>
  </rdf:Description>
