  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674034">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">intermolecular potential</rdfs:label>
    <schema:description xml:lang="en">energy function that describes the interactions between molecules</schema:description>
    <mathmoddb:P1459 xml:lang="en">Intermolecular potential energy function that describes the interactions between molecules. Typically, intermolecular forces are weak relative to intramolecular forces.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Intermolecular_force</mathmoddb:P1690>
  </rdf:Description>
