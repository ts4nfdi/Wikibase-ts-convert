    <rdfs:label xml:lang="en">finite volume method</rdfs:label>
    <schema:description xml:lang="en">method for representing and evaluating partial differential equations in the form of algebraic equations</schema:description>
    <mathmoddb:P1459 xml:lang="en">Finite volume methods can be compared and contrasted with the finite difference methods, which approximate derivatives using nodal values, or finite element methods, which create local approximations of a solution using local data, and construct a global approximation by stitching them together.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6674286</mathmoddb:P1684>
  </rdf:Description>
