  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775852">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">half maximal effective concentration</rdfs:label>
    <schema:description xml:lang="en">EC50</schema:description>
    <mathmoddb:P1459 xml:lang="en">Half maximal effective concentration (EC50) is a measure of the concentration of a drug, antibody or toxicant which induces a biological response halfway between the baseline and maximum after a specified exposure time.</mathmoddb:P1459>
  </rdf:Description>
