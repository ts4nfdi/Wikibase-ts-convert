    <rdfs:label xml:lang="en">potential energy operator</rdfs:label>
    <schema:description xml:lang="en">operator representing the potential energy of a quantum system</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">In quantum mechanics, this is the operator representing the potential energy of a quantum system. Typically, a function of the positions of the particles. Hence, a multiplicative operator.</mathmoddb:P1459>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775398"/>
