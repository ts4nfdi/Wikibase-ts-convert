  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821286">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">change in daylength</rdfs:label>
    <schema:description xml:lang="en">daily change in daylight duration</schema:description>
    <mathmoddb:P1459 xml:lang="en">This quantity represents the daily change in daylength relative to the previous day. It accounts for seasonal variation in photoperiod. It modifies the radiation-driven biomass production term. The quantity introduces a temporal adjustment to potential growth.</mathmoddb:P1459>
  </rdf:Description>
