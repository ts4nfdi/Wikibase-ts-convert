  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821304">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">leaf area index</rdfs:label>
    <schema:description xml:lang="en">dimensionless quantity that characterizes plant canopies</schema:description>
    <mathmoddb:P1459 xml:lang="en">Leaf area index is a dimensionless measure of canopy size defined as leaf area per unit ground area. It controls the fraction of incoming radiation intercepted by the canopy. Higher values correspond to denser canopies and greater light interception. Leaf area index is a dynamic state variable determined by crop growth and development.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6821291</mathmoddb:P1684>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821415">
