    <mathmoddb:P984 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534304"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684602">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">linear parameter estimation (uni uni reaction without product and uncompetitive complete inhibition - Hanes Woolf model - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">linear fit to determine the limiting reaction rate, michaelis constant and inhibition constants</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3241536"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6672218"/>
