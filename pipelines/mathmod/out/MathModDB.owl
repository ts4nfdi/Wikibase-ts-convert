  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q124919">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">agricultural science</rdfs:label>
    <schema:description xml:lang="en">academic field about agriculture and farming</schema:description>
    <mathmoddb:P1459 xml:lang="en">Agricultural science is the academic field concerned with the study of agriculture, food production, and land management using scientific methods. It integrates knowledge from biology, ecology, chemistry, engineering, and economics to improve the efficiency and sustainability of agricultural systems. The field addresses problems such as crop productivity, soil management, resource use, and environmental impacts of farming. Through research and modeling, agricultural science supports evidence-based decision making in food and fiber production. It provides the broader disciplinary context for applied fields such as agronomy, animal science, and agricultural engineering.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6821603</mathmoddb:P1684>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821122">
