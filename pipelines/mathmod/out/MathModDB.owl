  <rdf:Description rdf:nodeID="N59903aad8d9a4f68827188a7a1ca588f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674329"/>
