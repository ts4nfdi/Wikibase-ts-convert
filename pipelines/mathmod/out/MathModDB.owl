  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673806">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">reaction rate of enzyme - product 1 - product 2 complex</rdfs:label>
    <schema:description xml:lang="en">reaction rate of specific entity</schema:description>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Reaction_rate</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822039">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of soil nitrogen supply by mass flow</rdfs:label>
    <schema:description xml:lang="en">estimating potential nitrogen supply from soil layers</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task estimates the nitrogen supplied to plant roots from each soil layer through mass flow driven by plant water uptake. It combines soil nitrate content, soil water content, and layer-specific plant water use. The task produces a spatially distributed estimate of nitrogen supply from the soil.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N870782f2d8aa4f2ba56eac87bc99f250">
