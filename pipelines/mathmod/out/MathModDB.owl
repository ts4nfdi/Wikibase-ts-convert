    <rdfs:label xml:lang="en">bi bi reaction Theorell-Chance mechanism ODE system</rdfs:label>
    <schema:description xml:lang="en">system of ordinary differential equations describing a bi bi reaction with a Theorell-Chance mechanism</schema:description>
