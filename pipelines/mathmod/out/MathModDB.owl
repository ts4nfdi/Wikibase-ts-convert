  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821601">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">crop water usage model</rdfs:label>
    <schema:description xml:lang="en">simulates crop water uptake from soil profile</schema:description>
    <mathmoddb:P1459 xml:lang="en">This model simulates the potential and actual water use of crops from the soil profile. It estimates plant evaporation as a function of potential evaporation and canopy development. Water uptake is distributed through the root zone according to an exponential depth function that can account for soil water deficit compensation. The model further reduces potential uptake when soil moisture becomes limiting. Together, these components provide a mechanistic representation of plant water use under varying soil and atmospheric conditions.</mathmoddb:P1459>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821355"/>
