  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/wiki/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://portal.mardi4nfdi.de/wiki//1.0.0"/>
    <dcterms:title xml:lang="en">MathModDB Knowledge Graph of Mathematical Models | MathModDB</dcterms:title>
    <dcterms:hasVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</dcterms:hasVersion>
    <dcterms:description xml:lang="en">MathModDB defines a data model with classes (Mathematical Model, Mathematical Expression, Academic Discipline, Research Problem, Quantity (Kind), Computational Task, Scholarly Article), object properties/relations, data properties and annotation properties as an ontology. This ontology is populated with individuals/data from various fields of applied mathematics, making it a knowledge graph</dcterms:description>
  </rdf:Description>
