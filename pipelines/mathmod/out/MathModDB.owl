  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675429">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Lorentz force model (relativistic)</rdfs:label>
    <schema:description xml:lang="en">modeling the motion of "test charges" in electromagnetic fields in terms of the Lorentz force</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775523</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Neglecting the fact that real particles would generate their own E and B fields, which would alter the electromagnetic forces that they experience.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675428</mathmoddb:P1684>
    <mathmoddb:P1690 xml:lang="en">https://www.wikidata.org/wiki/Q172137</mathmoddb:P1690>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N34467e7f5c564486bae8ca6ed721621d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775446"/>
    <owl:annotatedTarget>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;θ&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
