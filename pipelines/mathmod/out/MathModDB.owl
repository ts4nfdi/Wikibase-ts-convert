  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684550">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">balanced truncation</rdfs:label>
    <schema:description xml:lang="en">powerful technique to reduce the state-space dimension of a dynamical system</schema:description>
    <mathmoddb:P1459 xml:lang="en">This approach is based on balancing the controllable and observable subspaces, and exploits the properties of the underlying dynamical system in that it uses the properties of the controllability and observability Gramians to identify suitable small parameters that are sent to 0 to yield a reduced-order system.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684551</mathmoddb:P1684>
  </rdf:Description>
