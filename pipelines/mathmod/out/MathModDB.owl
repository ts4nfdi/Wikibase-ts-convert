  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821128">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Dubinin-Radushkevich isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical adsorption model with Gaussian energy distribution on micropores</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821336"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821130"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821129"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821141"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">The Dubinin-Radushkevich isotherm is an empirical adsorption model originally developed for describing micropore filling of subcritical vapors on porous solids. It assumes a Gaussian distribution of adsorption energies on a heterogeneous surface and uses the Polanyi potential to express the effective adsorption work. The model is temperature-dependent and yields a characteristic curve when adsorption data at different temperatures are plotted against the square of the adsorption potential. The Dubinin-Radushkevich model is often used to distinguish physical from chemical adsorption via its mean free adsorption energy. It typically fits intermediate concentration ranges well but does not satisfy Henry’s law at low concentrations.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821263">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (UNILAN model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of UNILAN adsorption parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775770"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821258"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821259"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821261"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821262"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775767"/>
    <mathmoddb:P1459 xml:lang="en">This task consists of estimating the UNILAN isotherm parameters by fitting the nonlinear UNILAN equation to experimental equilibrium adsorption data. The fitted parameters typically include the maximum adsorption capacity, the adsorption affinity constant, and the heterogeneity parameter. Nonlinear regression methods are required due to the logarithmic and exponential structure of the model. The task is commonly used to characterize surface heterogeneity and adsorption energetics in heterogeneous adsorbent systems.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6ced853608234a44851efc2e64fb2d83">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775629"/>
