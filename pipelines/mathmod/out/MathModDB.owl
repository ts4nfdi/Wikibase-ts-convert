  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674047">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">link recommendation function</rdfs:label>
    <schema:description xml:lang="en">function representing link recommendation</schema:description>
    <mathmoddb:P1459 xml:lang="en">Link recommendation algorithms are often used to suggest new connections to users that have the greatest potential to be established. In modelling Opinion Dynamics, link recommendation can be incorporated via this function by assuming that individuals have a higher chance of switching to an influencer with a structurally similar followership. Strictly increasing on [0,1].</mathmoddb:P1459>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
