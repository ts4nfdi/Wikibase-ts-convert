    <rdfs:label xml:lang="en">propensity function</rdfs:label>
    <schema:description xml:lang="en">propensity function giving the rate for a reaction to occur</schema:description>
    <mathmoddb:P1459 xml:lang="en">For each reaction, there is a propensity function giving the rate (probability per unit of time) for the reaction to occur depending on the system’s state.</mathmoddb:P1459>
