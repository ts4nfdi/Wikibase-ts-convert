  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775634">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">nonthermal plasma</rdfs:label>
    <schema:description xml:lang="en">non-equilibrium state of matter</schema:description>
    <mathmoddb:P1459 xml:lang="en">Non-thermal (or cold) plasmas are not in thermodynamic equilibrium, because the electron temperature is much hotter than the temperature of heavy species. These plasmas are used in a large variety of technical processes and applications ranging from surface processing, gas conversion and agriculture to plasma medicine</mathmoddb:P1459>
  </rdf:Description>
