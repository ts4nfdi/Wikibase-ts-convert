  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775839">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Hill dose-response model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Hill dose–response model parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775838"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775846"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775851"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775852"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775853"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775854"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using dose–response data based on the Hill dose–response model. It estimates the maximal system response, the half-maximal concentration, and the cooperativity exponent by fitting the nonlinear sigmoidal Hill equation directly to observed concentration–effect measurements. Nonlinear regression eliminates distortions from linear transformations and yields robust estimates across a wide range of cooperative behaviors. The resulting parameters describe drug efficacy, potency, and the steepness of the dose–response relationship. This approach is widely used in pharmacology, toxicology, and pharmacokinetic–pharmacodynamic modeling.</mathmoddb:P1459>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q3116516"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820988">
