  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673782">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">Hankel singular value</rdfs:label>
    <schema:description xml:lang="en">In control theory, a measure of energy for each state in a system</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q1479821</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">In control theory, Hankel singular values, named after Hermann Hankel, are the basis for balanced model reduction, in which controllable and observable states are retained while the remaining states are discarded. The reduced model retains the important features of the original model.</mathmoddb:P1459>
  </rdf:Description>
