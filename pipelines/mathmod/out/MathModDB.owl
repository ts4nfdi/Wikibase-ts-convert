  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6823149">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">cost model for line concept</rdfs:label>
