  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821326">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Dubinin–Astakhov model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Dubinin–Astakhov isotherm parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775715"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821320"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821321"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821324"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821325"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using equilibrium adsorption data to determine the theoretical Dubinin–Astakhov isotherm saturation capacitythe, Dubinin–Astakhov isotherm constant, and the Dubinin–Astakhov heterogeneity exponent. The nonlinear Dubinin–Astakhov equation is fitted directly to equilibrium adsorption values determined by experimental adsorption measurements, using the Polanyi potential to capture the effective adsorption work. Because the Dubinin–Astakhov model is temperature-dependent, it can consolidate multi-temperature data into a single characteristic curve that describes micropore filling behavior.</mathmoddb:P1459>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821130"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821602">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of crop water use</rdfs:label>
    <schema:description xml:lang="en">quantify plant water uptake from soil</schema:description>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821601"/>
    <mathmoddb:P1459 xml:lang="en">This research problem addresses how crops extract water from the soil to meet atmospheric demand. Plant water use depends on canopy development, soil moisture availability, and the ability of plants to compensate for local water deficits. The problem links soil hydrology with plant physiological demand.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N1802d20afd494ffea7c49d36e3cbdd29">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674424"/>
    <owl:annotatedTarget xml:lang="en">&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;t&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</owl:annotatedTarget>
