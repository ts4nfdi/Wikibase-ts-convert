  <rdf:Description rdf:nodeID="Ne899f03355b54170ae2c668cab733b50">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="https://portal.mardi4nfdi.de/entity/Q6674410"/>
