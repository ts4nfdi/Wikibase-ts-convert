  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6830616">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Taylor–Couette model</rdfs:label>
    <schema:description xml:lang="en">modelling the dynamics of a viscous fluid in the gap between two rotating cylinders in terms of a stationary Navier Stokes</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q564419</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">For low relative angular velocities and for small gap (relative to the diameters of the cylinders), i.e., for a small Reynolds number, the flow is steady and purely azimuthal.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Taylor%E2%80%93Couette_flow</mathmoddb:P1690>
  </rdf:Description>
