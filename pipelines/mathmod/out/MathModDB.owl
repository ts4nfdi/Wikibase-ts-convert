    <mathmoddb:P1459 xml:lang="en">summation extends over all particles, i.e., electrons, ions and neutral species</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6673826</mathmoddb:P1684>
