  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675446">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">uni uni reaction (ODE model)</rdfs:label>
    <schema:description xml:lang="en">uni uni reaction model</schema:description>
    <mathmoddb:P1459 xml:lang="en">Ordinary differential equations for the rates of change of all chemical species (substrate, enzyme, enzyme-substrate complex, product) in an Uni Uni reaction. kᵢ with positive or negative i represents the rate constant of the forward- or backward-reaction i-th reaction step.</mathmoddb:P1459>
