  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6820963">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Fowler-Guggenheim isotherm model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Fowler–Guggenheim parameters</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q561111"/>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q2595344"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820965"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820966"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820968"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using adsorption equilibrium data to determine the Fowler–Guggenheim equilibrium constant and the interaction energy. The nonlinear Fowler–Guggenheim equation is fitted directly to fractional coverage and concentration data, capturing the effect of lateral interactions among adsorbed molecules. The results quantify both adsorption affinity and the magnitude of intermolecular interactions. This provides an accurate description of systems where adsorption behavior depends on the occupancy of neighboring sites.</mathmoddb:P1459>
    <mathmoddb:P1657 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6820964"/>
  </rdf:Description>
