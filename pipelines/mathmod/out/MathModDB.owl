  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822043">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of crop nitrogen uptake under varying soil conditions</rdfs:label>
    <schema:description xml:lang="en">quantify crop nitrogen demand and soil nitrogen supply</schema:description>
    <mathmoddb:P1459 xml:lang="en">This research problem concerns the estimation of crop nitrogen uptake as constrained by plant demand and soil nitrogen availability. It addresses how nitrogen demand evolves with crop growth and how soil processes supply nitrogen to roots through water-driven transport. The problem is central to understanding nutrient limitations on crop productivity and nitrogen cycling in agroecosystems.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822042"/>
  </rdf:Description>
