    <rdfs:label xml:lang="en">electron mass</rdfs:label>
    <schema:description xml:lang="en">mass of a stationary electron</schema:description>
    <mathmoddb:P1459 xml:lang="en">In particle physics, the mass of a stationary electron is one of the fundamental constants of physics.</mathmoddb:P1459>
  </rdf:Description>
