  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775502">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">light particle nonadiabatic transitions</rdfs:label>
    <schema:description xml:lang="en">nonadiabatic transitions of the light particle(s) in quantum-classical dynamics models</schema:description>
    <mathmoddb:P1459 xml:lang="en">Note that in quantum-classical dynamics the effective Hamiltonian governing the non-adiabatic transitions of the light particles parametrically depends on the heavy particle(s) positions.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Mixed_quantum-classical_dynamics</mathmoddb:P1690>
  </rdf:Description>
