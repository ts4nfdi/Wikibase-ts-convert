  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775500">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">heavy particle propagation</rdfs:label>
    <schema:description xml:lang="en">propagating the (classical!) state of the heavy particle(s) in quantum-classical dynamics models</schema:description>
    <mathmoddb:P1459 xml:lang="en">The classical trajectories can be integrated with conventional methods, as the Verlet algorithm. Such integration requires the forces acting on the nuclei. They are proportional to the gradient of the potential energy of the electronic states.</mathmoddb:P1459>
    <mathmoddb:P1459 xml:lang="en">Note that in quantum-classical dynamics the forces acting on the heavy particles depend on the quantum state of the light particles.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1690 rdf:resource="https://en.wikipedia.org/wiki/Mixed_quantum-classical_dynamics"/>
  </rdf:Description>
