  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821433">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of harvest index development</rdfs:label>
    <schema:description xml:lang="en">quantify temporal allocation of above-ground biomass to crop yield</schema:description>
    <mathmoddb:P1459 xml:lang="en">This research problem addresses how crops allocate above-ground biomass to reproductive or economic organs over time. Harvest index is often relatively stable at maturity but develops dynamically during the growing season. Accurately representing its development is essential for predicting crop yield. The problem links phenological development with above-ground biomass partitioning to reproductive structures.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821431"/>
  </rdf:Description>
