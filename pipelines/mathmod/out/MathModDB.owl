  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674107">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">angular momentum operator</rdfs:label>
    <schema:description xml:lang="en">quantum mechanical operator related to rotational symmetry</schema:description>
    <mathmoddb:P1459 xml:lang="en">In quantum mechanics, the angular momentum operator is one of several related operators analogous to classical angular momentum. The angular momentum operator plays a central role in the theory of atomic and molecular physics and other quantum problems involving rotational symmetry.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821375">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Weber-van Vliet model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Weber-van Vliet parameters</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q4115075</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Weber-van Vliet model parameters by fitting the nonlinear Weber-van Vliet equation to measured equilibrium solute concentration and adsorbed amount data. The fitting procedure minimizes deviations between experimental observations and model predictions across the full concentration range. The resulting parameters provide a flexible empirical representation of adsorption behavior when simpler isotherm models are inadequate. The task is commonly applied in adsorption studies related to chemical wastewater treatment.</mathmoddb:P1459>
  </rdf:Description>
