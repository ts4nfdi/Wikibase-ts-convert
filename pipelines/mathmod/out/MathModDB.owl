  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674151">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Lyapunov equation controllability</rdfs:label>
    <schema:description xml:lang="en">Lyapunov equation used in the stability analysis of linear dynamical systems to determine the controllability</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6482447</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">For the solvability of ordinary Lyapunov equations, the stability condition for A  is the only requirement.</mathmoddb:P1459>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Lyapunov_equation</mathmoddb:P1690>
    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;msub&gt;&lt;mi&gt;W&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;c&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;msub&gt;&lt;mi&gt;W&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;c&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;msup&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mo stretchy="false" lspace="0" rspace="0"&gt;∗&lt;/mo&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mi&gt;B&lt;/mi&gt;&lt;msup&gt;&lt;mi&gt;B&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mo stretchy="false" lspace="0" rspace="0"&gt;∗&lt;/mo&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;mn&gt;0&lt;/mn&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;W&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;c&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;B&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821202">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Jossens isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical adsorption model with distributed interaction energies</schema:description>
    <mathmoddb:P1459 xml:lang="en">The Jossens isotherm model is an empirical adsorption model based on a statistical distribution of adsorbate–adsorbent interaction energies on heterogeneous surfaces. It assumes that adsorption sites differ in energy and that the equilibrium concentration depends exponentially on the adsorbed amount. The model introduces temperature-dependent parameters to represent the energetic heterogeneity of the adsorbent surface. At low surface coverage, the equation reduces to Henry’s law, ensuring correct limiting behavior. The Jossens model has been applied mainly to adsorption on activated carbon and other heterogeneous adsorbents in solution-phase systems.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775721</mathmoddb:P1684>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nab48694d7202454f9c8699017e850d5b">
