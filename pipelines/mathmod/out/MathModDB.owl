  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822033">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">optimal plant nitrogen concentration equation</rdfs:label>
    <schema:description xml:lang="en">estimates ideal crop nitrogen concentration as function of development</schema:description>
    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;c&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;N&lt;/mi&gt;&lt;mi&gt;B&lt;/mi&gt;&lt;mo&gt;,&lt;/mo&gt;&lt;mi&gt;i&lt;/mi&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;mi&gt;b&lt;/mi&gt;&lt;msub&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mi&gt;b&lt;/mi&gt;&lt;msub&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;2&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;msup&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mo stretchy="false"&gt;−&lt;/mo&gt;&lt;mi&gt;b&lt;/mi&gt;&lt;msub&gt;&lt;mi&gt;n&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;3&lt;/mn&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mi&gt;H&lt;/mi&gt;&lt;mi&gt;U&lt;/mi&gt;&lt;msub&gt;&lt;mi&gt;I&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;i&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/msup&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
