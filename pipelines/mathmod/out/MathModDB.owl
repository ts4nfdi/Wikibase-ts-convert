    <rdfs:label xml:lang="en">Gaussian noise</rdfs:label>
    <schema:description xml:lang="en">signal noise that has a probability density function equal to that of the normal distribution</schema:description>
    <mathmoddb:P558 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6480411"/>
    <mathmoddb:P12 xml:lang="en">Q2725903</mathmoddb:P12>
