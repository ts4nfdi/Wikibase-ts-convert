  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684677">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">molecular spectrosopy (stationary)</rdfs:label>
    <schema:description xml:lang="en">studying molecular energy levels by stationary, i.e. time-independent molecular spectrosopy</schema:description>
    <mathmoddb:P1459 xml:lang="en">For example, molecular vibrational states can be detected by infrared or Raman spectroscopy.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684690">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">uni uni reaction with mixed partial inhibition</rdfs:label>
    <schema:description xml:lang="en">uni uni reaction with inhibition</schema:description>
    <mathmoddb:P1459 xml:lang="en">Enzyme (E) and Substrate (S) form an enzyme-substrate complex (ES), which catalyzes the formation of product (P). Rates for complex formation and dissociation are k₁ and k₋₁, k₂ is the rate of the rate-determining enzymatic step of product formation. Free enzyme and the enzyme-substrate complex may bind an inhibitor (I) to form an enzyme-inhibitor (EI) and enzyme-inhibitor-substrate complex (EIS) with k₃ or k₋₃ and k₄ or  k₋₄ as rates of inhibitor complex formation and depletion. Enzyme-inhibitor complex and enzyme-inhibitor-substrate convert into each other with rates k₅ and k₋₅. From the enzyme-inhibitor-substrate complex product is formed with rate k₆.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684667</mathmoddb:P1684>
  </rdf:Description>
