    <rdfs:label xml:lang="en">latitude</rdfs:label>
    <schema:description xml:lang="en">angle between zenith and a plane parallel to the equator</schema:description>
    <mathmoddb:P12 xml:lang="en">Q34027</mathmoddb:P12>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Latitude specifies the angular position of a location north or south of the equator. It determines the seasonal amplitude of daylength variation.</mathmoddb:P1459>
  </rdf:Description>
