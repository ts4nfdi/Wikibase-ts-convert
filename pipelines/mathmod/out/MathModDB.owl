  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821427">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of harvest index heat unit factor</rdfs:label>
    <schema:description xml:lang="en">calculates heat unit factor affecting harvest index</schema:description>
    <mathmoddb:P1459 xml:lang="en">This task computes a phenological scaling factor that governs the rate of harvest index development. The factor is derived from the heat unit index using a non-linear response function that reflects observed patterns of reproductive development in crops. It ensures that harvest index increases slowly during early growth and more rapidly during later stages of development. The task provides the daily heat unit factor used as input to the harvest index development computation. It links phenological progress to above ground biomass allocation to crop yield.</mathmoddb:P1459>
  </rdf:Description>
