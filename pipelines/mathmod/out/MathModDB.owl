    <rdfs:label xml:lang="en">hyperstress potential</rdfs:label>
    <schema:description xml:lang="en">Hyperstress potential in calculations of elasticity</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
