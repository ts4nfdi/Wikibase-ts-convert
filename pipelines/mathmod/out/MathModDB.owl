    <schema:description xml:lang="en">five-parameter empirical adsorption equation</schema:description>
    <mathmoddb:P989>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;msub&gt;&lt;mi&gt;q&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mo stretchy="false"&gt;=&lt;/mo&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mfrac&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;msub&gt;&lt;mi&gt;q&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;m&lt;/mi&gt;&lt;/mrow&gt;&lt;/msub&gt;&lt;mi&gt;A&lt;/mi&gt;&lt;msubsup&gt;&lt;mi&gt;C&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;a&lt;/mi&gt;&lt;/mrow&gt;&lt;/msubsup&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mn&gt;1&lt;/mn&gt;&lt;mo stretchy="false"&gt;+&lt;/mo&gt;&lt;mi&gt;B&lt;/mi&gt;&lt;msubsup&gt;&lt;mi&gt;C&lt;/mi&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;e&lt;/mi&gt;&lt;/mrow&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mi&gt;b&lt;/mi&gt;&lt;/mrow&gt;&lt;/msubsup&gt;&lt;/mrow&gt;&lt;/mrow&gt;&lt;/mfrac&gt;&lt;/mrow&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P989>
    <mathmoddb:P983>&lt;math xmlns="http://www.w3.org/1998/Math/MathML" class="mwe-math-element mwe-math-element-inline"&gt;&lt;mrow data-mjx-texclass="ORD"&gt;&lt;mstyle displaystyle="true" scriptlevel="0"&gt;&lt;mi&gt;a&lt;/mi&gt;&lt;/mstyle&gt;&lt;/mrow&gt;&lt;/math&gt;</mathmoddb:P983>
