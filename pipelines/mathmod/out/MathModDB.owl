  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821278">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">heat-unit-based phenological development model</rdfs:label>
    <schema:description xml:lang="en">crop development driven by accumulated thermal time</schema:description>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821277"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821274"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821275"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model simulates crop physiological development as a function of accumulated daily heat units. Development progresses from planting to physiological maturity based on temperatures exceeding a crop-specific base temperature. The accumulated heat units are normalized to a heat unit index that ranges from zero at planting to one at maturity. This index controls the timing of key developmental processes such as leaf area expansion, biomass partitioning, and harvest readiness. The approach provides a generic yet crop-specific representation of phenology using thermal time.</mathmoddb:P1459>
  </rdf:Description>
