  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684693">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">uni uni reaction with uncompetitive complete inhibition</rdfs:label>
    <schema:description xml:lang="en">uni uni reaction with inhibition</schema:description>
    <mathmoddb:P1459 xml:lang="en">Enzyme (E) and Substrate (S) form an enzyme-substrate complex (ES), which catalyzes the formation of product (P). Rates for complex formation and dissociation are k₁ and k₋₁, k₂ is the rate of the rate-determining enzymatic step of product formation. Enzyme-substrate complex may bind an inhibitor (I) to form an enzyme-inhibitor-substrate complex (EIS) with rates k₄ and k₋₄. The enzyme-inhibitor-substrate complex cannot form product, the inhibition is thus complete.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6684670</mathmoddb:P1684>
  </rdf:Description>
