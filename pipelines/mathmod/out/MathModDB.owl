    <rdfs:label xml:lang="en">Eadie Hofstee equation (uni uni reaction without product and non-competitive complete inhibition - steady state assumption)</rdfs:label>
    <schema:description xml:lang="en">equation for uni uni reaction without product and non-competitive complete inhibition following steady state assumption</schema:description>
