  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673940">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">effective mass (solid-state physics)</rdfs:label>
    <schema:description xml:lang="en">effective electron masses are deduced from band structure calculations (curvature of bands)</schema:description>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">In solid state physics, effective electron masses are deduced from band structure calculations (curvature of bands). In certain cases, these masses can have negative values. Their absolute values are typically found between 0.01 and 10 times the mass of a free electron.</mathmoddb:P1459>
    <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q1064434"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6673938">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">effective conductivity</rdfs:label>
    <schema:description xml:lang="en">combined effects of conduction, convection, and radiation heat transfer within an enclosed space or material</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534271"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">Effective conductivity refers to the combined effects of conduction, convection, and radiation heat transfer within an enclosed space or material and measures how effectively the medium can transfer heat.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674586">
