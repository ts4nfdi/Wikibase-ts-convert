    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Michaelis Menten equation (bi bi reaction ordered without products and single central complex - steady state assumption)</rdfs:label>
