  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821277">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of crop phenological development stage</rdfs:label>
    <schema:description xml:lang="en">deriving crop development stage from temperature data</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821266"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821268"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821269"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821271"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821272"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821274"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821275"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task computes the physiological development stage of a crop based on accumulated thermal time. Using daily temperature inputs and crop-specific thermal thresholds, the task calculates daily heat unit accumulation and aggregates it over time. The accumulated heat units are normalized by the crop’s potential heat unit requirement to obtain a dimensionless development index. This index represents the progression from planting to physiological maturity. The resulting development stage serves as a coordinating variable for multiple downstream crop growth processes.</mathmoddb:P1459>
  </rdf:Description>
