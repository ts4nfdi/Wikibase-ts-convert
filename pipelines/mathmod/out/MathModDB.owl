  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6534318">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">permittivity</rdfs:label>
    <schema:description xml:lang="en">measure of the electric polarizability of a dielectric material</schema:description>
    <mathmoddb:P1459 xml:lang="en">In electromagnetism, the absolute permittivity, often simply called permittivity is a measure of the electric polarizability of a dielectric material. It is given as the product of the vacuum dielectric permittivity and the relative permittivity of the material. Permittivities may be complex and frequency-dependent.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6673740</mathmoddb:P1684>
  </rdf:Description>
