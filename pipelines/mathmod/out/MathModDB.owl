    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Stokes Darcy equation (discretized, pv)</rdfs:label>
    <schema:description xml:lang="en">discrete model of Stokes-Darcy as a pressure-velocity (pv) formulation</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6773640</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Equation (9) from the referenced 2021 arXiv manuscript by Schmalfuss et al.: Discrete model of Stokes-Darcy as a pressure-velocity (pv) formulation, to be solved for every time step.</mathmoddb:P1459>
