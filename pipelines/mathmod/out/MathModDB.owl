  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821297">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">heat unit factor</rdfs:label>
    <schema:description xml:lang="en">normalized crop development factor</schema:description>
    <mathmoddb:P1459 xml:lang="en">The heat unit factor expresses the relative progress of crop development on a normalized scale from zero to one. It is derived from the accumulated heat unit index using a crop-specific sigmoid function. HUF is used to regulate phenology-dependent growth processes. It provides a smooth, continuous representation of crop development stage.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675409">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Stokes model</rdfs:label>
    <schema:description xml:lang="en">describes a fluid flow with small advective inertial forces compared to viscous forces</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q1515766</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">The Stokes model describes a fluid flow with small advective inertial forces compared to viscous forces, with a low Reynolds number. It occurs in situations with very slow fluid velocities, high viscosities, or small flow length scales.</mathmoddb:P1459>
    <mathmoddb:P1656 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675442</mathmoddb:P1656>
    <mathmoddb:P1690 xml:lang="en">https://en.wikipedia.org/wiki/Stokes_flow</mathmoddb:P1690>
  </rdf:Description>
