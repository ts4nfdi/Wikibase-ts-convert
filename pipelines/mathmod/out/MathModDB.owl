  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674380">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Hanes Woolf equation (uni uni reaction without product and competitive complete inhibition - steady state assumption)</rdfs:label>
