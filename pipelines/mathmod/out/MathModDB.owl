    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">intermediate concentration ODE (bi bi reaction ping pong)</rdfs:label>
    <schema:description xml:lang="en">ordinary differential equation describing the concentration over time in a Theorell-Chance bi bi reaction</schema:description>
