    <mathmoddb:P1690 rdf:resource="https://www.wikidata.org/wiki/Q1756677"/>
    <mathmoddb:P1459 xml:lang="en">The asymptotic stability of fixed points of a system of constant coefficient linear differential equations of first order (also known as a linear autonomous system or time-invariant system, ẋ = A·x) can be analyzed using the eigenvalues of the corresponding matrix.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
