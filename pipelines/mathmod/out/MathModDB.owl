  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821190">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Fritz-Schlunder 4-parameter model)</rdfs:label>
    <schema:description xml:lang="en">estimation of Fritz-Schlunder model parameters</schema:description>
    <mathmoddb:P1459 xml:lang="en">The Fritz-Schlunder 4-parameter isotherm model is a highly flexible empirical equation used to fit adsorption data across wide concentration ranges. It introduces two exponents to capture complex heterogeneity of adsorption sites. The model is especially useful for systems that deviate strongly from classical isotherms and require additional curvature control. Although it has no mechanistic interpretation, it provides accurate empirical correlations. It is frequently applied in advanced adsorption system characterization.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6775714</mathmoddb:P1684>
  </rdf:Description>
