  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822171">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534237"/>
    <rdfs:label xml:lang="en">mathematical pendulum amplitude (small angle, damped, driven)</rdfs:label>
