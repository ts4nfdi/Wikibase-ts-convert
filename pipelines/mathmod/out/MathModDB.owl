  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674525">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">quantum eigen energy (intermolecular)</rdfs:label>
    <schema:description xml:lang="en">eigenenergies of molecular vibrations, including the effects of intermolecular vibrations</schema:description>
    <mathmoddb:P1459 xml:lang="en">For simplicity, here only for a chromophore interacting with solvent molecules of a different species. Hence, only non-degenerate perturbation theory (up to 2nd order) is used here. First and second order results for the 0-&gt;1 vibrational frequency|energy shifts are given as two separate formulations.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6534304">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
