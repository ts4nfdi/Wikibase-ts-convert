  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6534341">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">semiconductor charge neutrality</rdfs:label>
    <schema:description xml:lang="en">concept of local charge neutrality in semiconductor</schema:description>
    <mathmoddb:P1459 xml:lang="en">At Ohmic contacts, the local charge-neutrality condition is often used to determine the built-in voltage by requiring zero net charge density from mobile carriers and ionized dopants. Unlike global neutrality, which only requires the total integrated charge to vanish, local charge-neutrality applies pointwise. The resulting local charge-neutrality potential can also serve as an initial guess for solving the nonlinear Poisson equation to determine thermodynamic equilibrium.</mathmoddb:P1459>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673783"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6673784"/>
