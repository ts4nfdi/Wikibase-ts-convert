  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821376">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Weber-van Vliet isotherm model</rdfs:label>
    <schema:description xml:lang="en">empirical four-parameter adsorption isotherm model</schema:description>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775724"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775858"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821373"/>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821374"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821375"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">The Weber-van Vliet isotherm model is an empirical adsorption model developed to describe equilibrium adsorption behavior using a flexible four-parameter formulation. It directly relates equilibrium solute concentration to adsorbed amount without assuming ideal monolayer adsorption or a specific adsorption mechanism. The model is particularly useful when classical two-parameter isotherms such as Langmuir or Freundlich fail to fit experimental data over wide concentration ranges. Due to its empirical nature, the parameters do not have a strict physical interpretation but provide high flexibility in curve fitting. The model has been applied in adsorption studies relevant to chemical and environmental engineering, including wastewater treatment.</mathmoddb:P1459>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821372"/>
  </rdf:Description>
