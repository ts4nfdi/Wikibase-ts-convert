  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674465">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">line concept costs</rdfs:label>
    <schema:description xml:lang="en">costs of a line concept</schema:description>
    <mathmoddb:P1459 xml:lang="en">The costs for a line concept summarizing the costs of single lines multiplied by their frequencies.</mathmoddb:P1459>
