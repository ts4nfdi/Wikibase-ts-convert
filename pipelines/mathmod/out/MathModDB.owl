  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821389">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">computation of root biomass distribution</rdfs:label>
    <schema:description xml:lang="en">allocates daily root growth to soil layers</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1459 xml:lang="en">This task computes how daily root biomass growth is distributed across the soil profile. It allocates the total root biomass increment to individual soil layers based on their relative contribution to plant water uptake. The task produces a layer-specific root biomass increment for each time step. The resulting distribution is used to represent root presence and function within the soil.</mathmoddb:P1459>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821377"/>
