    <rdfs:label xml:lang="en">kinetic batch reactor model (Monod)</rdfs:label>
    <schema:description xml:lang="en">mathematical model for biomass growth and substrate utilization in a batch reactor following Monod</schema:description>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">The Monod-based kinetic batch reactor model is a mathematical model that describes the growth of microorganisms and substrate consumption in a closed system. It relates the rate of biomass change to the concentration of a limiting substrate and includes a death rate coefficient to account for microbial decay.</mathmoddb:P1459>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775666"/>
