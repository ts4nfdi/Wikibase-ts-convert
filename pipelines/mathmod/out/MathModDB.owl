  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6775832">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Hill adsorption model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Hill adsorption model parameters</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q3116516</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using equilibrium adsorption data applied to the Hill adsorption model. It determines the Hill adsorption constant, the maximum adsorption capacity, and the cooperativity exponent by directly fitting the nonlinear Hill isotherm to solute concentration and adsorbed-amount measurements. Nonlinear regression avoids structural distortions introduced by linearized forms and ensures accurate estimation of parameters across cooperative and non-cooperative regimes. The resulting parameters quantify adsorption affinity, surface saturation behavior, and cooperative interactions among adsorbed species. This approach is commonly used in environmental and materials science to analyze sigmoidal adsorption equilibria.</mathmoddb:P1459>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nba5abd85b4fa48d68b199e783362fc09">
