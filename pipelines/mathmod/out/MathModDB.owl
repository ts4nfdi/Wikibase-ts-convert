  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6674319">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q96183"/>
    <rdfs:label xml:lang="en">Michaelis Menten equation (uni uni reaction without product and non-competitive complete inhibition - steady state assumption)</rdfs:label>
