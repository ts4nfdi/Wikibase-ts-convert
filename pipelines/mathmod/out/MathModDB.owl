  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821333">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534247"/>
    <rdfs:label xml:lang="en">nonlinear parameter estimation (Frumkin model)</rdfs:label>
    <schema:description xml:lang="en">nonlinear estimation of Frumkin isotherm parameters</schema:description>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775716"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775824"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821329"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821330"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821331"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534272"/>
    <mathmoddb:P1684 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6775767"/>
    <mathmoddb:P1459 xml:lang="en">This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Frumkin equilibrium constant and the lateral interaction parameter by fitting the nonlinear Frumkin isotherm equation to measured solute concentration and fractional surface coverage data. The task captures deviations from ideal Langmuir behavior arising from attractive or repulsive interactions among adsorbed molecules. Nonlinear fitting preserves the thermodynamic structure of the model and avoids distortions introduced by linearization. The resulting parameters characterize both adsorption affinity and interaction effects on the adsorbent surface.</mathmoddb:P1459>
  </rdf:Description>
