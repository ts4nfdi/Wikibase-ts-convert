  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6822115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534292"/>
    <rdfs:label xml:lang="en">estimation of biological nitrogen fixation in legume crops</rdfs:label>
    <schema:description xml:lang="en">quantify biological nitrogen fixation</schema:description>
    <mathmoddb:P1459 xml:lang="en">This research problem concerns the quantitative estimation of biologically fixed atmospheric nitrogen in legume crops during the growing season. It addresses nitrogen fixation resulting from symbiotic interactions between legume roots and nitrogen-fixing microorganisms, and its dependence on plant nitrogen demand, phenological development, soil water availability, and soil nitrate content. The problem is central to modeling crop nitrogen dynamics, nutrient cycling, and fertilizer substitution effects in agroecosystems.</mathmoddb:P1459>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534269"/>
    <mathmoddb:P1513 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6822114"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5bbd35485cdf479c9b6befa1bbf0b6a5">
