  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6684708">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q60231"/>
    <rdfs:label xml:lang="en">transmission electron microscopy</rdfs:label>
    <schema:description xml:lang="en">uses the propagation of electron waves through magnetic lenses to create images of, e.g., the crystallographic structure of materials down to an atomic scale</schema:description>
    <mathmoddb:P12 xml:lang="en">Q110779037</mathmoddb:P12>
    <mathmoddb:P356 rdf:resource="http://commons.wikimedia.org/wiki/Special:FilePath/Polio%20EM%20PHIL%201875%20lores.PNG"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6684660"/>
    <mathmoddb:P104 rdf:resource="https://en.wikipedia.org/wiki/Transmission_electron_microscopy"/>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534268"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
    <mathmoddb:P1459 xml:lang="en">As such, Transmission Electron Microscopy (TEM) has become an indispensable experimental tool to examine objects in life sciences or in material sciences at nanoscales. See also WIAS annual report 2021</mathmoddb:P1459>
  </rdf:Description>
