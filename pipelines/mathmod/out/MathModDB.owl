  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6675320">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">Maxwell's equations</rdfs:label>
    <schema:description xml:lang="en">set of four coupled partial differential equations describing how electric and magnetic fields are generated and altered by each other and by charges and currents</schema:description>
    <mathmoddb:P558 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6482471</mathmoddb:P558>
    <mathmoddb:P1459 xml:lang="en">Together with the Lorentz force law, Maxwell's equations form the foundation of classical electromagnetism and optics. The equations provide a mathematical model for electric, optical, and radio technologies.</mathmoddb:P1459>
    <mathmoddb:P1684 xml:lang="en">https://portal.mardi4nfdi.de/entity/Q6675438</mathmoddb:P1684>
  </rdf:Description>
