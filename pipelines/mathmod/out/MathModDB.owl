  <rdf:Description rdf:about="https://portal.mardi4nfdi.de/entity/Q6821393">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://portal.mardi4nfdi.de/entity/Q68663"/>
    <rdfs:label xml:lang="en">root biomass distribution model</rdfs:label>
    <schema:description xml:lang="en">model distributing root biomass growth across soil layers</schema:description>
    <mathmoddb:P1460 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534270"/>
    <mathmoddb:P1459 xml:lang="en">This model simulates the vertical distribution of root biomass growth within the soil profile. Newly formed root biomass is allocated among soil layers in proportion to plant water use in each layer. This approach links root development to functional root activity rather than purely geometric depth. Under non-limiting conditions, the formulation produces an exponential decrease in root biomass with depth. When soil water availability or root stress factors constrain growth, both water use and root biomass allocation are reduced accordingly.</mathmoddb:P1459>
    <mathmoddb:P286 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821276"/>
    <mathmoddb:P147 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821389"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821384"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6821390"/>
    <mathmoddb:P1560 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6824223"/>
    <mathmoddb:P1495 rdf:resource="https://portal.mardi4nfdi.de/entity/Q6534265"/>
  </rdf:Description>
