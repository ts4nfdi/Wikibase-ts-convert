<https://portal.mardi4nfdi.de/entity/Q6821202> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Jossens isotherm model"@en ;
    mathmoddb:P1459 "The Jossens isotherm model is an empirical adsorption model based on a statistical distribution of adsorbate–adsorbent interaction energies on heterogeneous surfaces. It assumes that adsorption sites differ in energy and that the equilibrium concentration depends exponentially on the adsorbed amount. The model introduces temperature-dependent parameters to represent the energetic heterogeneity of the adsorbent surface. At low surface coverage, the equation reduces to Henry’s law, ensuring correct limiting behavior. The Jossens model has been applied mainly to adsorption on activated carbon and other heterogeneous adsorbents in solution-phase systems." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821207" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821206" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775721" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821214" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "empirical adsorption model with distributed interaction energies"@en .

