<https://portal.mardi4nfdi.de/entity/Q6675445> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "transport model"@en ;
    mathmoddb:P1459 "There are several (constitutive) equations which describe the transport of matter, or properties of it, in an almost identical way. In every case, in words they read: Flux (density) is proportional to a gradient, where the constant of proportionality is a characteristic of the material. In general, the constant must be replaced by a 2nd rank tensor, to account for directional dependencies of the material." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
