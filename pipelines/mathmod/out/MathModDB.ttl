<https://portal.mardi4nfdi.de/entity/Q6821333> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Frumkin model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Frumkin equilibrium constant and the lateral interaction parameter by fitting the nonlinear Frumkin isotherm equation to measured solute concentration and fractional surface coverage data. The task captures deviations from ideal Langmuir behavior arising from attractive or repulsive interactions among adsorbed molecules. Nonlinear fitting preserves the thermodynamic structure of the model and avoids distortions introduced by linearization. The resulting parameters characterize both adsorption affinity and interaction effects on the adsorbent surface." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821329" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775767" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Frumkin isotherm parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6821334> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Frumkin isotherm model"@en ;
    mathmoddb:P1459 "The Frumkin isotherm model is an adsorption model that extends the Langmuir framework by explicitly accounting for lateral interactions between adsorbed molecules. It assumes monolayer adsorption on a surface with energetically equivalent sites while allowing attractive or repulsive interactions among neighboring adsorbates. The strength and sign of these interactions influence the shape of the adsorption isotherm and the variation of adsorption energy with surface coverage. In the absence of lateral interactions, the Frumkin model reduces to the Langmuir isotherm. The model is closely related to the Fowler–Guggenheim isotherm and is widely applied in solution-phase adsorption studies, including chemical wastewater treatment." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821333" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821331" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775766" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821332" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "adsorption isotherm with lateral adsorbate interactions"@en .

