<https://portal.mardi4nfdi.de/entity/Q6534309> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "quantum number"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Quantum_number" ;
    mathmoddb:P12 "Q232431" ;
    mathmoddb:P1459 "In quantum physics and chemistry, quantum numbers are quantities that characterize the possible states of the system. Quantum numbers are closely related to eigenvalues of observables. When the corresponding observable commutes with the Hamiltonian, the quantum number is said to be \"good\", and acts as a constant of motion in the quantum dynamics." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534237" ;
    schema:description "quantities that characterize the possible states of the system"@en .

