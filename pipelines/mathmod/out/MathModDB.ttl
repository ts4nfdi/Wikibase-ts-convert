    schema:description "assumption for the solute concentration in equilibrium"@en .

<https://portal.mardi4nfdi.de/entity/Q6821058> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Jovanovic multilayer isotherm model"@en ;
    mathmoddb:P1459 "The Jovanovich multilayer isotherm model is an empirical adsorption model that extends the Jovanovich monolayer equation to allow adsorption in second and higher layers through an exponential layer-growth term. It introduces separate constants to describe the first-layer adsorption and the contribution of multilayer formation. The model assumes mobile adsorbate molecules and does not incorporate explicit lateral interactions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821060" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821059" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6821054" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821064" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "empirical multilayer adsorption model with exponential layer growth"@en .

