    schema:description "nonlinear micropore filling isotherm with Gaussian energy term"@en .

<https://portal.mardi4nfdi.de/entity/Q6821130> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Dubinin-Radushkevich model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using equilibrium adsorption data to determine the theoretical Dubinin-Radushkevich isotherm saturation capacity and the Dubinin-Radushkevich isotherm constant . The nonlinear Dubinin-Radushkevich equation is fitted directly to equilibrium adsorption values determined by experimental adsorption measurements, using the Polanyi potential to capture the effective adsorption work. Because the Dubinin-Radushkevich model is temperature-dependent, it can consolidate multi-temperature data into a single characteristic curve that describes micropore filling behavior." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821132" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Dubinin-Radushkevich parameters"@en .

