    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>d</mi><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mrow></mfrac></mrow><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "mobile monolayer adsorption equation without lateral interactions"@en .

<https://portal.mardi4nfdi.de/entity/Q6820981> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Flory-Huggins isotherm model"@en ;
    mathmoddb:P1459 "The Flory–Huggins isotherm is an empirical adsorption model adapted from polymer solution theory that describes how chemically similar molecules of different chain length occupy adsorbent sites. It uses a coverage degree defined from initial and equilibrium concentrations and explicitly accounts for an occupancy number that represents how many adsorbate units occupy a site. The model is used to assess adsorption feasibility and spontaneity via an equilibrium constant that can be related to a standard Gibbs free-energy expression. It is applied when adsorbate molecules are large or chain-like (e.g., polymers, large organics) and the adsorbate–adsorbent arrangement is approximately random." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6820983" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6820989" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821374" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6820991" ;
    schema:description "adsorption model for multi-site occupancy and chain effects"@en .

<https://portal.mardi4nfdi.de/entity/Q6820982> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Flory-Huggins model)"@en ;
    mathmoddb:P1459 "This task fits the nonlinear Flory–Huggins equation to adsorption data to estimate the Flory–Huggins equilibrium constant and the occupancy number. It uses experimental initial and equilibrium concentrations and measured uptake to directly obtain parameter estimates without data linearization. The outputs quantify the effective site occupancy per adsorbate and the equilibrium parameter used to evaluate spontaneity." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6820985" ;
    mathmoddb:P1657 "https://portal.mardi4nfdi.de/entity/Q6820983" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6820991" ;
    schema:description "nonlinear estimation of Flory–Huggins parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6820983> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "linear parameter estimation (Flory-Huggins model)"@en ;
    mathmoddb:P1459 "This task uses the linearized Flory–Huggins equation to estimate the equilibrium constant and occupation number from transformed equilibrium data. Linear regression provides a straightforward estimation method, but may introduce bias due to logarithmic transformation. The resulting parameters characterize adsorption feasibility and the extent of surface site occupation in the Flory–Huggins model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6820988" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672085" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6820991" ;
    schema:description "linear estimation of Flory–Huggins parameters"@en .

