        <https://portal.mardi4nfdi.de/entity/Q6534245> ;
    rdfs:label "mass per area"@en ;
    mathmoddb:P12 "Q1907514" ;
    mathmoddb:P1212 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msup><mrow data-mjx-texclass=\"ORD\"><mi>𝖫</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mn>2</mn></mrow></mrow></msup><mrow data-mjx-texclass=\"ORD\"><mi>𝖬</mi></mrow></mstyle></mrow></math>" ;
