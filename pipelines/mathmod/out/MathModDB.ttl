<https://portal.mardi4nfdi.de/entity/Q6775766> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Langmuir isotherm model"@en ;
    mathmoddb:P1459 "The Langmuir isotherm model is a theoretical adsorption isotherm that assumes monolayer adsorption of solute molecules onto a homogeneous surface with finite, identical adsorption sites. It is based on the assumption that once a site is occupied, no further adsorption can occur at that site. The model is widely used to describe adsorption processes in water and wastewater treatment, catalysis, and surface chemistry." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775767" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775772" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821374" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672076" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q74562" ;
    schema:description "equation that relates the coverage or adsorption of molecules on a solid surface to gas pressure or concentration of a medium above the solid surface at a fixed temperature in equilibrium"@en .

<https://portal.mardi4nfdi.de/entity/Q6775767> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Langmuir adsorption model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Langmuir adsorption constant and maximum monolayer adsorption capacity by fitting the nonlinear Langmuir equation directly to measured solute concentration and adsorbed amount data. The results quantify the adsorption affinity and monolayer capacity of the adsorbent without bias from linearization." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775772" ;
    mathmoddb:P1657 "https://portal.mardi4nfdi.de/entity/Q6775768" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q74562" ;
    schema:description "Langmuir adsorption model"@en .

<https://portal.mardi4nfdi.de/entity/Q6775768> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "linear parameter estimation (Langmuir adsorption model)"@en ;
    mathmoddb:P1459 "This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Langmuir adsorption constant and maximum monolayer adsorption capacity by fitting the linearized Langmuir equation to measured solute concentration and adsorbed amount data. The results characterize the adsorption capacity and surface homogeneity of the adsorbent." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775771" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672085" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q74562" ;
    schema:description "Langmuir adsorption model"@en .

