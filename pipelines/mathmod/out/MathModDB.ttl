    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6672278" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "mathematical model for transmission electron microscopy of nanostructures"@en .

