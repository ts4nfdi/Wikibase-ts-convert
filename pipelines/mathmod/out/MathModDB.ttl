    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6534329" ;
    mathmoddb:P1640 "https://portal.mardi4nfdi.de/wiki/File:3082b.jpg" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6672211" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q68663" ;
    schema:description "quantum dynamical model of an electron to be shuttled in a Si/SiGe quantum bus"@en .

<https://portal.mardi4nfdi.de/entity/Q6534343> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "spin qbit shuttling"@en ;
    mathmoddb:P1459 "Spin-qubit shuttles are novel functional elements in modular architectures of semiconductor quantum processors, that have the capability of solving the scalability problem. Such coherent quantum links serve to interconnect different processor units and enable the transfer of quantum information over longer distances across the chip by physical transport of electrons." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
