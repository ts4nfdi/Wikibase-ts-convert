    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q96183" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6775562" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>l</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mo stretchy=\"false\">=</mo><mi>k</mi><mi>Δ</mi><mi>l</mi></mstyle></mrow></math>" ;
