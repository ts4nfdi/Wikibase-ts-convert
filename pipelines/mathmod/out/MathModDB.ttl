<https://portal.mardi4nfdi.de/entity/Q6821207> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Jossens model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using adsorption equilibrium data from solution-phase systems. The objective is to determine the Jossens equilibrium constant, interaction coefficient, and heterogeneity exponent by fitting the nonlinear Jossens adsorption equation to measured solute concentration and adsorbed amount data. The fitting preserves the exponential structure of the model and captures energetic heterogeneity of adsorption sites. At low adsorption levels, the task ensures consistency with Henry-type behavior. The estimated parameters characterize both adsorption affinity and the distribution of surface interaction energies." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821211" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775722" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Jossens isotherm parameters"@en .

