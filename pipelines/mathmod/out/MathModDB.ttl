    mathmoddb:P1690 "https://en.wikipedia.org/wiki/Constitutive_equation" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q68663" ;
    schema:description "constitutive law describing the transport of matter, or properties of it, where the is proportional to a gradient"@en .

