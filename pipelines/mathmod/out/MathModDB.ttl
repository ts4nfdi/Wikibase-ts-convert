<https://portal.mardi4nfdi.de/entity/Q6674558> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "rate of switching influencers formulation"@en ;
    mathmoddb:P1459 "Each individual i can at any time t switch its current influencer l′ to another influencer l with a given rate. By setting the pair function to ψ(x) = exp(−x), an individual has an exponentially higher rate to switch to an influencer that has a similar opinion than to an influencer with a very different opinion. This rate of switching influencers is defined by this formulation." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
