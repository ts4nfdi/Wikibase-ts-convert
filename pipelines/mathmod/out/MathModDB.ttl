<https://portal.mardi4nfdi.de/entity/Q6775632> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "nonadiabatic molecular dynamics"@en ;
    foaf:depiction "http://commons.wikimedia.org/wiki/Special:FilePath/Na-mqc-scheme.jpg" ;
    mathmoddb:P1459 "Used to describe the dynamics of a system comprising of light/fast and heavy/slow particles where the classical approximation can be only justified for the latter ones, as is usually the case in molecular dynamics. There, non-adiabatic transitions of the quantum subsystem (usually electrons) can be triggered by dynamics of the classical subsystem (usually nuclei) and vice versa. Note that the many different approaches to quantum-classical dynamics, most notably surface hopping trajectories simulations, differ in the way how the nonadiabatic transition probabilities are calculated." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6675431" ;
    mathmoddb:P1690 "https://www.wikidata.org/wiki/Q65091550" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775323" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    mathmoddb:P356 "http://commons.wikimedia.org/wiki/Special:FilePath/Na-mqc-scheme.jpg" ;
    schema:description "molecular dynamics simulations including nonadiabatic transitions"@en .

<https://portal.mardi4nfdi.de/entity/Q6775633> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "plasma physics"@en ;
    foaf:depiction "http://commons.wikimedia.org/wiki/Special:FilePath/TCABR%20lab.jpg" ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Plasma_(physics)" ;
    mathmoddb:P12 "Q5615097" ;
    mathmoddb:P1459 "Plasma is a state of matter that results from a gaseous state having undergone some degree of ionisation. It thus consists of a significant portion of charged particles (ions and/or electrons). While rarely encountered on Earth, it is estimated that 99.9% of all ordinary matter in the universe is plasma. Stars are almost pure balls of plasma, and plasma dominates the rarefied intracluster medium and intergalactic medium. Plasma can be artificially generated, for example, by heating a neutral gas or subjecting it to a strong electromagnetic field." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775634" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    mathmoddb:P356 "http://commons.wikimedia.org/wiki/Special:FilePath/TCABR%20lab.jpg" ;
    schema:description "branch of physics dealing with a state of matter consisting of ionized gas"@en .

<https://portal.mardi4nfdi.de/entity/Q6775634> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "nonthermal plasma"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Nonthermal_plasma" ;
    mathmoddb:P12 "Q1513560" ;
    mathmoddb:P1459 "Non-thermal (or cold) plasmas are not in thermodynamic equilibrium, because the electron temperature is much hotter than the temperature of heavy species. These plasmas are used in a large variety of technical processes and applications ranging from surface processing, gas conversion and agriculture to plasma medicine" ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775635" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "non-equilibrium state of matter"@en .

<https://portal.mardi4nfdi.de/entity/Q6775635> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "electric discharge"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Electric_discharge" ;
    mathmoddb:P12 "Q488071" ;
    mathmoddb:P1459 "The properties and effects of electric discharges are useful over a wide range of magnitudes. Tiny pulses of current are used to detect ionizing radiation in a Geiger–Müller tube. A low steady current can illustrate the gas spectrum in a gas-filled tube. A neon lamp is an example of a gas-discharge lamp, useful both for illumination and as a voltage regulator. A flashtube generates a short pulse of intense light useful for photography by sending a heavy current through a gas arc discharge. Corona discharges are used in photocopiers." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1463 "https://portal.mardi4nfdi.de/entity/Q16278" ;
