    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mrow></mfrac></mrow><mo stretchy=\"false\">=</mo><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mi>E</mi></mrow></msub><msub><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>E</mi></mrow></msub><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mo stretchy=\"false\">−</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mrow></mfrac></mrow><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "empirical adsorption equation based on exponential energy variation"@en .

<https://portal.mardi4nfdi.de/entity/Q6775815> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "linear parameter estimation (Elovich isotherm)"@en ;
    mathmoddb:P1459 "This task performs linear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Elovich equilibrium constant and the Elovich maximum adsorption capacity by fitting the linearized form of the Elovich isotherm to measured values of adsorbed amount and equilibrium solution concentration. The linearization expresses the ratio of adsorbed amount to equilibrium concentration in logarithmic form, allowing the model parameters to be obtained from the slope and intercept of a straight-line plot. The resulting parameters describe the surface heterogeneity and the exponential energy distribution assumed by the empirical Elovich model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775818" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672085" ;
    schema:description "linear estimation of Elovich adsorption parameters from equilibrium data"@en .

<https://portal.mardi4nfdi.de/entity/Q6775816> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Elovich isotherm)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Elovich equilibrium constant and the Elovich maximum adsorption capacity by fitting the original nonlinear Elovich isotherm directly to measured equilibrium concentration and adsorbed amount data. Nonlinear regression avoids the distortions introduced by logarithmic transformation and generally provides more accurate estimates of both parameters. The resulting parameter values characterize adsorption affinity and the heterogeneous, energy-dependent adsorption behavior represented by the empirical Elovich model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775817" ;
    mathmoddb:P1657 "https://portal.mardi4nfdi.de/entity/Q6775815" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Elovich adsorption parameters from equilibrium data"@en .

