    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>F</mi><mi>S</mi></mrow></mrow></msub><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">+</mo><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub><msubsup><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>F</mi><mi>S</mi></mrow></mrow></msub></mrow></msubsup></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "three-parameter empirical adsorption equation"@en .

<https://portal.mardi4nfdi.de/entity/Q6821186> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Fritz-Schlunder 3-parameter model)"@en ;
    mathmoddb:P1459 "This task concerns the nonlinear estimation of parameters in the Fritz–Schlunder 3-parameter isotherm model. The parameters are determined by fitting the model to equilibrium adsorption data using nonlinear regression techniques. The goal is to identify values that minimize the difference between predicted and observed loadings. The task is typically performed when simpler two-parameter isotherms do not adequately describe the system. Reliable estimation is required for comparing adsorption performance across materials and conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775770" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "estimation of Fritz–Schlunder model parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6821187> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Fritz-Schlunder 4-parameter isotherm model"@en ;
    mathmoddb:P1459 "The Fritz-Schlunder 4-parameter isotherm model is an empirical equation providing high flexibility for modeling adsorption on heterogeneous surfaces. It introduces two independent exponents and two affinity parameters, enabling extremely close fits to non-ideal adsorption data over wide concentration ranges. Because of its general form, the model does not assume monolayer behavior and imposes no strict physical interpretation on its parameters. It is especially useful when typical three-parameter models fail to capture complex curvature in experimental isotherms. Applications include chemical wastewater treatment, dye removal, heavy metals removal, and adsorption process design." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821190" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821189" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775766" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821201" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "flexible four-parameter empirical adsorption isotherm"@en .

