<https://portal.mardi4nfdi.de/entity/Q6821184> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Fritz-Schlunder 3-parameter isotherm model"@en ;
    mathmoddb:P1459 "The Fritz–Schlunder 3-parameter isotherm model is an empirical adsorption model designed to flexibly fit equilibrium data over a broad concentration range. It extends the Langmuir formulation by introducing an additional exponent describing surface heterogeneity. The model is frequently used when simpler isotherms such as Langmuir or Freundlich provide poor agreement with experimental data. It is suitable for both homogeneous and heterogeneous adsorption systems. The model does not rely on a specific adsorption mechanism and is primarily used for data correlation." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821186" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821185" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821201" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "three-parameter empirical adsorption isotherm"@en .

