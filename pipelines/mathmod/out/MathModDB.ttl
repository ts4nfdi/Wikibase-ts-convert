<https://portal.mardi4nfdi.de/entity/Q6534317> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "Lindblad equation"@en ;
    mathmoddb:P12 "Q4476520" ;
    mathmoddb:P1459 "Markovian quantum master equation for the evolution of quantum mechanical density matrices (pure or mixed states).  It generalizes the Schrödinger equation to open quantum systems; that is, systems in contacts with their surroundings. The resulting dynamics is no longer unitary, but still satisfies the property of being trace-preserving and completely positive for any initial condition." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
