<https://portal.mardi4nfdi.de/entity/Q6821594> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "actual plant water use rate in soil layer equation"@en ;
    mathmoddb:P1459 "This equation determines the actual plant water use rate from the potential plant water use rate considering the soil moisture. When soil water content falls below a threshold fraction of plant-available water, the use rate declines exponentially. Above this threshold, potential uptake is fully realized. The formulation captures the non-linear response of root water absorption to soil moisture availability." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mi>P</mi></mrow></msub></mstyle></mrow></math>" ;
