    schema:description "index indicating the physiological development of a plant"@en .

<https://portal.mardi4nfdi.de/entity/Q6821274> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "heat unit accumulation equation"@en ;
    mathmoddb:P1459 "This equation calculates the daily heat units contributing to crop development based on daily maximum and minimum air temperatures. Only temperatures exceeding a crop-specific base temperature contribute to development. Negative values are truncated to zero to prevent development under unsuitable thermal conditions. The resulting heat units are accumulated over time to drive phenological progress." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672094" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>x</mi></mrow></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>x</mi><mo>,</mo><mi>K</mi></mrow></mrow></msub><mo stretchy=\"false\">+</mo><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>n</mi><mo>,</mo><mi>K</mi></mrow></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></mfrac></mrow><mo stretchy=\"false\">−</mo><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>b</mi><mo>,</mo><mi>j</mi></mrow></mrow></msub></mstyle></mrow></math>" ;
    schema:description "effective thermal time per day"@en .

<https://portal.mardi4nfdi.de/entity/Q6821275> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "heat unit index equation"@en ;
    mathmoddb:P1459 "This equation computes the heat unit index as the ratio of accumulated heat units to the potential heat units required for crop maturity. The index ranges from zero at planting to one at physiological maturity. It provides a normalized, dimensionless measure of development stage. Many other models use this index to regulate growth, partitioning, and senescence processes." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>P</mi><mi>H</mi><mi>U</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><munderover><mo movablelimits=\"false\" stretchy=\"false\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>K</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></munderover><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mi>H</mi><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "normalizes accumulated heat units to maturity"@en .

<https://portal.mardi4nfdi.de/entity/Q6821277> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of crop phenological development stage"@en ;
    mathmoddb:P1459 "This task computes the physiological development stage of a crop based on accumulated thermal time. Using daily temperature inputs and crop-specific thermal thresholds, the task calculates daily heat unit accumulation and aggregates it over time. The accumulated heat units are normalized by the crop’s potential heat unit requirement to obtain a dimensionless development index. This index represents the progression from planting to physiological maturity. The resulting development stage serves as a coordinating variable for multiple downstream crop growth processes." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821275" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "deriving crop development stage from temperature data"@en .

<https://portal.mardi4nfdi.de/entity/Q6821278> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "heat-unit-based phenological development model"@en ;
    mathmoddb:P1459 "This model simulates crop physiological development as a function of accumulated daily heat units. Development progresses from planting to physiological maturity based on temperatures exceeding a crop-specific base temperature. The accumulated heat units are normalized to a heat unit index that ranges from zero at planting to one at maturity. This index controls the timing of key developmental processes such as leaf area expansion, biomass partitioning, and harvest readiness. The approach provides a generic yet crop-specific representation of phenology using thermal time." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821277" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821275" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "crop development driven by accumulated thermal time"@en .

<https://portal.mardi4nfdi.de/entity/Q6821279> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "crop phenological development"@en ;
    mathmoddb:P1459 "The research problem concerns predicting the progression of crop physiological development as influenced by temperature over time. Crop growth stages such as emergence, flowering, and maturity depend strongly on accumulated thermal energy rather than calendar time. The challenge is to represent this dependency in a general, crop-independent yet parameterizable way that can be applied across environments and management scenarios. The modeled solution translates daily temperature data into a normalized development index that governs downstream growth processes. This enables consistent coupling of phenology with biomass production, stress responses, and yield formation." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821278" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "predicting crop development timing from thermal conditions"@en .

<https://portal.mardi4nfdi.de/entity/Q6821280> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "ecophysiology"@en ;
    mathmoddb:P12 "Q295425" ;
    mathmoddb:P1459 "Ecophysiology is a scientific discipline that investigates how the physiological processes of organisms respond and adapt to environmental conditions. It focuses on interactions between biological function and external drivers such as temperature, light, water availability, and nutrient supply. The field seeks to explain how these interactions influence growth, development, reproduction, and survival across different environments. Ecophysiology bridges organismal physiology and ecology by linking internal mechanisms to environmental variability. It provides a mechanistic understanding of how organisms function under natural and managed conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821433" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "study of adaptation of a organism's physiology to environmental conditions"@en .

<https://portal.mardi4nfdi.de/entity/Q6821281> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "intercepted photosynthetically active radiation"@en ;
    mathmoddb:P1459 "Intercepted photosynthetically active radiation represents the portion of incoming solar radiation that is absorbed by the crop canopy and available for photosynthesis. It is computed as a function of total solar radiation and canopy leaf area. This quantity determines the energy input for potential biomass growth. It is a central driver of radiation-based crop growth models." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "radiation intercepted by the crop canopy"@en .

<https://portal.mardi4nfdi.de/entity/Q6821282> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "canopy light attenuation coefficient"@en ;
    mathmoddb:P1459 "This coefficient quantifies the exponential attenuation of incoming radiation as it passes through a plant canopy. It represents the combined effects of absorption and scattering by leaves and other plant organs. The parameter is used in Beer–Lambert type equations to estimate radiation interception from leaf area index. Its value depends on canopy architecture and leaf orientation. It is a specialization of a general attenuation coefficient applied to plant canopies." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534237" ;
    schema:description "attenuation of light within a plant canopy"@en .

<https://portal.mardi4nfdi.de/entity/Q6821283> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "photosynthetically active solar radiation fraction"@en ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534237" ;
    schema:description "solar radiation conversion fraction"@en .

<https://portal.mardi4nfdi.de/entity/Q6821284> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "potential biomass increment"@en ;
    mathmoddb:P1459 "This quantity represents the increase in crop dry matter biomass during a single day under optimal conditions. It is computed from intercepted photosynthetically active radiation and a crop-specific conversion efficiency. The value reflects the maximum attainable biomass growth for that day. It contributes to the accumulation of total potential crop biomass over the growing season." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "potential daily increase in crop biomass"@en .

<https://portal.mardi4nfdi.de/entity/Q6821285> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "radiation use efficiency parameter"@en ;
    mathmoddb:P1459 "This crop-specific parameter defines the efficiency with which intercepted photosynthetically active radiation is converted into dry matter biomass. It represents physiological and biochemical characteristics of the crop. Higher values indicate more efficient biomass production per unit of absorbed radiation. The parameter is assumed constant under optimal growth conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "converts radiation into biomass"@en .

<https://portal.mardi4nfdi.de/entity/Q6821286> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "change in daylength"@en ;
    mathmoddb:P1459 "This quantity represents the daily change in daylength relative to the previous day. It accounts for seasonal variation in photoperiod. It modifies the radiation-driven biomass production term. The quantity introduces a temporal adjustment to potential growth." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "daily change in daylight duration"@en .

<https://portal.mardi4nfdi.de/entity/Q6821287> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "daylength"@en ;
    mathmoddb:P1459 "Daylength represents the number of hours between sunrise and sunset for a given day and location. It depends on Earth’s axial tilt and orbital position relative to the Sun." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "daylight duration"@en .

<https://portal.mardi4nfdi.de/entity/Q6821288> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "solar declination angle"@en ;
    mathmoddb:P1459 "The solar declination angle describes the angular position of the Sun relative to Earth’s equatorial plane. It varies predictably throughout the year due to Earth’s axial tilt. This angle determines the apparent height of the Sun and the length of daylight at a given latitude. It is a standard astronomical variable used in photoperiod calculations." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672114" ;
    schema:description "angle between Sun and equatorial plane"@en .

<https://portal.mardi4nfdi.de/entity/Q6821289> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "day index"@en ;
