    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mo stretchy=\"false\">−</mo><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow></msub><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "nonlinear adsorption isotherm with exponential uptake behavior"@en .

<https://portal.mardi4nfdi.de/entity/Q6821056> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Jovanovic model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Jovanovic equilibrium constant and the Jovanovic maximum adsorption capacity by directly fitting the nonlinear Jovanovic equation to measured solute concentration and adsorbed amount data. The nonlinear approach avoids distortions introduced by linear transformations and preserves the exponential saturation behavior characteristic of the model. The results describe the adsorption affinity and the gradual approach to saturation predicted by the Jovanovic isotherm." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821062" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775722" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Jovanovic model parameters"@en .

