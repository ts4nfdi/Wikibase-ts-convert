<https://portal.mardi4nfdi.de/entity/Q6674354> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "transport equation"@en ;
    mathmoddb:P12 "Q105560509" ;
    mathmoddb:P1459 "There are several (constitutive) equations which describe the transport of matter, or properties of it, in an almost identical way. In every case, in words they read: Flux (density) is proportional to a gradient, where the constant of proportionality is a characteristic of the material. In general, the constant must be replaced by a 2nd rank tensor, to account for directional dependencies of the material." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775445" ;
    mathmoddb:P1691 "https://portal.mardi4nfdi.de/entity/Q6674283" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672107" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>ρ</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>F</mi><mo stretchy=\"false\">∝</mo><mi mathvariant=\"normal\">∇</mi><mi>ρ</mi></mstyle></mrow></math>" ;
    schema:description "equation that describes the transport of some (extensive) quantity such as mass, energy|heat, momentum, electric charge"@en .

<https://portal.mardi4nfdi.de/entity/Q6674355> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "finite volume method"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Finite_volume_method" ;
    mathmoddb:P12 "Q1401936" ;
    mathmoddb:P1459 "In the finite volume method, volume integrals in a partial differential equation that contain a divergence term are converted to surface integrals, using the divergence theorem. These terms are then evaluated as fluxes at the surfaces of each finite volume." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
