<https://portal.mardi4nfdi.de/entity/Q6821194> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Fritz-Schlunder 5-parameter model)"@en ;
    mathmoddb:P1459 "This task concerns fitting the five parameters of the FritzSchlunder 5-parameter isotherm to experimental adsorption data. The model’s high flexibility allows it to capture complex adsorption behavior but requires robust nonlinear optimization to avoid parameter correlation. The estimation involves adjusting the saturation capacity, two constants, and two exponents simultaneously. It is used when adsorption systems exhibit unusual heterogeneity or curvature not representable by simpler models. Accurate parameters enable detailed empirical characterization of challenging adsorption systems." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821189" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "estimation of Fritz-Schlunder model parameters"@en .

