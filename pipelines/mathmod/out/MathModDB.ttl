    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msub><msubsup><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msub><msubsup><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mn>3</mn></mrow></msub></mrow></msubsup><mo stretchy=\"false\">+</mo><msub><mi>P</mi><mrow data-mjx-texclass=\"ORD\"><mn>4</mn></mrow></msub></mrow></mrow></msubsup></mstyle></mrow></math>" ;
    schema:description "empirical nonlinear adsorption equilibrium equation"@en .

<https://portal.mardi4nfdi.de/entity/Q6821375> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Weber-van Vliet model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Weber-van Vliet model parameters by fitting the nonlinear Weber-van Vliet equation to measured equilibrium solute concentration and adsorbed amount data. The fitting procedure minimizes deviations between experimental observations and model predictions across the full concentration range. The resulting parameters provide a flexible empirical representation of adsorption behavior when simpler isotherm models are inadequate. The task is commonly applied in adsorption studies related to chemical wastewater treatment." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821366" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q4115075" ;
    schema:description "nonlinear estimation of Weber-van Vliet parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6821376> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Weber-van Vliet isotherm model"@en ;
    mathmoddb:P1459 "The Weber-van Vliet isotherm model is an empirical adsorption model developed to describe equilibrium adsorption behavior using a flexible four-parameter formulation. It directly relates equilibrium solute concentration to adsorbed amount without assuming ideal monolayer adsorption or a specific adsorption mechanism. The model is particularly useful when classical two-parameter isotherms such as Langmuir or Freundlich fail to fit experimental data over wide concentration ranges. Due to its empirical nature, the parameters do not have a strict physical interpretation but provide high flexibility in curve fitting. The model has been applied in adsorption studies relevant to chemical and environmental engineering, including wastewater treatment." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821375" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821372" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821374" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "empirical four-parameter adsorption isotherm model"@en .

<https://portal.mardi4nfdi.de/entity/Q6821377> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "total root weight increment"@en ;
    mathmoddb:P1459 "This quantity represents the potential daily increase in crop root biomass on a specific day. It is computed as the portion of total biomass growth allocated to the root system. The value reflects phenology-dependent carbon partitioning rather than independent root growth. It is used to update the total root biomass and to drive subsequent root distribution calculations. It is expressed as a mass per unit area." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "daily change in total root weight"@en .

<https://portal.mardi4nfdi.de/entity/Q6821378> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "root weight in soil layer increment"@en ;
    mathmoddb:P1459 "This quantity represents the root weight increment allocated to a specific soil layer. It is a portion of the total root weight increment." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "daily change in root weight in soil layer"@en .

<https://portal.mardi4nfdi.de/entity/Q6821379> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "plant water use rate in soil layer"@en ;
    mathmoddb:P1459 "This quantity represents the amount of water extracted by plant roots from a specific soil layer on a specific day. It reflects both root presence and soil water availability in that layer. Water use is reduced when soil moisture is limiting or when root stress factors restrict root function." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775543" ;
    schema:description "plant water use rate in soil layer considering soil moisture"@en .

<https://portal.mardi4nfdi.de/entity/Q6821380> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "rooting depth"@en ;
    mathmoddb:P1459 "This quantity represents the vertical extent of the crop root system on a specific day. It defines the maximum soil depth from which roots can extract water and nutrients. Rooting depth increases as the crop develops and is capped by the soil profile depth. The value constrains root biomass distribution and soil–plant exchange processes. It is expressed as a length." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6821381" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775543" ;
    schema:description "depth of roots"@en .

<https://portal.mardi4nfdi.de/entity/Q6821381> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "maximum root depth"@en ;
    mathmoddb:P1459 "This quantity represents the maximum rooting depth attainable by a crop under ideal soil conditions. It is a crop-specific parameter reflecting genetic potential for root system expansion." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "crop-specific maximum rooting depth under ideal soil conditions"@en .

<https://portal.mardi4nfdi.de/entity/Q6821382> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "root zone depth"@en ;
    mathmoddb:P1459 "This quantity represents the depth of the soil profile available for root growth. It constrains the maximum rooting depth that can be attained regardless of crop potential. It reflects physical soil limitations such as bedrock or impermeable layers." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "maximum depth available for root growth in the soil profile"@en .

<https://portal.mardi4nfdi.de/entity/Q6821383> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "root biomass partitioning equation"@en ;
    mathmoddb:P1459 "This equation computes the potential daily increase in root biomass by allocating a fraction of total crop biomass growth to the root system. The allocation fraction decreases linearly with phenological development, reflecting empirical observations that crops invest more biomass in roots during early growth stages than at maturity. At emergence, a larger share of biomass is assigned to root growth, while this share is reduced as the crop develops. The formulation represents a simplified biomass partitioning rule rather than an independent root growth process. The resulting root biomass increment is used as input for subsequent root distribution and soil interaction calculations." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>I</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>Δ</mi><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">(</mo><mn>0.4</mn><mo stretchy=\"false\">−</mo><mn>0.2</mn><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "computes fraction of biomass allocated to roots"@en .

<https://portal.mardi4nfdi.de/entity/Q6821384> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "root biomass distribution equation"@en ;
    mathmoddb:P1459 "This equation distributes the total daily increase in root biomass among soil layers in proportion to plant water use in each layer. The formulation assumes that layers contributing more to water uptake also receive a larger share of new root growth. Normalization by total water use ensures conservation of total root biomass increment across layers. The approach yields realistic vertical root distributions under non-limiting conditions and dynamically adjusts allocation when soil water or root stress factors reduce water uptake." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mi>Δ</mi><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><munderover><mo movablelimits=\"false\" stretchy=\"false\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>l</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mi>M</mi></mrow></munderover><msub><mi>u</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "allocates root biomass growth according to water use"@en .

<https://portal.mardi4nfdi.de/entity/Q6821385> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "rooting depth equation"@en ;
    mathmoddb:P1459 "This equation computes crop rooting depth as a linear function of phenological development represented by the heat unit index. Root depth increases proportionally with heat unit accumulation and approaches a crop-specific maximum under ideal soil conditions. A scaling constant ensures that maximum rooting depth is attained early in the growing season, before physiological maturity. The computed rooting depth is constrained by the soil profile depth, preventing roots from extending beyond the available root zone. The equation provides a simplified representation of root system expansion." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>D</mi><mi>M</mi><mi>X</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mn>2.5</mn><mi>R</mi><mi>D</mi><mi>M</mi><msub><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>" ;
    schema:description "computes crop rooting depth from heat unit index"@en .

<https://portal.mardi4nfdi.de/entity/Q6821386> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "rooting depth constraint"@en ;
    mathmoddb:P1459 "This constraint limits simulated crop rooting depth to the depth of the soil profile. It prevents roots from extending beyond physically available soil layers. The constraint reflects soil-imposed limitations on root system expansion. It is applied after computing potential rooting depth from phenological development." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672081" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>Z</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">≤</mo><mi>R</mi><msub><mi>Z</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub></mstyle></mrow></math>" ;
    schema:description "limits rooting depth to soil profile depth"@en .

<https://portal.mardi4nfdi.de/entity/Q6821387> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of root biomass allocation"@en ;
    mathmoddb:P1459 "This task computes the fraction of daily crop biomass growth that is allocated to the root system. The allocation fraction is determined as a linear function of phenological development. The task produces a deterministic estimate of daily root biomass increment, which is used to update root system mass." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821425" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775549" ;
    schema:description "allocates daily biomass growth to the root system"@en .

<https://portal.mardi4nfdi.de/entity/Q6821388> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of rooting depth"@en ;
    mathmoddb:P1459 "This task computes crop rooting depth as a function of phenological development and crop-specific root characteristics. Rooting depth increases with accumulated heat units and is capped by the potential root zone depth of the soil. The task produces a deterministic estimate of rooting depth at each time step. The resulting depth constrains root biomass distribution and soil water and nutrient uptake processes." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821277" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "calculates crop rooting depth from phenological development"@en .

<https://portal.mardi4nfdi.de/entity/Q6821389> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of root biomass distribution"@en ;
    mathmoddb:P1459 "This task computes how daily root biomass growth is distributed across the soil profile. It allocates the total root biomass increment to individual soil layers based on their relative contribution to plant water uptake. The task produces a layer-specific root biomass increment for each time step. The resulting distribution is used to represent root presence and function within the soil." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821596" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "allocates daily root growth to soil layers"@en .

<https://portal.mardi4nfdi.de/entity/Q6821390> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "root biomass partitioning model"@en ;
    mathmoddb:P1459 "This model computes the potential daily increase in crop root biomass by allocating a fraction of total biomass growth to the root system. The allocation fraction decreases linearly with phenological development, reflecting a shift in carbon partitioning from roots to aboveground organs as the crop matures. At emergence, a larger share of biomass is allocated to roots, while at maturity this share is reduced. The model represents empirical knowledge of crop biomass partitioning in a simplified and deterministic manner. The resulting root biomass increment serves as input for root distribution and soil interaction models." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821387" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821278" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "model allocating biomass growth to the root system"@en .

<https://portal.mardi4nfdi.de/entity/Q6821391> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "root depth model"@en ;
    mathmoddb:P1459 "This model simulates the temporal development of crop rooting depth during the growing season. Root depth increases as a function of phenological development and approaches a crop-specific maximum under ideal soil conditions. The model assumes that rooting depth expands rapidly early in the growing season and reaches its maximum well before physiological maturity. Root depth is constrained by the depth of the soil profile, preventing unrealistic penetration beyond available soil layers. The simulated rooting depth limits the spatial extent of root biomass distribution and soil resource uptake." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821388" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821386" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "model simulating crop rooting depth development"@en .

<https://portal.mardi4nfdi.de/entity/Q6821392> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of root biomass partitioning"@en ;
    mathmoddb:P1459 "This research problem addresses the estimation of how total crop biomass growth is partitioned between aboveground and belowground components. Biomass allocation to roots varies systematically over the growing season and influences soil resource uptake. Representing this allocation is essential for modeling crop growth and plant–soil interactions. The problem focuses on capturing empirically observed shifts in partitioning as crops develop from emergence to maturity." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821390" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify allocation of crop biomass to roots"@en .

<https://portal.mardi4nfdi.de/entity/Q6821393> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "root biomass distribution model"@en ;
    mathmoddb:P1459 "This model simulates the vertical distribution of root biomass growth within the soil profile. Newly formed root biomass is allocated among soil layers in proportion to plant water use in each layer. This approach links root development to functional root activity rather than purely geometric depth. Under non-limiting conditions, the formulation produces an exponential decrease in root biomass with depth. When soil water availability or root stress factors constrain growth, both water use and root biomass allocation are reduced accordingly." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821389" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821384" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672110" ;
    schema:description "model distributing root biomass growth across soil layers"@en .

<https://portal.mardi4nfdi.de/entity/Q6821394> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of crop rooting depth"@en ;
    mathmoddb:P1459 "This research problem addresses the estimation of how deep crop roots extend into the soil over time. Rooting depth determines access to water and nutrients stored in deeper soil layers and influences crop resilience to drought. In many crops, rooting depth increases rapidly early in development and reaches its maximum before maturity. Accurate representation of rooting depth is essential for modeling soilplant interactions and belowground resource availability. The problem links phenological development with physical constraints imposed by soil depth." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821391" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify the vertical extent of the crop root system"@en .

<https://portal.mardi4nfdi.de/entity/Q6821395> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of vertical root biomass distribution"@en ;
    mathmoddb:P1459 "This research problem concerns the representation of how crop root biomass is distributed vertically within the soil profile. Root distribution determines which soil layers contribute to water and nutrient uptake. A realistic description must account for functional root activity rather than only geometric depth. The problem focuses on linking root growth allocation to soil-layer-specific conditions, such as water availability. Accurate representation of vertical root distribution is essential for modeling soil-plant interactions and crop responses to environmental stress." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821393" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify how root growth is distributed across soil layers"@en .

