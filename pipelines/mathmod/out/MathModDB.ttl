<https://portal.mardi4nfdi.de/entity/Q6821597> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "potential plant evaporation rate equation"@en ;
    mathmoddb:P1459 "This equation estimates the potential plant evaporation rate as a fraction of the potential evaporation. The fraction depends on canopy development, represented by the leaf area index. The formulation constrains the potential plant evaporation rate so that it does not exceed the potential evaporation. It provides a simple representation of canopy resistance in the plant water use model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821595" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
