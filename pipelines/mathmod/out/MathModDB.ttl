    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>E</mi><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>E</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>a</mi><mi>x</mi></mrow></mrow></msub><msub><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>E</mi><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mn>50</mn></mrow></msub><mo stretchy=\"false\">+</mo><msub><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow></msub></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "hyperbolic equation describing non-cooperative dose–response"@en .

<https://portal.mardi4nfdi.de/entity/Q6775842> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Emax model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation for the non-cooperative Emax dose–response model. It determines the maximal effect and the half-maximal effective concentration by directly fitting the nonlinear Emax equation to measured concentration–response data. Nonlinear regression avoids the biases associated with linearized transformations and provides accurate estimates of potency and maximal efficacy. The resulting parameters characterize the saturation behavior of the system and the sensitivity of the response to changing concentrations. This approach is widely used in pharmacology and toxicology to quantify drug action under non-cooperative conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775854" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Emax model parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6775843> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Hill model (binding)"@en ;
    mathmoddb:P1459 "The Hill model in binding is an empirical equilibrium model used to describe cooperative interactions between ligands and macromolecular binding sites. It represents fractional occupancy as a sigmoidal function of ligand concentration, controlled by the Hill coefficient, which quantifies positive or negative cooperativity. The model provides a phenomenological framework for allosteric or multi-site binding without requiring a detailed mechanistic interpretation of the molecular steps involved. When the Hill coefficient equals one, the model reduces to simple non-cooperative binding governed by mass-action behavior, though no distinct classical model emerges from this case. The Hill binding model is widely applied in biochemistry, molecular biology, and systems biology to analyze cooperative binding equilibria." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775845" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775844" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775862" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "empirical model describing cooperative ligand binding"@en .

