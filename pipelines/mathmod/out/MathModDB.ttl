<https://portal.mardi4nfdi.de/entity/Q6822203> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "gas separation"@en ;
    mathmoddb:P12 "Q17050218" ;
    mathmoddb:P1459 "Gas separation is the process of selectively isolating one or more components from a gas mixture. It encompasses a variety of techniques, including adsorption, membranes, cryogenic distillation, and pressure or temperature swing methods. Research in this area focuses on developing efficient, selective, and scalable separation processes for industrial and environmental applications. Typical goals include purifying products, recovering valuable gases, or removing pollutants from gas streams. Advances in materials, process design, and modeling are key to improving the efficiency and sustainability of gas separation technologies." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6822199" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "technique to provide multiple products or purify a product"@en .

