    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>2</mn><mi>s</mi></mrow></mrow></mfrac></mrow><mi>ln</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">+</mo><mi>b</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mi>s</mi></mrow></msup><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">+</mo><mi>b</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mi>s</mi></mrow></mrow></msup><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
