<https://portal.mardi4nfdi.de/entity/Q6821422> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "harvest index accumulation equation"@en ;
    mathmoddb:P1459 "This equation computes the harvest index on a specific day by accumulating the harvest index heat unit factor over time. It represents the gradual allocation of above-ground biomass to crop yield as the crop develops. The formulation ensures that harvest index increases from zero at planting to its maximum value at maturity. It captures the temporal dynamics of reproductive development." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672107" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>H</mi><mi>U</mi><mi>F</mi><mi>H</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>I</mi><msub><mi>A</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>H</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><munderover><mo movablelimits=\"false\" stretchy=\"false\">∑</mo><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>K</mi><mo stretchy=\"false\">=</mo><mn>1</mn></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></munderover><mi>Δ</mi><mi>H</mi><mi>U</mi><mi>F</mi><msub><mi>H</mi><mrow data-mjx-texclass=\"ORD\"><mi>K</mi></mrow></msub></mstyle></mrow></math>" ;
    schema:description "computes daily harvest index value"@en .

<https://portal.mardi4nfdi.de/entity/Q6821423> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "harvest index heat unit factor equation"@en ;
    mathmoddb:P1459 "This equation computes a heat unit factor that controls the rate of harvest index development. The factor increases non-linearly with phenological development represented by the heat unit index. Parameter values are chosen so that most crop yield is produced during the second half of the growing season. The formulation reflects observed reproductive development patterns in grain crops." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672094" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>I</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>U</mi><mi>F</mi><msub><mi>H</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">+</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>6.50</mn><mo stretchy=\"false\">−</mo><mn>10.0</mn><mi>H</mi><mi>U</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></mrow></msup></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "computes phenological scaling factor for harvest index"@en .

<https://portal.mardi4nfdi.de/entity/Q6821424> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "crop economic yield equation"@en ;
    mathmoddb:P1459 "This equation computes crop economic yield as the product of harvest index and above-ground biomass. It assumes that yield is proportional to vegetative biomass production. The formulation represents a harvest index–based yield estimation approach commonly used in crop models. It provides a simple and robust link between biomass growth and harvestable yield." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672107" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Y</mi><mi>L</mi><mi>D</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Y</mi><mi>L</mi><msub><mi>D</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>H</mi><msub><mi>I</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><mi>G</mi></mrow></mrow></msub></mstyle></mrow></math>" ;
    schema:description "computes economic yield from harvest index"@en .

<https://portal.mardi4nfdi.de/entity/Q6821425> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "total root weight accumulation equation"@en ;
    mathmoddb:P1459 "This equation updates the accumulated total root weight by adding the daily total root weight increment to its previous value. It represents the temporal integration of daily root weight production over the growing season. The formulation assumes that root weight accumulation is additive and does not impose additional physiological constraints beyond those governing daily production. The equation is applied at each simulation time step to maintain the root weight state variable. It provides the accumulated total root weight used in subsequent yield formation processes." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>W</mi><mi>T</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo stretchy=\"false\">−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy=\"false\">+</mo><mi>Δ</mi><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>" ;
    schema:description "accumulates daily total root weight"@en .

<https://portal.mardi4nfdi.de/entity/Q6821426> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "above-ground biomass equation"@en ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672094" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><mi>G</mi></mrow></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>A</mi><mi>G</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">−</mo><mi>R</mi><mi>W</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mstyle></mrow></math>" ;
    schema:description "determine above-ground biomass from total biomass and root weight"@en .

<https://portal.mardi4nfdi.de/entity/Q6821427> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of harvest index heat unit factor"@en ;
    mathmoddb:P1459 "This task computes a phenological scaling factor that governs the rate of harvest index development. The factor is derived from the heat unit index using a non-linear response function that reflects observed patterns of reproductive development in crops. It ensures that harvest index increases slowly during early growth and more rapidly during later stages of development. The task provides the daily heat unit factor used as input to the harvest index development computation. It links phenological progress to above ground biomass allocation to crop yield." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821423" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775549" ;
    schema:description "calculates heat unit factor affecting harvest index"@en .

<https://portal.mardi4nfdi.de/entity/Q6821428> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of above-ground biomass"@en ;
    mathmoddb:P1459 "This task computes the total above-ground biomass from the accumulated potential biomass and the accumulated potential root weight." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821426" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672085" ;
    schema:description "calculates above-ground biomass"@en .

<https://portal.mardi4nfdi.de/entity/Q6821429> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of harvest index development"@en ;
    mathmoddb:P1459 "This task computes the temporal development of harvest index over the growing season. It integrates the daily heat unit-based harvest index factor to represent the progressive allocation of above ground biomass to crop yield. The task produces the harvest index value for each time step, starting from zero at planting and approaching a crop-specific maximum at maturity. It depends on the computation of the harvest index heat unit factor, which controls the rate and timing of development. The resulting harvest index is used to track the progression of reproductive development and to determine when the crop has reached its final harvest index value." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821427" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775549" ;
    schema:description "calculates harvest index over time"@en .

<https://portal.mardi4nfdi.de/entity/Q6821430> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of crop economic yield"@en ;
    mathmoddb:P1459 "This task computes crop economic yield by multiplying above-ground biomass by harvest index. It produces a final yield estimate at maturity. The task assumes non-stressed conditions unless modified by additional stress models." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821428" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672085" ;
    schema:description "calculates harvestable crop yield"@en .

<https://portal.mardi4nfdi.de/entity/Q6821431> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "harvest index development model"@en ;
    mathmoddb:P1459 "This model simulates the development of harvest index over the growing season. Harvest index represents the fraction of above-ground biomass allocated to crop yield. The model assumes that harvest index increases non-linearly from planting to maturity under non-stressed conditions. Development is controlled by phenological progress using a heat unit based scaling factor. The simulated harvest index is used to compute final crop yield." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821429" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821423" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672110" ;
    schema:description "model simulating temporal development of harvest index"@en .

<https://portal.mardi4nfdi.de/entity/Q6821432> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "economic yield model"@en ;
    mathmoddb:P1459 "This model computes crop economic yield using the harvest index concept. Economic yield is calculated as the product of harvest index and above-ground biomass at maturity. The formulation assumes that yield is proportional to accumulated vegetative production. The model provides a simplified but robust estimate of harvestable crop yield. It does not explicitly represent grain filling or reproductive organ growth." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821430" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821426" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "model computing crop economic yield from above-ground biomass"@en .

<https://portal.mardi4nfdi.de/entity/Q6821433> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of harvest index development"@en ;
    mathmoddb:P1459 "This research problem addresses how crops allocate above-ground biomass to reproductive or economic organs over time. Harvest index is often relatively stable at maturity but develops dynamically during the growing season. Accurately representing its development is essential for predicting crop yield. The problem links phenological development with above-ground biomass partitioning to reproductive structures." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821431" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify temporal allocation of above-ground biomass to crop yield"@en .

<https://portal.mardi4nfdi.de/entity/Q6821434> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of crop economic yield"@en ;
    mathmoddb:P1459 "This research problem concerns the estimation of harvestable crop yield based on biomass production. Economic yield represents the portion of plant biomass that can be removed from the field. Accurate yield estimation is central to agricultural and food system modeling. The problem links biomass accumulation with reproductive allocation." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821432" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify harvestable yield from above-ground crop biomass"@en .

<https://portal.mardi4nfdi.de/entity/Q6821435> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "agronomy"@en ;
    mathmoddb:P12 "Q173113" ;
    mathmoddb:P1459 "Agronomy is the science and technology of producing and using plants for food, fuel, fiber, and land management. A central concern of the discipline is the estimation and improvement of crop yield under field conditions. Agronomic models translate plant growth processes into practical measures of agricultural productivity. Harvest index–based approaches provide a widely used method to link biomass production with economically relevant yield." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6824238" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "science and technology of producing and using plants for food, fuel, fiber, and reclamation"@en .

