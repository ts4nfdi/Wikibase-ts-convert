    rdfs:label "model order reduction"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/Model_order_reduction" ;
    mathmoddb:P12 "Q12202921" ;
    mathmoddb:P1459 "After spatial discretization of PDEa, solving the resulting large-scale systems of ODEs can therefore become incredibly time-consuming. Developed from well established mathematical theory and robust numerical algorithms, Model Order Reduction (MOR) has been recognized as very efficient for reducing the simulation time of large-scale systems." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
