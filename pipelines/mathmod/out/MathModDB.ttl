<https://portal.mardi4nfdi.de/entity/Q6775644> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Monod equation"@en ;
    mathmoddb:P12 "Q1944979" ;
    mathmoddb:P1459 "The Monod model explains how the specific growth rate of microorganisms depends on the availability of a limiting nutrient. It shows that the specific growth rate increases with nutrient concentration but eventually levels off when the microorganisms reach their maximum specific growth rate." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775645" ;
