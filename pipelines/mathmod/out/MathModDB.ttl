<https://portal.mardi4nfdi.de/entity/Q6821116> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Redlich-Peterson isotherm model"@en ;
    mathmoddb:P1459 "The Redlich-Peterson isotherm model is a three-parameter empirical adsorption model that combines features of both the Langmuir monolayer isotherm and the Freundlich heterogeneous isotherm. It describes adsorption using a linear dependence on concentration in the numerator and a nonlinear term in the denominator, enabling accurate representation over a wide concentration range. The model does not assume ideal monolayer adsorption and can be applied to both homogeneous and heterogeneous surfaces. Its exponent parameter controls the degree to which the model behaves like Langmuir (β close to 1) or Henry (β close to 0). Because of its versatility, the Redlich-Peterson model frequently provides excellent agreement with experimental data in chemical wastewater treatment and other adsorption applications." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821119" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821117" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775721" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821611" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q4760921" ;
    schema:description "empirical hybrid adsorption model combining Langmuir and Freundlich"@en .

