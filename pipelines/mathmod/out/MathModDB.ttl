<https://portal.mardi4nfdi.de/entity/Q6821439> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "mathematical pendulum period (small angle)"@en ;
    mathmoddb:P1459 "This relation is also known as Christiaan Huygens's law for the period of a pendulum. Note that under the small-angle approximation, the period is independent of the initial amplitude; this is the property of isochronism that Galileo first discovered." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
