    mathmoddb:P104 "https://en.wikipedia.org/wiki/Taylor%E2%80%93Couette_flow" ;
    mathmoddb:P12 "Q3151656" ;
    mathmoddb:P1459 "The stationary flow of an incompressible fluid confined in between two rotating cylinders of different radii and angular velocities is a well-known benchmark problem in numerical fluid dynamics. For low relative angular velocities and for a small gap (relative to the diameters of the cylinders), i.e., for a Reynolds number, the flow is steady and purely azimuthal, for which case an analytical solution exists." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1463 "https://portal.mardi4nfdi.de/entity/Q16496" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6830616" ;
    mathmoddb:P1690 "https://www.openfoam.com/documentation/guides/v1912/doc/guide-applications-solvers-incompressible-simpleFoam.html" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6830687" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    mathmoddb:P356 "http://commons.wikimedia.org/wiki/Special:FilePath/CouetteTaylorSystem.png" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q1512328" ;
    schema:description "viscous fluid confined in the gap between two rotating cylinders of different radii and angular velocities"@en .

