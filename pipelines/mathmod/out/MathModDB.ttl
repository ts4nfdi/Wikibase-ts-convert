<https://portal.mardi4nfdi.de/entity/Q6821362> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "crop height equation"@en ;
    mathmoddb:P1459 "This equation computes crop height as a function of phenological development. Height increases with accumulated thermal progress and approaches a crop-specific maximum value as the crop matures. The formulation assumes a monotonic relationship between development stage and plant height, representing structural growth in a simplified manner. It does not explicitly model biomass allocation or mechanical growth processes. The equation provides a deterministic estimate of canopy height at discrete time steps for use in crop growth and environmental models." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672075" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>H</mi><mi>M</mi><mi>X</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>C</mi><mi>H</mi><msub><mi>T</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub><mo stretchy=\"false\">=</mo><mi>H</mi><mi>M</mi><msub><mi>X</mi><mrow data-mjx-texclass=\"ORD\"><mi>j</mi></mrow></msub><mrow data-mjx-texclass=\"ORD\"><msqrt><mrow data-mjx-texclass=\"ORD\"><mi>H</mi><mi>U</mi><msub><mi>F</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi></mrow></msub></mrow></msqrt></mrow></mstyle></mrow></math>" ;
    schema:description "computes height of crop"@en .

<https://portal.mardi4nfdi.de/entity/Q6821363> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of crop height"@en ;
    mathmoddb:P1459 "This task computes crop height as a function of phenological progress during the growing season. It uses a normalized development factor to scale crop height between emergence and maturity. The task produces a deterministic estimate of crop height at each time step. The resulting height can be used to parameterize canopy structure and related processes." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821361" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "calculates crop height from phenological development"@en .

<https://portal.mardi4nfdi.de/entity/Q6821364> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "crop height model"@en ;
    mathmoddb:P1459 "This model simulates the temporal development of crop height during the growing season. Crop height is represented as a function of phenological progress, reflecting structural growth of the plant. The model scales height from emergence toward a crop-specific maximum as development advances. It provides a simplified, deterministic representation of canopy vertical structure without explicitly modeling mechanical or anatomical processes. The simulated crop height is used to characterize canopy structure in crop growth and land surface models." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821363" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821362" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672082" ;
    schema:description "model simulating crop height development over time"@en .

