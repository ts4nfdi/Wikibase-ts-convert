<https://portal.mardi4nfdi.de/entity/Q6821163> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Toth model)"@en ;
    mathmoddb:P1459 "This task involves estimating the parameters of the Toth adsorption isotherm model from equilibrium adsorption data. The model is nonlinear in its parameters, so numerical regression techniques are required to obtain optimal values for the maximum adsorption capacity, equilibrium constant, and heterogeneity exponent. The goal is to minimize prediction error between experimental uptake data and the theoretical Toth curve. The task is typically implemented using nonlinear least-squares optimization. Estimated parameters are then used to characterize adsorption behavior on heterogeneous surfaces." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821166" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775767" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q1110333" ;
    schema:description "nonlinear estimation of Toth model parameters"@en .

