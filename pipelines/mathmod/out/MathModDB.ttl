<https://portal.mardi4nfdi.de/entity/Q6775654> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Andrews model"@en ;
    mathmoddb:P1459 "The Andrews model is a mathematical model that describes the specific growth rate of micoorganisms. It modifies the traditional Monod model to account for the negative effects of high substrate concentrations. When the substrate level becomes too high, the specific growth rate decreases due to inhibition. This model is widely used in fermentation and other bioprocesses to predict growth under inhibitory conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775655" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775658" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775644" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775657" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6775765" ;
    schema:description "microbial growth model accounting for substrate inhibition"@en .

