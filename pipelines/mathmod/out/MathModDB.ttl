    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6820992" ;
    schema:description "nonlinear estimation of Kiselev model parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6820972> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "linear parameter estimation (Kiselev model)"@en ;
    mathmoddb:P1459 "This task estimates the Kiselev equilibrium constant and the complex formation constant using the linearized form of the Kiselev isotherm. Experimental equilibrium coverage and concentration data are transformed and analyzed using linear regression. Although computationally simple, the approach may introduce bias due to data transformation. The estimated parameters describe adsorption affinity and the extent of complex formation among adsorbed species." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
