    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mrow data-mjx-texclass=\"ORD\"><mi>𝝈</mi></mrow><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mi>𝖢</mi></mrow><mo stretchy=\"false\">:</mo><mrow data-mjx-texclass=\"ORD\"><mi>𝜺</mi></mrow></mstyle></mrow></math>" ;
