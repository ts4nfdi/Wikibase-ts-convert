><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">≤</mo><mn>0.01516</mn></mtd></mtr><mtr><mtd class=\"mwe-math-columnalign-l\"><msubsup><mi>F</mi><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">M</mi></mrow></mrow></msubsup><mo stretchy=\"false\">(</mo><mn>37.526</mn><msub><mi>ϵ</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">T</mi></mrow></mrow></msub><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">−</mo><mn>0.26029</mn><mo stretchy=\"false\">)</mo><mtext>&#160;</mtext></mtd><mtd class=\"mwe-math-columnalign-l\"><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">f</mi></mrow></mrow><mtext>&#160;</mtext><mn>0.01516</mn><mo>&lt;</mo><msub><mi>ϵ</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">T</mi></mrow></mrow></msub><mo stretchy=\"false\">(</mo><mi>t</mi><mo stretchy=\"false\">)</mo><mo>&lt;</mo><mn>0.1</mn></mtd></mtr></mtable><mo fence=\"true\" stretchy=\"true\" symmetric=\"true\" data-mjx-texclass=\"CLOSE\"></mo></mrow></mstyle></mrow></math>" ;
