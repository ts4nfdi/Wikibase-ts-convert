    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>S</mi><mi>H</mi></mrow></mrow></msub><msubsup><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msubsup><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mi>D</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup><mo stretchy=\"false\">+</mo><msubsup><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
