    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6775763" ;
    schema:description "mathematical model for biomass growth and substrate utilization in a batch reactor following Monod"@en .

<https://portal.mardi4nfdi.de/entity/Q6775666> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "evaluation of biokinetic parameters"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental data for biomass concentration and substrate concentration in a bioreactor. The objective is to determine key kinetic parameters, including the maximum specific growth rate, Monod constant, and death rate coefficient, by fitting a dynamic model of biomass growth and substrate consumption to the observed data." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775681" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775549" ;
    schema:description "kinetic batch reactor model following Monod"@en .

<https://portal.mardi4nfdi.de/entity/Q6775667> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "kinetic batch reactor model (Haldane)"@en ;
    mathmoddb:P1459 "The Haldane-based kinetic batch reactor model is a mathematical model that describes the growth of microorganisms and substrate consumption in a closed system. It relates the rate of biomass change to the concentration of a limiting substrate, includes a death rate coefficient to account for microbial decay, and a substrate inhibition constant to account for substrate inhibition at high concentrations." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775668" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775682" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775665" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775678" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q1437088" ;
    schema:description "mathematical model for biomass growth and substrate utilization in a batch reactor following Haldane"@en .

