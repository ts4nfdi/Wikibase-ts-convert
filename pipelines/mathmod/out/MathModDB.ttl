    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mo stretchy=\"false\">−</mo><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mi>J</mi></mrow></msub><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">)</mo><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>J</mi><mo>,</mo><mi>m</mi></mrow></mrow></msub><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "nonlinear multilayer adsorption equation"@en .

<https://portal.mardi4nfdi.de/entity/Q6821060> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Jovanovic multilayer model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using equilibrium adsorption data. The objective is to determine the Jovanovic monolayer capacity together with the first-layer and multilayer adsorption constants by directly fitting the nonlinear multilayer Jovanovic equation to measurements of solute concentration and adsorbed amount. Unlike linearized approaches, nonlinear fitting preserves the intrinsic exponential structure of the multilayer model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821063" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6821056" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of multilayer Jovanovic model parameters"@en .

