<https://portal.mardi4nfdi.de/entity/Q124919> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "agricultural science"@en ;
    mathmoddb:P12 "Q3606845" ;
    mathmoddb:P1459 "Agricultural science is the academic field concerned with the study of agriculture, food production, and land management using scientific methods. It integrates knowledge from biology, ecology, chemistry, engineering, and economics to improve the efficiency and sustainability of agricultural systems. The field addresses problems such as crop productivity, soil management, resource use, and environmental impacts of farming. Through research and modeling, agricultural science supports evidence-based decision making in food and fiber production. It provides the broader disciplinary context for applied fields such as agronomy, animal science, and agricultural engineering." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6821435" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "academic field about agriculture and farming"@en .

