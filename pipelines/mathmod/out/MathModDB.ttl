<https://portal.mardi4nfdi.de/entity/Q6822199> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "gas separation (adsorption)"@en ;
    mathmoddb:P1459 "Gas separation using adsorption is a process in which specific gas components are selectively adsorbed onto solid surfaces. The equilibrium between the adsorbed phase and the gas phase can often be described by the Langmuir adsorption isotherm. Research includes studying adsorbent materials, optimizing operating conditions, and evaluating separation efficiency and selectivity. This process is applied in industrial contexts such as carbon dioxide capture, air purification, and hydrogen recovery. Understanding adsorption thermodynamics and kinetics is essential for designing efficient gas separation systems." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6775766" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "selective adsorption of gas components onto solid surfaces for separation"@en .

<https://portal.mardi4nfdi.de/entity/Q6822200> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534245> ;
