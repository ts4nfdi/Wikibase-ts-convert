<https://portal.mardi4nfdi.de/entity/Q6534341> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "semiconductor charge neutrality"@en ;
    mathmoddb:P1459 "The physical concept of local charge neutrality in semiconductor is characterized by the absence of space charge regions. Hence, the Poisson equation for the electric field potential simplifies to the Laplace equation." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
