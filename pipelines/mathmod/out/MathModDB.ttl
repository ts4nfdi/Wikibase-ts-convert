<https://portal.mardi4nfdi.de/entity/Q6775832> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Hill adsorption model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using equilibrium adsorption data applied to the Hill adsorption model. It determines the Hill adsorption constant, the maximum adsorption capacity, and the cooperativity exponent by directly fitting the nonlinear Hill isotherm to solute concentration and adsorbed-amount measurements. Nonlinear regression avoids structural distortions introduced by linearized forms and ensures accurate estimation of parameters across cooperative and non-cooperative regimes. The resulting parameters quantify adsorption affinity, surface saturation behavior, and cooperative interactions among adsorbed species. This approach is commonly used in environmental and materials science to analyze sigmoidal adsorption equilibria." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775848" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "nonlinear estimation of Hill adsorption model parameters"@en .

