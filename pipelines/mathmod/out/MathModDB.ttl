<https://portal.mardi4nfdi.de/entity/Q6821128> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Dubinin-Radushkevich isotherm model"@en ;
    mathmoddb:P1459 "The Dubinin-Radushkevich isotherm is an empirical adsorption model originally developed for describing micropore filling of subcritical vapors on porous solids. It assumes a Gaussian distribution of adsorption energies on a heterogeneous surface and uses the Polanyi potential to express the effective adsorption work. The model is temperature-dependent and yields a characteristic curve when adsorption data at different temperatures are plotted against the square of the adsorption potential. The Dubinin-Radushkevich model is often used to distinguish physical from chemical adsorption via its mean free adsorption energy. It typically fits intermediate concentration ranges well but does not satisfy Henry’s law at low concentrations." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821130" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821129" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821336" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6821141" ;
    schema:description "empirical adsorption model with Gaussian energy distribution on micropores"@en .

