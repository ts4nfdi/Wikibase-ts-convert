<https://portal.mardi4nfdi.de/entity/Q6674076> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "normal coordinate"@en ;
    mathmoddb:P12 "Q112730947" ;
    mathmoddb:P1459 "Normal coordinates refer to the positions of atoms away from their equilibrium positions, wrt a normal mode of vibration. Formally, normal modes are determined by solving a secular determinant, and then the normal coordinates can be expressed as a summation over the cartesian coordinates (over the atom positions). The normal modes diagonalize the matrix governing the molecular vibrations." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1658 "https://portal.mardi4nfdi.de/entity/Q6674077" ;
    mathmoddb:P1690 "https://en.wikipedia.org/wiki/Normal_mode" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534237" ;
    schema:description "pattern of motion in which all parts of the system move sinusoidally with the same frequency and with a fixed phase relation"@en .

