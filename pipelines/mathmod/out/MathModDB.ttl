    rdfs:label "half maximal effective concentration"@en ;
    mathmoddb:P104 "https://en.wikipedia.org/wiki/EC50" ;
    mathmoddb:P12 "Q286136" ;
    mathmoddb:P1459 "Half maximal effective concentration (EC50) is a measure of the concentration of a drug, antibody or toxicant which induces a biological response halfway between the baseline and maximum after a specified exposure time." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
