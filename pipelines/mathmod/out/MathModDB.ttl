<https://portal.mardi4nfdi.de/entity/Q6674389> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "Hooke's law (spring)"@en ;
    mathmoddb:P1459 "An empirical law which states that the force (F) needed to extend or compress a spring by some distance (x) scales linearly with respect to that distance—that is, F = kx, where k is a constant factor characteristic of the spring (i.e., its stiffness), and x is small compared to the total possible deformation of the spring. The law is named after 17th-century British physicist Robert Hooke." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
