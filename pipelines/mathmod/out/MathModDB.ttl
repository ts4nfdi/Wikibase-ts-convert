    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6672211" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "novel functional elements in modular architectures of semiconductor quantum processors"@en .

