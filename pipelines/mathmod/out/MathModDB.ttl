    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mn>1</mn></mrow></msub><msub><mi>C</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi></mrow></mrow></mfrac></mrow><mi>exp</mi><mo>&#x2061;</mo><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>θ</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">−</mo><mi>θ</mi></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">−</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mn>2</mn></mrow></msub><mi>θ</mi></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>R</mi><mi>T</mi></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "theoretical adsorption isotherm including lateral interactions"@en .

<https://portal.mardi4nfdi.de/entity/Q6775822> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Hill-de Boer model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Hill–de Boer constant and the interaction energy constant by fitting the nonlinear Hill–de Boer equation directly to measured equilibrium concentration and fractional surface coverage data. The results quantify adsorption affinity and the magnitude of lateral interactions between adsorbed molecules without the distortions introduced by linearization. This approach provides a more accurate representation of nonideal adsorption behavior described by the model." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
