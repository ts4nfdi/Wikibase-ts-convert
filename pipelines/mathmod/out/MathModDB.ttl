<https://portal.mardi4nfdi.de/entity/Q6775665> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "kinetic batch reactor model (Monod)"@en ;
    mathmoddb:P1459 "The Monod-based kinetic batch reactor model is a mathematical model that describes the growth of microorganisms and substrate consumption in a closed system. It relates the rate of biomass change to the concentration of a limiting substrate and includes a death rate coefficient to account for microbial decay." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775666" ;
