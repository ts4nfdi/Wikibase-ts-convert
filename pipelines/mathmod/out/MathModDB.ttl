<https://portal.mardi4nfdi.de/entity/Q6821576> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "hydrology"@en ;
    mathmoddb:P12 "Q42250" ;
    mathmoddb:P1459 "Hydrology is the scientific study of the occurrence, movement, distribution, and quality of water on Earth and in the atmosphere. It examines the processes of the water cycle, including precipitation, evaporation, infiltration, runoff, and groundwater flow. Hydrology provides the theoretical and methodological basis for understanding water availability in natural and managed systems. The discipline supports applications in water resource management, agriculture, ecology, and environmental protection." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6821603" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "science that deals with the water above, on and below the land surface of the earth"@en .

