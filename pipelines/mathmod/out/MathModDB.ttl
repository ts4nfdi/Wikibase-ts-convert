<https://portal.mardi4nfdi.de/entity/Q6821190> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Fritz-Schlunder 4-parameter model)"@en ;
    mathmoddb:P1459 "The Fritz-Schlunder 4-parameter isotherm model is a highly flexible empirical equation used to fit adsorption data across wide concentration ranges. It introduces two exponents to capture complex heterogeneity of adsorption sites. The model is especially useful for systems that deviate strongly from classical isotherms and require additional curvature control. Although it has no mechanistic interpretation, it provides accurate empirical correlations. It is frequently applied in advanced adsorption system characterization." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775715" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775714" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "estimation of Fritz-Schlunder model parameters"@en .

