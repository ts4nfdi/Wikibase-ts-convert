<https://portal.mardi4nfdi.de/entity/Q6775830> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Hill model (adsorption)"@en ;
    mathmoddb:P1459 "The Hill model in adsorption is an empirical isotherm used to describe cooperative uptake of solutes on solid surfaces. It represents systems in which the adsorption of one molecule increases or decreases the likelihood of subsequent adsorption events, producing a sigmoidal equilibrium curve. The model captures saturation behavior and incorporates a cooperativity exponent to reflect positive or negative interaction among adsorbed species. When the cooperativity exponent equals one, the model reduces to the non-cooperative Langmuir isotherm. The Hill adsorption model is applied to systems exhibiting S-shaped adsorption behavior in water treatment, materials science, and surface chemistry." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775832" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775831" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775766" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775858" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "empirical model describing cooperative adsorption on surfaces"@en .

