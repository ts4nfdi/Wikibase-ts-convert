<https://portal.mardi4nfdi.de/entity/Q6824222> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "accumulated root weight in soil layer"@en ;
    mathmoddb:P1459 "This quantity represents the accumulated root weight allocated to a specific soil layer up to a specific day. It is a portion of the accumulated total root weight." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775552" ;
    schema:description "weight of roots in soil layer"@en .

<https://portal.mardi4nfdi.de/entity/Q6824223> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "root weight in soil layer accumulation equation"@en ;
    mathmoddb:P1459 "This equation updates the accumulated root weight in soil layer by adding the daily root weight in soil layer increment to its previous value. It represents the temporal integration of daily root weight production in soil layer over the growing season. The formulation assumes that root weight accumulation is additive and does not impose additional physiological constraints beyond those governing daily production. The equation is applied at each simulation time step to maintain the root weight state variable. It provides the accumulated root weight in soil layer used in subsequent processes, e.g. plant phosphorus uptake." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>Δ</mi><mi>R</mi><mi>W</mi></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mi>R</mi><msub><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo stretchy=\"false\">−</mo><mn>1</mn><mo>,</mo><mi>l</mi></mrow></mrow></msub><mo stretchy=\"false\">+</mo><mi>Δ</mi><mi>R</mi><mi>W</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>l</mi></mrow></mstyle></mrow></math>" ;
    schema:description "accumulates daily root weight in soil layer"@en .

