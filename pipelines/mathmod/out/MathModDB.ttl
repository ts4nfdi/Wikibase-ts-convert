    schema:description "soil phosphorus availability response"@en .

<https://portal.mardi4nfdi.de/entity/Q6824235> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of crop phosphorus demand"@en ;
    mathmoddb:P1459 "This task estimates the daily phosphorus demand of a crop based on accumulated plant biomass and an optimal phosphorus concentration that declines with phenological development. The optimal concentration is computed as a nonlinear function of heat unit index, and cumulative phosphorus uptake is subtracted to determine unmet demand." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6824232" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775549" ;
    schema:description "determine daily phosphorus demand of the crop"@en .

<https://portal.mardi4nfdi.de/entity/Q6824236> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "computation of soil phosphorus supply"@en ;
    mathmoddb:P1459 "This task estimates the phosphorus supply available to the crop from the soil based on plant phosphorus demand, root biomass distribution across soil layers, and labile phosphorus availability. A nonlinear labile phosphorus uptake factor modulates root-weighted supply, allowing enhanced uptake under phosphorus-deficient conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
