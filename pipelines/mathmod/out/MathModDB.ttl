<https://portal.mardi4nfdi.de/entity/Q6824234> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "labile phosphorus uptake factor equation"@en ;
    mathmoddb:P1459 "Computes a dimensionless uptake factor based on labile soil phosphorus concentration, allowing near-optimal uptake at sufficiently high labile phosphorus levels." ;
