    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672114" ;
    schema:description "integer number identifying a specific day"@en .

<https://portal.mardi4nfdi.de/entity/Q6821290> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "daily change in leaf area index"@en ;
    mathmoddb:P1459 "This quantity represents the daily change in leaf area index before the onset of leaf decline. The quantity controls the dynamic evolution of canopy size over time." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672114" ;
    schema:description "increment in leaf area index"@en .

