<https://portal.mardi4nfdi.de/entity/Q6821601> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "crop water usage model"@en ;
    mathmoddb:P1459 "This model simulates the potential and actual water use of crops from the soil profile. It estimates plant evaporation as a function of potential evaporation and canopy development. Water uptake is distributed through the root zone according to an exponential depth function that can account for soil water deficit compensation. The model further reduces potential uptake when soil moisture becomes limiting. Together, these components provide a mechanistic representation of plant water use under varying soil and atmospheric conditions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821598" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821588" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821276" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "simulates crop water uptake from soil profile"@en .

<https://portal.mardi4nfdi.de/entity/Q6821602> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "estimation of crop water use"@en ;
    mathmoddb:P1459 "This research problem addresses how crops extract water from the soil to meet atmospheric demand. Plant water use depends on canopy development, soil moisture availability, and the ability of plants to compensate for local water deficits. The problem links soil hydrology with plant physiological demand." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6821601" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "quantify plant water uptake from soil"@en .

<https://portal.mardi4nfdi.de/entity/Q6821603> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q60231> ;
    rdfs:label "agricultural hydrology"@en ;
    mathmoddb:P12 "Q2883300" ;
    mathmoddb:P1459 "Agricultural hydrology examines the movement, availability, and use of water in agricultural landscapes. It integrates soil physics, plant physiology, and atmospheric processes to understand crop water demand and supply. Models of plant water uptake provide essential tools for evaluating irrigation needs, drought impacts, and water-use efficiency. The discipline supports sustainable water management in crop production systems." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534268" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821602" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q60231" ;
    schema:description "study of water balance components intervening in agricultural water management, especially in irrigation and drainage"@en .

