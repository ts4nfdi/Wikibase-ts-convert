<https://portal.mardi4nfdi.de/entity/Q6775500> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "heavy particle propagation"@en ;
    mathmoddb:P1459 "The classical trajectories can be integrated with conventional methods, as the Verlet algorithm. Such integration requires the forces acting on the nuclei. They are proportional to the gradient of the potential energy of the electronic states." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1690 "https://en.wikipedia.org/wiki/Mixed_quantum-classical_dynamics" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "propagating the (classical!) state of the heavy particle(s) in quantum-classical dynamics models"@en .

<https://portal.mardi4nfdi.de/entity/Q6775501> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "heavy particle velocity adjustment"@en ;
    mathmoddb:P1459 "If the classical kinetic energy can aﬀord the energy cost of the quantum transition, the nuclei switch simultaneously to the new PES. The nuclear positions are kept unchanged and the nuclear velocities are adjusted along the direction of the nonadiabatic (NA) coupling vector to conserve total energy. Otherwise, the surface hop is rejected. This procedure is essential to achieve Boltzmann quantum state populations and detailed balance between hops up and down in energy." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "adjusting heavy particle(s) velocity upon nonadiabatic transitions in quantum-classical dynamics"@en .

<https://portal.mardi4nfdi.de/entity/Q6775502> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "light particle nonadiabatic transitions"@en ;
    mathmoddb:P1459 "Typically, the many different approaches to quantum-classical dynamics, most notably surface hopping trajectories, differ in the way how the nonadiabatic transition probabilities are calculated." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1690 "https://en.wikipedia.org/wiki/Mixed_quantum-classical_dynamics" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "nonadiabatic transitions of the light particle(s) in quantum-classical dynamics models"@en .

<https://portal.mardi4nfdi.de/entity/Q6775503> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "light particle propagation"@en ;
    mathmoddb:P1459 "The electrons are usually treated by a local approximation of the TDSE, i.e., they depend only on the electronic forces and couplings at the instantaneous position of the nuclei." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775478" ;
    mathmoddb:P1690 "https://www.wikidata.org/wiki/Q65091550" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534247" ;
    schema:description "propagating the (quantum!) state of the light particle(s) in quantum-classical dynamics models"@en .

