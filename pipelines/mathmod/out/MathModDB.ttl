    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q2603291" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>ℓ</mi></mstyle></mrow></math>" ;
