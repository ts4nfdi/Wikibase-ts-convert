    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>v</mi><mrow data-mjx-texclass=\"ORD\"><mn>0</mn></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msub><mi>V</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>m</mi><mi>a</mi><mi>x</mi></mrow></mrow></msub><msubsup><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>S</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup></mrow></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><msubsup><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mn>0.5</mn></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup><mo stretchy=\"false\">+</mo><msubsup><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>S</mi></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mi>H</mi></mrow></msub></mrow></msubsup></mrow></mrow></mfrac></mrow></mstyle></mrow></math>" ;
    schema:description "cooperative rate equation for enzyme catalysis"@en .

<https://portal.mardi4nfdi.de/entity/Q6775836> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Hill enzyme kinetics model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation for the Hill enzyme-kinetics model using initial reaction-rate data. It determines the maximal catalytic rate, the Hill kinetic constant, and the cooperativity exponent by fitting the nonlinear Hill velocity equation directly to substrate-concentration and reaction-velocity measurements. Nonlinear regression avoids biases that occur when kinetic data are linearized, producing more accurate parameter estimates for cooperative, allosteric, or multimeric enzymes. The resulting values characterize catalytic efficiency, apparent substrate affinity, and the degree of cooperativity in enzymatic turnover. This method is used in biochemistry and systems biology to analyze non-Michaelis–Menten reaction behavior." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775850" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "nonlinear estimation of Hill enzyme kinetics parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6775837> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Hill model (dose-response)"@en ;
    mathmoddb:P1459 "The Hill model in dose–response analysis is an empirical pharmacodynamic model used to represent cooperative activation or inhibition by drugs or ligands. It describes how biological effect increases with concentration in a sigmoidal manner controlled by a cooperativity exponent. The model includes a maximal effect and a half-maximal concentration parameter, providing intuitive measures of efficacy and potency. When the cooperativity exponent equals one, the model reduces to the non-cooperative hyperbolic Emax model. The Hill dose–response model is widely used in pharmacology, toxicology, and pharmacokinetic–pharmacodynamic modeling to analyze concentration–effect relationships." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775839" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775838" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775840" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775861" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "sigmoidal model describing cooperative dose–response behavior"@en .

