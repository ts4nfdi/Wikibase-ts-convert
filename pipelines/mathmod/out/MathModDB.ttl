    schema:description "Diagram showing the proportion of a receptor bound to a ligand"@en .

<https://portal.mardi4nfdi.de/entity/Q6775845> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Hill binding model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation for the Hill binding model using equilibrium ligand-binding data. It determines the Hill binding constant, maximal occupancy, and the cooperativity exponent by fitting the nonlinear Hill binding equation directly to free-ligand concentrations and fractional binding measurements. Nonlinear regression avoids artifacts from linearization and produces accurate estimates across cooperative, non-cooperative, and anti-cooperative regimes. The resulting parameters quantify binding affinity, saturation behavior, and the degree of cooperative interaction among binding sites. This method is commonly applied in biochemistry, molecular biology, and systems biology to study cooperative ligand–macromolecule interactions." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775844" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "nonlinear estimation of Hill binding model parameters"@en .

<https://portal.mardi4nfdi.de/entity/Q6775846> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534237> ;
    rdfs:label "Hill coefficient"@en ;
    mathmoddb:P12 "Q1618639" ;
    mathmoddb:P1459 "The Hill cooperativity coefficient is a dimensionless empirical parameter that quantifies the degree of cooperative behavior in a system modeled by a Hill-type equation. It determines how strongly the binding, adsorption, catalytic rate, or biological response departs from simple non-cooperative behavior. Values greater than one represent positive cooperativity, where one binding or adsorption event increases the likelihood of additional events, while values less than one indicate negative cooperativity. A value of exactly one corresponds to non-cooperative, hyperbolic behavior as seen in classical Langmuir, Michaelis–Menten, or Emax models. The Hill coefficient does not reflect a mechanistic number of sites but rather describes the steepness of the sigmoidal response curve." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534271" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534237" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "slope of the curve describing the binding of an inhibitor or a substrate"@en .

