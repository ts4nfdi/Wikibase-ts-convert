<https://portal.mardi4nfdi.de/entity/Q6821119> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Redlich-Peterson model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using experimental adsorption equilibrium data. The objective is to determine the Redlich-Peterson constant, coefficient, and exponent by directly fitting the nonlinear Redlich-Peterson equation to measured solute concentration and adsorbed amount data. Nonlinear regression preserves the full hybrid functional form, allowing the model to transition smoothly between Langmuir-like and Freundlich-like behavior. The resulting parameters quantify adsorption affinity, heterogeneity, and the degree of deviation from ideal monolayer adsorption." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821125" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775767" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q6821142" ;
    schema:description "nonlinear estimation of Redlich-Peterson model parameters"@en .

