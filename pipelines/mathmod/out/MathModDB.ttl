    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mtable displaystyle=\"true\"><mtr><mtd class=\"mwe-math-columnalign-r\"><mi>a</mi></mtd><mtd class=\"mwe-math-columnalign-l\"><mo stretchy=\"false\">=</mo><mn>1</mn></mtd></mtr><mtr><mtd class=\"mwe-math-columnalign-r\"><mi>b</mi></mtd><mtd class=\"mwe-math-columnalign-l\"><mo stretchy=\"false\">=</mo><mn>1</mn></mtd></mtr></mtable></mstyle></mrow></math>" ;
    schema:description "assumption for Fritz-Schlunder exponents"@en .

<https://portal.mardi4nfdi.de/entity/Q6821192> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Fritz-Schlunder 5-parameter isotherm model"@en ;
    mathmoddb:P1459 "The Fritz-Schlunder 5-parameter isotherm model is the most flexible member of the Fritz-Schlunder family, designed to accurately represent highly curved or complex adsorption isotherms. By combining a saturation capacity, two affinity constants, and two exponents, the model can match a wide range of heterogeneous adsorption behaviors, including systems where multilayer formation or strong site-energy diversity is present. It is fully empirical and places no mechanistic restrictions on surface behavior. It is primarily used in cases where simpler models show poor agreement with experimental data, such as in wastewater treatment adsorption studies involving highly heterogeneous adsorbents." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6821194" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821193" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6821201" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775551" ;
    schema:description "high-flexibility five-parameter adsorption isotherm model"@en .

