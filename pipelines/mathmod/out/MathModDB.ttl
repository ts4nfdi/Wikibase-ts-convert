<https://portal.mardi4nfdi.de/entity/Q6821136> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534247> ;
    rdfs:label "nonlinear parameter estimation (Sips model)"@en ;
    mathmoddb:P1459 "This task performs nonlinear parameter estimation using adsorption equilibrium data. The objective is to determine the Sips maximum adsorption capacity, the Sips equilibrium constant, and the Sips heterogeneity exponent by fitting the nonlinear Sips equation directly to measured solute concentrations and adsorbed amounts. The nonlinear approach preserves the combined Langmuir-Freundlich behavior of the model and avoids distortions introduced by linearization. The results characterize both the adsorption affinity and the degree of surface heterogeneity governing the adsorption process." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534272" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6821139" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6775767" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6672087" ;
    schema:description "nonlinear estimation of Sips isotherm parameters"@en .

