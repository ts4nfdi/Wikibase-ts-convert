<https://portal.mardi4nfdi.de/entity/Q6775820> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q68663> ;
    rdfs:label "Hill-de Boer isotherm model"@en ;
    mathmoddb:P1459 "The Hill–de Boer isotherm model is a theoretical adsorption model that accounts for lateral interactions and mobility among adsorbed molecules. It extends the Langmuir framework by incorporating an interaction energy term that captures attractive or repulsive forces between neighboring adsorbates. The model relates fractional surface coverage to equilibrium solute concentration through an exponential term derived from statistical thermodynamics. Because it includes interaction effects, it provides a more realistic description of adsorption on surfaces where adsorbate–adsorbate forces are significant. The Hill–de Boer model is used to analyze nonideal adsorption behavior in environmental, chemical, and surface science applications." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534270" ;
    mathmoddb:P147 "https://portal.mardi4nfdi.de/entity/Q6775823" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1560 "https://portal.mardi4nfdi.de/entity/Q6775821" ;
    mathmoddb:P1684 "https://portal.mardi4nfdi.de/entity/Q6820977" ;
    mathmoddb:P286 "https://portal.mardi4nfdi.de/entity/Q6775724" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q68663" ;
    mathmoddb:P558 "https://portal.mardi4nfdi.de/entity/Q3116516" ;
    schema:description "mathematical model describing adsorption with lateral interactions"@en .

