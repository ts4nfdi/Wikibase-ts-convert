<https://portal.mardi4nfdi.de/entity/Q6775792> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q6534292> ;
    rdfs:label "spatial prediction"@en ;
    mathmoddb:P1459 "Spatial prediction is the research problem of estimating the value of a variable at locations where no observations are available, based on measurements taken at other locations and on the spatial structure of the phenomenon under study. It aims to exploit spatial dependence, similarity, and possibly additional covariate information in order to infer unknown values across a spatial domain. Typical objectives include accurate interpolation, uncertainty quantification, and the generation of continuous prediction maps from discrete data. Spatial prediction plays a central role in fields such as geostatistics, environmental science, engineering, and remote sensing, where observations are often sparse, noisy, or irregularly distributed." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q6534269" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P1513 "https://portal.mardi4nfdi.de/entity/Q6822189" ;
    mathmoddb:P1640 "https://portal.mardi4nfdi.de/wiki/File:Spatial_interpolation_wiki.png" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6534292" ;
    schema:description "prediction of spatial quantities to unobserved locations"@en .

