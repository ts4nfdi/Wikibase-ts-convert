    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mi>ln</mi><mo>&#x2061;</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>c</mi><mrow data-mjx-texclass=\"ORD\"><mi>E</mi></mrow></msub></mrow></mfrac></mrow><mo stretchy=\"false\">=</mo><mi>ln</mi><mo>&#x2061;</mo><mrow data-mjx-texclass=\"ORD\"><msub><mi>K</mi><mrow data-mjx-texclass=\"ORD\"><mi>E</mi></mrow></msub><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mrow><mo stretchy=\"false\">−</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>e</mi></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><msub><mi>q</mi><mrow data-mjx-texclass=\"ORD\"><mi>m</mi></mrow></msub></mrow></mfrac></mrow></mstyle></mrow></math>" ;
