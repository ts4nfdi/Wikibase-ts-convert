<https://portal.mardi4nfdi.de/entity/Q6821588> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "cumulative potential plant water use equation"@en ;
    mathmoddb:P1459 "This equation computes the cumulative potential water use by plants from the soil surface to a specified depth. It distributes evaporative demand using an exponential depth function controlled by a soil-plant interaction parameter. The formulation reflects decreasing root activity with depth under typical conditions. It provides the basis for estimating water uptake by soil layers." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
    mathmoddb:P31 "https://portal.mardi4nfdi.de/entity/Q6775550" ;
    mathmoddb:P983 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mi>P</mi></mrow></msub></mstyle></mrow></math>" ;
    mathmoddb:P989 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" class=\"mwe-math-element mwe-math-element-inline\"><mrow data-mjx-texclass=\"ORD\"><mstyle displaystyle=\"true\" scriptlevel=\"0\"><msub><mi>U</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub><mo stretchy=\"false\">=</mo><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><msub><mi>E</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>P</mi><mo>,</mo><mi>i</mi></mrow></mrow></msub></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mn>1</mn><mo stretchy=\"false\">−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mi>Λ</mi></mrow></mrow></msup></mrow></mrow></mfrac></mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo stretchy=\"false\">−</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">−</mo><mi>Λ</mi><mrow data-mjx-texclass=\"ORD\"><mfrac><mrow data-mjx-texclass=\"ORD\"><mi>Z</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mrow data-mjx-texclass=\"ORD\"><mi>R</mi><mi>Z</mi></mrow></mrow></mfrac></mrow></mrow></mrow></msup><mo stretchy=\"false\">)</mo></mstyle></mrow></math>" ;
    schema:description "estimates cumulative potential plant water use from the root zone"@en .

<https://portal.mardi4nfdi.de/entity/Q6821589> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "potential crop water use rate in soil layer equation (total compensation)"@en ;
    mathmoddb:P1459 "This equation distributes potential plant water use among soil layers within the root zone using an exponential depth function. A compensation mechanism is employed which allows plants to offset water deficits in dry layers by increasing uptake from wetter layers." ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
    mathmoddb:P1495 "https://portal.mardi4nfdi.de/entity/Q6534265" ;
