<https://portal.mardi4nfdi.de/entity/Q6821372> a owl:NamedIndividual,
        <https://portal.mardi4nfdi.de/entity/Q96183> ;
    rdfs:label "Weber-van Vliet equation"@en ;
    mathmoddb:P1460 "https://portal.mardi4nfdi.de/entity/Q5981696" ;
